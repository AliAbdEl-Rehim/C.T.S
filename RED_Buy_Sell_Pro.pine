//@version=6
indicator("RED Buy Sell PRO [Critical Reclaim]", shorttitle = "RED PRO", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200)

// ══════════════════════════════════════════════════════════════════════════════
// RED Buy Sell PRO
// الشراء/البيع الدقيق = إغلاق صندوق Critical Areas (استعادة HMA السريع للخط المنعكس)
// الصندوق يتوسع كل شمعة. الإشارة الافتراضية بعد إغلاق الشمعة حتى لا يعاد رسمها.
// ══════════════════════════════════════════════════════════════════════════════

string GRP_CORE = "01 RED Core"
string GRP_SIG  = "02 Signals"
string GRP_BOX  = "03 Critical Areas"
string GRP_FLT  = "04 Filters"
string GRP_RSK  = "05 Risk (TP / SL)"
string GRP_VIS  = "06 Display"
string GRP_ALR  = "07 Alerts"

fastHmaLen   = input.int(8, "Fast HMA (cross line)", minval = 2, group = GRP_CORE)
shortHmaLen  = input.int(36, "Short HMA", minval = 2, group = GRP_CORE)
longHmaLen   = input.int(44, "Long HMA", minval = 2, group = GRP_CORE)
smoothLen    = input.int(2, "Reflected Smooth Period", minval = 1, group = GRP_CORE)
trailMode    = input.string("ATR", "Trail Mode", options = ["ATR", "Percent"], group = GRP_CORE, tooltip = "ATR أدق من النسبة الأصلية 0.04%.")
atrLen       = input.int(14, "ATR Length", minval = 1, group = GRP_CORE)
atrMult      = input.float(2.0, "ATR Trail Multiplier", minval = 0.5, step = 0.1, group = GRP_CORE)
pctTrail     = input.float(1.5, "Percent Trail %", minval = 0.05, step = 0.05, group = GRP_CORE)

signalLang   = input.string("AR", "Language", options = ["AR", "EN"], group = GRP_SIG)
profile      = input.string("Balanced", "Profile", options = ["More Signals", "Balanced", "Precision", "Custom"], group = GRP_SIG)
entryMode    = input.string("Continuation", "Entry Mode", options = ["Continuation", "Reversal", "Both"], group = GRP_SIG, tooltip = "Continuation = دخول عند إغلاق الصندوق. Reversal = انقلاب التريل.")
confirmClose = input.bool(true, "Confirm on candle close (no repaint)", group = GRP_SIG, tooltip = "ON = بعد إغلاق الشمعة (أدق، وتقدر تدخل على الإغلاق). OFF = أثناء شمعة اليوم (قد تتغير قبل الإغلاق).")
requireBody  = input.bool(true, "Require candle in trade direction", group = GRP_SIG)
minBoxBars   = input.int(2, "Min Critical bars before entry", minval = 1, maxval = 20, group = GRP_SIG)
cooldownBars = input.int(5, "Cooldown after signal (bars)", minval = 0, maxval = 50, group = GRP_SIG)
minConfInput = input.int(62, "Min Confidence % (Custom)", minval = 40, maxval = 95, group = GRP_SIG)
oneWayUntilExit = input.bool(true, "One signal until TP/SL/opposite", group = GRP_SIG)

showBoxes    = input.bool(true, "Show Critical Area boxes", group = GRP_BOX)
expandBox    = input.bool(true, "Expand box to pullback range", group = GRP_BOX)
showBothSides = input.bool(true, "Boxes in downtrend too", group = GRP_BOX)
boxBullTxt   = input.string("Critical Areas", "Uptrend box text", group = GRP_BOX)
boxBearTxt   = input.string("Critical Areas", "Downtrend box text", group = GRP_BOX)

useMtf       = input.bool(true, "HTF trend alignment", group = GRP_FLT)
htfTf        = input.timeframe("60", "Higher Timeframe", group = GRP_FLT)
htfEmaLen    = input.int(50, "HTF EMA", minval = 10, group = GRP_FLT)
useAdx       = input.bool(true, "ADX filter", group = GRP_FLT)
adxLen       = input.int(14, "ADX Length", minval = 5, group = GRP_FLT)
adxMin       = input.float(18.0, "Min ADX", minval = 5, step = 1, group = GRP_FLT)
useRsi       = input.bool(true, "Block RSI extremes", group = GRP_FLT)
rsiLen       = input.int(14, "RSI Length", minval = 2, group = GRP_FLT)
rsiOb        = input.int(75, "RSI Overbought (block BUY)", minval = 55, maxval = 95, group = GRP_FLT)
rsiOs        = input.int(25, "RSI Oversold (block SELL)", minval = 5, maxval = 45, group = GRP_FLT)
useVol       = input.bool(false, "Volume confirmation", group = GRP_FLT)
volMult      = input.float(1.1, "Volume x SMA20", minval = 0.5, step = 0.1, group = GRP_FLT)
useChop      = input.bool(true, "Block compressed volatility", group = GRP_FLT)
useSession   = input.bool(false, "Session filter", group = GRP_FLT)
sessStr      = input.session("0000-2359", "Session", group = GRP_FLT)

showRisk     = input.bool(true, "Show TP / SL lines", group = GRP_RSK)
slAtrBuf     = input.float(0.25, "SL buffer (xATR beyond box)", minval = 0.0, step = 0.05, group = GRP_RSK)
minSlAtr     = input.float(0.8, "Min SL distance (xATR)", minval = 0.2, step = 0.1, group = GRP_RSK)
tp1R         = input.float(1.0, "TP1 (xRisk)", minval = 0.5, step = 0.1, group = GRP_RSK)
tp2R         = input.float(2.0, "TP2 (xRisk)", minval = 1.0, step = 0.1, group = GRP_RSK)
tp3R         = input.float(3.0, "TP3 (xRisk)", minval = 1.5, step = 0.1, group = GRP_RSK)
moveBE       = input.bool(true, "Move SL to breakeven at TP1", group = GRP_RSK)

showRedLine  = input.bool(true, "Show reflected RED line", group = GRP_VIS)
showHma8     = input.bool(true, "Show Fast HMA", group = GRP_VIS)
showTrail    = input.bool(true, "Show trail", group = GRP_VIS)
showRejected = input.bool(false, "Show rejected setups", group = GRP_VIS)
showDash     = input.bool(true, "Show dashboard", group = GRP_VIS)
dashPos      = input.string("Top Right", "Dashboard position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = GRP_VIS)

enableAlerts = input.bool(true, "Enable alert() calls", group = GRP_ALR)

// ── Profile ──────────────────────────────────────────────────────────────────
bool moreSig = profile == "More Signals"
bool precis  = profile == "Precision"
bool custom  = profile == "Custom"
int  effMinConf = custom ? minConfInput : precis ? 75 : moreSig ? 50 : 62
int  effMinBox  = custom ? minBoxBars : precis ? 3 : moreSig ? 1 : minBoxBars
bool effMtf     = custom ? useMtf : precis ? true : moreSig ? false : useMtf
bool effAdx     = custom ? useAdx : precis ? true : moreSig ? false : useAdx
bool wantCont   = entryMode == "Continuation" or entryMode == "Both"
bool wantRev    = entryMode == "Reversal" or entryMode == "Both"
bool ar         = signalLang == "AR"

// ── Core RED math ────────────────────────────────────────────────────────────
float hmaFast   = ta.hma(close, fastHmaLen)
float hmaShort  = ta.hma(close, shortHmaLen)
float hmaLong   = ta.hma(close, longHmaLen)
float reflected = 2.0 * hmaShort - hmaLong
float smooth    = ta.hma(reflected, smoothLen)
float atr       = ta.atr(atrLen)
float rsiVal    = ta.rsi(close, rsiLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
float volMa     = ta.sma(volume, 20)
float atrSlow   = ta.atr(50)
float trailDist = trailMode == "ATR" ? atr * atrMult : math.max(nz(smooth, close) * pctTrail * 0.01, syminfo.mintick)

bool xDown = ta.crossunder(hmaFast, reflected)
bool xUp   = ta.crossover(hmaFast, reflected)

float htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
float htfClose = request.security(syminfo.tickerid, htfTf, close, barmerge.gaps_off, barmerge.lookahead_off)
bool  htfBull  = htfClose > htfEma
bool  htfBear  = htfClose < htfEma

bool volOk   = not useVol or volume > volMa * volMult
bool chopOk  = not useChop or (atr / math.max(atrSlow, syminfo.mintick) >= 0.7)
bool sessOk  = not useSession or not na(time(timeframe.period, sessStr))
bool adxOk   = not effAdx or adxVal >= adxMin
bool barOk   = not confirmClose or barstate.isconfirmed
bool bullCnd = close > open
bool bearCnd = close < open

// ── Trail / trend ────────────────────────────────────────────────────────────
var int   dir    = 0
var float peak   = na
var float trough = na
var float trail  = na
bool revBuy  = false
bool revSell = false

if not na(smooth)
    if dir == 0
        dir := hmaShort >= hmaLong ? 1 : -1
        peak := smooth
        trough := smooth
        trail := dir == 1 ? smooth - trailDist : smooth + trailDist
    else if dir == 1
        peak := math.max(nz(peak, smooth), smooth)
        trail := trailMode == "ATR" ? peak - trailDist : peak * (1.0 - pctTrail * 0.01)
        if smooth <= trail
            dir := -1
            trough := smooth
            trail := trailMode == "ATR" ? smooth + trailDist : smooth * (1.0 + pctTrail * 0.01)
            revSell := true
    else
        trough := math.min(nz(trough, smooth), smooth)
        trail := trailMode == "ATR" ? trough + trailDist : trough * (1.0 + pctTrail * 0.01)
        if smooth >= trail
            dir := 1
            peak := smooth
            trail := trailMode == "ATR" ? smooth - trailDist : smooth * (1.0 - pctTrail * 0.01)
            revBuy := true

bool upTrend   = dir == 1
bool downTrend = dir == -1

// ── Critical zone (logical + visual, grows every bar) ────────────────────────
var box   critBox  = na
var int   zoneSide = 0
var int   zoneStart = na
var float zoneTop  = na
var float zoneBot  = na

if zoneSide != 0
    zoneTop := math.max(nz(zoneTop, high), high)
    zoneBot := math.min(nz(zoneBot, low), low)
    if not na(critBox)
        box.set_right(critBox, bar_index)
        if expandBox
            box.set_top(critBox, zoneTop)
            box.set_bottom(critBox, zoneBot)

bool flippedAgainstZone = (zoneSide == 1 and revSell) or (zoneSide == -1 and revBuy)
if flippedAgainstZone and zoneSide != 0
    if not na(critBox)
        box.set_right(critBox, bar_index)
        critBox := na
    zoneSide := 0
    zoneStart := na

int  zoneLen   = zoneSide == 0 or na(zoneStart) ? 0 : bar_index - zoneStart + 1
bool zoneReady = zoneSide != 0 and zoneLen >= effMinBox

bool reclaimUp   = xUp and zoneSide == 1 and zoneReady and not flippedAgainstZone
bool reclaimDown = xDown and zoneSide == -1 and zoneReady and not flippedAgainstZone
bool setupBuy    = reclaimUp and upTrend
bool setupSell   = reclaimDown and downTrend

// Close zone on confirmed reclaim (keeps box growing until the close of that candle)
if barOk and (reclaimUp or reclaimDown) and zoneSide != 0
    if not na(critBox)
        box.set_right(critBox, bar_index)
        critBox := na
    zoneSide := 0
    zoneStart := na

bool canOpenLongZone  = barOk and xDown and upTrend and zoneSide == 0
bool canOpenShortZone = barOk and showBothSides and xUp and downTrend and zoneSide == 0

if canOpenLongZone
    zoneSide := 1
    zoneStart := bar_index
    zoneTop := high
    zoneBot := low
    if showBoxes
        critBox := box.new(bar_index, high, bar_index, low, border_color = color.rgb(254, 213, 31), border_width = 2, bgcolor = color.new(color.red, 88), text = boxBullTxt, text_color = color.white, text_size = size.small)

if canOpenShortZone
    zoneSide := -1
    zoneStart := bar_index
    zoneTop := high
    zoneBot := low
    if showBoxes
        critBox := box.new(bar_index, high, bar_index, low, border_color = color.rgb(254, 213, 31), border_width = 2, bgcolor = color.new(color.teal, 88), text = boxBearTxt, text_color = color.white, text_size = size.small)

// ── Score ────────────────────────────────────────────────────────────────────
scoreOf(bool isLong) =>
    int s = 48
    s += isLong ? (upTrend ? 12 : 0) : (downTrend ? 12 : 0)
    s += isLong ? ((not effMtf or htfBull) ? 10 : 0) : ((not effMtf or htfBear) ? 10 : 0)
    s += adxOk ? 8 : 0
    s += volOk ? 6 : 0
    s += chopOk ? 4 : 0
    s += isLong ? ((not useRsi or rsiVal < rsiOb) ? 5 : 0) : ((not useRsi or rsiVal > rsiOs) ? 5 : 0)
    s += isLong ? ((not requireBody or bullCnd) ? 4 : 0) : ((not requireBody or bearCnd) ? 4 : 0)
    s += zoneLen >= 3 ? 3 : 0
    math.min(s, 99)

int buyScore  = scoreOf(true)
int sellScore = scoreOf(false)

bool rsiBuyOk   = not useRsi or rsiVal < rsiOb
bool rsiSellOk  = not useRsi or rsiVal > rsiOs
bool mtfBuyOk   = not effMtf or htfBull
bool mtfSellOk  = not effMtf or htfBear
bool bodyBuyOk  = not requireBody or bullCnd
bool bodySellOk = not requireBody or bearCnd
bool closeBuyOk  = close > reflected
bool closeSellOk = close < reflected

var int   lastSigBar = -999
var int   posDir     = 0
var float posEntry   = na
var float posSL      = na
var float posTP1     = na
var float posTP2     = na
var float posTP3     = na
var bool  beDone     = false
var int   wins       = 0
var int   losses     = 0
var int   trades     = 0

bool cooled   = (bar_index - lastSigBar) >= cooldownBars
bool slotFree = not oneWayUntilExit or posDir == 0

bool filtersBuy  = barOk and sessOk and chopOk and adxOk and volOk and rsiBuyOk and mtfBuyOk and bodyBuyOk and closeBuyOk and cooled and slotFree and buyScore >= effMinConf
bool filtersSell = barOk and sessOk and chopOk and adxOk and volOk and rsiSellOk and mtfSellOk and bodySellOk and closeSellOk and cooled and slotFree and sellScore >= effMinConf

bool buyCont  = wantCont and setupBuy and filtersBuy
bool sellCont = wantCont and setupSell and filtersSell
bool buyRev   = wantRev and revBuy and filtersBuy and not buyCont
bool sellRev  = wantRev and revSell and filtersSell and not sellCont
bool buyNow   = buyCont or buyRev
bool sellNow  = sellCont or sellRev
bool rejBuy   = showRejected and setupBuy and not buyNow and barOk
bool rejSell  = showRejected and setupSell and not sellNow and barOk

string buyWhy  = buyCont ? (ar ? "استعادة المنطقة الحرجة" : "Critical reclaim") : (ar ? "انعكاس التريل" : "Trail reversal")
string sellWhy = sellCont ? (ar ? "استعادة المنطقة الحرجة" : "Critical reclaim") : (ar ? "انعكاس التريل" : "Trail reversal")

// ── Manage open visual trade ─────────────────────────────────────────────────
if posDir == 1 and not na(posSL)
    if moveBE and not beDone and not na(posTP1) and high >= posTP1
        posSL := math.max(posSL, posEntry)
        beDone := true
    if low <= posSL
        losses += 1
        trades += 1
        posDir := 0
        beDone := false
    else if not na(posTP2) and high >= posTP2
        wins += 1
        trades += 1
        posDir := 0
        beDone := false
else if posDir == -1 and not na(posSL)
    if moveBE and not beDone and not na(posTP1) and low <= posTP1
        posSL := math.min(posSL, posEntry)
        beDone := true
    if high >= posSL
        losses += 1
        trades += 1
        posDir := 0
        beDone := false
    else if not na(posTP2) and low <= posTP2
        wins += 1
        trades += 1
        posDir := 0
        beDone := false

if buyNow
    float eBuy = close
    float rawSlBuy = (buyCont ? nz(zoneBot, low) : ta.lowest(low, 5)) - atr * slAtrBuf
    float riskBuy = math.max(eBuy - math.min(rawSlBuy, eBuy - atr * minSlAtr), atr * minSlAtr)
    posDir := 1
    posEntry := eBuy
    posSL := eBuy - riskBuy
    posTP1 := eBuy + riskBuy * tp1R
    posTP2 := eBuy + riskBuy * tp2R
    posTP3 := eBuy + riskBuy * tp3R
    beDone := false
    lastSigBar := bar_index

if sellNow
    float eSell = close
    float rawSlSell = (sellCont ? nz(zoneTop, high) : ta.highest(high, 5)) + atr * slAtrBuf
    float riskSell = math.max(math.max(rawSlSell, eSell + atr * minSlAtr) - eSell, atr * minSlAtr)
    posDir := -1
    posEntry := eSell
    posSL := eSell + riskSell
    posTP1 := eSell - riskSell * tp1R
    posTP2 := eSell - riskSell * tp2R
    posTP3 := eSell - riskSell * tp3R
    beDone := false
    lastSigBar := bar_index

// ── Plots ────────────────────────────────────────────────────────────────────
plot(showRedLine ? reflected : na, "RED reflected", reflected > smooth ? color.rgb(253, 25, 238, 20) : color.rgb(183, 255, 30), 2)
plot(showHma8 ? hmaFast : na, "Fast HMA", color.new(#4fc3f7, 0), 1)
plot(showTrail ? trail : na, "Trail", upTrend ? color.new(color.green, 0) : color.new(color.red, 0), 2, plot.style_linebr)

plotshape(buyNow, title = "BUY", style = shape.labelup, location = location.belowbar, color = color.new(#00e676, 0), textcolor = color.white, size = size.small, text = "BUY")
plotshape(sellNow, title = "SELL", style = shape.labeldown, location = location.abovebar, color = color.new(#ff1744, 0), textcolor = color.white, size = size.small, text = "SELL")
plotshape(rejBuy, title = "Rejected BUY", style = shape.circle, location = location.belowbar, color = color.new(color.gray, 30), size = size.tiny)
plotshape(rejSell, title = "Rejected SELL", style = shape.circle, location = location.abovebar, color = color.new(color.gray, 30), size = size.tiny)

if buyNow
    label.new(bar_index, low - atr * 0.6, (ar ? "شراء\n" : "BUY\n") + buyWhy + "\n" + str.tostring(buyScore) + "%", style = label.style_label_up, color = color.new(#00c853, 10), textcolor = color.white, size = size.small)
if sellNow
    label.new(bar_index, high + atr * 0.6, (ar ? "بيع\n" : "SELL\n") + sellWhy + "\n" + str.tostring(sellScore) + "%", style = label.style_label_down, color = color.new(#d50000, 10), textcolor = color.white, size = size.small)

if showRisk and (buyNow or sellNow)
    line.new(bar_index, posEntry, bar_index + 12, posEntry, color = color.new(color.white, 20), width = 1, style = line.style_dotted)
    line.new(bar_index, posSL, bar_index + 12, posSL, color = color.new(#ff1744, 0), width = 2)
    line.new(bar_index, posTP1, bar_index + 12, posTP1, color = color.new(#ffff00, 0), width = 1)
    line.new(bar_index, posTP2, bar_index + 12, posTP2, color = color.new(#00e676, 0), width = 2)
    line.new(bar_index, posTP3, bar_index + 12, posTP3, color = color.new(#00c853, 0), width = 1)
    label.new(bar_index + 12, posSL, "SL " + str.tostring(posSL, format.mintick), style = label.style_label_left, color = color.new(#ff1744, 20), textcolor = color.white, size = size.tiny)
    label.new(bar_index + 12, posTP1, "TP1", style = label.style_label_left, color = color.new(#ffff00, 30), textcolor = color.black, size = size.tiny)
    label.new(bar_index + 12, posTP2, "TP2", style = label.style_label_left, color = color.new(#00e676, 20), textcolor = color.black, size = size.tiny)
    label.new(bar_index + 12, posTP3, "TP3", style = label.style_label_left, color = color.new(#00c853, 20), textcolor = color.black, size = size.tiny)

// ── Dashboard ────────────────────────────────────────────────────────────────
tablePos = dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : dashPos == "Bottom Left" ? position.bottom_left : position.top_right

if showDash and barstate.islast
    var table dash = table.new(tablePos, 2, 11, bgcolor = color.new(#0b0f14, 18), border_width = 1, border_color = color.new(#263238, 0))
    table.cell(dash, 0, 0, ar ? "RED إشارات دقيقة" : "RED Precise Signals", bgcolor = #102027, text_color = #ffd54f, text_size = size.small)
    table.cell(dash, 1, 0, profile, bgcolor = #102027, text_color = #ffd54f, text_size = size.small)

    table.cell(dash, 0, 1, ar ? "الاتجاه" : "Trend", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, upTrend ? (ar ? "صاعد" : "UP") : downTrend ? (ar ? "هابط" : "DOWN") : "—", text_color = upTrend ? #00e676 : #ff5252, text_size = size.small)

    table.cell(dash, 0, 2, "Critical Area", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, zoneSide == 0 ? (ar ? "مغلق" : "Closed") : (ar ? "مفتوح " : "Open ") + str.tostring(zoneLen), text_color = zoneSide == 0 ? color.silver : #ffd54f, text_size = size.small)

    string nxt = zoneSide == 1 ? (ar ? "انتظر استعادة ↑ ثم شراء" : "Wait reclaim ↑ then BUY") : zoneSide == -1 ? (ar ? "انتظر كسر ↓ ثم بيع" : "Wait reject ↓ then SELL") : (ar ? "لا إعداد" : "No setup")
    table.cell(dash, 0, 3, ar ? "الإعداد" : "Setup", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, nxt, text_color = #80d8ff, text_size = size.tiny)

    table.cell(dash, 0, 4, ar ? "الثقة Buy/Sell" : "Conf Buy/Sell", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(buyScore) + " / " + str.tostring(sellScore) + "  min " + str.tostring(effMinConf), text_color = color.white, text_size = size.small)

    table.cell(dash, 0, 5, "ADX / RSI", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(adxVal, "#.#") + " / " + str.tostring(rsiVal, "#.#"), text_color = adxOk ? #00e676 : #ffab00, text_size = size.small)

    table.cell(dash, 0, 6, "HTF", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 6, htfBull ? (ar ? "صاعد" : "Bull") : (ar ? "هابط" : "Bear"), text_color = htfBull ? #00e676 : #ff5252, text_size = size.small)

    table.cell(dash, 0, 7, ar ? "الصفقة" : "Position", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 7, posDir == 1 ? (ar ? "شراء مفتوح" : "Long") : posDir == -1 ? (ar ? "بيع مفتوح" : "Short") : (ar ? "لا صفقة" : "Flat"), text_color = posDir == 0 ? color.silver : posDir == 1 ? #00e676 : #ff5252, text_size = size.small)

    float wr = trades > 0 ? 100.0 * wins / trades : 0.0
    table.cell(dash, 0, 8, ar ? "النتائج" : "Tracker", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 8, str.tostring(wins) + "W / " + str.tostring(losses) + "L  (" + str.tostring(wr, "#.#") + "%)", text_color = color.white, text_size = size.small)

    table.cell(dash, 0, 9, ar ? "توقيت الإشارة" : "Signal timing", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 9, confirmClose ? (ar ? "بعد إغلاق الشمعة — ادخل" : "On close — you may enter") : (ar ? "شمعة اليوم (قد يعاد الرسم)" : "Live bar (can repaint)"), text_color = #ffd54f, text_size = size.tiny)

    table.cell(dash, 0, 10, ar ? "قاعدة الدخول" : "Entry rule", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 10, ar ? "إغلاق الصندوق + الفلاتر" : "Box close + filters", text_color = #80cbc4, text_size = size.tiny)

// ── Alerts ───────────────────────────────────────────────────────────────────
if enableAlerts and buyNow
    alert((ar ? "RED شراء | " : "RED BUY | ") + buyWhy + " | " + str.tostring(buyScore) + "% | " + syminfo.ticker, alert.freq_once_per_bar_close)
if enableAlerts and sellNow
    alert((ar ? "RED بيع | " : "RED SELL | ") + sellWhy + " | " + str.tostring(sellScore) + "% | " + syminfo.ticker, alert.freq_once_per_bar_close)

alertcondition(buyNow, "RED BUY", "RED precise BUY")
alertcondition(sellNow, "RED SELL", "RED precise SELL")
alertcondition(buyCont, "RED BUY Reclaim", "Critical Area reclaim BUY")
alertcondition(sellCont, "RED SELL Reclaim", "Critical Area reclaim SELL")
alertcondition(setupBuy, "RED BUY Setup", "Critical reclaim setup (unfiltered)")
alertcondition(setupSell, "RED SELL Setup", "Critical reclaim setup (unfiltered)")
