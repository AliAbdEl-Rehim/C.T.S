grp_cvd = "📊 CVD Leader Settings"
i_enableCVD        = input.bool(true, "Enable CVD Leader Confirmation", group=grp_cvd)
i_cvdAvgLen        = input.int(9, "CVD Avg Length (EMA of delta)", minval=1, group=grp_cvd)
i_cvdSmoothLen     = input.int(9, "CVD Smooth Length", minval=1, group=grp_cvd)
i_leadLen          = input.int(3, "Leader Smooth Length", minval=1, group=grp_cvd)
i_leadMult         = input.float(2.0, "Leader Sensitivity", step=0.1, group=grp_cvd)
i_resetDaily       = input.bool(true, "Reset CVD Each Session", group=grp_cvd)
i_chopZonePct      = input.float(0.15, "Chop Zone % of Range", step=0.01, group=grp_cvd, tooltip="Leader must be within this % of its range to qualify as chop")
i_chopSlopePct     = input.float(0.05, "Chop Slope % of Range", step=0.01, group=grp_cvd, tooltip="Leader slope must be below this % of range to qualify as chop")
i_cvdMode          = input.string("Confirm Both", "CVD Confirmation Mode", options=["Confirm Buy Signals", "Confirm Sell Signals", "Confirm Both", "None"], group=grp_cvd)
i_showCVDTable     = input.bool(true, "Show CVD Status in Tables", group=grp_cvd)

//====================================================================================
// 📋 INDICATORS CALCULATION
//====================================================================================
atr      = ta.atr(i_atrLen)
atrLong  = ta.atr(i_volRegimeLen)
emaFast  = ta.ema(close, i_emaFast)
emaSlow  = ta.ema(close, i_emaSlow)
emaHTF   = ta.ema(close, i_emaHTF)
volMA    = ta.sma(volume, i_rvolLen)
rvol     = volume / math.max(volMA, 1)

bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

// HTF buffer
htfBuf    = i_sigHTFBuffer * atr
aboveHTF  = close > emaHTF + htfBuf
belowHTF  = close < emaHTF - htfBuf

// Volatility regime
volRatio   = atr / math.max(atrLong, syminfo.mintick)
volCompressed = volRatio < i_volCompressPct
volExpanded   = volRatio > i_volExpandPct
volNormal     = not volCompressed and not volExpanded

// Killzones
inLondon = not na(time(timeframe.period, i_kzLondon, i_tzOffset))
inNYAM   = not na(time(timeframe.period, i_kzNYAM,   i_tzOffset))
inNYPM   = not na(time(timeframe.period, i_kzNYPM,   i_tzOffset))
inKZ     = inLondon or inNYAM or inNYPM

bgcolor(i_kzShowBG and inLondon ? color.new(#448aff, 94) : na)
bgcolor(i_kzShowBG and inNYAM   ? color.new(#00e676, 94) : na)
bgcolor(i_kzShowBG and inNYPM   ? color.new(#ffd700, 94) : na)

// Time-of-day filter
nyHour   = hour(time, i_tzOffset)
nyMinute = minute(time, i_tzOffset)
nyMinsFromMid = nyHour * 60 + nyMinute
openBlackout  = nyMinsFromMid >= 570 and nyMinsFromMid < (570 + i_avoidOpenMin)
closeBlackout = nyMinsFromMid >= (960 - i_avoidCloseMin) and nyMinsFromMid < 960
lunchBlackout = i_avoidLunch and nyMinsFromMid >= 690 and nyMinsFromMid < 810
inBlackout = i_useTimeFilter and (openBlackout or closeBlackout or lunchBlackout)

//====================================================================================
// 📋 TRAP DETECTION SYSTEM
//====================================================================================

// 1. RSI/Price Divergence Detection
rsi_for_divergence = ta.rsi(close, 14)
rsi_high = ta.pivothigh(rsi_for_divergence, 5, 5)
rsi_low = ta.pivotlow(rsi_for_divergence, 5, 5)
price_high = ta.pivothigh(high, 5, 5)
price_low = ta.pivotlow(low, 5, 5)

var float last_rsi_high = na
var float last_price_high = na
var float last_rsi_low = na
var float last_price_low = na

if not na(rsi_high) and not na(price_high)
    last_rsi_high := rsi_high
    last_price_high := price_high
if not na(rsi_low) and not na(price_low)
    last_rsi_low := rsi_low
    last_price_low := price_low

// Bearish Divergence (trap for buy signals - price makes higher high but RSI lower high)
bearish_divergence = detect_divergence and not na(last_rsi_high) and not na(last_price_high) and 
                     not na(rsi_high) and not na(price_high) and
                     price_high > last_price_high and rsi_high < last_rsi_high

// Bullish Divergence (trap for sell signals - price makes lower low but RSI higher low)
bullish_divergence = detect_divergence and not na(last_rsi_low) and not na(last_price_low) and 
                     not na(rsi_low) and not na(price_low) and
                     price_low < last_price_low and rsi_low > last_rsi_low

// 2. Volume Analysis for Traps
volume_ma_short = ta.sma(volume, 10)
volume_ma_long = ta.sma(volume, 20)
volume_declining = detect_volume_drop and volume < volume_ma_short and volume_ma_short < volume_ma_long
volume_increasing = volume > volume_ma_short and volume_ma_short > volume_ma_long

// 3. Rejection Pattern Detection (Long Wicks)
candle_body = math.abs(close - open)
candle_range = high - low
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low

bullish_rejection = detect_rejection_pattern and close > open and upper_wick > candle_body * 2 and upper_wick > lower_wick * 1.5
bearish_rejection = detect_rejection_pattern and close < open and lower_wick > candle_body * 2 and lower_wick > upper_wick * 1.5

// 4. Momentum Exhaustion Detection
[macd_line, signal_line, hist] = ta.macd(close, 12, 26, 9)
momentum_weakening_bullish = detect_exhaustion and hist > 0 and hist < hist[1] and hist[1] < hist[2]
momentum_weakening_bearish = detect_exhaustion and hist < 0 and hist > hist[1] and hist[1] > hist[2]

// 5. Multi-Timeframe Confirmation
htf_close = request.security(syminfo.tickerid, htf_period, close)
htf_ema_fast = request.security(syminfo.tickerid, htf_period, ta.ema(close, i_emaFast))
htf_ema_slow = request.security(syminfo.tickerid, htf_period, ta.ema(close, i_emaSlow))
htf_bullish = htf_close > htf_ema_fast and htf_ema_fast > htf_ema_slow
htf_bearish = htf_close < htf_ema_fast and htf_ema_fast < htf_ema_slow
htf_aligned_bullish = not require_multi_timeframe or htf_bullish
htf_aligned_bearish = not require_multi_timeframe or htf_bearish

//====================================================================================
// 📋 STATISTICAL SUCCESS MODEL
//====================================================================================

// Historical Pattern Storage
type SignalPattern
    int bar_index
    float entry_price
    float rsi_value
    float volume_ratio
    float atr_value
    bool is_bullish
    bool trend_aligned
    bool volume_confirmed
    float momentum_value
    bool success_tp1
    bool success_tp2
    bool success_tp3
    bool hit_sl
    float success_score

var array<SignalPattern> signal_history = array.new<SignalPattern>()

// Calculate pattern similarity
pattern_similarity(current_rsi, current_vol, current_atr, current_momentum, historical_pattern) =>
    if na(historical_pattern)
        0.0
    else
        rsi_diff = math.abs(current_rsi - historical_pattern.rsi_value) / 100
        vol_diff = math.abs(current_vol - historical_pattern.volume_ratio) / current_vol
        atr_diff = math.abs(current_atr - historical_pattern.atr_value) / current_atr
        momentum_diff = math.abs(current_momentum - historical_pattern.momentum_value) / 100
        
        similarity = 1.0 - ((rsi_diff + vol_diff + atr_diff + momentum_diff) / 4)
        math.max(0.0, similarity)

// Find similar historical patterns and calculate success rate
calculate_success_rate(is_bullish_signal, current_rsi, current_vol, current_atr, current_momentum) =>
    var float total_success = 0.0
    var int pattern_count = 0
    
    if array.size(signal_history) > 0
        for i = 0 to math.min(lookback_history, array.size(signal_history) - 1)
            if i < array.size(signal_history)
                pattern = array.get(signal_history, i)
                
                // Only compare with same direction signals
                if pattern.is_bullish == is_bullish_signal
                    similarity = pattern_similarity(current_rsi, current_vol, current_atr, current_momentum, pattern)
                    
                    if similarity >= (1.0 - pattern_similarity_tolerance)
                        pattern_count += 1
                        if pattern.success_tp1 or pattern.success_tp2 or pattern.success_tp3
                            total_success += pattern.success_score
    
    success_rate = pattern_count >= min_similar_patterns ? (total_success / pattern_count) * 100 : 0.0
    [success_rate, pattern_count]

// Track historical signal outcomes (simplified for demonstration)
if barstate.isconfirmed and bar_index > 100
    // Check previous signals for TP/SL hits
    if array.size(signal_history) > 0
        for i = array.size(signal_history) - 1 to math.max(0, array.size(signal_history) - 50)
            if i < array.size(signal_history)
                pattern = array.get(signal_history, i)
                bars_since = bar_index - pattern.bar_index
                
                if bars_since > 0 and bars_since <= 30 and not pattern.success_tp1
                    tp1_distance = pattern.is_bullish ? 0.01 : -0.01
                    tp2_distance = pattern.is_bullish ? 0.02 : -0.02
                    tp3_distance = pattern.is_bullish ? 0.035 : -0.035
                    sl_distance = pattern.is_bullish ? -0.015 : 0.015
                    
                    tp1_price = pattern.entry_price * (1 + tp1_distance)
                    tp2_price = pattern.entry_price * (1 + tp2_distance)
                    tp3_price = pattern.entry_price * (1 + tp3_distance)
                    sl_price = pattern.entry_price * (1 + sl_distance)
                    
                    if pattern.is_bullish
                        if high >= tp1_price
                            array.set(signal_history, i, SignalPattern.new(pattern.bar_index, pattern.entry_price, pattern.rsi_value, pattern.volume_ratio, pattern.atr_value, pattern.is_bullish, pattern.trend_aligned, pattern.volume_confirmed, pattern.momentum_value, true, high >= tp2_price, high >= tp3_price, false, 0.7))
                        else if low <= sl_price
                            array.set(signal_history, i, SignalPattern.new(pattern.bar_index, pattern.entry_price, pattern.rsi_value, pattern.volume_ratio, pattern.atr_value, pattern.is_bullish, pattern.trend_aligned, pattern.volume_confirmed, pattern.momentum_value, false, false, false, true, 0.0))
                    else
                        if low <= tp1_price
                            array.set(signal_history, i, SignalPattern.new(pattern.bar_index, pattern.entry_price, pattern.rsi_value, pattern.volume_ratio, pattern.atr_value, pattern.is_bullish, pattern.trend_aligned, pattern.volume_confirmed, pattern.momentum_value, true, low <= tp2_price, low <= tp3_price, false, 0.7))
                        else if high >= sl_price
                            array.set(signal_history, i, SignalPattern.new(pattern.bar_index, pattern.entry_price, pattern.rsi_value, pattern.volume_ratio, pattern.atr_value, pattern.is_bullish, pattern.trend_aligned, pattern.volume_confirmed, pattern.momentum_value, false, false, false, true, 0.0))

//====================================================================================
// 📋 ENHANCED SIGNAL VALIDATION (ORIGINAL CODE CONTINUED)
//====================================================================================

// Continue with original indicator code but add trap filtering...
// [Original displacement, swing, BOS, FVG detection code here - keeping it as is]

isDisp(ofs, wantBull) =>
    bodyAbs = math.abs(close[ofs] - open[ofs])
    rng     = math.max(high[ofs] - low[ofs], syminfo.mintick)
    atrRef  = math.max(atr, syminfo.mintick)
    big     = bodyAbs / atrRef >= i_dispBodyAtr
    solid   = bodyAbs / rng    >= i_dispBodyRat
    dir     = wantBull ? close[ofs] > open[ofs] : close[ofs] < open[ofs]
    big and solid and dir

c2_bullDisp = isDisp(1, true)
c2_bearDisp = isDisp(1, false)
curBullDisp = isDisp(0, true)
curBearDisp = isDisp(0, false)

bullVelocity = (isDisp(0, true)  ? 1 : 0) + (isDisp(1, true)  ? 1 : 0) + (isDisp(2, true)  ? 1 : 0)
bearVelocity = (isDisp(0, false) ? 1 : 0) + (isDisp(1, false) ? 1 : 0) + (isDisp(2, false) ? 1 : 0)

volRelDisp = volume[1] / math.max(volMA[1], 1)

swingH = ta.pivothigh(high, i_swingLen, i_swingLen)
swingL = ta.pivotlow(low,   i_swingLen, i_swingLen)

var float lastSH = na
var float lastSL = na
var float prevSH = na
var float prevSL = na
var int   lastSHBar = na
var int   lastSLBar = na

if not na(swingH)
    prevSH := lastSH
    lastSH := swingH
    lastSHBar := bar_index - i_swingLen
    if i_showStructure
        label.new(bar_index - i_swingLen, swingH, "H", style=label.style_none, textcolor=color.new(#ff1744, 30), size=size.tiny, yloc=yloc.abovebar)
if not na(swingL)
    prevSL := lastSL
    lastSL := swingL
    lastSLBar := bar_index - i_swingLen
    if i_showStructure
        label.new(bar_index - i_swingLen, swingL, "L", style=label.style_none, textcolor=color.new(#00e676, 30), size=size.tiny, yloc=yloc.belowbar)

bosBull = not na(lastSH) and not na(prevSH) and lastSH > prevSH
bosBear = not na(lastSL) and not na(prevSL) and lastSL < prevSL

haveRange = not na(lastSH) and not na(lastSL)
rangeHi   = haveRange ? math.max(lastSH, lastSL) : na
rangeLo   = haveRange ? math.min(lastSH, lastSL) : na
rangeMid  = haveRange ? (rangeHi + rangeLo) / 2 : na

inDiscount = haveRange and close < rangeMid
inPremium  = haveRange and close > rangeMid

var line pdLine  = na
var box  premBox = na
var box  discBox = na
if i_showPDZones and haveRange and barstate.islast
    line.delete(pdLine)
    box.delete(premBox)
    box.delete(discBox)
    pdLine  := line.new(bar_index - 50, rangeMid, bar_index + 20, rangeMid, color=color.new(#ffd700, 40), style=line.style_dashed)
    premBox := box.new(bar_index - 50, rangeHi, bar_index + 20, rangeMid, bgcolor=color.new(#ff1744, 96), border_color=color.new(#ff1744, 85))
    discBox := box.new(bar_index - 50, rangeMid, bar_index + 20, rangeLo, bgcolor=color.new(#00e676, 96), border_color=color.new(#00e676, 85))

sweepBull = false
sweepBear = false
if i_useSweeps and not na(lastSL) and not na(lastSH)
    wickDown = low < lastSL and (lastSL - low) >= i_sweepMinWick * atr
    wickUp   = high > lastSH and (high - lastSH) >= i_sweepMinWick * atr
    reclaimUp   = not i_sweepReclaim or close > lastSL
    reclaimDown = not i_sweepReclaim or close < lastSH
    sweepBull := wickDown and reclaimUp
    sweepBear := wickUp   and reclaimDown

var array<float> ob_tops   = array.new<float>()
var array<float> ob_bots   = array.new<float>()
var array<bool>  ob_isBull = array.new<bool>()
var array<int>   ob_bar    = array.new<int>()

if i_useOB
    if curBullDisp
        for k = 1 to i_obLookback
            if close[k] < open[k]
                obTop = high[k]
                obBot = low[k]
                dup = false
                if array.size(ob_tops) > 0
                    for m = 0 to array.size(ob_tops) - 1
                        if math.abs(array.get(ob_tops, m) - obTop) < syminfo.mintick and math.abs(array.get(ob_bots, m) - obBot) < syminfo.mintick
                            dup := true
                            break
                if not dup
                    array.push(ob_tops, obTop)
                    array.push(ob_bots, obBot)
                    array.push(ob_isBull, true)
                    array.push(ob_bar, bar_index - k)
                break
    if curBearDisp
        for k = 1 to i_obLookback
            if close[k] > open[k]
                obTop = high[k]
                obBot = low[k]
                dup = false
                if array.size(ob_tops) > 0
                    for m = 0 to array.size(ob_tops) - 1
                        if math.abs(array.get(ob_tops, m) - obTop) < syminfo.mintick and math.abs(array.get(ob_bots, m) - obBot) < syminfo.mintick
                            dup := true
                            break
                if not dup
                    array.push(ob_tops, obTop)
                    array.push(ob_bots, obBot)
                    array.push(ob_isBull, false)
                    array.push(ob_bar, bar_index - k)
                break

if array.size(ob_tops) > 20
    array.shift(ob_tops)
    array.shift(ob_bots)
    array.shift(ob_isBull)
    array.shift(ob_bar)

obRetestBull = false
obRetestBear = false
if array.size(ob_tops) > 0
    for m = 0 to array.size(ob_tops) - 1
        t = array.get(ob_tops, m)
        b = array.get(ob_bots, m)
        isBullOB = array.get(ob_isBull, m)
        bornAt = array.get(ob_bar, m)
        if bar_index - bornAt < 100
            if isBullOB and low <= t and low >= b and close > b
                obRetestBull := true
            if not isBullOB and high >= b and high <= t and close < t
                obRetestBear := true

var array<line> liq_lines = array.new<line>()
var array<int>  liq_bars  = array.new<int>()

if i_showLiq and not na(swingH) and not na(prevSH)
    if math.abs(lastSH - prevSH) <= i_liqTolerance * atr
        ln = line.new(lastSHBar, lastSH, bar_index + 10, lastSH, color=color.new(i_liqColor, 40), style=line.style_dotted, width=3, extend=extend.right)
        array.push(liq_lines, ln)
        array.push(liq_bars, bar_index)

if i_showLiq and not na(swingL) and not na(prevSL)
    if math.abs(lastSL - prevSL) <= i_liqTolerance * atr
        ln = line.new(lastSLBar, lastSL, bar_index + 10, lastSL, color=color.new(i_liqColor, 40), style=line.style_dotted, width=3, extend=extend.right)
        array.push(liq_lines, ln)
        array.push(liq_bars, bar_index)

if array.size(liq_lines) > 0
    var array<int> liqToDel = array.new<int>()
    array.clear(liqToDel)
    for m = 0 to array.size(liq_lines) - 1
        if bar_index - array.get(liq_bars, m) > i_liqMaxAge
            array.push(liqToDel, m)
    if array.size(liqToDel) > 0
        for j = array.size(liqToDel) - 1 to 0
            idx = array.get(liqToDel, j)
            if idx < array.size(liq_lines)
                line.delete(array.get(liq_lines, idx))
                array.remove(liq_lines, idx)
                array.remove(liq_bars, idx)

var float orHigh = na
var float orLow  = na
var line  orHighLn = na
var line  orLowLn  = na

inORSession = not na(time(timeframe.period, i_orSession, i_tzOffset))
if inORSession and not inORSession[1]
    orHigh := high
    orLow  := low
if inORSession
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)

if i_showOR and not na(orHigh) and barstate.islast
    line.delete(orHighLn)
    line.delete(orLowLn)
    orHighLn := line.new(bar_index - 100, orHigh, bar_index + 20, orHigh, color=color.new(i_orColor, 30), style=line.style_solid, width=3, extend=extend.right)
    orLowLn  := line.new(bar_index - 100, orLow,  bar_index + 20, orLow,  color=color.new(i_orColor, 30), style=line.style_solid, width=3, extend=extend.right)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
pdo = request.security(syminfo.tickerid, "D", open[1], lookahead=barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1],lookahead=barmerge.lookahead_on)

var line pdhLn = na
var line pdlLn = na
var line pdoLn = na
var line pdcLn = na

if i_showPDHL and barstate.islast
    line.delete(pdhLn)
    line.delete(pdlLn)
    pdhLn := line.new(bar_index - 100, pdh, bar_index + 20, pdh, color=color.new(i_pdhColor, 30), style=line.style_dashed, width=3, extend=extend.right)
    pdlLn := line.new(bar_index - 100, pdl, bar_index + 20, pdl, color=color.new(i_pdlColor, 30), style=line.style_dashed, width=3, extend=extend.right)

if i_showPDOC and barstate.islast
    line.delete(pdoLn)
    line.delete(pdcLn)
    pdoLn := line.new(bar_index - 100, pdo, bar_index + 20, pdo, color=color.new(color.gray, 50), style=line.style_dotted, width=3, extend=extend.right)
    pdcLn := line.new(bar_index - 100, pdc, bar_index + 20, pdc, color=color.new(color.white, 50), style=line.style_dotted, width=3, extend=extend.right)

clamp(v, lo, hi) => math.max(lo, math.min(hi, v))
logit(p) => math.log(p / (1.0 - p))

calcScore(fvgSize, fvgMid, isBull) =>
    sizeRatio = fvgSize / math.max(atr, syminfo.mintick)
    f1 = sizeRatio > 1.5 ? 0.82 : sizeRatio > 0.9 ? 0.65 : sizeRatio > 0.4 ? 0.50 : 0.35
    f2 = isBull ? (bullTrend ? 0.78 : 0.30) : (bearTrend ? 0.78 : 0.30)
    f3 = isBull ? (aboveHTF ? 0.76 : 0.34) : (belowHTF ? 0.76 : 0.34)
    f4 = volRelDisp > 1.5 ? 0.72 : volRelDisp > 0.8 ? 0.55 : 0.38
    f5 = not haveRange ? 0.50 : (isBull ? (fvgMid < rangeMid ? 0.80 : 0.30) : (fvgMid > rangeMid ? 0.80 : 0.30))
    f6 = isBull ? (bosBull ? 0.75 : 0.40) : (bosBear ? 0.75 : 0.40)
    f7 = inKZ ? 0.68 : 0.45
    f8 = volNormal ? 0.60 : volExpanded ? 0.75 : 0.35
    ll = 1.2*logit(clamp(f1,0.1,0.9)) + 1.0*logit(clamp(f2,0.1,0.9)) + 1.0*logit(clamp(f3,0.1,0.9)) + 0.8*logit(clamp(f4,0.1,0.9)) + 1.5*logit(clamp(f5,0.1,0.9)) + 1.3*logit(clamp(f6,0.1,0.9)) + 0.7*logit(clamp(f7,0.1,0.9)) + 0.9*logit(clamp(f8,0.1,0.9))
    clamp(1.0 / (1.0 + math.exp(-(-0.60 + ll))), 0.04, i_maxScore)

probColor(p, isBull) =>
    tier = p >= i_highProb ? 2 : p >= i_medProb ? 1 : 0
    isBull ? (tier == 2 ? i_bullHigh : tier == 1 ? i_bullMed : i_bullLow) : (tier == 2 ? i_bearHigh : tier == 1 ? i_bearMed : i_bearLow)

tierLabel(p) => p >= i_highProb ? "H" : p >= i_medProb ? "M" : "L"

var array<box>   fvg_boxes    = array.new<box>()
var array<line>  fvg_ceLns    = array.new<line>()
var array<float> fvg_tops     = array.new<float>()
var array<float> fvg_bots     = array.new<float>()
var array<bool>  fvg_isBull   = array.new<bool>()
var array<float> fvg_probs    = array.new<float>()
var array<int>   fvg_state    = array.new<int>()
var array<int>   fvg_birthBar = array.new<int>()

overlaps(newTop, newBot) =>
    bool hit = false
    sz = array.size(fvg_boxes)
    if sz > 0
        for i = 0 to sz - 1
            exTop = array.get(fvg_tops, i)
            exBot = array.get(fvg_bots, i)
            if (newTop <= exTop and newTop >= exBot) or (newBot <= exTop and newBot >= exBot) or (newBot <= exBot and newTop >= exTop) or (exBot <= newBot and exTop >= newTop)
                hit := true
                break
    hit

bullGap = low - high[2]
bearGap = low[2] - high
bullFVG = low > high[2] and bullGap >= i_minAtrMult * atr and (not i_useDisp or c2_bullDisp)
bearFVG = high < low[2] and bearGap >= i_minAtrMult * atr and (not i_useDisp or c2_bearDisp)

if bullFVG and not overlaps(low, high[2])
    mid = (low + high[2]) / 2
    p   = calcScore(bullGap, mid, true)
    c   = probColor(p, true)
    lbl = tierLabel(p) + " " + str.format("{0,number,#}%", p * 100)
    bx  = box.new(bar_index[2], low, bar_index + i_extendBars, high[2], bgcolor=color.new(c, i_fillAlpha), border_color=color.new(c, i_borderAlpha), border_width=3, extend=extend.right, text=lbl, text_color=color.new(c, 10), text_size=size.normal, text_halign=text.align_right, text_valign=text.align_top)
    ceLn = i_showCE ? line.new(bar_index[2], mid, bar_index + i_extendBars, mid, color=color.new(c, 30), style=line.style_dotted, extend=extend.right) : na
    array.push(fvg_boxes, bx)
    array.push(fvg_ceLns, ceLn)
    array.push(fvg_tops, low)
    array.push(fvg_bots, high[2])
    array.push(fvg_isBull, true)
    array.push(fvg_probs, p)
    array.push(fvg_state, 0)
    array.push(fvg_birthBar, bar_index)

if bearFVG and not overlaps(low[2], high)
    mid = (low[2] + high) / 2
    p   = calcScore(bearGap, mid, false)
    c   = probColor(p, false)
    lbl = tierLabel(p) + " " + str.format("{0,number,#}%", p * 100)
    bx  = box.new(bar_index[2], low[2], bar_index + i_extendBars, high, bgcolor=color.new(c, i_fillAlpha), border_color=color.new(c, i_borderAlpha), border_width=3, extend=extend.right, text=lbl, text_color=color.new(c, 10), text_size=size.normal, text_halign=text.align_right, text_valign=text.align_top)
    ceLn = i_showCE ? line.new(bar_index[2], mid, bar_index + i_extendBars, mid, color=color.new(c, 30), style=line.style_dotted, extend=extend.right) : na
    array.push(fvg_boxes, bx)
    array.push(fvg_ceLns, ceLn)
    array.push(fvg_tops, low[2])
    array.push(fvg_bots, high)
    array.push(fvg_isBull, false)
    array.push(fvg_probs, p)
    array.push(fvg_state, 0)
    array.push(fvg_birthBar, bar_index)

atrDist = i_ifvgCloseDist * atr
var array<int> toDelete = array.new<int>()
array.clear(toDelete)

bool ceTapBullFVG = false
bool ceTapBearFVG = false
float ceTapBullScore = 0.0
float ceTapBearScore = 0.0

sz = array.size(fvg_boxes)
if sz > 0
    for i = 0 to sz - 1
        t     = array.get(fvg_tops,     i)
        b     = array.get(fvg_bots,     i)
        bull  = array.get(fvg_isBull,   i)
        st    = array.get(fvg_state,    i)
        pSc   = array.get(fvg_probs,    i)
        birth = array.get(fvg_birthBar, i)
        mid   = (t + b) / 2
        bx    = array.get(fvg_boxes,    i)
        age   = bar_index - birth

        if st == 0
            ceTap = bull ? low <= mid : high >= mid
            if ceTap
                array.set(fvg_state, i, 1)
                box.set_border_width(bx, 3)
                if bull and pSc > ceTapBullScore
                    ceTapBullFVG := true
                    ceTapBullScore := pSc
                if not bull and pSc > ceTapBearScore
                    ceTapBearFVG := true
                    ceTapBearScore := pSc

        if age > i_ageHard
            array.push(toDelete, i)
        else if age > i_ageSoft
            curBull = array.get(fvg_isBull, i)
            newC = st == 3 ? (curBull ? i_ifvgBull : i_ifvgBear) : probColor(pSc, curBull)
            box.set_bgcolor(bx, color.new(newC, math.min(95, i_fillAlpha + i_dimExtra)))
            box.set_border_color(bx, color.new(newC, math.min(95, i_borderAlpha + i_dimExtra + 10)))

        if st != 3
            fullFill = bull ? low <= b : high >= t
            if fullFill
                closeBeyond = bull ? close < b : close > t
                closeDistOk = bull ? (b - close) >= atrDist : (close - t) >= atrDist
                dispOk      = not i_ifvgReqDisp or (bull ? curBearDisp : curBullDisp)
                bosOk       = not i_ifvgReqBOS  or (bull ? bosBear     : bosBull)
                kzOk        = not i_ifvgKzOnly  or inKZ
                validInv    = i_trackIFVG and closeBeyond and closeDistOk and dispOk and bosOk and kzOk

                if validInv
                    newC = bull ? i_ifvgBull : i_ifvgBear
                    newTop = t
                    newBot = b
                    if i_ifvgRedraw
                        newTop := math.max(open, close)
                        newBot := math.min(open, close)
                        array.set(fvg_tops, i, newTop)
                        array.set(fvg_bots, i, newBot)
                        box.set_top(bx, newTop)
                        box.set_bottom(bx, newBot)
                        newMid = (newTop + newBot) / 2
                        ceLn = array.get(fvg_ceLns, i)
                        if not na(ceLn)
                            line.set_y1(ceLn, newMid)
                            line.set_y2(ceLn, newMid)
                            line.set_color(ceLn, color.new(newC, 30))
                    box.set_bgcolor(bx, color.new(newC, i_fillAlpha - 5))
                    box.set_border_color(bx, color.new(newC, i_borderAlpha))
                    box.set_text(bx, "IFVG " + str.format("{0,number,#}%", pSc * 100))
                    array.set(fvg_isBull, i, not bull)
                    array.set(fvg_state,  i, 3)
                else
                    shouldDel = i_fullMitigate ? fullFill : (bull ? low <= t : high >= b)
                    if shouldDel
                        array.push(toDelete, i)

        if st == 3
            tNow    = array.get(fvg_tops,   i)
            bNow    = array.get(fvg_bots,   i)
            nowBull = array.get(fvg_isBull, i)
            broken  = nowBull ? close < bNow : close > tNow
            if broken
                array.push(toDelete, i)

sz_vis = array.size(fvg_boxes)
if sz_vis > 0
    for i = 0 to sz_vis - 1
        bx = array.get(fvg_boxes, i)
        ce = array.get(fvg_ceLns, i)
        if not show_fvg_boxes
            box.set_bgcolor(bx, color.new(color.gray, 100))
            box.set_border_color(bx, color.new(color.gray, 100))
            box.set_text(bx, "")
        if not show_fvg_ce_lines and not na(ce)
            line.set_color(ce, color.new(color.gray, 100))

if i_enableDist and barstate.islast
    sz3 = array.size(fvg_boxes)
    if sz3 > 0
        for i = 0 to sz3 - 1
            t2 = array.get(fvg_tops, i)
            b2 = array.get(fvg_bots, i)
            m2 = (t2 + b2) / 2
            dist = math.abs(close - m2) / math.max(atr, syminfo.mintick)
            bx2 = array.get(fvg_boxes, i)
            if dist > i_distMax
                box.set_bgcolor(bx2, color.new(color.gray, 99))
                box.set_border_color(bx2, color.new(color.gray, 99))
                box.set_text(bx2, "")
                ceLn2 = array.get(fvg_ceLns, i)
                if not na(ceLn2)
                    line.set_color(ceLn2, color.new(color.gray, 99))

delSz = array.size(toDelete)
if delSz > 0
    var array<int> seen = array.new<int>()
    array.clear(seen)
    for j = delSz - 1 to 0
        idx = array.get(toDelete, j)
        if not array.includes(seen, idx) and idx < array.size(fvg_boxes)
            array.push(seen, idx)
            box.delete(array.get(fvg_boxes, idx))
            ceLn3 = array.get(fvg_ceLns, idx)
            if not na(ceLn3)
                line.delete(ceLn3)
            array.remove(fvg_boxes,    idx)
            array.remove(fvg_ceLns,    idx)
            array.remove(fvg_tops,     idx)
            array.remove(fvg_bots,     idx)
            array.remove(fvg_isBull,   idx)
            array.remove(fvg_probs,    idx)
            array.remove(fvg_state,    idx)
            array.remove(fvg_birthBar, idx)

//====================================================================================
// 📋 OBV + CVD (keeping original code structure)
//====================================================================================
var float cumVolOBV = 0.0
cumVolOBV += nz(volume)
obv_raw = ta.cum(math.sign(ta.change(close)) * volume)
obv_smooth = ta.ema(obv_raw, i_obvSmoothLen)

obv_pivot_low = ta.pivotlow(obv_smooth, i_obvPivotLen, i_obvPivotLen)
obv_pivot_high = ta.pivothigh(obv_smooth, i_obvPivotLen, i_obvPivotLen)

var float obv_low1 = na
var float obv_low2 = na
var float obv_high1 = na
var float obv_high2 = na
var int obv_low1_bar = na
var int obv_low2_bar = na
var int obv_high1_bar = na
var int obv_high2_bar = na
var bool forming_bullish_pattern = false
var bool forming_bearish_pattern = false
var bool obv_bullish_reversal = false
var bool obv_bearish_reversal = false
var float obv_mid_high = na
var float obv_mid_low = na
var int obv_pattern_bar = na

if not na(obv_pivot_low) and na(obv_low1)
    obv_low1 := obv_pivot_low
    obv_low1_bar := bar_index - i_obvPivotLen
    forming_bullish_pattern := true

if not na(obv_pivot_low) and forming_bullish_pattern and not na(obv_low1) and na(obv_low2)
    if obv_pivot_low > obv_low1
        obv_low2 := obv_pivot_low
        obv_low2_bar := bar_index - i_obvPivotLen

if not na(obv_low1) and not na(obv_low2)
    start_bar = math.min(obv_low1_bar, obv_low2_bar)
    end_bar = math.max(obv_low1_bar, obv_low2_bar)
    highest_obv = obv_smooth
    for i = 0 to (end_bar - start_bar)
        highest_obv := math.max(highest_obv, obv_smooth[i])
    obv_mid_high := highest_obv

if not na(obv_mid_high) and not na(obv_low2)
    if obv_smooth > obv_mid_high and obv_smooth > obv_smooth[1]
        obv_bullish_reversal := true
        obv_pattern_bar := bar_index
        obv_low1 := na
        obv_low2 := na
        obv_mid_high := na
        forming_bullish_pattern := false
    else
        obv_bullish_reversal := false

if forming_bullish_pattern and bar_index - obv_low1_bar > i_obvLookback
    obv_low1 := na
    obv_low2 := na
    obv_mid_high := na
    forming_bullish_pattern := false

if not na(obv_pivot_high) and na(obv_high1)
    obv_high1 := obv_pivot_high
    obv_high1_bar := bar_index - i_obvPivotLen
    forming_bearish_pattern := true

if not na(obv_pivot_high) and forming_bearish_pattern and not na(obv_high1) and na(obv_high2)
    if obv_pivot_high < obv_high1
        obv_high2 := obv_pivot_high
        obv_high2_bar := bar_index - i_obvPivotLen

if not na(obv_high1) and not na(obv_high2)
    start_bar = math.min(obv_high1_bar, obv_high2_bar)
    end_bar = math.max(obv_high1_bar, obv_high2_bar)
    lowest_obv = obv_smooth
    for i = 0 to (end_bar - start_bar)
        lowest_obv := math.min(lowest_obv, obv_smooth[i])
    obv_mid_low := lowest_obv

if not na(obv_mid_low) and not na(obv_high2)
    if obv_smooth < obv_mid_low and obv_smooth < obv_smooth[1]
        obv_bearish_reversal := true
        obv_pattern_bar := bar_index
        obv_high1 := na
        obv_high2 := na
        obv_mid_low := na
        forming_bearish_pattern := false
    else
        obv_bearish_reversal := false

if forming_bearish_pattern and bar_index - obv_high1_bar > i_obvLookback
    obv_high1 := na
    obv_high2 := na
    obv_mid_low := na
    forming_bearish_pattern := false

var bool last_obv_bullish = false
var bool last_obv_bearish = false
if obv_bullish_reversal
    last_obv_bullish := true
if obv_bearish_reversal
    last_obv_bearish := true
if bar_index - obv_pattern_bar > 10
    last_obv_bullish := false
    last_obv_bearish := false

plot(i_showOBV ? obv_smooth : na, "OBV Smoothed", color=color.new(#2962FF, 0), linewidth=3)
plotshape(i_showOBVPattern and obv_bullish_reversal, "🟢 OBV Bullish Reversal", location=location.bottom, style=shape.labelup, color=color.new(#00ff88, 0), size=size.small, text="OBV↑", textcolor=color.white)
plotshape(i_showOBVPattern and obv_bearish_reversal, "🔴 OBV Bearish Reversal", location=location.top, style=shape.labeldown, color=color.new(#ff4444, 0), size=size.small, text="OBV↓", textcolor=color.white)

buyVol  = volume * (close - low) / (high - low + 0.0001)
sellVol = volume * (high - close) / (high - low + 0.0001)
delta   = buyVol - sellVol

totalVol = buyVol + sellVol
buyPct   = totalVol > 0 ? buyVol / totalVol * 100 : 50.0
sellPct  = totalVol > 0 ? sellVol / totalVol * 100 : 50.0

sessionChange = ta.change(time('D'))
newSession = i_resetDaily and sessionChange != 0

var float cvd = na
alphaAvg = 2.0 / (i_cvdAvgLen + 1)
if newSession or na(cvd[1])
    cvd := delta
else
    cvd := alphaAvg * delta + (1 - alphaAvg) * cvd[1]

var float cvdSmoothed = na
alphaSmooth = 2.0 / (i_cvdSmoothLen + 1)
if newSession or na(cvdSmoothed[1])
    cvdSmoothed := cvd
else
    cvdSmoothed := alphaSmooth * cvd + (1 - alphaSmooth) * cvdSmoothed[1]

var float cvdROC = na
if newSession
    cvdROC := 0.0
else
    cvdROC := cvdSmoothed - cvdSmoothed[1]

cvdLeader = ta.ema(cvdROC, i_leadLen) * i_leadMult

leaderRising    = cvdLeader > cvdLeader[1]
leaderFalling   = cvdLeader < cvdLeader[1]
leaderAboveZero = cvdLeader > 0
leaderBelowZero = cvdLeader < 0
cvdSmoothedRising  = cvdSmoothed > cvdSmoothed[1]
cvdSmoothedFalling = cvdSmoothed < cvdSmoothed[1]
cvdPositive     = cvdSmoothed > 0
cvdNegative     = cvdSmoothed < 0

leaderCrossUp   = ta.crossover(cvdLeader, 0)
leaderCrossDown = ta.crossunder(cvdLeader, 0)
leaderInflectUp   = cvdLeader > cvdLeader[1] and cvdLeader[1] > cvdLeader[2]
leaderInflectDown = cvdLeader < cvdLeader[1] and cvdLeader[1] < cvdLeader[2]

leaderRange   = ta.highest(math.abs(cvdLeader), 50)
leaderSlope   = math.abs(cvdLeader - cvdLeader[2])
leaderNearZero = math.abs(cvdLeader) < leaderRange * i_chopZonePct
leaderShallowSlope = leaderSlope < leaderRange * i_chopSlopePct
recentCross = leaderCrossUp or leaderCrossDown or leaderCrossUp[1] or leaderCrossDown[1] or leaderCrossUp[2] or leaderCrossDown[2]
strongCross = (leaderCrossUp or leaderCrossDown) and not leaderShallowSlope
isChop = leaderNearZero and leaderShallowSlope and recentCross and not strongCross

cvdStrongBuy  = not isChop and leaderAboveZero and leaderRising and cvdPositive and cvdSmoothedRising
cvdBuy        = not isChop and leaderAboveZero and leaderRising and (not cvdPositive or not cvdSmoothedRising)
cvdStrongSell = not isChop and leaderBelowZero and leaderFalling and cvdNegative and cvdSmoothedFalling
cvdSell       = not isChop and leaderBelowZero and leaderFalling and (not cvdNegative or not cvdSmoothedFalling)

cvdConfirmLong  = true
cvdConfirmShort = true
if i_enableCVD
    if i_cvdMode == "Confirm Buy Signals"
        cvdConfirmLong  := cvdBuy or cvdStrongBuy
        cvdConfirmShort := true
    else if i_cvdMode == "Confirm Sell Signals"
        cvdConfirmLong  := true
        cvdConfirmShort := cvdSell or cvdStrongSell
    else if i_cvdMode == "Confirm Both"
        cvdConfirmLong  := cvdBuy or cvdStrongBuy
        cvdConfirmShort := cvdSell or cvdStrongSell
    else if i_cvdMode == "None"
        cvdConfirmLong  := true
        cvdConfirmShort := true

//====================================================================================
// 📋 ENHANCED SIGNAL ENGINE WITH TRAP FILTERING
//====================================================================================
var int lastLongSigBar  = -9999
var int lastShortSigBar = -9999

barsSinceLong  = bar_index - lastLongSigBar
barsSinceShort = bar_index - lastShortSigBar
cooldownLong   = barsSinceLong  >= i_sigCooldown
cooldownShort  = barsSinceShort >= i_sigCooldown

trig_longCE     = ceTapBullFVG[1]
trig_shortCE    = ceTapBearFVG[1]
trig_longOB     = obRetestBull[1]
trig_shortOB    = obRetestBear[1]
trig_longSweep  = sweepBull[1]
trig_shortSweep = sweepBear[1]

trigScoreLong  = ceTapBullScore[1]
trigScoreShort = ceTapBearScore[1]

anyLongTrig  = (i_sigOnCETap and trig_longCE)     or (i_sigOnOBRetest and trig_longOB)   or (i_sigOnSweep and trig_longSweep)
anyShortTrig = (i_sigOnCETap and trig_shortCE)    or (i_sigOnOBRetest and trig_shortOB)  or (i_sigOnSweep and trig_shortSweep)

obv_confirm_long = true
obv_confirm_short = true
if i_enableOBVConfirm
    if i_obvConfirmMode == "Confirm Sell Signals"
        obv_confirm_short := last_obv_bearish
    else if i_obvConfirmMode == "Confirm Buy Signals"
        obv_confirm_long := last_obv_bullish
    else if i_obvConfirmMode == "Confirm Both"
        obv_confirm_long := last_obv_bullish
        obv_confirm_short := last_obv_bearish

rvolOk  = rvol >= i_rvolMin
scoreOkLong  = not i_sigOnCETap or (trig_longCE  ? trigScoreLong  >= i_sigMinScore : true)
scoreOkShort = not i_sigOnCETap or (trig_shortCE ? trigScoreShort >= i_sigMinScore : true)
kzOk    = not i_sigReqKZ or inKZ
confirmLong  = not i_sigReqConfirm or curBullDisp
confirmShort = not i_sigReqConfirm or curBearDisp
notBlackout  = not inBlackout
notCompressed = not volCompressed

trendOkLong  = bullTrend and bosBull and aboveHTF
trendOkShort = bearTrend and bosBear and belowHTF
pdOkLong  = not i_sigReqPD or inDiscount
pdOkShort = not i_sigReqPD or inPremium

// ============= TRAP FILTERS =============
// For BUY signals, check for bearish traps
isTrapBuy = enable_trap_filter and (
     (detect_divergence and bearish_divergence[1]) or
     (detect_volume_drop and volume_declining) or
     (detect_rejection_pattern and bullish_rejection) or
     (detect_exhaustion and momentum_weakening_bullish) or
     (require_volume_increase and not volume_increasing) or
     (require_momentum_confirm and hist < 0) or
     (not htf_aligned_bullish)
 )

// For SELL signals, check for bullish traps
isTrapSell = enable_trap_filter and (
     (detect_divergence and bullish_divergence[1]) or
     (detect_volume_drop and volume_declining) or
     (detect_rejection_pattern and bearish_rejection) or
     (detect_exhaustion and momentum_weakening_bearish) or
     (require_volume_increase and not volume_increasing) or
     (require_momentum_confirm and hist > 0) or
     (not htf_aligned_bearish)
 )

// Calculate statistical success rate for current conditions
[buy_success_rate, buy_pattern_count] = calculate_success_rate(true, rsi_for_divergence, rvol, atr, hist)
[sell_success_rate, sell_pattern_count] = calculate_success_rate(false, rsi_for_divergence, rvol, atr, hist)

statistical_buy_valid = not enable_statistical_model or (buy_success_rate >= min_success_rate and buy_pattern_count >= min_similar_patterns)
statistical_sell_valid = not enable_statistical_model or (sell_success_rate >= min_success_rate and sell_pattern_count >= min_similar_patterns)

baseCtx = rvolOk and kzOk and notBlackout and notCompressed

canFireTrendLong  = baseCtx and anyLongTrig  and confirmLong  and scoreOkLong  and trendOkLong  and pdOkLong  and cooldownLong  and obv_confirm_long and cvdConfirmLong and not isTrapBuy and statistical_buy_valid
canFireTrendShort = baseCtx and anyShortTrig and confirmShort and scoreOkShort and trendOkShort and pdOkShort and cooldownShort and obv_confirm_short and cvdConfirmShort and not isTrapSell and statistical_sell_valid

canFireRevLong  = baseCtx and trig_longSweep  and confirmLong  and bearTrend and cooldownLong  and obv_confirm_long and cvdConfirmLong and not isTrapBuy and statistical_buy_valid
canFireRevShort = baseCtx and trig_shortSweep and confirmShort and bullTrend and cooldownShort and obv_confirm_short and cvdConfirmShort and not isTrapSell and statistical_sell_valid

modeTrend = i_sigMode == "Trend Only" or i_sigMode == "Both"
modeRev   = i_sigMode == "Reversal Only" or i_sigMode == "Both"

fireTrendLong  = i_showSignals and modeTrend and canFireTrendLong
fireTrendShort = i_showSignals and modeTrend and canFireTrendShort
fireRevLong    = i_showSignals and modeRev   and canFireRevLong
fireRevShort   = i_showSignals and modeRev   and canFireRevShort

tierOf(isLong, isTrend) =>
    triggerCount = 0
    if isLong
        triggerCount += (trig_longCE     ? 1 : 0)
        triggerCount += (trig_longOB     ? 1 : 0)
        triggerCount += (trig_longSweep  ? 1 : 0)
    else
        triggerCount += (trig_shortCE    ? 1 : 0)
        triggerCount += (trig_shortOB    ? 1 : 0)
        triggerCount += (trig_shortSweep ? 1 : 0)
    velOk = isLong ? bullVelocity >= 2 : bearVelocity >= 2
    highScore = isLong ? trigScoreLong >= i_highProb : trigScoreShort >= i_highProb
    if isTrend and triggerCount >= 2 and volExpanded and velOk
        "A+"
    else if isTrend and (triggerCount >= 2 or (highScore and velOk))
        "A"
    else
        "B"

longTier  = fireTrendLong  ? tierOf(true,  true)  : fireRevLong  ? "REV-" + tierOf(true,  false) : ""
shortTier = fireTrendShort ? tierOf(false, true)  : fireRevShort ? "REV-" + tierOf(false, false) : ""

passAplusLong  = not i_sigAplusOnly or longTier  == "A+"
passAplusShort = not i_sigAplusOnly or shortTier == "A+"

obv_label_long = i_enableOBVConfirm and last_obv_bullish ? " [OBV✓]" : ""
obv_label_short = i_enableOBVConfirm and last_obv_bearish ? " [OBV✓]" : ""
cvd_label_long = i_enableCVD and cvdConfirmLong and (cvdBuy or cvdStrongBuy) ? " [CVD✓]" : ""
cvd_label_short = i_enableCVD and cvdConfirmShort and (cvdSell or cvdStrongSell) ? " [CVD✓]" : ""
success_label_long = show_success_rate and buy_success_rate > 0 ? "\n✅" + str.tostring(math.round(buy_success_rate)) + "% (" + str.tostring(buy_pattern_count) + ")" : ""
success_label_short = show_success_rate and sell_success_rate > 0 ? "\n✅" + str.tostring(math.round(sell_success_rate)) + "% (" + str.tostring(sell_pattern_count) + ")" : ""

if (fireTrendLong or fireRevLong) and passAplusLong and show_fvg_signals
    lblType = fireRevLong ? "REV LONG" : "LONG"
    sc      = trigScoreLong
    txt     = lblType + " " + longTier + obv_label_long + cvd_label_long + success_label_long + (sc > 0 ? " " + str.format("{0,number,#}%", sc * 100) : "")
    labelColor = fireRevLong ? color.new(#7e57c2, 10) : color.new(colorValidSignal, 20)
    label.new(bar_index, low, txt, style=label.style_label_up, color=labelColor, textcolor=color.white, size=size.normal, yloc=yloc.belowbar)
    lastLongSigBar := bar_index
    
    // Store signal in history
    if enable_statistical_model
        new_pattern = SignalPattern.new(bar_index, close, rsi_for_divergence, rvol, atr, true, trendOkLong, volume_increasing, hist, false, false, false, false, 0.0)
        array.push(signal_history, new_pattern)
        if array.size(signal_history) > lookback_history
            array.shift(signal_history)

if (fireTrendShort or fireRevShort) and passAplusShort and show_fvg_signals
    lblType = fireRevShort ? "REV SHORT" : "SHORT"
    sc      = trigScoreShort
    txt     = lblType + " " + shortTier + obv_label_short + cvd_label_short + success_label_short + (sc > 0 ? " " + str.format("{0,number,#}%", sc * 100) : "")
    labelColor = fireRevShort ? color.new(#f48fb1, 10) : color.new(colorValidSignal, 20)
    label.new(bar_index, high, txt, style=label.style_label_down, color=labelColor, textcolor=color.white, size=size.normal, yloc=yloc.abovebar)
    lastShortSigBar := bar_index
    
    // Store signal in history
    if enable_statistical_model
        new_pattern = SignalPattern.new(bar_index, close, rsi_for_divergence, rvol, atr, false, trendOkShort, volume_increasing, hist, false, false, false, false, 0.0)
        array.push(signal_history, new_pattern)
        if array.size(signal_history) > lookback_history
            array.shift(signal_history)

// Show trap warnings
if show_trap_warnings
    if isTrapBuy and anyLongTrig
        label.new(bar_index, high, "⚠️ TRAP\nFAKE BUY", style=label.style_label_down, color=color.new(colorTrapWarning, 0), textcolor=color.white, size=size.small, yloc=yloc.abovebar)
    
    if isTrapSell and anyShortTrig
        label.new(bar_index, low, "⚠️ TRAP\nFAKE SELL", style=label.style_label_up, color=color.new(colorTrapWarning, 0), textcolor=color.white, size=size.small, yloc=yloc.belowbar)

// Original dashboard continues with trap statistics added...
int openBull  = 0
int openBear  = 0
int openIFVG  = 0
int openCETap = 0
sz2 = array.size(fvg_boxes)
if sz2 > 0
    for i = 0 to sz2 - 1
        st = array.get(fvg_state, i)
        if st == 3
            openIFVG += 1
        else
            if array.get(fvg_isBull, i)
                openBull += 1
            else
                openBear += 1
            if st == 1
                openCETap += 1

avgProb(wantBull) =>
    float s = 0.0
    float w = 0.0
    n = array.size(fvg_probs)
    if n > 0
        for i = 0 to n - 1
            if array.get(fvg_isBull, i) == wantBull and array.get(fvg_state, i) != 3
                m    = (array.get(fvg_tops, i) + array.get(fvg_bots, i)) / 2
                dist = math.abs(close - m) / math.max(atr, syminfo.mintick)
                wt   = 1.0 / (1.0 + dist)
                s += array.get(fvg_probs, i) * wt
                w += wt
    w > 0 ? s / w : na

bool longTrendCtx  = baseCtx and trendOkLong  and pdOkLong
bool shortTrendCtx = baseCtx and trendOkShort and pdOkShort
bool longRevCtx    = baseCtx and bearTrend and (sweepBull  or array.size(ob_tops) > 0)
bool shortRevCtx   = baseCtx and bullTrend and (sweepBear  or array.size(ob_tops) > 0)

obv_status = last_obv_bullish ? "OBV🟢" : last_obv_bearish ? "OBV🔴" : "-"

ctxTxt = longTrendCtx ? "LONG-TREND" : shortTrendCtx ? "SHORT-TREND" : longRevCtx ? "LONG-REV?" : shortRevCtx ? "SHORT-REV?" : inBlackout ? "BLACKOUT" : volCompressed ? "COMPRESSED" : "WAIT"
ctxClr = longTrendCtx ? color.new(#00e676, 0) : shortTrendCtx ? color.new(#ff1744, 0) : longRevCtx ? color.new(#7e57c2, 0) : shortRevCtx ? color.new(#f48fb1, 0) : color.new(#8b949e, 0)

pdStatus  = not haveRange ? "-" : close > rangeMid ? "PREM" : "DISC"
bosStatus = bosBull ? "BOS+" : bosBear ? "BOS-" : "-"
kzStatus  = inLondon ? "LDN" : inNYAM ? "NY-AM" : inNYPM ? "NY-PM" : "-"
volRegTxt = volCompressed ? "COMP" : volExpanded ? "EXP" : "NORM"
volRegClr = volCompressed ? color.new(#ff6d00, 0) : volExpanded ? color.new(#00e676, 0) : color.new(#8b949e, 0)
rvolTxt   = rvol >= 1.5 ? "HIGH" : rvol >= 1.0 ? "OK" : rvol >= 0.7 ? "LOW" : "DEAD"
rvolClr   = rvol >= 1.5 ? color.new(#00e676, 0) : rvol >= 1.0 ? color.new(#8b949e, 0) : color.new(#ff6d00, 0)

var table dash = table.new(i_tblPos == "Top Right" ? position.top_right : i_tblPos == "Top Left" ? position.top_left : i_tblPos == "Bottom Right" ? position.bottom_right : position.bottom_left, 3, 22, bgcolor=color.new(#0d1117, 10), border_color=color.new(#30363d, 60), border_width=3, frame_color=color.new(#58a6ff, 40), frame_width=3)

hdrBg   = color.new(#161b22, 20)
hdrTxt  = color.new(#8b949e, 0)
bullClr = color.new(#00e676, 0)
bearClr = color.new(#ff1744, 0)
dimTxt  = color.new(#58a6ff, 0)
rowBg1  = color.new(#0d1117, 30)
rowBg2  = color.new(#161b22, 20)
ifvgClr = color.new(#bb86fc, 0)
kzClr   = color.new(#ffd700, 0)
obvClr  = color.new(#00ff88, 0)
cvdClr  = color.new(#ffaa00, 0)
trapClr = color.new(colorTrapWarning, 0)

if i_showTable and show_analysis_tables and barstate.islast
    table.cell(dash, 0, 0, "FVG v6.0 + TRAP FILTER", text_color=dimTxt,  bgcolor=hdrBg, text_size=size.tiny)
    table.cell(dash, 1, 0, "BULL",     text_color=bullClr, bgcolor=hdrBg, text_size=size.tiny)
    table.cell(dash, 2, 0, "BEAR",     text_color=bearClr, bgcolor=hdrBg, text_size=size.tiny)

    table.cell(dash, 0, 1, "SETUP",    text_color=hdrTxt,  bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 1, ctxTxt,     text_color=ctxClr,  bgcolor=rowBg1, text_size=size.small)
    table.cell(dash, 2, 1, obv_status, text_color=obvClr,  bgcolor=rowBg1, text_size=size.tiny)

    table.cell(dash, 0, 2, "Open",     text_color=hdrTxt,  bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(openBull), text_color=bullClr, bgcolor=rowBg2, text_size=size.small)
    table.cell(dash, 2, 2, str.tostring(openBear), text_color=bearClr, bgcolor=rowBg2, text_size=size.small)

    abp  = avgProb(true)
    abrp = avgProb(false)
    table.cell(dash, 0, 3, "Avg Q",   text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 3, na(abp)  ? "-" : str.format("{0}%", math.round(abp  * 100)), text_color=bullClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 3, na(abrp) ? "-" : str.format("{0}%", math.round(abrp * 100)), text_color=bearClr, bgcolor=rowBg1, text_size=size.tiny)

    trendTxt = bullTrend and aboveHTF ? "BULL" : bearTrend and belowHTF ? "BEAR" : "CHOP"
    trendClr = bullTrend and aboveHTF ? bullClr : bearTrend and belowHTF ? bearClr : color.new(#8b949e, 0)
    bosC     = bosBull ? bullClr : bosBear ? bearClr : hdrTxt
    table.cell(dash, 0, 4, "Bias",    text_color=hdrTxt,   bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 4, trendTxt,  text_color=trendClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 4, bosStatus, text_color=bosC,     bgcolor=rowBg2, text_size=size.tiny)

    zoneClr = not haveRange ? hdrTxt : close > rangeMid ? bearClr : bullClr
    table.cell(dash, 0, 5, "Zone",    text_color=hdrTxt,  bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 5, pdStatus,  text_color=zoneClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 5, "",        bgcolor=rowBg1)

    table.cell(dash, 0, 6, "Killzone", text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 6, kzStatus,   text_color=inKZ ? kzClr : hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 6, "",         bgcolor=rowBg2)

    table.cell(dash, 0, 7, "VolReg",   text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 7, volRegTxt,  text_color=volRegClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 7, "",         bgcolor=rowBg1)

    table.cell(dash, 0, 8, "RVOL",     text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 8, rvolTxt + " " + str.format("{0,number,#.#}", rvol), text_color=rvolClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 8, "",         bgcolor=rowBg2)

    sweepTxt = sweepBull ? "SWEEP+" : sweepBear ? "SWEEP-" : "-"
    sweepClr = sweepBull ? bullClr : sweepBear ? bearClr : hdrTxt
    table.cell(dash, 0, 9, "Sweep",    text_color=hdrTxt,  bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 9, sweepTxt,   text_color=sweepClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 9, str.tostring(array.size(ob_tops)) + " OBs", text_color=dimTxt, bgcolor=rowBg1, text_size=size.tiny)

    table.cell(dash, 0, 10, "IFVG/CE", text_color=hdrTxt,  bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 10, str.tostring(openIFVG),  text_color=ifvgClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 10, str.tostring(openCETap), text_color=dimTxt,  bgcolor=rowBg2, text_size=size.tiny)

    blackoutTxt = openBlackout ? "OPEN" : closeBlackout ? "CLOSE" : lunchBlackout ? "LUNCH" : "-"
    table.cell(dash, 0, 11, "Blackout", text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 11, blackoutTxt, text_color=inBlackout ? color.new(#ff6d00, 0) : hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 11, "",        bgcolor=rowBg1)

    table.cell(dash, 0, 12, "Mode",    text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 12, i_sigMode, text_color=dimTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 12, i_sigAplusOnly ? "A+ only" : "All tiers", text_color=dimTxt, bgcolor=rowBg2, text_size=size.tiny)

    table.cell(dash, 0, 13, "OBV Confirm", text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 13, i_obvConfirmMode, text_color=obvClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 13, i_enableOBVConfirm ? "ON" : "OFF", text_color=dimTxt, bgcolor=rowBg1, text_size=size.tiny)

    cvdStatusText = isChop ? "CHOP" : cvdLeader > 0 ? "🟢" : "🔴"
    cvdSignalText = cvdStrongBuy ? "SB" : cvdBuy ? "B" : cvdStrongSell ? "SS" : cvdSell ? "S" : "-"
    table.cell(dash, 0, 14, "CVD", text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 14, cvdStatusText + " " + cvdSignalText, text_color= cvdLeader>0 ? bullClr : bearClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 14, str.tostring(math.round(buyPct,1))+"%", text_color= cvdLeader>0 ? bullClr : bearClr, bgcolor=rowBg2, text_size=size.tiny)

    table.cell(dash, 0, 15, "CVD Mode", text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 15, i_cvdMode, text_color=cvdClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 15, i_enableCVD ? "ON" : "OFF", text_color=dimTxt, bgcolor=rowBg1, text_size=size.tiny)

    // NEW TRAP FILTER ROWS
    table.cell(dash, 0, 16, "───────────", bgcolor=rowBg2, text_color=color.gray)
    table.cell(dash, 1, 16, "TRAP FILTER", bgcolor=rowBg2, text_color=trapClr, text_size=size.small)
    table.cell(dash, 2, 16, "───────────", bgcolor=rowBg2, text_color=color.gray)
    
    table.cell(dash, 0, 17, "Success Rate", text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 17, buy_success_rate > 0 ? str.tostring(math.round(buy_success_rate)) + "%" : "-", text_color=buy_success_rate >= min_success_rate ? bullClr : trapClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 17, sell_success_rate > 0 ? str.tostring(math.round(sell_success_rate)) + "%" : "-", text_color=sell_success_rate >= min_success_rate ? bearClr : trapClr, bgcolor=rowBg1, text_size=size.tiny)
    
    table.cell(dash, 0, 18, "Pattern Count", text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 18, str.tostring(buy_pattern_count), text_color=dimTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 18, str.tostring(sell_pattern_count), text_color=dimTxt, bgcolor=rowBg2, text_size=size.tiny)
    
    trapStatusBuy = isTrapBuy ? "⚠️TRAP" : "✓ CLEAR"
    trapStatusSell = isTrapSell ? "⚠️TRAP" : "✓ CLEAR"
    table.cell(dash, 0, 19, "Trap Status", text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 19, trapStatusBuy, text_color=isTrapBuy ? trapClr : bullClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 19, trapStatusSell, text_color=isTrapSell ? trapClr : bearClr, bgcolor=rowBg1, text_size=size.tiny)
    
    htfStatusBuy = htf_aligned_bullish ? "✓" : "✗"
    htfStatusSell = htf_aligned_bearish ? "✓" : "✗"
    table.cell(dash, 0, 20, "HTF Aligned", text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 20, htfStatusBuy, text_color=htf_aligned_bullish ? bullClr : trapClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 20, htfStatusSell, text_color=htf_aligned_bearish ? bearClr : trapClr, bgcolor=rowBg2, text_size=size.tiny)

    table.cell(dash, 0, 21, "Not financial advice", text_color=color.new(#4a4a4a, 0), bgcolor=hdrBg, text_size=size.tiny)
    table.cell(dash, 1, 21, "", bgcolor=hdrBg)
    table.cell(dash, 2, 21, "", bgcolor=hdrBg)

plot(i_ShowEMA ? emaFast : na, color=color.new(#20f408, 0), linewidth=3, title="Fast EMA")
plot(i_ShowEMA ? emaSlow : na, color=color.new(#ed1405, 0), linewidth=3, title="Slow EMA")
plot(i_ShowEMA ? emaHTF  : na, color=color.new(#ffd900, 0), linewidth=3, title="HTF EMA")

alertcondition(fireTrendLong,  "LONG Trend Setup",  "LONG trend setup")
alertcondition(fireTrendShort, "SHORT Trend Setup", "SHORT trend setup")
alertcondition(fireRevLong,    "LONG Reversal",     "LONG reversal setup")
alertcondition(fireRevShort,   "SHORT Reversal",    "SHORT reversal setup")
alertcondition(sweepBull,      "Bullish Sweep",     "Liquidity sweep of lows")
alertcondition(sweepBear,      "Bearish Sweep",     "Liquidity sweep of highs")
alertcondition(isTrapBuy,      "⚠️ Trap Buy Warning", "Potential false buy signal detected")
alertcondition(isTrapSell,     "⚠️ Trap Sell Warning", "Potential false sell signal detected")

plot(final_confidence, "Confidence Score", display=display.none)

