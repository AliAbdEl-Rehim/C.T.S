//@version=6
// Pine v6 compile/runtime fixes: typed na colors, 1D timeframes, timeframe.change for CVD
// session reset, drawing-object reuse (no line/box/label leaks), overlay-safe OBV/Stoch
// plots, historical pattern matching wired to unused filters, Wolfe divide-by-zero guard,
// separate pivot bar arrays, CVD Leader + Strat bar coloring.
indicator("🔀 Ultimate FVG + Wyckoff + Advanced Trading + Pivot Predictor + Stochastic MTF + OBV Reversal Confirmation + CVD Leader", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500, max_bars_back=5000)

//====================================================================================
// 📋 BAR COLOR BASED ON PATTERNS (FROM STRAT ULTRA PRO v3.1)
//====================================================================================
bool insideNow  = bar_index > 0 and high <= high[1] and low >= low[1]
bool outsideNow = bar_index > 0 and high > high[1] and low < low[1]

// 0 = first bar, 1 = inside, 3 = outside, 2 = bullish, -2 = bearish
int clsNow = bar_index == 0 ? 0 : insideNow ? 1 : outsideNow ? 3 : high > high[1] ? 2 : -2

color BULL_COLOR    = #00E676
color BEAR_COLOR    = #FF5252
color INSIDE_COLOR  = #FFD54F
color OUTSIDE_COLOR = #E040FB

clsColor(int c) =>
    c == 1  ? INSIDE_COLOR  :
    c == 3  ? OUTSIDE_COLOR :
    c == 2  ? BULL_COLOR    :
    c == -2 ? BEAR_COLOR    :
    color(na)

barcolor(clsColor(clsNow))

//====================================================================================
// 📋 SECTION 0: VISIBILITY CONTROLS
//====================================================================================
grp_visibility = "🖥️ Visibility Controls"

// FVG Visibility
show_fvg_boxes      = input.bool(true, "📦 Show FVG Boxes", group=grp_visibility)
show_fvg_ce_lines   = input.bool(true, "📈 Show CE (50%) Lines", group=grp_visibility)
show_fvg_signals    = input.bool(true, "🔔 Show FVG Buy/Sell Signals", group=grp_visibility)

// Wyckoff Visibility
show_wyckoff_boxes  = input.bool(true, "📊 Show Wyckoff Accumulation/Distribution Boxes", group=grp_visibility)

// Advanced Patterns Visibility
show_c_signals      = input.bool(true, "🎯 Show C1-C4 Buy/Sell Signals", group=grp_visibility)
show_wolfe_signals  = input.bool(true, "🐺 Show Wolfe Buy/Sell Signals", group=grp_visibility)

// Zones Visibility
show_accumulation_zones = input.bool(true, "📦 Show Accumulation Zones (Blue Boxes)", group=grp_visibility)
show_rejection_zones    = input.bool(true, "📦 Show Rejection Zones (Red Boxes)", group=grp_visibility)

// Golden Wicks Visibility
show_golden_wicks_visibility = input.bool(true, "✨ Show Golden Wicks", group=grp_visibility)

// Predictor Lines Visibility
show_prediction_lines     = input.bool(true, "🎯 Show TP/SL Prediction Lines", group=grp_visibility)
show_pivot_lines_visibility = input.bool(true, "🔮 Show Pivot Predictor Lines & Signals", group=grp_visibility)

// Stochastic Visibility
show_stochastic_lines    = input.bool(false, "📊 Show Stochastic K/D Lines (data window on overlay)", group=grp_visibility, tooltip="K/D are 0-100 values. On an overlay chart they are sent to the data window so they do not crush the price scale. Use B/S markers and background highlights on the chart.")
show_stochastic_bg       = input.bool(true, "🟢 Show Stochastic Background Highlights", group=grp_visibility)
show_stochastic_crosses  = input.bool(true, "🔴 Show Stochastic Cross Signals (B/S)", group=grp_visibility)

// Tables Visibility - NEW
grp_tables = "📊 Table Visibility"
show_analysis_tables = input.bool(true, "📊 Show All Analysis Tables", group=grp_tables, tooltip="Show/Hide all tables (FVG Dashboard, Advanced Analysis, Pivot Predictor)")

//====================================================================================
// 📋 SECTION 1: FVG with Probabilities (GainzAlgo)
//====================================================================================

// ui 
grp_fvg    = "FVG Detection"
grp_disp   = "Displacement Filter"
grp_ifvg   = "IFVG Rules"
grp_ml     = "Quality Score"
grp_smc    = "Market Structure"
grp_ob     = "Order Blocks (Internal)"
grp_sweep  = "Liquidity Sweeps (Internal)"
grp_liq    = "Liquidity Pools (Equal H/L)"
grp_daily  = "Daily Levels"
grp_sess   = "Killzones"
grp_clean  = "Chart Cleanup"
grp_sig    = "Signal Engine"
grp_vol    = "Volume & Volatility"
grp_time   = "Time-of-Day Filter"
grp_style  = "Visual Style"
grp_tbl    = "Dashboard"
grp_obv    = "📊 OBV Reversal Pattern Confirmation"

// FVG
i_minAtrMult   = input.float(0.3, "Min FVG Size (ATR x)", minval=0.05, step=0.05, group=grp_fvg)
i_atrLen       = input.int(14, "ATR Length", group=grp_fvg)
i_extendBars   = input.int(50, "Box Extension", group=grp_fvg)
i_fullMitigate = input.bool(false, "Full Rebalance Mitigation", group=grp_fvg)
i_showCE       = input.bool(true, "Show CE (50%)", group=grp_fvg)

// Displacement
i_useDisp      = input.bool(true, "Require Displacement", group=grp_disp)
i_dispBodyAtr  = input.float(0.6, "Min Body (ATR x)", minval=0.1, step=0.05, group=grp_disp)
i_dispBodyRat  = input.float(0.6, "Min Body/Range", minval=0.3, maxval=0.95, step=0.05, group=grp_disp)

// IFVG
i_trackIFVG     = input.bool(true, "Track IFVGs", group=grp_ifvg)
i_ifvgReqDisp   = input.bool(true, "Req Displacement on Inversion", group=grp_ifvg)
i_ifvgCloseDist = input.float(0.3, "Min Close Dist Past Gap (ATR x)", minval=0.0, step=0.05, group=grp_ifvg)
i_ifvgReqBOS    = input.bool(true, "Req Aligned BOS", group=grp_ifvg)
i_ifvgRedraw    = input.bool(true, "Redraw Box to Inversion Body", group=grp_ifvg)
i_ifvgKzOnly    = input.bool(false, "Inversions Only in Killzones", group=grp_ifvg)

// Score
i_emaFast  = input.int(20, "Fast EMA", group=grp_ml)
i_emaSlow  = input.int(50, "Slow EMA", group=grp_ml)
i_emaHTF   = input.int(200, "HTF EMA", group=grp_ml)
i_ShowEMA  = input.bool(true, "Show EMAs", group=grp_ml)
i_highProb = input.float(0.65, "High Cutoff", group=grp_ml, minval=0.5, maxval=0.99, step=0.01)
i_medProb  = input.float(0.45, "Med Cutoff", group=grp_ml, minval=0.2, maxval=0.64, step=0.01)
i_maxScore = input.float(0.85, "Max Score Clamp", group=grp_ml, minval=0.70, maxval=0.98, step=0.01)

// Structure
i_swingLen      = input.int(5, "Fractal Lookback", minval=2, maxval=20, group=grp_smc)
i_showStructure = input.bool(false, "Show Swing Points", group=grp_smc)
i_showPDZones   = input.bool(true, "Show P/D Zones", group=grp_smc)

// Order Blocks (internal)
i_useOB        = input.bool(true, "Enable OB Detection", group=grp_ob)
i_obLookback   = input.int(10, "OB Lookback (bars)", minval=3, maxval=30, group=grp_ob)

// Liquidity Sweeps (internal)
i_useSweeps    = input.bool(true, "Enable Sweep Detection", group=grp_sweep)
i_sweepMinWick = input.float(0.3, "Min Sweep Wick (ATR x)", minval=0.1, step=0.05, group=grp_sweep)
i_sweepReclaim = input.bool(true, "Require Reclaim (close back)", group=grp_sweep)

// Liquidity Pools (equal H/L)
i_showLiq      = input.bool(true, "Show Equal H/L Lines", group=grp_liq)
i_liqTolerance = input.float(0.1, "Equal Tolerance (ATR x)", minval=0.01, step=0.01, group=grp_liq)
i_liqMaxAge    = input.int(50, "Max Age (bars)", minval=10, group=grp_liq)

// Daily Levels
i_showOR       = input.bool(true, "Show Opening Range", group=grp_daily)
i_orSession    = input.session("0930-1000", "Opening Range Session", group=grp_daily)
i_showPDHL     = input.bool(true, "Show PDH / PDL", group=grp_daily)
i_showPDOC     = input.bool(false, "Show Prev Day Open/Close", group=grp_daily)

// Killzones
i_tzOffset = input.string("America/New_York", "Session TZ", options=["America/New_York","Europe/London","Asia/Tokyo","UTC"], group=grp_sess)
i_kzLondon = input.session("0200-0500", "London KZ", group=grp_sess)
i_kzNYAM   = input.session("0700-1000", "NY AM KZ", group=grp_sess)
i_kzNYPM   = input.session("1330-1600", "NY PM KZ", group=grp_sess)
i_kzShowBG = input.bool(false, "Highlight KZ BG", group=grp_sess)

// Cleanup
i_ageSoft    = input.int(100, "Dim Older Than (bars)", minval=10, group=grp_clean)
i_ageHard    = input.int(300, "Delete Older Than (bars)", minval=50, group=grp_clean)
i_distMax    = input.float(8.0, "Hide Beyond (ATR x)", minval=2.0, step=0.5, group=grp_clean)
i_enableDist = input.bool(true, "Enable Distance Filter", group=grp_clean)

// Signal Engine
i_showSignals     = input.bool(true, "Enable Signals", group=grp_sig)
i_sigMinScore     = input.float(0.60, "Min FVG Score for Signal", group=grp_sig, minval=0.40, maxval=0.95, step=0.01)
i_sigMode         = input.string("Both", "Signal Mode", options=["Trend Only","Reversal Only","Both"], group=grp_sig)
i_sigReqConfirm   = input.bool(true,  "Require Confirmation Candle", group=grp_sig)
i_sigReqPD        = input.bool(true,  "Req P/D Alignment (Trend)", group=grp_sig)
i_sigReqKZ        = input.bool(true,  "Req Killzone Active", group=grp_sig)
i_sigHTFBuffer    = input.float(0.3,  "HTF Buffer (ATR x)", minval=0.0, step=0.05, group=grp_sig)
i_sigCooldown     = input.int(10, "Min Bars Between Signals", minval=0, group=grp_sig)
i_sigAplusOnly    = input.bool(false, "Show Only A+ Signals", group=grp_sig)
i_sigOnCETap      = input.bool(true,  "Trigger on CE Tap", group=grp_sig)
i_sigOnOBRetest   = input.bool(true,  "Trigger on OB Retest", group=grp_sig)
i_sigOnSweep      = input.bool(true,  "Trigger on Liquidity Sweep", group=grp_sig)

// ====================================================================================
// 📋 OBV REVERSAL PATTERN CONFIRMATION (NEW)
// ====================================================================================
i_enableOBVConfirm = input.bool(true, "Enable OBV Reversal Confirmation", group=grp_obv)
i_obvConfirmMode   = input.string("Confirm Sell Signals", "OBV Confirmation Mode", options=["Confirm Sell Signals", "Confirm Buy Signals", "Confirm Both"], group=grp_obv)
i_obvSmoothLen     = input.int(14, "OBV Smoothing Length", minval=5, maxval=30, group=grp_obv)
i_obvPivotLen      = input.int(5, "OBV Pivot Length", minval=3, maxval=10, group=grp_obv)
i_obvLookback      = input.int(30, "OBV Pattern Lookback", minval=10, maxval=100, group=grp_obv)
i_showOBV          = input.bool(false, "Show OBV in Data Window", group=grp_obv, tooltip="OBV magnitude is far from price. It is plotted to the data window only so the overlay scale stays intact.")
i_showOBVPattern   = input.bool(true, "Show OBV Reversal Pattern Signal", group=grp_obv)

// Volume & Volatility
i_rvolLen        = input.int(20, "RVOL Length", minval=5, group=grp_vol)
i_rvolMin        = input.float(1.0, "Min RVOL for Signal", minval=0.3, step=0.1, group=grp_vol)
i_volRegimeLen   = input.int(50, "Volatility Regime ATR Length", group=grp_vol)
i_volCompressPct = input.float(0.7, "Compression Threshold", minval=0.4, maxval=0.95, step=0.05, group=grp_vol)
i_volExpandPct   = input.float(1.3, "Expansion Threshold", minval=1.05, maxval=2.0, step=0.05, group=grp_vol)

// Time-of-Day
i_useTimeFilter  = input.bool(true, "Enable Time Filter", group=grp_time)
i_avoidOpenMin   = input.int(5, "Skip First N Minutes of NY AM", minval=0, maxval=30, group=grp_time)
i_avoidCloseMin  = input.int(10, "Skip Last N Minutes of NY PM", minval=0, maxval=30, group=grp_time)
i_avoidLunch     = input.bool(true, "Skip Lunch (11:30-13:30 NY)", group=grp_time)

// Style
color i_bullHigh = input.color(#00e676, "Bull High", group=grp_style)
color i_bullMed  = input.color(#26a69a, "Bull Med",  group=grp_style)
color i_bullLow  = input.color(#37474f, "Bull Low",  group=grp_style)
color i_bearHigh = input.color(#ff1744, "Bear High", group=grp_style)
color i_bearMed  = input.color(#ff6d00, "Bear Med",  group=grp_style)
color i_bearLow  = input.color(#4e342e, "Bear Low",  group=grp_style)
color i_ifvgBull = input.color(#7e57c2, "IFVG was Bull", group=grp_style)
color i_ifvgBear = input.color(#f48fb1, "IFVG was Bear", group=grp_style)
color i_orColor  = input.color(#ffd700, "Opening Range", group=grp_style)
color i_pdhColor = input.color(#ff1744, "PDH",  group=grp_style)
color i_pdlColor = input.color(#00e676, "PDL",  group=grp_style)
color i_liqColor = input.color(#bb86fc, "Liquidity", group=grp_style)
i_fillAlpha   = input.int(88, "Fill Alpha", minval=60, maxval=98, group=grp_style)
i_borderAlpha = input.int(45, "Border Alpha", minval=0, maxval=90, group=grp_style)
i_dimExtra    = input.int(6, "Extra Dim on Old", minval=0, maxval=10, group=grp_style)

// Dashboard
i_showTable = input.bool(true, "Show Dashboard", group=grp_tbl)
i_tblPos    = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grp_tbl)

//====================================================================================
// 📋 CVD LEADER CONFIRMATION
//====================================================================================
grp_cvd = "📊 CVD Leader Settings"
i_enableCVD        = input.bool(true, "Enable CVD Leader Confirmation", group=grp_cvd)
i_cvdAvgLen        = input.int(9, "CVD Avg Length (EMA of delta)", minval=1, group=grp_cvd)
i_cvdSmoothLen     = input.int(9, "CVD Smooth Length", minval=1, group=grp_cvd)
i_leadLen          = input.int(3, "Leader Smooth Length", minval=1, group=grp_cvd)
i_leadMult         = input.float(2.0, "Leader Sensitivity", step=0.1, group=grp_cvd)
i_resetDaily       = input.bool(true, "Reset CVD Each Session", group=grp_cvd)
i_chopZonePct      = input.float(0.15, "Chop Zone % of Range", step=0.01, group=grp_cvd, tooltip="Leader must be within this % of its range to qualify as chop")
i_chopSlopePct     = input.float(0.05, "Chop Slope % of Range", step=0.01, group=grp_cvd, tooltip="Leader slope must be below this % of range to qualify as chop")
i_cvdMode          = input.string("Confirm Both", "CVD Confirmation Mode", options=["Confirm Buy Signals", "Confirm Sell Signals", "Confirm Both", "None"], group=grp_cvd)
i_showCVDTable     = input.bool(true, "Show CVD Status in Tables", group=grp_cvd)

atr      = ta.atr(i_atrLen)
atrLong  = ta.atr(i_volRegimeLen)
emaFast  = ta.ema(close, i_emaFast)
emaSlow  = ta.ema(close, i_emaSlow)
emaHTF   = ta.ema(close, i_emaHTF)
volMA    = ta.sma(volume, i_rvolLen)
rvol     = volume / math.max(volMA, 1)

bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

// HTF buffer - price must be clearly above/below HTF to count
htfBuf    = i_sigHTFBuffer * atr
aboveHTF  = close > emaHTF + htfBuf
belowHTF  = close < emaHTF - htfBuf

// Volatility regime
volRatio   = atr / math.max(atrLong, syminfo.mintick)
volCompressed = volRatio < i_volCompressPct
volExpanded   = volRatio > i_volExpandPct
volNormal     = not volCompressed and not volExpanded

// Killzones
inLondon = not na(time(timeframe.period, i_kzLondon, i_tzOffset))
inNYAM   = not na(time(timeframe.period, i_kzNYAM,   i_tzOffset))
inNYPM   = not na(time(timeframe.period, i_kzNYPM,   i_tzOffset))
inKZ     = inLondon or inNYAM or inNYPM

bgcolor(i_kzShowBG and inLondon ? color.new(#448aff, 94) : na)
bgcolor(i_kzShowBG and inNYAM   ? color.new(#00e676, 94) : na)
bgcolor(i_kzShowBG and inNYPM   ? color.new(#ffd700, 94) : na)

// Time-of-day filter
nyHour   = hour(time, i_tzOffset)
nyMinute = minute(time, i_tzOffset)
nyMinsFromMid = nyHour * 60 + nyMinute

// NY AM open = 9:30 = 570 mins; skip first N mins = until 570 + N
openBlackout  = nyMinsFromMid >= 570 and nyMinsFromMid < (570 + i_avoidOpenMin)
// NY close = 16:00 = 960; skip last N mins
closeBlackout = nyMinsFromMid >= (960 - i_avoidCloseMin) and nyMinsFromMid < 960
// Lunch = 11:30 to 13:30 = 690 to 810
lunchBlackout = i_avoidLunch and nyMinsFromMid >= 690 and nyMinsFromMid < 810

inBlackout = i_useTimeFilter and (openBlackout or closeBlackout or lunchBlackout)

isDisp(int ofs, bool wantBull) =>
    bodyAbs = math.abs(close[ofs] - open[ofs])
    rng     = math.max(high[ofs] - low[ofs], syminfo.mintick)
    atrRef  = math.max(atr, syminfo.mintick)
    big     = bodyAbs / atrRef >= i_dispBodyAtr
    solid   = bodyAbs / rng    >= i_dispBodyRat
    dir     = wantBull ? close[ofs] > open[ofs] : close[ofs] < open[ofs]
    big and solid and dir

c2_bullDisp = isDisp(1, true)
c2_bearDisp = isDisp(1, false)
curBullDisp = isDisp(0, true)
curBearDisp = isDisp(0, false)

// Velocity: consecutive displacement candles
bullVelocity = (isDisp(0, true)  ? 1 : 0) + (isDisp(1, true)  ? 1 : 0) + (isDisp(2, true)  ? 1 : 0)
bearVelocity = (isDisp(0, false) ? 1 : 0) + (isDisp(1, false) ? 1 : 0) + (isDisp(2, false) ? 1 : 0)

volRelDisp = volume[1] / math.max(volMA[1], 1)

swingH = ta.pivothigh(high, i_swingLen, i_swingLen)
swingL = ta.pivotlow(low,   i_swingLen, i_swingLen)

var float lastSH = na
var float lastSL = na
var float prevSH = na
var float prevSL = na
var int   lastSHBar = na
var int   lastSLBar = na

if not na(swingH)
    prevSH := lastSH
    lastSH := swingH
    lastSHBar := bar_index - i_swingLen
    if i_showStructure
        label.new(bar_index - i_swingLen, swingH, "H", style=label.style_none, textcolor=color.new(#ff1744, 30), size=size.tiny, yloc=yloc.abovebar)
if not na(swingL)
    prevSL := lastSL
    lastSL := swingL
    lastSLBar := bar_index - i_swingLen
    if i_showStructure
        label.new(bar_index - i_swingLen, swingL, "L", style=label.style_none, textcolor=color.new(#00e676, 30), size=size.tiny, yloc=yloc.belowbar)

bosBull = not na(lastSH) and not na(prevSH) and lastSH > prevSH
bosBear = not na(lastSL) and not na(prevSL) and lastSL < prevSL

haveRange = not na(lastSH) and not na(lastSL)
rangeHi   = haveRange ? math.max(lastSH, lastSL) : na
rangeLo   = haveRange ? math.min(lastSH, lastSL) : na
rangeMid  = haveRange ? (rangeHi + rangeLo) / 2 : na

inDiscount = haveRange and close < rangeMid
inPremium  = haveRange and close > rangeMid

// P/D zones visual
var line pdLine  = na
var box  premBox = na
var box  discBox = na
if i_showPDZones and haveRange and barstate.islast
    line.delete(pdLine)
    box.delete(premBox)
    box.delete(discBox)
    pdLine  := line.new(bar_index - 50, rangeMid, bar_index + 20, rangeMid, color=color.new(#ffd700, 40), style=line.style_dashed)
    premBox := box.new(bar_index - 50, rangeHi, bar_index + 20, rangeMid, bgcolor=color.new(#ff1744, 96), border_color=color.new(#ff1744, 85))
    discBox := box.new(bar_index - 50, rangeMid, bar_index + 20, rangeLo, bgcolor=color.new(#00e676, 96), border_color=color.new(#00e676, 85))

sweepBull = false
sweepBear = false
if i_useSweeps and not na(lastSL) and not na(lastSH)
    wickDown = low < lastSL and (lastSL - low) >= i_sweepMinWick * atr
    wickUp   = high > lastSH and (high - lastSH) >= i_sweepMinWick * atr
    reclaimUp   = not i_sweepReclaim or close > lastSL
    reclaimDown = not i_sweepReclaim or close < lastSH
    sweepBull := wickDown and reclaimUp
    sweepBear := wickUp   and reclaimDown

var array<float> ob_tops   = array.new<float>()
var array<float> ob_bots   = array.new<float>()
var array<bool>  ob_isBull = array.new<bool>()
var array<int>   ob_bar    = array.new<int>()

if i_useOB

    if curBullDisp
        for k = 1 to i_obLookback
            if close[k] < open[k]
                obTop = high[k]
                obBot = low[k]
                dup = false
                if array.size(ob_tops) > 0
                    for m = 0 to array.size(ob_tops) - 1
                        if math.abs(array.get(ob_tops, m) - obTop) < syminfo.mintick and math.abs(array.get(ob_bots, m) - obBot) < syminfo.mintick
                            dup := true
                            break
                if not dup
                    array.push(ob_tops, obTop)
                    array.push(ob_bots, obBot)
                    array.push(ob_isBull, true)
                    array.push(ob_bar, bar_index - k)
                break
    if curBearDisp
        for k = 1 to i_obLookback
            if close[k] > open[k]
                obTop = high[k]
                obBot = low[k]
                dup = false
                if array.size(ob_tops) > 0
                    for m = 0 to array.size(ob_tops) - 1
                        if math.abs(array.get(ob_tops, m) - obTop) < syminfo.mintick and math.abs(array.get(ob_bots, m) - obBot) < syminfo.mintick
                            dup := true
                            break
                if not dup
                    array.push(ob_tops, obTop)
                    array.push(ob_bots, obBot)
                    array.push(ob_isBull, false)
                    array.push(ob_bar, bar_index - k)
                break

// Prune old OBs (keep last 20)
if array.size(ob_tops) > 20
    array.shift(ob_tops)
    array.shift(ob_bots)
    array.shift(ob_isBull)
    array.shift(ob_bar)

// OB retest detection 
obRetestBull = false
obRetestBear = false
if array.size(ob_tops) > 0
    for m = 0 to array.size(ob_tops) - 1
        t = array.get(ob_tops, m)
        b = array.get(ob_bots, m)
        isBullOB = array.get(ob_isBull, m)
        bornAt = array.get(ob_bar, m)
        if bar_index - bornAt < 100
            if isBullOB and low <= t and low >= b and close > b
                obRetestBull := true
            if not isBullOB and high >= b and high <= t and close < t
                obRetestBear := true

var array<line> liq_lines = array.new<line>()
var array<int>  liq_bars  = array.new<int>()

if i_showLiq and not na(swingH) and not na(prevSH)
    if math.abs(lastSH - prevSH) <= i_liqTolerance * atr
        ln = line.new(lastSHBar, lastSH, bar_index + 10, lastSH, color=color.new(i_liqColor, 40), style=line.style_dotted, width=3, extend=extend.right)
        array.push(liq_lines, ln)
        array.push(liq_bars, bar_index)

if i_showLiq and not na(swingL) and not na(prevSL)
    if math.abs(lastSL - prevSL) <= i_liqTolerance * atr
        ln = line.new(lastSLBar, lastSL, bar_index + 10, lastSL, color=color.new(i_liqColor, 40), style=line.style_dotted, width=3, extend=extend.right)
        array.push(liq_lines, ln)
        array.push(liq_bars, bar_index)

// Clean old liquidity lines
if array.size(liq_lines) > 0
    var array<int> liqToDel = array.new<int>()
    array.clear(liqToDel)
    for m = 0 to array.size(liq_lines) - 1
        if bar_index - array.get(liq_bars, m) > i_liqMaxAge
            array.push(liqToDel, m)
    if array.size(liqToDel) > 0
        for j = array.size(liqToDel) - 1 to 0
            idx = array.get(liqToDel, j)
            if idx < array.size(liq_lines)
                line.delete(array.get(liq_lines, idx))
                array.remove(liq_lines, idx)
                array.remove(liq_bars, idx)

var float orHigh = na
var float orLow  = na
var line  orHighLn = na
var line  orLowLn  = na

inORSession = not na(time(timeframe.period, i_orSession, i_tzOffset))
if inORSession and not inORSession[1]
    orHigh := high
    orLow  := low
if inORSession
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)

if i_showOR and not na(orHigh) and barstate.islast
    line.delete(orHighLn)
    line.delete(orLowLn)
    orHighLn := line.new(bar_index - 100, orHigh, bar_index + 20, orHigh, color=color.new(i_orColor, 30), style=line.style_solid, width=3, extend=extend.right)
    orLowLn  := line.new(bar_index - 100, orLow,  bar_index + 20, orLow,  color=color.new(i_orColor, 30), style=line.style_solid, width=3, extend=extend.right)

// PDH / PDL / PDO / PDC
[pdh, pdl, pdo, pdc] = request.security(syminfo.tickerid, "1D", [high[1], low[1], open[1], close[1]], lookahead=barmerge.lookahead_on)

var line pdhLn = na
var line pdlLn = na
var line pdoLn = na
var line pdcLn = na

if i_showPDHL and barstate.islast
    line.delete(pdhLn)
    line.delete(pdlLn)
    pdhLn := line.new(bar_index - 100, pdh, bar_index + 20, pdh, color=color.new(i_pdhColor, 30), style=line.style_dashed, width=3, extend=extend.right)
    pdlLn := line.new(bar_index - 100, pdl, bar_index + 20, pdl, color=color.new(i_pdlColor, 30), style=line.style_dashed, width=3, extend=extend.right)

if i_showPDOC and barstate.islast
    line.delete(pdoLn)
    line.delete(pdcLn)
    pdoLn := line.new(bar_index - 100, pdo, bar_index + 20, pdo, color=color.new(color.gray, 50), style=line.style_dotted, width=3, extend=extend.right)
    pdcLn := line.new(bar_index - 100, pdc, bar_index + 20, pdc, color=color.new(color.white, 50), style=line.style_dotted, width=3, extend=extend.right)

clamp(v, lo, hi) => math.max(lo, math.min(hi, v))
logit(p) => math.log(p / (1.0 - p))

calcScore(fvgSize, fvgMid, isBull) =>
    sizeRatio = fvgSize / math.max(atr, syminfo.mintick)
    f1 = sizeRatio > 1.5 ? 0.82 : sizeRatio > 0.9 ? 0.65 : sizeRatio > 0.4 ? 0.50 : 0.35
    f2 = isBull ? (bullTrend ? 0.78 : 0.30) : (bearTrend ? 0.78 : 0.30)
    f3 = isBull ? (aboveHTF ? 0.76 : 0.34) : (belowHTF ? 0.76 : 0.34)
    f4 = volRelDisp > 1.5 ? 0.72 : volRelDisp > 0.8 ? 0.55 : 0.38
    f5 = not haveRange ? 0.50 : (isBull ? (fvgMid < rangeMid ? 0.80 : 0.30) : (fvgMid > rangeMid ? 0.80 : 0.30))
    f6 = isBull ? (bosBull ? 0.75 : 0.40) : (bosBear ? 0.75 : 0.40)
    f7 = inKZ ? 0.68 : 0.45
    f8 = volNormal ? 0.60 : volExpanded ? 0.75 : 0.35
    ll = 1.2*logit(clamp(f1,0.1,0.9)) + 1.0*logit(clamp(f2,0.1,0.9)) + 1.0*logit(clamp(f3,0.1,0.9)) + 0.8*logit(clamp(f4,0.1,0.9)) + 1.5*logit(clamp(f5,0.1,0.9)) + 1.3*logit(clamp(f6,0.1,0.9)) + 0.7*logit(clamp(f7,0.1,0.9)) + 0.9*logit(clamp(f8,0.1,0.9))
    clamp(1.0 / (1.0 + math.exp(-(-0.60 + ll))), 0.04, i_maxScore)

probColor(p, isBull) =>
    tier = p >= i_highProb ? 2 : p >= i_medProb ? 1 : 0
    isBull ? (tier == 2 ? i_bullHigh : tier == 1 ? i_bullMed : i_bullLow) : (tier == 2 ? i_bearHigh : tier == 1 ? i_bearMed : i_bearLow)

tierLabel(p) => p >= i_highProb ? "H" : p >= i_medProb ? "M" : "L"

var array<box>   fvg_boxes    = array.new<box>()
var array<line>  fvg_ceLns    = array.new<line>()
var array<float> fvg_tops     = array.new<float>()
var array<float> fvg_bots     = array.new<float>()
var array<bool>  fvg_isBull   = array.new<bool>()
var array<float> fvg_probs    = array.new<float>()
var array<int>   fvg_state    = array.new<int>()
var array<int>   fvg_birthBar = array.new<int>()

overlaps(newTop, newBot) =>
    bool hit = false
    sz = array.size(fvg_boxes)
    if sz > 0
        for i = 0 to sz - 1
            exTop = array.get(fvg_tops, i)
            exBot = array.get(fvg_bots, i)
            if (newTop <= exTop and newTop >= exBot) or (newBot <= exTop and newBot >= exBot) or (newBot <= exBot and newTop >= exTop) or (exBot <= newBot and exTop >= newTop)
                hit := true
                break
    hit

// Detection
bullGap = low - high[2]
bearGap = low[2] - high
bullFVG = low > high[2] and bullGap >= i_minAtrMult * atr and (not i_useDisp or c2_bullDisp)
bearFVG = high < low[2] and bearGap >= i_minAtrMult * atr and (not i_useDisp or c2_bearDisp)

if bullFVG and not overlaps(low, high[2])
    mid = (low + high[2]) / 2
    p   = calcScore(bullGap, mid, true)
    c   = probColor(p, true)
    lbl = tierLabel(p) + " " + str.format("{0,number,#}%", p * 100)
    bx  = box.new(bar_index[2], low, bar_index + i_extendBars, high[2], bgcolor=color.new(c, i_fillAlpha), border_color=color.new(c, i_borderAlpha), border_width=3, extend=extend.right, text=lbl, text_color=color.new(c, 10), text_size=size.normal, text_halign=text.align_right, text_valign=text.align_top)
    ceLn = i_showCE ? line.new(bar_index[2], mid, bar_index + i_extendBars, mid, color=color.new(c, 30), style=line.style_dotted, extend=extend.right) : na
    array.push(fvg_boxes, bx)
    array.push(fvg_ceLns, ceLn)
    array.push(fvg_tops, low)
    array.push(fvg_bots, high[2])
    array.push(fvg_isBull, true)
    array.push(fvg_probs, p)
    array.push(fvg_state, 0)
    array.push(fvg_birthBar, bar_index)

if bearFVG and not overlaps(low[2], high)
    mid = (low[2] + high) / 2
    p   = calcScore(bearGap, mid, false)
    c   = probColor(p, false)
    lbl = tierLabel(p) + " " + str.format("{0,number,#}%", p * 100)
    bx  = box.new(bar_index[2], low[2], bar_index + i_extendBars, high, bgcolor=color.new(c, i_fillAlpha), border_color=color.new(c, i_borderAlpha), border_width=3, extend=extend.right, text=lbl, text_color=color.new(c, 10), text_size=size.normal, text_halign=text.align_right, text_valign=text.align_top)
    ceLn = i_showCE ? line.new(bar_index[2], mid, bar_index + i_extendBars, mid, color=color.new(c, 30), style=line.style_dotted, extend=extend.right) : na
    array.push(fvg_boxes, bx)
    array.push(fvg_ceLns, ceLn)
    array.push(fvg_tops, low[2])
    array.push(fvg_bots, high)
    array.push(fvg_isBull, false)
    array.push(fvg_probs, p)
    array.push(fvg_state, 0)
    array.push(fvg_birthBar, bar_index)

atrDist = i_ifvgCloseDist * atr
var array<int> toDelete = array.new<int>()
array.clear(toDelete)

// Track whether CE was tapped this bar 
bool ceTapBullFVG = false
bool ceTapBearFVG = false
float ceTapBullScore = 0.0
float ceTapBearScore = 0.0

sz = array.size(fvg_boxes)
if sz > 0
    for i = 0 to sz - 1
        t     = array.get(fvg_tops,     i)
        b     = array.get(fvg_bots,     i)
        bull  = array.get(fvg_isBull,   i)
        st    = array.get(fvg_state,    i)
        pSc   = array.get(fvg_probs,    i)
        birth = array.get(fvg_birthBar, i)
        mid   = (t + b) / 2
        bx    = array.get(fvg_boxes,    i)
        age   = bar_index - birth

        if st == 0
            ceTap = bull ? low <= mid : high >= mid
            if ceTap
                array.set(fvg_state, i, 1)
                box.set_border_width(bx, 3)
                if bull and pSc > ceTapBullScore
                    ceTapBullFVG := true
                    ceTapBullScore := pSc
                if not bull and pSc > ceTapBearScore
                    ceTapBearFVG := true
                    ceTapBearScore := pSc

        if age > i_ageHard
            array.push(toDelete, i)
        else if age > i_ageSoft
            curBull = array.get(fvg_isBull, i)
            newC = st == 3 ? (curBull ? i_ifvgBull : i_ifvgBear) : probColor(pSc, curBull)
            box.set_bgcolor(bx, color.new(newC, math.min(95, i_fillAlpha + i_dimExtra)))
            box.set_border_color(bx, color.new(newC, math.min(95, i_borderAlpha + i_dimExtra + 10)))

        if st != 3
            fullFill = bull ? low <= b : high >= t
            if fullFill
                closeBeyond = bull ? close < b : close > t
                closeDistOk = bull ? (b - close) >= atrDist : (close - t) >= atrDist
                dispOk      = not i_ifvgReqDisp or (bull ? curBearDisp : curBullDisp)
                bosOk       = not i_ifvgReqBOS  or (bull ? bosBear     : bosBull)
                kzOk        = not i_ifvgKzOnly  or inKZ
                validInv    = i_trackIFVG and closeBeyond and closeDistOk and dispOk and bosOk and kzOk

                if validInv
                    newC = bull ? i_ifvgBull : i_ifvgBear
                    newTop = t
                    newBot = b
                    if i_ifvgRedraw
                        newTop := math.max(open, close)
                        newBot := math.min(open, close)
                        array.set(fvg_tops, i, newTop)
                        array.set(fvg_bots, i, newBot)
                        box.set_top(bx, newTop)
                        box.set_bottom(bx, newBot)
                        newMid = (newTop + newBot) / 2
                        ceLn = array.get(fvg_ceLns, i)
                        if not na(ceLn)
                            line.set_y1(ceLn, newMid)
                            line.set_y2(ceLn, newMid)
                            line.set_color(ceLn, color.new(newC, 30))
                    box.set_bgcolor(bx, color.new(newC, i_fillAlpha - 5))
                    box.set_border_color(bx, color.new(newC, i_borderAlpha))
                    box.set_text(bx, "IFVG " + str.format("{0,number,#}%", pSc * 100))
                    array.set(fvg_isBull, i, not bull)
                    array.set(fvg_state,  i, 3)
                else
                    shouldDel = i_fullMitigate ? fullFill : (bull ? low <= t : high >= b)
                    if shouldDel
                        array.push(toDelete, i)

        if st == 3
            tNow    = array.get(fvg_tops,   i)
            bNow    = array.get(fvg_bots,   i)
            nowBull = array.get(fvg_isBull, i)
            broken  = nowBull ? close < bNow : close > tNow
            if broken
                array.push(toDelete, i)

// Apply visibility to FVG boxes and CE lines - FIXED: Added size check
sz_vis = array.size(fvg_boxes)
if sz_vis > 0
    for i = 0 to sz_vis - 1
        bx = array.get(fvg_boxes, i)
        ce = array.get(fvg_ceLns, i)
        if not show_fvg_boxes
            box.set_bgcolor(bx, color.new(color.gray, 100))
            box.set_border_color(bx, color.new(color.gray, 100))
            box.set_text(bx, "")
        if not show_fvg_ce_lines and not na(ce)
            line.set_color(ce, color.new(color.gray, 100))

// Distance hiding
if i_enableDist and barstate.islast
    sz3 = array.size(fvg_boxes)
    if sz3 > 0
        for i = 0 to sz3 - 1
            t2 = array.get(fvg_tops, i)
            b2 = array.get(fvg_bots, i)
            m2 = (t2 + b2) / 2
            dist = math.abs(close - m2) / math.max(atr, syminfo.mintick)
            bx2 = array.get(fvg_boxes, i)
            if dist > i_distMax
                box.set_bgcolor(bx2, color.new(color.gray, 99))
                box.set_border_color(bx2, color.new(color.gray, 99))
                box.set_text(bx2, "")
                ceLn2 = array.get(fvg_ceLns, i)
                if not na(ceLn2)
                    line.set_color(ceLn2, color.new(color.gray, 99))

// Deletions
delSz = array.size(toDelete)
if delSz > 0
    var array<int> seen = array.new<int>()
    array.clear(seen)
    for j = delSz - 1 to 0
        idx = array.get(toDelete, j)
        if not array.includes(seen, idx) and idx < array.size(fvg_boxes)
            array.push(seen, idx)
            box.delete(array.get(fvg_boxes, idx))
            ceLn3 = array.get(fvg_ceLns, idx)
            if not na(ceLn3)
                line.delete(ceLn3)
            array.remove(fvg_boxes,    idx)
            array.remove(fvg_ceLns,    idx)
            array.remove(fvg_tops,     idx)
            array.remove(fvg_bots,     idx)
            array.remove(fvg_isBull,   idx)
            array.remove(fvg_probs,    idx)
            array.remove(fvg_state,    idx)
            array.remove(fvg_birthBar, idx)

//====================================================================================
// 📋 OBV REVERSAL PATTERN DETECTION (Confirmation for signals)
//====================================================================================

// OBV Calculation
var float cumVolOBV = 0.0
cumVolOBV += nz(volume)
obv_raw = ta.cum(math.sign(ta.change(close)) * volume)

// Smoothed OBV
obv_smooth = ta.ema(obv_raw, i_obvSmoothLen)

// Detect Bullish Reversal Pattern on OBV (like figure 8 / double bottom)
obv_pivot_low = ta.pivotlow(obv_smooth, i_obvPivotLen, i_obvPivotLen)
obv_pivot_high = ta.pivothigh(obv_smooth, i_obvPivotLen, i_obvPivotLen)

var float obv_low1 = na
var float obv_low2 = na
var float obv_high1 = na
var float obv_high2 = na
var int obv_low1_bar = na
var int obv_low2_bar = na
var int obv_high1_bar = na
var int obv_high2_bar = na
var bool forming_bullish_pattern = false
var bool forming_bearish_pattern = false
bool obv_bullish_reversal = false
bool obv_bearish_reversal = false
var float obv_mid_high = na
var float obv_mid_low = na
var int obv_pattern_bar = na

// === BULLISH REVERSAL PATTERN (Figure 8 / Double Bottom) ===
// Detect first bottom
if not na(obv_pivot_low) and na(obv_low1)
    obv_low1 := obv_pivot_low
    obv_low1_bar := bar_index - i_obvPivotLen
    forming_bullish_pattern := true

// Detect second bottom (must be higher than first)
if not na(obv_pivot_low) and forming_bullish_pattern and not na(obv_low1) and na(obv_low2)
    if obv_pivot_low > obv_low1  // Higher low = bullish divergence
        obv_low2 := obv_pivot_low
        obv_low2_bar := bar_index - i_obvPivotLen

// Find the mid-point high between the two bottoms
if not na(obv_low1) and not na(obv_low2)
    start_bar = math.min(obv_low1_bar, obv_low2_bar)
    end_bar = math.max(obv_low1_bar, obv_low2_bar)
    highest_obv = obv_smooth
    int span = math.max(0, nz(end_bar - start_bar, 0))
    for i = 0 to span
        highest_obv := math.max(highest_obv, obv_smooth[i])
    obv_mid_high := highest_obv

// Confirm bullish reversal: OBV breaks above the mid-point high
if not na(obv_mid_high) and not na(obv_low2)
    if obv_smooth > obv_mid_high and obv_smooth > obv_smooth[1]
        obv_bullish_reversal := true
        obv_pattern_bar := bar_index
        // Reset for next pattern
        obv_low1 := na
        obv_low2 := na
        obv_mid_high := na
        forming_bullish_pattern := false

// Reset if too much time passed
if forming_bullish_pattern and bar_index - obv_low1_bar > i_obvLookback
    obv_low1 := na
    obv_low2 := na
    obv_mid_high := na
    forming_bullish_pattern := false

// === BEARISH REVERSAL PATTERN (Inverted Figure 8 / Double Top) ===
// Detect first top
if not na(obv_pivot_high) and na(obv_high1)
    obv_high1 := obv_pivot_high
    obv_high1_bar := bar_index - i_obvPivotLen
    forming_bearish_pattern := true

// Detect second top (must be lower than first)
if not na(obv_pivot_high) and forming_bearish_pattern and not na(obv_high1) and na(obv_high2)
    if obv_pivot_high < obv_high1  // Lower high = bearish divergence
        obv_high2 := obv_pivot_high
        obv_high2_bar := bar_index - i_obvPivotLen

// Find the mid-point low between the two tops
if not na(obv_high1) and not na(obv_high2)
    start_bar = math.min(obv_high1_bar, obv_high2_bar)
    end_bar = math.max(obv_high1_bar, obv_high2_bar)
    lowest_obv = obv_smooth
    int span = math.max(0, nz(end_bar - start_bar, 0))
    for i = 0 to span
        lowest_obv := math.min(lowest_obv, obv_smooth[i])
    obv_mid_low := lowest_obv

// Confirm bearish reversal: OBV breaks below the mid-point low
if not na(obv_mid_low) and not na(obv_high2)
    if obv_smooth < obv_mid_low and obv_smooth < obv_smooth[1]
        obv_bearish_reversal := true
        obv_pattern_bar := bar_index
        // Reset for next pattern
        obv_high1 := na
        obv_high2 := na
        obv_mid_low := na
        forming_bearish_pattern := false

// Reset if too much time passed
if forming_bearish_pattern and bar_index - obv_high1_bar > i_obvLookback
    obv_high1 := na
    obv_high2 := na
    obv_mid_low := na
    forming_bearish_pattern := false

// OBV pattern status for signal confirmation (last 10 bars)
var bool last_obv_bullish = false
var bool last_obv_bearish = false
if obv_bullish_reversal
    last_obv_bullish := true
if obv_bearish_reversal
    last_obv_bearish := true
if bar_index - obv_pattern_bar > 10
    last_obv_bullish := false
    last_obv_bearish := false

// Plot OBV to the data window only (overlay scale must stay on price)
plot(i_showOBV ? obv_smooth : na, "OBV Smoothed", color=color.new(#2962FF, 0), linewidth=3, display=display.data_window)

// Plot pattern signals
plotshape(i_showOBVPattern and obv_bullish_reversal, "🟢 OBV Bullish Reversal", 
         location=location.bottom, 
         style=shape.labelup, 
         color=color.new(#00ff88, 0), 
         size=size.small,
         text="OBV↑",
         textcolor=color.white)

plotshape(i_showOBVPattern and obv_bearish_reversal, "🔴 OBV Bearish Reversal", 
         location=location.top, 
         style=shape.labeldown, 
         color=color.new(#ff4444, 0), 
         size=size.small,
         text="OBV↓",
         textcolor=color.white)

// Alerts
alertcondition(obv_bullish_reversal, "OBV Bullish Reversal", "OBV Bullish Reversal Pattern Detected")
alertcondition(obv_bearish_reversal, "OBV Bearish Reversal", "OBV Bearish Reversal Pattern Detected")

//====================================================================================
// 📋 CVD LEADER CALCULATION
//====================================================================================
float rngSafe = high - low + syminfo.mintick
buyVol  = volume * (close - low) / rngSafe
sellVol = volume * (high - close) / rngSafe
delta   = buyVol - sellVol

totalVol = buyVol + sellVol
buyPct   = totalVol > 0 ? buyVol / totalVol * 100 : 50.0
sellPct  = totalVol > 0 ? sellVol / totalVol * 100 : 50.0

bool newSession = i_resetDaily and timeframe.change("1D")

var float cvd = na
alphaAvg = 2.0 / (i_cvdAvgLen + 1)
if newSession or na(cvd[1])
    cvd := delta
else
    cvd := alphaAvg * delta + (1 - alphaAvg) * cvd[1]

var float cvdSmoothed = na
alphaSmooth = 2.0 / (i_cvdSmoothLen + 1)
if newSession or na(cvdSmoothed[1])
    cvdSmoothed := cvd
else
    cvdSmoothed := alphaSmooth * cvd + (1 - alphaSmooth) * cvdSmoothed[1]

var float cvdROC = na
if newSession
    cvdROC := 0.0
else
    cvdROC := cvdSmoothed - nz(cvdSmoothed[1])

cvdLeader = ta.ema(cvdROC, i_leadLen) * i_leadMult

leaderRising    = cvdLeader > cvdLeader[1]
leaderFalling   = cvdLeader < cvdLeader[1]
leaderAboveZero = cvdLeader > 0
leaderBelowZero = cvdLeader < 0
cvdSmoothedRising  = cvdSmoothed > cvdSmoothed[1]
cvdSmoothedFalling = cvdSmoothed < cvdSmoothed[1]
cvdPositive     = cvdSmoothed > 0
cvdNegative     = cvdSmoothed < 0

leaderCrossUp   = ta.crossover(cvdLeader, 0)
leaderCrossDown = ta.crossunder(cvdLeader, 0)

leaderRange   = ta.highest(math.abs(cvdLeader), 50)
leaderSlope   = math.abs(cvdLeader - cvdLeader[2])
leaderNearZero = math.abs(cvdLeader) < leaderRange * i_chopZonePct
leaderShallowSlope = leaderSlope < leaderRange * i_chopSlopePct
recentCross = leaderCrossUp or leaderCrossDown or leaderCrossUp[1] or leaderCrossDown[1] or leaderCrossUp[2] or leaderCrossDown[2]
strongCross = (leaderCrossUp or leaderCrossDown) and not leaderShallowSlope
isChop = leaderNearZero and leaderShallowSlope and recentCross and not strongCross

cvdStrongBuy  = not isChop and leaderAboveZero and leaderRising and cvdPositive and cvdSmoothedRising
cvdBuy        = not isChop and leaderAboveZero and leaderRising and (not cvdPositive or not cvdSmoothedRising)
cvdStrongSell = not isChop and leaderBelowZero and leaderFalling and cvdNegative and cvdSmoothedFalling
cvdSell       = not isChop and leaderBelowZero and leaderFalling and (not cvdNegative or not cvdSmoothedFalling)

cvdConfirmLong  = true
cvdConfirmShort = true
if i_enableCVD
    if i_cvdMode == "Confirm Buy Signals"
        cvdConfirmLong  := cvdBuy or cvdStrongBuy
        cvdConfirmShort := true
    else if i_cvdMode == "Confirm Sell Signals"
        cvdConfirmLong  := true
        cvdConfirmShort := cvdSell or cvdStrongSell
    else if i_cvdMode == "Confirm Both"
        cvdConfirmLong  := cvdBuy or cvdStrongBuy
        cvdConfirmShort := cvdSell or cvdStrongSell
    else if i_cvdMode == "None"
        cvdConfirmLong  := true
        cvdConfirmShort := true

//====================================================================================
// 📋 SIGNAL ENGINE WITH OBV + CVD CONFIRMATION
//====================================================================================

var int lastLongSigBar  = -9999
var int lastShortSigBar = -9999

barsSinceLong  = bar_index - lastLongSigBar
barsSinceShort = bar_index - lastShortSigBar
cooldownLong   = barsSinceLong  >= i_sigCooldown
cooldownShort  = barsSinceShort >= i_sigCooldown

// Capture trigger events from prior bar
trig_longCE     = ceTapBullFVG[1]
trig_shortCE    = ceTapBearFVG[1]
trig_longOB     = obRetestBull[1]
trig_shortOB    = obRetestBear[1]
trig_longSweep  = sweepBull[1]
trig_shortSweep = sweepBear[1]

trigScoreLong  = ceTapBullScore[1]
trigScoreShort = ceTapBearScore[1]

// Any long / short trigger?
anyLongTrig  = (i_sigOnCETap and trig_longCE)     or (i_sigOnOBRetest and trig_longOB)   or (i_sigOnSweep and trig_longSweep)
anyShortTrig = (i_sigOnCETap and trig_shortCE)    or (i_sigOnOBRetest and trig_shortOB)  or (i_sigOnSweep and trig_shortSweep)

// OBV Confirmation Logic
obv_confirm_long = true
obv_confirm_short = true

if i_enableOBVConfirm
    if i_obvConfirmMode == "Confirm Sell Signals"
        // Require OBV bearish reversal to confirm sell signals
        obv_confirm_short := last_obv_bearish
    else if i_obvConfirmMode == "Confirm Buy Signals"
        // Require OBV bullish reversal to confirm buy signals
        obv_confirm_long := last_obv_bullish
    else if i_obvConfirmMode == "Confirm Both"
        // Require appropriate OBV reversal for both signals
        obv_confirm_long := last_obv_bullish
        obv_confirm_short := last_obv_bearish

// Context checks (current bar)
rvolOk  = rvol >= i_rvolMin
scoreOkLong  = not i_sigOnCETap or (trig_longCE  ? trigScoreLong  >= i_sigMinScore : true)
scoreOkShort = not i_sigOnCETap or (trig_shortCE ? trigScoreShort >= i_sigMinScore : true)
kzOk    = not i_sigReqKZ or inKZ
confirmLong  = not i_sigReqConfirm or curBullDisp
confirmShort = not i_sigReqConfirm or curBearDisp
notBlackout  = not inBlackout
notCompressed = not volCompressed

// Trend alignment
trendOkLong  = bullTrend and bosBull and aboveHTF
trendOkShort = bearTrend and bosBear and belowHTF

// P/D alignment
pdOkLong  = not i_sigReqPD or inDiscount
pdOkShort = not i_sigReqPD or inPremium

// Shared base context (non-directional)
baseCtx = rvolOk and kzOk and notBlackout and notCompressed

// TREND signals with OBV confirmation
canFireTrendLong  = baseCtx and anyLongTrig  and confirmLong  and scoreOkLong  and trendOkLong  and pdOkLong  and cooldownLong  and obv_confirm_long and cvdConfirmLong
canFireTrendShort = baseCtx and anyShortTrig and confirmShort and scoreOkShort and trendOkShort and pdOkShort and cooldownShort and obv_confirm_short and cvdConfirmShort

// REVERSAL signals with OBV + CVD confirmation
canFireRevLong  = baseCtx and trig_longSweep  and confirmLong  and bearTrend and cooldownLong  and obv_confirm_long and cvdConfirmLong
canFireRevShort = baseCtx and trig_shortSweep and confirmShort and bullTrend and cooldownShort and obv_confirm_short and cvdConfirmShort

// Mode gates
modeTrend = i_sigMode == "Trend Only" or i_sigMode == "Both"
modeRev   = i_sigMode == "Reversal Only" or i_sigMode == "Both"

fireTrendLong  = i_showSignals and modeTrend and canFireTrendLong
fireTrendShort = i_showSignals and modeTrend and canFireTrendShort
fireRevLong    = i_showSignals and modeRev   and canFireRevLong
fireRevShort   = i_showSignals and modeRev   and canFireRevShort

tierOf(isLong, isTrend) =>
    triggerCount = 0
    if isLong
        triggerCount += (trig_longCE     ? 1 : 0)
        triggerCount += (trig_longOB     ? 1 : 0)
        triggerCount += (trig_longSweep  ? 1 : 0)
    else
        triggerCount += (trig_shortCE    ? 1 : 0)
        triggerCount += (trig_shortOB    ? 1 : 0)
        triggerCount += (trig_shortSweep ? 1 : 0)
    velOk = isLong ? bullVelocity >= 2 : bearVelocity >= 2
    highScore = isLong ? trigScoreLong >= i_highProb : trigScoreShort >= i_highProb
    if isTrend and triggerCount >= 2 and volExpanded and velOk
        "A+"
    else if isTrend and (triggerCount >= 2 or (highScore and velOk))
        "A"
    else
        "B"

// Determine label content
longTier  = fireTrendLong  ? tierOf(true,  true)  : fireRevLong  ? "REV-" + tierOf(true,  false) : ""
shortTier = fireTrendShort ? tierOf(false, true)  : fireRevShort ? "REV-" + tierOf(false, false) : ""

// Apply A+ only filter
passAplusLong  = not i_sigAplusOnly or longTier  == "A+"
passAplusShort = not i_sigAplusOnly or shortTier == "A+"

// Add OBV confirmation to label if used
obv_label_long = i_enableOBVConfirm and last_obv_bullish ? " [OBV✓]" : ""
obv_label_short = i_enableOBVConfirm and last_obv_bearish ? " [OBV✓]" : ""
cvd_label_long = i_enableCVD and cvdConfirmLong and (cvdBuy or cvdStrongBuy) ? " [CVD✓]" : ""
cvd_label_short = i_enableCVD and cvdConfirmShort and (cvdSell or cvdStrongSell) ? " [CVD✓]" : ""

// Fire labels with visibility control
if (fireTrendLong or fireRevLong) and passAplusLong and show_fvg_signals
    lblType = fireRevLong ? "REV LONG" : "LONG"
    sc      = trigScoreLong
    txt     = lblType + " " + longTier + obv_label_long + cvd_label_long + (sc > 0 ? " " + str.format("{0,number,#}%", sc * 100) : "")
    labelColor = fireRevLong ? color.new(#7e57c2, 10) : color.new(#00e676, 20)
    label.new(bar_index, low, txt, style=label.style_label_up, color=labelColor, textcolor=color.white, size=size.normal, yloc=yloc.belowbar)
    lastLongSigBar := bar_index

if (fireTrendShort or fireRevShort) and passAplusShort and show_fvg_signals
    lblType = fireRevShort ? "REV SHORT" : "SHORT"
    sc      = trigScoreShort
    txt     = lblType + " " + shortTier + obv_label_short + cvd_label_short + (sc > 0 ? " " + str.format("{0,number,#}%", sc * 100) : "")
    labelColor = fireRevShort ? color.new(#f48fb1, 10) : color.new(#ff1744, 20)
    label.new(bar_index, high, txt, style=label.style_label_down, color=labelColor, textcolor=color.white, size=size.normal, yloc=yloc.abovebar)
    lastShortSigBar := bar_index

int openBull  = 0
int openBear  = 0
int openIFVG  = 0
int openCETap = 0
sz2 = array.size(fvg_boxes)
if sz2 > 0
    for i = 0 to sz2 - 1
        st = array.get(fvg_state, i)
        if st == 3
            openIFVG += 1
        else
            if array.get(fvg_isBull, i)
                openBull += 1
            else
                openBear += 1
            if st == 1
                openCETap += 1

avgProb(wantBull) =>
    float s = 0.0
    float w = 0.0
    n = array.size(fvg_probs)
    if n > 0
        for i = 0 to n - 1
            if array.get(fvg_isBull, i) == wantBull and array.get(fvg_state, i) != 3
                m    = (array.get(fvg_tops, i) + array.get(fvg_bots, i)) / 2
                dist = math.abs(close - m) / math.max(atr, syminfo.mintick)
                wt   = 1.0 / (1.0 + dist)
                s += array.get(fvg_probs, i) * wt
                w += wt
    w > 0 ? s / w : na

// Overall context
bool longTrendCtx  = baseCtx and trendOkLong  and pdOkLong
bool shortTrendCtx = baseCtx and trendOkShort and pdOkShort
bool longRevCtx    = baseCtx and bearTrend and (sweepBull  or array.size(ob_tops) > 0)
bool shortRevCtx   = baseCtx and bullTrend and (sweepBear  or array.size(ob_tops) > 0)

// OBV status for dashboard
obv_status = last_obv_bullish ? "OBV🟢" : last_obv_bearish ? "OBV🔴" : "-"

ctxTxt = longTrendCtx ? "LONG-TREND" : shortTrendCtx ? "SHORT-TREND" : longRevCtx ? "LONG-REV?" : shortRevCtx ? "SHORT-REV?" : inBlackout ? "BLACKOUT" : volCompressed ? "COMPRESSED" : "WAIT"
ctxClr = longTrendCtx ? color.new(#00e676, 0) : shortTrendCtx ? color.new(#ff1744, 0) : longRevCtx ? color.new(#7e57c2, 0) : shortRevCtx ? color.new(#f48fb1, 0) : color.new(#8b949e, 0)

pdStatus  = not haveRange ? "-" : close > rangeMid ? "PREM" : "DISC"
bosStatus = bosBull ? "BOS+" : bosBear ? "BOS-" : "-"
kzStatus  = inLondon ? "LDN" : inNYAM ? "NY-AM" : inNYPM ? "NY-PM" : "-"
volRegTxt = volCompressed ? "COMP" : volExpanded ? "EXP" : "NORM"
volRegClr = volCompressed ? color.new(#ff6d00, 0) : volExpanded ? color.new(#00e676, 0) : color.new(#8b949e, 0)
rvolTxt   = rvol >= 1.5 ? "HIGH" : rvol >= 1.0 ? "OK" : rvol >= 0.7 ? "LOW" : "DEAD"
rvolClr   = rvol >= 1.5 ? color.new(#00e676, 0) : rvol >= 1.0 ? color.new(#8b949e, 0) : color.new(#ff6d00, 0)

var table dash = table.new(i_tblPos == "Top Right" ? position.top_right : i_tblPos == "Top Left" ? position.top_left : i_tblPos == "Bottom Right" ? position.bottom_right : position.bottom_left, 3, 18, bgcolor=color.new(#0d1117, 10), border_color=color.new(#30363d, 60), border_width=3, frame_color=color.new(#58a6ff, 40), frame_width=3)

hdrBg   = color.new(#161b22, 20)
hdrTxt  = color.new(#8b949e, 0)
bullClr = color.new(#00e676, 0)
bearClr = color.new(#ff1744, 0)
dimTxt  = color.new(#58a6ff, 0)
rowBg1  = color.new(#0d1117, 30)
rowBg2  = color.new(#161b22, 20)
ifvgClr = color.new(#bb86fc, 0)
kzClr   = color.new(#ffd700, 0)
obvClr  = color.new(#00ff88, 0)
cvdClr  = color.new(#ffaa00, 0)

// FVG Dashboard - Now controlled by show_analysis_tables
if i_showTable and show_analysis_tables and barstate.islast
    table.cell(dash, 0, 0, "FVG v5.2 + OBV + CVD", text_color=dimTxt,  bgcolor=hdrBg, text_size=size.tiny)
    table.cell(dash, 1, 0, "BULL",     text_color=bullClr, bgcolor=hdrBg, text_size=size.tiny)
    table.cell(dash, 2, 0, "BEAR",     text_color=bearClr, bgcolor=hdrBg, text_size=size.tiny)

    table.cell(dash, 0, 1, "SETUP",    text_color=hdrTxt,  bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 1, ctxTxt,     text_color=ctxClr,  bgcolor=rowBg1, text_size=size.small)
    table.cell(dash, 2, 1, obv_status, text_color=obvClr,  bgcolor=rowBg1, text_size=size.tiny)

    table.cell(dash, 0, 2, "Open",     text_color=hdrTxt,  bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(openBull), text_color=bullClr, bgcolor=rowBg2, text_size=size.small)
    table.cell(dash, 2, 2, str.tostring(openBear), text_color=bearClr, bgcolor=rowBg2, text_size=size.small)

    abp  = avgProb(true)
    abrp = avgProb(false)
    table.cell(dash, 0, 3, "Avg Q",   text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 3, na(abp)  ? "-" : str.format("{0}%", math.round(abp  * 100)), text_color=bullClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 3, na(abrp) ? "-" : str.format("{0}%", math.round(abrp * 100)), text_color=bearClr, bgcolor=rowBg1, text_size=size.tiny)

    trendTxt = bullTrend and aboveHTF ? "BULL" : bearTrend and belowHTF ? "BEAR" : "CHOP"
    trendClr = bullTrend and aboveHTF ? bullClr : bearTrend and belowHTF ? bearClr : color.new(#8b949e, 0)
    bosC     = bosBull ? bullClr : bosBear ? bearClr : hdrTxt
    table.cell(dash, 0, 4, "Bias",    text_color=hdrTxt,   bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 4, trendTxt,  text_color=trendClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 4, bosStatus, text_color=bosC,     bgcolor=rowBg2, text_size=size.tiny)

    zoneClr = not haveRange ? hdrTxt : close > rangeMid ? bearClr : bullClr
    table.cell(dash, 0, 5, "Zone",    text_color=hdrTxt,  bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 5, pdStatus,  text_color=zoneClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 5, "",        bgcolor=rowBg1)

    table.cell(dash, 0, 6, "Killzone", text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 6, kzStatus,   text_color=inKZ ? kzClr : hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 6, "",         bgcolor=rowBg2)

    table.cell(dash, 0, 7, "VolReg",   text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 7, volRegTxt,  text_color=volRegClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 7, "",         bgcolor=rowBg1)

    table.cell(dash, 0, 8, "RVOL",     text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 8, rvolTxt + " " + str.format("{0,number,#.#}", rvol), text_color=rvolClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 8, "",         bgcolor=rowBg2)

    sweepTxt = sweepBull ? "SWEEP+" : sweepBear ? "SWEEP-" : "-"
    sweepClr = sweepBull ? bullClr : sweepBear ? bearClr : hdrTxt
    table.cell(dash, 0, 9, "Sweep",    text_color=hdrTxt,  bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 9, sweepTxt,   text_color=sweepClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 9, str.tostring(array.size(ob_tops)) + " OBs", text_color=dimTxt, bgcolor=rowBg1, text_size=size.tiny)

    table.cell(dash, 0, 10, "IFVG/CE", text_color=hdrTxt,  bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 10, str.tostring(openIFVG),  text_color=ifvgClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 10, str.tostring(openCETap), text_color=dimTxt,  bgcolor=rowBg2, text_size=size.tiny)

    blackoutTxt = openBlackout ? "OPEN" : closeBlackout ? "CLOSE" : lunchBlackout ? "LUNCH" : "-"
    table.cell(dash, 0, 11, "Blackout", text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 11, blackoutTxt, text_color=inBlackout ? color.new(#ff6d00, 0) : hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 11, "",        bgcolor=rowBg1)

    table.cell(dash, 0, 12, "Mode",    text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 12, i_sigMode, text_color=dimTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 12, i_sigAplusOnly ? "A+ only" : "All tiers", text_color=dimTxt, bgcolor=rowBg2, text_size=size.tiny)

    table.cell(dash, 0, 13, "OBV Confirm", text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 13, i_obvConfirmMode, text_color=obvClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 13, i_enableOBVConfirm ? "ON" : "OFF", text_color=dimTxt, bgcolor=rowBg1, text_size=size.tiny)

    cvdStatusText = isChop ? "CHOP" : cvdLeader > 0 ? "🟢" : "🔴"
    cvdSignalText = cvdStrongBuy ? "SB" : cvdBuy ? "B" : cvdStrongSell ? "SS" : cvdSell ? "S" : "-"
    table.cell(dash, 0, 14, "CVD", text_color=hdrTxt, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 1, 14, i_showCVDTable ? cvdStatusText + " " + cvdSignalText : "-", text_color=cvdLeader > 0 ? bullClr : bearClr, bgcolor=rowBg2, text_size=size.tiny)
    table.cell(dash, 2, 14, str.tostring(math.round(buyPct, 1)) + "%", text_color=cvdLeader > 0 ? bullClr : bearClr, bgcolor=rowBg2, text_size=size.tiny)

    table.cell(dash, 0, 15, "CVD Mode", text_color=hdrTxt, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 1, 15, i_cvdMode, text_color=cvdClr, bgcolor=rowBg1, text_size=size.tiny)
    table.cell(dash, 2, 15, i_enableCVD ? "ON" : "OFF", text_color=dimTxt, bgcolor=rowBg1, text_size=size.tiny)

    table.cell(dash, 0, 16, "Not financial advice", text_color=color.new(#4a4a4a, 0), bgcolor=hdrBg, text_size=size.tiny)
    table.cell(dash, 1, 16, "", bgcolor=hdrBg)
    table.cell(dash, 2, 16, "", bgcolor=hdrBg)

plot(i_ShowEMA ? emaFast : na, color=color.new(#20f408, 0), linewidth=3, title="Fast EMA")
plot(i_ShowEMA ? emaSlow : na, color=color.new(#ed1405, 0), linewidth=3, title="Slow EMA")
plot(i_ShowEMA ? emaHTF  : na, color=color.new(#ffd900, 0), linewidth=3, title="HTF EMA")

//alerts
alertcondition(fireTrendLong,  "LONG Trend Setup",  "LONG trend setup")
alertcondition(fireTrendShort, "SHORT Trend Setup", "SHORT trend setup")
alertcondition(fireRevLong,    "LONG Reversal",     "LONG reversal setup")
alertcondition(fireRevShort,   "SHORT Reversal",    "SHORT reversal setup")
alertcondition(sweepBull,      "Bullish Sweep",     "Liquidity sweep of lows")
alertcondition(sweepBear,      "Bearish Sweep",     "Liquidity sweep of highs")

//====================================================================================
// 📋 SECTION 2: WYCKOFF + ADVANCED TRADING + PIVOT PREDICTOR
//====================================================================================

//==================== WYCKOFF SETTINGS ====================
wyckoffGroup = "📊 Wyckoff Accumulation Distribution"
color_ = input.color(color.white, "Text Color", group=wyckoffGroup)

// RSI hesaplama
rsilen = input.int(14, "RSI Length", group=wyckoffGroup)
rsi_wyckoff = ta.rsi(close, rsilen)
rsisens = input.int(20, title="Trend Sensitivity", maxval=50, minval=0, group=wyckoffGroup)

utad = rsi_wyckoff<50+rsisens and rsi_wyckoff[1]>50+rsisens
spring = rsi_wyckoff>50-rsisens and rsi_wyckoff[1]<50-rsisens

myhigh(int lenH) =>
    int n = math.min(500, math.max(1, nz(lenH, 1)))
    float mx = high
    if n > 1
        for i = 1 to n - 1
            mx := math.max(mx, high[i])
    mx

mylow(int lenL) =>
    int n = math.min(500, math.max(1, nz(lenL, 1)))
    float mn = low
    if n > 1
        for i = 1 to n - 1
            mn := math.min(mn, low[i])
    mn

side = (rsi_wyckoff < 50 + rsisens and rsi_wyckoff > 50 - rsisens) or (rsi_wyckoff[1] < 50 + rsisens and rsi_wyckoff[1] > 50 - rsisens)
bull = rsi_wyckoff > 50 + rsisens and rsi_wyckoff[1] > 50 + rsisens
bear = rsi_wyckoff < 50 - rsisens and rsi_wyckoff[1] < 50 - rsisens 

boxlen = ta.barssince(side and not side[1])
int boxSpan = math.max(1, nz(boxlen, 0) + 1)

x1 = ta.valuewhen(side and not side[1], bar_index, 0)
x2 = ta.valuewhen(not side and side[1], bar_index[1], 0) - 1
y1 = myhigh(boxSpan)[2]
y2 = mylow(boxSpan)[2]

var box trendBox = na
if side[1] and not side and not na(x1) and not na(x2) and not na(y1) and not na(y2)
    int boxLeft = math.min(x1, x2)
    int boxRight = math.max(x1, x2)
    if boxRight > boxLeft
        trendBox := box.new(boxLeft, y1, boxRight, y2, color.gray, 1, line.style_solid, extend.none, xloc.bar_index, color.rgb(120, 123, 134, 90), text_color=color.new(color_, 80))

var string after_trend = na
if bull
    after_trend := "Accumulation"
else if bear
    after_trend := "Distribution"

if not na(trendBox) and after_trend == "Accumulation"
    box.set_bgcolor(trendBox, color.rgb(76, 175, 79, 95))
    box.set_text(trendBox, "Accumulation")
else if not na(trendBox) and after_trend == "Distribution"
    box.set_bgcolor(trendBox, color.rgb(255, 82, 82, 95))
    box.set_text(trendBox, "Distribution")

// Apply visibility to Wyckoff boxes
if not show_wyckoff_boxes and not na(trendBox)
    box.set_bgcolor(trendBox, color.new(color.gray, 100))
    box.set_text(trendBox, "")

pivotLen = input.int(5, "Pivot Length", minval=1, group=wyckoffGroup)
rsiLow = 50 - rsisens
rsiHigh = 50 + rsisens
offsetVal = -pivotLen

pivotLowValue = ta.pivotlow(low, pivotLen, pivotLen)
pivotHighValue = ta.pivothigh(high, pivotLen, pivotLen)
isPivotLow = not na(pivotLowValue)
isPivotHigh = not na(pivotHighValue)
rsiAtPivot = rsi_wyckoff[pivotLen]

var bool isSCFlag = false
var bool isARFlag = false
var bool isSTFlag = false
var bool isBCFlag = false
var bool isDARFlag = false
var bool isDSTFlag = false

isSC = isPivotLow and rsiAtPivot < rsiLow and not isSCFlag and not spring
plotshape(isSC, "The Selling Climax", location=location.belowbar, style=shape.triangleup, color=color.green, size=size.tiny, offset=offsetVal, text="SC", textcolor=color_)
isSCFlag := isSC ? true : isSCFlag

var int scBarIndex = na
if isSC
    scBarIndex := bar_index - pivotLen
isAR = false
if not na(scBarIndex)
    if isPivotHigh and (bar_index - pivotLen > scBarIndex) and not isARFlag
        isAR := true
        scBarIndex := na
isARFlag := isAR ? true : isARFlag
plotshape(isAR, "Automatic Rally", style=shape.triangledown, location=location.abovebar, color=color.green, size=size.tiny, offset=offsetVal, text="AR", textcolor=color_)

var int pivotCounter = 0
if isPivotLow
    pivotCounter := pivotCounter + 1
if rsiAtPivot < rsiLow
    pivotCounter := 0
isST = pivotCounter == 1 and isPivotLow and not isSTFlag 
plotshape(isST,"The Secondary Test", location=location.belowbar, style=shape.triangleup, color=color.green, size=size.tiny, offset=offsetVal, text="ST", textcolor=color_)
isSTFlag := isST ? true : isSTFlag

isBC = rsiAtPivot > rsiHigh and isPivotHigh and not isBCFlag and not utad
plotshape(isBC,"The Buying Climax", location=location.abovebar, style=shape.triangledown, color=color.red, size=size.tiny, offset=offsetVal, text="BC", textcolor=color_)
isBCFlag := isBC ? true : isBCFlag

var int bcBarIndex = na
if isBC
    bcBarIndex := bar_index - pivotLen
isDAR = false
if not na(bcBarIndex)
    if isPivotLow and (bar_index - pivotLen > bcBarIndex) and not isDARFlag
        isDAR := true
        bcBarIndex := na
isDARFlag := isDAR ? true : isDARFlag
plotshape(isDAR,"Automatic Reaction", location=location.belowbar, style=shape.triangleup, color=color.red, size=size.tiny, offset=offsetVal, text="AR", textcolor=color_)

var int darBarIndex = na
if isDAR
    darBarIndex := bar_index - pivotLen
isDST = false
if not na(darBarIndex)
    if isPivotHigh and (bar_index - pivotLen > darBarIndex) and not isDSTFlag and not isBC
        isDST := true
        darBarIndex := na
isDSTFlag := isDST ? true : isDSTFlag
plotshape(isDST,"The Secondary Test", location=location.abovebar, style=shape.triangledown, color=color.red, size=size.tiny, offset=offsetVal, text="ST", textcolor=color_)

plotshape(isPivotLow and not isSC and not isST and not isAR and not isDAR, "pivotLow", location=location.belowbar, style=shape.triangleup, color=color.orange, size=size.auto, offset=offsetVal)
plotshape(isPivotHigh and not isAR and not isDST and not isBC, "pivotHigh", location=location.abovebar, style=shape.triangledown, color=color.orange, size=size.auto, offset=offsetVal)

if bar_index != bar_index[1]
    isSCFlag := false
    isARFlag := false
    isSTFlag := false
    isBCFlag := false
    isDARFlag := false
    isDSTFlag := false

//==================== ADVANCED TRADING PREDICTOR SETTINGS ====================
analysisGroup = "📊 Pattern Historical Analysis"
historical_lookback = input.int(500, "نطاق البحث التاريخي", minval=100, maxval=1000, step=50, group=analysisGroup)
filter_by_trend = input.bool(true, "مقارنة بنفس اتجاه الشموع", group=analysisGroup)
filter_by_rsi = input.bool(true, "مقارنة بنفس نطاق RSI", group=analysisGroup)
filter_by_volume = input.bool(true, "مقارنة بنفس الحجم", group=analysisGroup)
rsi_tolerance = input.int(10, "تفاوت RSI المسموح", minval=5, maxval=20, step=1, group=analysisGroup)
volume_tolerance = input.float(0.8, "تفاوت الحجم", minval=0.5, maxval=1.5, step=0.1, group=analysisGroup)
min_pattern_matches = input.int(2, "الحد الأدنى للأنماط المطابقة", minval=1, maxval=10, step=1, group=analysisGroup)

scalpingGroup = "⚡ Scalping Signals & Filters"
min_signals_required = input.int(3, "الحد الأدنى للإشارات", minval=2, maxval=6, step=1, group=scalpingGroup)
min_confidence = input.float(75.0, "الحد الأدنى للثقة %", minval=60, maxval=90, step=1, group=scalpingGroup)
skip_first_bars = input.int(50, "تجاهل أول عدد شموع", minval=10, maxval=200, step=10, group=scalpingGroup)
require_strong_trend = input.bool(true, "تطلب اتجاه قوي", group=scalpingGroup)
min_trend_strength = input.float(1.5, "قوة الاتجاه المطلوبة %", minval=0.5, maxval=5.0, step=0.1, group=scalpingGroup)
require_rsi_extreme = input.bool(false, "تطلب RSI متطرف", group=scalpingGroup)
require_volume_confirmation = input.bool(false, "تطلب تأكيد الحجم", group=scalpingGroup)
require_macd_confirmation = input.bool(true, "تطلب تأكيد MACD", group=scalpingGroup)

zonesGroup = "📦 Accumulation & Rejection Zones"
detect_accumulation = input.bool(true, "كشف مناطق التجميع", group=zonesGroup)
accumulation_bars = input.int(20, "عدد الشموع", minval=5, maxval=50, step=1, group=zonesGroup)
accumulation_range_threshold = input.float(0.005, "حد المدى الأقصى", minval=0.001, maxval=0.01, step=0.001, group=zonesGroup)
accumulation_volume_multiplier = input.float(1.5, "مضاعف الحجم", minval=1.0, maxval=3.0, step=0.1, group=zonesGroup)
accumulation_color = input.color(color.new(#0066ff, 80), "لون التجميع", group=zonesGroup)
detect_rejection = input.bool(true, "كشف مناطق الخداع", group=zonesGroup)
rejection_wick_ratio = input.float(0.6, "نسبة الذيل", minval=0.4, maxval=0.8, step=0.1, group=zonesGroup)
rejection_color = input.color(color.new(#ff3333, 80), "لون الخداع", group=zonesGroup)

patternsGroup = "🎯 C1-C4 Patterns"
enable_C1 = input.bool(true, "C1 - شراء: Pin Bar", group=patternsGroup)
enable_C2 = input.bool(true, "C2 - شراء: Harami", group=patternsGroup)
enable_C3 = input.bool(true, "C3 - بيع: Shooting Star", group=patternsGroup)
enable_C4 = input.bool(true, "C4 - بيع: Harami", group=patternsGroup)
bodyPctMin = input.float(15.0, "أدنى نسبة الجسم %", minval=5, maxval=40, step=1, group=patternsGroup)
tailBiasPct = input.float(25.0, "تحيز الذيول %", minval=10, maxval=50, step=1, group=patternsGroup)
proximityMode = input.string("ATR", "طريقة قياس القرب", options=["ATR", "Percentage"], group=patternsGroup)
nearK_ATR = input.float(0.25, "ATR Multiplier", minval=0.1, maxval=0.5, step=0.05, group=patternsGroup)
nearK_Pct = input.float(10.0, "نسبة % من المدى", minval=5, maxval=20, step=1, group=patternsGroup)
use_trend_filter = input.bool(true, "فلتر الاتجاه", group=patternsGroup)
trendFilterType = input.string("EMA", "نوع المتوسط", options=["EMA", "SMA"], group=patternsGroup)
trendFilterLength = input.int(14, "طول المتوسط", minval=5, maxval=50, group=patternsGroup)
use_volume_filter = input.bool(false, "فلتر الحجم", group=patternsGroup)
volumeFilterLength = input.int(50, "طول متوسط الحجم", minval=10, maxval=100, group=patternsGroup)
colorBuySignal = input.color(#ddf90a, "لون الشراء", group=patternsGroup)
colorSellSignal = input.color(#05a3ff, "لون البيع", group=patternsGroup)

wolfeGroup = "🐺 Wolfe Candle Pattern"
enable_wolfe = input.bool(true, "تفعيل نموذج وولف", group=wolfeGroup)
wolfe_body_max = input.float(20.0, "أقصى نسبة الجسم %", minval=5, maxval=30, step=1, group=wolfeGroup)
wolfe_wick_ratio = input.float(1.8, "نسبة الذيل/الجسم", minval=1.5, maxval=3.0, step=0.1, group=wolfeGroup)
wolfe_prev_body_min = input.float(40.0, "أدنى نسبة الجسم السابقة %", minval=30, maxval=60, step=1, group=wolfeGroup)
wolfe_require_golden = input.bool(true, "يتطلب Golden Wick", group=wolfeGroup)
colorWolfeBull = input.color(#ffaa00, "لون وولف صاعد", group=wolfeGroup)
colorWolfeBear = input.color(#00aaff, "لون وولف هابط", group=wolfeGroup)

targetGroup = "🎯 Targets & Stop Loss"
tp1_percent = input.float(1.0, "TP1 %", minval=0.5, maxval=5.0, step=0.1, group=targetGroup)
tp2_percent = input.float(2.0, "TP2 %", minval=1.0, maxval=8.0, step=0.1, group=targetGroup)
tp3_percent = input.float(3.5, "TP3 %", minval=2.0, maxval=12.0, step=0.1, group=targetGroup)
stop_loss_percent = input.float(1.5, "Stop Loss %", minval=0.5, maxval=5.0, step=0.1, group=targetGroup)

displayGroup = "🎨 Display & Lines Control"
show_prediction = input.bool(true, "عرض التنبؤ بالأسعار", group=displayGroup)
show_analysis_table = input.bool(true, "عرض جدول التحليل", group=displayGroup)
show_golden_wicks = input.bool(true, "عرض القاعدة الذهبية", group=displayGroup)
lines_display_mode = input.string("All", "اختر الخطوط:", options=["All", "TP Only", "SL Only", "TP Green Only", "TP Yellow Only"], group=displayGroup)
show_tp1 = input.bool(true, "عرض TP1", group=displayGroup)
show_tp2 = input.bool(true, "عرض TP2", group=displayGroup)
show_tp3 = input.bool(true, "عرض TP3", group=displayGroup)
show_sl = input.bool(true, "عرض SL", group=displayGroup)

//==================== PIVOT PREDICTOR SETTINGS ====================
pivotGroup = "🎯 Pivot Settings"
leftBars = input.int(5, "Pivot Left Bars", minval=2, maxval=20, group=pivotGroup)
rightBars = input.int(5, "Pivot Right Bars", minval=2, maxval=20, group=pivotGroup)
pivotLookback = input.int(50, "Pivot Lookback", minval=20, maxval=200, group=pivotGroup)

//==================== INDICATORS CALCULATION ====================
rsi_adv = ta.rsi(close, 14)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
bb_basis = ta.sma(close, 20)
bb_dev = ta.stdev(close, 20)
bb_upper = bb_basis + 2 * bb_dev
bb_lower = bb_basis - 2 * bb_dev
volume_ma = ta.sma(volume, 20)

trendMA = use_trend_filter ? (trendFilterType == "EMA" ? ta.ema(close, trendFilterLength) : ta.sma(close, trendFilterLength)) : na
volumeMA = use_volume_filter ? ta.sma(volume, volumeFilterLength) : na

//==================== CANDLE ANALYSIS ====================
candle_body_adv = math.abs(close - open)
candle_range_adv = high - low
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low

body_percent_adv = candle_range_adv > 0 ? (candle_body_adv / candle_range_adv) * 100 : 0
upper_wick_strong = upper_wick > (candle_body_adv * 1.5)
lower_wick_strong = lower_wick > (candle_body_adv * 1.5)
bullish_wick_signal = lower_wick_strong and close > open
bearish_wick_signal = upper_wick_strong and close < open

//==================== C1-C4 PATTERNS ====================
lookbackBars = 20
highest_price = ta.highest(high, lookbackBars)
lowest_price = ta.lowest(low, lookbackBars)

proximity_threshold = proximityMode == "ATR" ? atr * nearK_ATR : candle_range_adv * (nearK_Pct / 100)
near_high = (highest_price - high) <= proximity_threshold
near_low = (low - lowest_price) <= proximity_threshold

body_strong_enough = body_percent_adv >= bodyPctMin
trend_filter_bull = not use_trend_filter or close > trendMA
trend_filter_bear = not use_trend_filter or close < trendMA
volume_filter_pass = not use_volume_filter or volume >= volumeMA

C1_signal = enable_C1 and lower_wick_strong and close > open and body_strong_enough and ema9 > ema21 and near_low and trend_filter_bull and volume_filter_pass
C2_signal = enable_C2 and high < high[1] and low > low[1] and close > open and trend_filter_bull and volume_filter_pass
C3_signal = enable_C3 and upper_wick_strong and close < open and body_strong_enough and ema9 < ema21 and near_high and trend_filter_bear and volume_filter_pass
C4_signal = enable_C4 and high < high[1] and low > low[1] and close < open and trend_filter_bear and volume_filter_pass

//==================== WOLFE PATTERN ====================
wolfe_candle_body = math.abs(close - open)
wolfe_candle_range = high - low
wolfe_body_percent = wolfe_candle_range > 0 ? (wolfe_candle_body / wolfe_candle_range) * 100 : 0
wolfe_upper_wick = high - math.max(close, open)
wolfe_lower_wick = math.min(close, open) - low
prev_body_percent = (high[1] - low[1]) > 0 ? (math.abs(close[1] - open[1]) / (high[1] - low[1])) * 100 : 0

wolfe_bullish = enable_wolfe and wolfe_candle_body > 0 and wolfe_body_percent <= wolfe_body_max and wolfe_lower_wick > 0 and wolfe_upper_wick > 0 and (wolfe_lower_wick / wolfe_candle_body) >= wolfe_wick_ratio and close > open and close[1] > open[1] and prev_body_percent >= wolfe_prev_body_min
wolfe_bearish = enable_wolfe and wolfe_candle_body > 0 and wolfe_body_percent <= wolfe_body_max and wolfe_upper_wick > 0 and wolfe_lower_wick > 0 and (wolfe_upper_wick / wolfe_candle_body) >= wolfe_wick_ratio and close < open and close[1] < open[1] and prev_body_percent >= wolfe_prev_body_min

WOLFE_bullish = wolfe_bullish and (not wolfe_require_golden or (wolfe_lower_wick > (wolfe_candle_body * 1.5) and close > open))
WOLFE_bearish = wolfe_bearish and (not wolfe_require_golden or (wolfe_upper_wick > (wolfe_candle_body * 1.5) and close < open))

//==================== SIGNAL COUNTING ====================
trend_strength = math.abs(ema9 - ema21) / ema21 * 100
is_uptrend = ema9 > ema21 and ema21 > ema50
is_downtrend = ema9 < ema21 and ema21 < ema50
is_oversold = rsi_adv < 30
is_overbought = rsi_adv > 70
is_rsi_increasing = rsi_adv > rsi_adv[1]
is_rsi_decreasing = rsi_adv < rsi_adv[1]
macd_bullish = macdLine > signalLine and histLine > histLine[1]
macd_bearish = macdLine < signalLine and histLine < histLine[1]
bb_bullish_extreme = close < bb_lower
bb_bearish_extreme = close > bb_upper
volume_strong = volume > volume_ma * 1.2
strong_trend = trend_strength > min_trend_strength

bullish_candle = close[1] > open[1] and (close[1] - open[1]) > atr[1] * 0.6
bearish_candle = close < open and (open - close) > atr * 0.6
reversal_pattern_bullish = (open[1] - close[1]) > atr[1] * 0.6 and close > open and (close - open) > atr * 0.6 and close > close[1]
reversal_pattern_bearish = bullish_candle and bearish_candle and close < open[1]

int bullish_signals = 0
int bearish_signals = 0

if is_oversold and is_rsi_increasing
    bullish_signals += 2
if macd_bullish
    bullish_signals += 2
if bb_bullish_extreme and is_uptrend
    bullish_signals += 2
if volume_strong and macd_bullish
    bullish_signals += 1
if close > ema9 and ema9 > ema21
    bullish_signals += 1
if reversal_pattern_bullish
    bullish_signals += 2
if C1_signal or C2_signal
    bullish_signals += 2
if WOLFE_bullish
    bullish_signals += 2

if is_overbought and is_rsi_decreasing
    bearish_signals += 2
if macd_bearish
    bearish_signals += 2
if bb_bearish_extreme and is_downtrend
    bearish_signals += 2
if volume_strong and macd_bearish
    bearish_signals += 1
if close < ema9 and ema9 < ema21
    bearish_signals += 1
if reversal_pattern_bearish
    bearish_signals += 3
if C3_signal or C4_signal
    bearish_signals += 2
if WOLFE_bearish
    bearish_signals += 2

//==================== PATTERN HISTORY ====================
type PatternData
    int bar_num
    string pattern_name
    float entry_price
    float rsi_value
    float volume_value
    bool is_uptrend
    bool is_downtrend

var array<PatternData> pattern_history = array.new<PatternData>()

if (C1_signal or C2_signal or C3_signal or C4_signal or WOLFE_bullish or WOLFE_bearish) and barstate.isconfirmed
    pat_name = C1_signal ? "C1" : C2_signal ? "C2" : C3_signal ? "C3" : C4_signal ? "C4" : WOLFE_bullish ? "WOLFE_BULL" : "WOLFE_BEAR"
    pat = PatternData.new(bar_index, pat_name, close, rsi_adv, volume, is_uptrend, is_downtrend)
    array.push(pattern_history, pat)
    if array.size(pattern_history) > historical_lookback
        array.remove(pattern_history, 0)

int match_count_bull = 0
int match_count_bear = 0
bool current_bullish_pattern = C1_signal or C2_signal or WOLFE_bullish
bool current_bearish_pattern = C3_signal or C4_signal or WOLFE_bearish

if (current_bullish_pattern or current_bearish_pattern) and array.size(pattern_history) > 1
    for i = 0 to array.size(pattern_history) - 1
        each = array.get(pattern_history, i)
        if each.bar_num != bar_index
            bool trend_match = (not filter_by_trend) or (is_uptrend and each.is_uptrend) or (is_downtrend and each.is_downtrend)
            bool rsi_match = (not filter_by_rsi) or math.abs(each.rsi_value - rsi_adv) <= rsi_tolerance
            bool volume_match = (not filter_by_volume) or (each.volume_value >= volume * (1.0 - volume_tolerance) and each.volume_value <= volume * (1.0 + volume_tolerance))
            if trend_match and rsi_match and volume_match
                if each.pattern_name == "C1" or each.pattern_name == "C2" or each.pattern_name == "WOLFE_BULL"
                    match_count_bull += 1
                else if each.pattern_name == "C3" or each.pattern_name == "C4" or each.pattern_name == "WOLFE_BEAR"
                    match_count_bear += 1

bool historical_bull_confirmed = match_count_bull >= min_pattern_matches
bool historical_bear_confirmed = match_count_bear >= min_pattern_matches
bool pastWarmup = bar_index > skip_first_bars
bool bull_filters_ok = pastWarmup and (not require_strong_trend or strong_trend) and (not require_rsi_extreme or is_oversold) and (not require_volume_confirmation or volume_strong) and (not require_macd_confirmation or macd_bullish)
bool bear_filters_ok = pastWarmup and (not require_strong_trend or strong_trend) and (not require_rsi_extreme or is_overbought) and (not require_volume_confirmation or volume_strong) and (not require_macd_confirmation or macd_bearish)

//==================== FINAL SIGNAL (ADVANCED TRADING PREDICTOR) ====================
string signal_type_adv = "محايد"
float final_confidence = 50.0

if bull_filters_ok and ((bullish_signals > bearish_signals and bullish_signals >= min_signals_required) or (historical_bull_confirmed and bullish_signals >= 1))
    signal_type_adv := "شراء 🟢"
    final_confidence := 70.0 + (bullish_signals * 5.0)
    if is_oversold
        final_confidence += 5
    if volume_strong
        final_confidence += 5
    if strong_trend
        final_confidence += 5
    if reversal_pattern_bullish
        final_confidence += 5
    if historical_bull_confirmed
        final_confidence += 10
else if bear_filters_ok and ((bearish_signals > bullish_signals and bearish_signals >= min_signals_required) or (historical_bear_confirmed and bearish_signals >= 1))
    signal_type_adv := "بيع 🔴"
    final_confidence := 70.0 + (bearish_signals * 5.0)
    if is_overbought
        final_confidence += 5
    if volume_strong
        final_confidence += 5
    if strong_trend
        final_confidence += 5
    if reversal_pattern_bearish
        final_confidence += 5
    if historical_bear_confirmed
        final_confidence += 10

final_confidence := math.min(final_confidence, 95)

tp1_adv = signal_type_adv == "شراء 🟢" ? close * (1 + tp1_percent / 100) : close * (1 - tp1_percent / 100)
tp2_adv = signal_type_adv == "شراء 🟢" ? close * (1 + tp2_percent / 100) : close * (1 - tp2_percent / 100)
tp3_adv = signal_type_adv == "شراء 🟢" ? close * (1 + tp3_percent / 100) : close * (1 - tp3_percent / 100)
sl_adv = signal_type_adv == "شراء 🟢" ? close * (1 - stop_loss_percent / 100) : close * (1 + stop_loss_percent / 100)

//==================== PIVOT DETECTION ====================
pivotHigh = ta.pivothigh(high, leftBars, rightBars)
pivotLow = ta.pivotlow(low, leftBars, rightBars)

var float[] pastPivotHighs = array.new_float()
var float[] pastPivotLows = array.new_float()
var int[] pastPivotHighBars = array.new_int()
var int[] pastPivotLowBars = array.new_int()

if not na(pivotHigh)
    array.push(pastPivotHighs, pivotHigh)
    array.push(pastPivotHighBars, bar_index - rightBars)
    if array.size(pastPivotHighs) > 50
        array.shift(pastPivotHighs)
        array.shift(pastPivotHighBars)

if not na(pivotLow)
    array.push(pastPivotLows, pivotLow)
    array.push(pastPivotLowBars, bar_index - rightBars)
    if array.size(pastPivotLows) > 50
        array.shift(pastPivotLows)
        array.shift(pastPivotLowBars)

//==================== PREDICTION BASED ON PAST PIVOTS ====================
var float nearestPivotHigh = na
var float nearestPivotLow = na
var int nearestPivotBar = na

if array.size(pastPivotHighs) > 0
    nearestPivotHigh := array.get(pastPivotHighs, array.size(pastPivotHighs) - 1)
if array.size(pastPivotLows) > 0
    nearestPivotLow := array.get(pastPivotLows, array.size(pastPivotLows) - 1)
if array.size(pastPivotHighBars) > 0
    nearestPivotBar := array.get(pastPivotHighBars, array.size(pastPivotHighBars) - 1)
if array.size(pastPivotLowBars) > 0
    int lowBar = array.get(pastPivotLowBars, array.size(pastPivotLowBars) - 1)
    nearestPivotBar := na(nearestPivotBar) or lowBar > nearestPivotBar ? lowBar : nearestPivotBar

trendFromPivots = "NEUTRAL"
pivotStrength = 0.0

if not na(nearestPivotHigh) and not na(nearestPivotLow)
    if nearestPivotHigh > nearestPivotLow and bar_index - nearestPivotBar < pivotLookback
        trendFromPivots := "BEARISH"
        pivotStrength := (nearestPivotHigh - nearestPivotLow) / nearestPivotLow * 100
    else if nearestPivotLow > nearestPivotHigh and bar_index - nearestPivotBar < pivotLookback
        trendFromPivots := "BULLISH"
        pivotStrength := (nearestPivotLow - nearestPivotHigh) / nearestPivotHigh * 100

//==================== CURRENT CANDLE PREDICTION (FROM PIVOTS) ====================
var float supportLevel = na
var float resistanceLevel = na

if array.size(pastPivotLows) >= 3
    lastLows = array.new_float()
    for i = 0 to 2
        array.push(lastLows, array.get(pastPivotLows, array.size(pastPivotLows) - 1 - i))
    supportLevel := array.avg(lastLows)
    
if array.size(pastPivotHighs) >= 3
    lastHighs = array.new_float()
    for i = 0 to 2
        array.push(lastHighs, array.get(pastPivotHighs, array.size(pastPivotHighs) - 1 - i))
    resistanceLevel := array.avg(lastHighs)

pivot_prediction = ""
pivot_confidence = 50

if not na(supportLevel) and close <= supportLevel * 1.002
    pivot_prediction := "BUY 🔵"
    pivot_confidence := 75
    if close < supportLevel
        pivot_confidence := 85
else if not na(resistanceLevel) and close >= resistanceLevel * 0.998
    pivot_prediction := "SELL 🔴"
    pivot_confidence := 75
    if close > resistanceLevel
        pivot_confidence := 85

//==================== ACCUMULATION & REJECTION ZONES ====================
accumulation_detected = false
if detect_accumulation
    avg_range = 0.0
    for i = 0 to accumulation_bars - 1
        avg_range += (high[i] - low[i])
    avg_range := avg_range / accumulation_bars
    avg_vol = 0.0
    for i = 0 to accumulation_bars - 1
        avg_vol += volume[i]
    avg_vol := avg_vol / accumulation_bars
    if avg_range < accumulation_range_threshold and volume > avg_vol * accumulation_volume_multiplier
        accumulation_detected := true

rejection_detected = false
if detect_rejection
    upper_wick_ratio = candle_range_adv > 0 ? upper_wick / candle_range_adv : 0
    lower_wick_ratio = candle_range_adv > 0 ? lower_wick / candle_range_adv : 0
    if upper_wick_ratio > rejection_wick_ratio or lower_wick_ratio > rejection_wick_ratio
        rejection_detected := true

//==================== DISPLAY - WYCKOFF & ADVANCED SIGNALS ====================
// Apply visibility to advanced signals
plotshape(show_c_signals and (C1_signal or C2_signal), "C1-C2 Buy", location=location.belowbar, style=shape.labelup, color=colorBuySignal, size=size.tiny, text="BUY", textcolor=color.white)
plotshape(show_c_signals and (C3_signal or C4_signal), "C3-C4 Sell", location=location.abovebar, style=shape.labeldown, color=colorSellSignal, size=size.tiny, text="SELL", textcolor=color.white)
plotshape(show_wolfe_signals and WOLFE_bullish, "Wolfe Bullish", location=location.belowbar, style=shape.triangleup, color=colorWolfeBull, size=size.small, text="W↑")
plotshape(show_wolfe_signals and WOLFE_bearish, "Wolfe Bearish", location=location.abovebar, style=shape.triangledown, color=colorWolfeBear, size=size.small, text="W↓")
plotshape(show_golden_wicks_visibility and show_golden_wicks and bullish_wick_signal, "Golden Wick Bull", location=location.belowbar, style=shape.diamond, color=color.new(#00ff00, 0), size=size.tiny)
plotshape(show_golden_wicks_visibility and show_golden_wicks and bearish_wick_signal, "Golden Wick Bear", location=location.abovebar, style=shape.diamond, color=color.new(#ff0000, 0), size=size.tiny)

var box accBox = na
if detect_accumulation and accumulation_detected and show_accumulation_zones and barstate.isconfirmed and not accumulation_detected[1]
    accBox := box.new(bar_index - accumulation_bars, high, bar_index, low, bgcolor=accumulation_color, border_color=color.new(color.blue, 70))
var box rejBox = na
if detect_rejection and rejection_detected and show_rejection_zones and barstate.isconfirmed and not rejection_detected[1]
    rejBox := box.new(bar_index - 1, high, bar_index, low, bgcolor=rejection_color, border_color=color.new(color.red, 70))

var line tp1Ln = na
var line tp2Ln = na
var line tp3Ln = na
var line slLn = na
var label advPredLbl = na
bool showAdvPred = show_prediction and show_prediction_lines and final_confidence >= min_confidence and signal_type_adv != "محايد"
if barstate.islast
    line.delete(tp1Ln)
    line.delete(tp2Ln)
    line.delete(tp3Ln)
    line.delete(slLn)
    label.delete(advPredLbl)
    if showAdvPred
        if show_tp1 and (lines_display_mode == "All" or lines_display_mode == "TP Only" or lines_display_mode == "TP Yellow Only")
            tp1Ln := line.new(bar_index, tp1_adv, bar_index + 1, tp1_adv, extend=extend.right, color=color.new(#ffff00, 60), width=2)
        if show_tp2 and (lines_display_mode == "All" or lines_display_mode == "TP Only" or lines_display_mode == "TP Green Only")
            tp2Ln := line.new(bar_index, tp2_adv, bar_index + 1, tp2_adv, extend=extend.right, color=color.new(#00ff88, 60), width=2)
        if show_tp3 and (lines_display_mode == "All" or lines_display_mode == "TP Only" or lines_display_mode == "TP Green Only")
            tp3Ln := line.new(bar_index, tp3_adv, bar_index + 1, tp3_adv, extend=extend.right, color=color.new(#00ff00, 60), width=2)
        if show_sl and (lines_display_mode == "All" or lines_display_mode == "SL Only")
            slLn := line.new(bar_index, sl_adv, bar_index + 1, sl_adv, extend=extend.right, color=color.new(#ff0000, 60), width=2)
        label_color = signal_type_adv == "شراء 🟢" ? color.new(#00ff00, 20) : color.new(#ff0000, 20)
        lbl_txt = signal_type_adv + "\n" + str.tostring(final_confidence, "#.#") + "%\nTP1: " + str.tostring(tp1_adv, "#.##") + "\nTP2: " + str.tostring(tp2_adv, "#.##") + "\nTP3: " + str.tostring(tp3_adv, "#.##") + "\nSL: " + str.tostring(sl_adv, "#.##")
        offset_y = atr * 2.0
        lbl_y = signal_type_adv == "شراء 🟢" ? low - offset_y : high + offset_y
        advPredLbl := label.new(bar_index, lbl_y, lbl_txt, style=signal_type_adv == "شراء 🟢" ? label.style_label_up : label.style_label_down, color=label_color, textcolor=color.white, size=size.small)

var array<line> pivotHighLns = array.new<line>()
var array<line> pivotLowLns = array.new<line>()
var label pivotPredLbl = na
if barstate.islast
    while array.size(pivotHighLns) > 0
        line.delete(array.shift(pivotHighLns))
    while array.size(pivotLowLns) > 0
        line.delete(array.shift(pivotLowLns))
    label.delete(pivotPredLbl)
    if show_pivot_lines_visibility
        if array.size(pastPivotHighs) > 0
            int maxHighs = math.min(4, array.size(pastPivotHighs) - 1)
            for i = 0 to maxHighs
                float pivotVal = array.get(pastPivotHighs, array.size(pastPivotHighs) - 1 - i)
                int pivotBar = array.get(pastPivotHighBars, array.size(pastPivotHighBars) - 1 - i)
                if bar_index - pivotBar <= pivotLookback
                    array.push(pivotHighLns, line.new(pivotBar, pivotVal, bar_index, pivotVal, extend=extend.right, color=color.new(#ff4444, 70), width=2, style=line.style_dotted))
        if array.size(pastPivotLows) > 0
            int maxLows = math.min(4, array.size(pastPivotLows) - 1)
            for i = 0 to maxLows
                float pivotVal = array.get(pastPivotLows, array.size(pastPivotLows) - 1 - i)
                int pivotBar = array.get(pastPivotLowBars, array.size(pastPivotLowBars) - 1 - i)
                if bar_index - pivotBar <= pivotLookback
                    array.push(pivotLowLns, line.new(pivotBar, pivotVal, bar_index, pivotVal, extend=extend.right, color=color.new(#44ff44, 70), width=2, style=line.style_dotted))
        if pivot_prediction == "BUY 🔵"
            pivotPredLbl := label.new(bar_index, low, pivot_prediction + "\n" + str.tostring(pivot_confidence) + "%", color=color.new(#00ff00, 70), textcolor=color.white, style=label.style_label_up)
        if pivot_prediction == "SELL 🔴"
            pivotPredLbl := label.new(bar_index, high, pivot_prediction + "\n" + str.tostring(pivot_confidence) + "%", color=color.new(#ff0000, 70), textcolor=color.white, style=label.style_label_down)

//==================== STATISTICS TABLES ====================
// Advanced Analysis Table - Now controlled by show_analysis_tables
if show_analysis_table and show_analysis_tables and barstate.islast
    var table stats = table.new(position.top_left, 2, 12, bgcolor=color.new(#000000, 50))
    table.cell(stats, 0, 0, "📊 التحليل المتقدم", bgcolor=#1a1a1a, text_color=#ffcc00, text_size=size.large)
    table.cell(stats, 1, 0, "القيمة", bgcolor=#1a1a1a, text_color=#ffcc00, text_size=size.large)
    
    table.cell(stats, 0, 1, "الإشارة", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(stats, 1, 1, signal_type_adv, bgcolor=#0a0a0a, text_color=#ffffff, text_size=size.large)
    
    table.cell(stats, 0, 2, "الثقة", bgcolor=#0a0a0a, text_color=color.gray)
    conf_color = final_confidence >= 80 ? #00ff00 : final_confidence >= 70 ? #88ff00 : #ffaa00
    table.cell(stats, 1, 2, str.tostring(final_confidence, "#.#") + "%", bgcolor=#0a0a0a, text_color=conf_color)
    
    table.cell(stats, 0, 3, "الإشارات", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(stats, 1, 3, "↑" + str.tostring(bullish_signals) + " | ↓" + str.tostring(bearish_signals), bgcolor=#0a0a0a, text_color=#00aaff)
    
    table.cell(stats, 0, 4, "مطابقات تاريخية", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(stats, 1, 4, "↑" + str.tostring(match_count_bull) + " | ↓" + str.tostring(match_count_bear), bgcolor=#0a0a0a, text_color=#00aaff)
    
    table.cell(stats, 0, 5, "قوة الاتجاه", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(stats, 1, 5, str.tostring(trend_strength, "#.##") + "%", bgcolor=#0a0a0a, text_color=#00aaff)
    
    table.cell(stats, 0, 6, "RSI", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(stats, 1, 6, str.tostring(rsi_adv, "#.#"), bgcolor=#0a0a0a, text_color=#00aaff)
    
    table.cell(stats, 0, 7, "TP1/SL", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(stats, 1, 7, str.tostring(tp1_percent, "#.#") + "% / " + str.tostring(stop_loss_percent, "#.#") + "%", bgcolor=#0a0a0a, text_color=#ffff00)
    
    table.cell(stats, 0, 8, "Wyckoff", bgcolor=#0a0a0a, text_color=color.gray)
    wyckoff_status = bull ? "تراكم" : bear ? "توزيع" : "جانبي"
    table.cell(stats, 1, 8, wyckoff_status, bgcolor=#0a0a0a, text_color=#ffaa00)
    
    table.cell(stats, 0, 9, "نموذج وولف", bgcolor=#0a0a0a, text_color=color.gray)
    wolfe_status = WOLFE_bullish ? "صاعد" : WOLFE_bearish ? "هابط" : "لا يوجد"
    table.cell(stats, 1, 9, wolfe_status, bgcolor=#0a0a0a, text_color=#ffaa00)
    
    table.cell(stats, 0, 10, "منطقة تجميع", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(stats, 1, 10, accumulation_detected ? "نعم" : "لا", bgcolor=#0a0a0a, text_color=#00ff00)
    
    table.cell(stats, 0, 11, "منطقة خداع", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(stats, 1, 11, rejection_detected ? "نعم" : "لا", bgcolor=#0a0a0a, text_color=#ff6600)

// Pivot Predictor Table - Now controlled by show_analysis_tables
var table predTable = table.new(position.top_right, 2, 6, bgcolor=color.new(#000000, 80))
if show_analysis_tables and barstate.islast
    table.set_position(predTable, position.bottom_left)
    
    table.cell(predTable, 0, 0, "🔮 PIVOT PREDICTOR", bgcolor=#1a1a1a, text_color=#ffcc00, text_size=size.large)
    table.cell(predTable, 1, 0, "القيمة", bgcolor=#1a1a1a, text_color=#ffcc00, text_size=size.large)
    
    table.cell(predTable, 0, 1, "التوقع", bgcolor=#0a0a0a, text_color=color.gray)
    predColor = pivot_prediction == "BUY 🔵" ? #00ff00 : pivot_prediction == "SELL 🔴" ? #ff0000 : #ffffff
    table.cell(predTable, 1, 1, pivot_prediction != "" ? pivot_prediction : "انتظار", bgcolor=#0a0a0a, text_color=predColor)
    
    table.cell(predTable, 0, 2, "الثقة", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(predTable, 1, 2, str.tostring(pivot_confidence) + "%", bgcolor=#0a0a0a, text_color=#ffff00)
    
    table.cell(predTable, 0, 3, "اتجاه البيفوت", bgcolor=#0a0a0a, text_color=color.gray)
    trendColor = trendFromPivots == "BULLISH" ? #00ff00 : trendFromPivots == "BEARISH" ? #ff0000 : #ffffff
    table.cell(predTable, 1, 3, trendFromPivots, bgcolor=#0a0a0a, text_color=trendColor)
    
    table.cell(predTable, 0, 4, "الدعم", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(predTable, 1, 4, not na(supportLevel) ? str.tostring(supportLevel, "#.####") : "---", bgcolor=#0a0a0a, text_color=#44ff44)
    
    table.cell(predTable, 0, 5, "المقاومة", bgcolor=#0a0a0a, text_color=color.gray)
    table.cell(predTable, 1, 5, not na(resistanceLevel) ? str.tostring(resistanceLevel, "#.####") : "---", bgcolor=#0a0a0a, text_color=#ff4444)

//==================== ALERTS ====================
if signal_type_adv == "شراء 🟢" and final_confidence >= min_confidence and barstate.isconfirmed
    alert("🟢 إشارة شراء قوية!\nالثقة: " + str.tostring(final_confidence, "#.#") + "%", alert.freq_once_per_bar)

if signal_type_adv == "بيع 🔴" and final_confidence >= min_confidence and barstate.isconfirmed
    alert("🔴 إشارة بيع قوية!\nالثقة: " + str.tostring(final_confidence, "#.#") + "%", alert.freq_once_per_bar)

alertcondition(signal_type_adv == "شراء 🟢" and final_confidence >= min_confidence, "🟢 شراء قوي", "شراء")
alertcondition(signal_type_adv == "بيع 🔴" and final_confidence >= min_confidence, "🔴 بيع قوي", "بيع")
alertcondition(pivot_prediction == "BUY 🔵" and pivot_confidence >= 75, "شراء من دعم بيفوت", "Buy Signal")
alertcondition(pivot_prediction == "SELL 🔴" and pivot_confidence >= 75, "بيع من مقاومة بيفوت", "Sell Signal")

//==================== PLOTS (hidden) ====================
plot(final_confidence, "Confidence Score", display=display.none)

//====================================================================================
// 📋 SECTION 3: STOCHASTIC MTF (FIXED - BGCOLOR ERRORS RESOLVED)
//====================================================================================

stochGroup = "📊 Stochastic MTF Settings"

stochLen = input.int(14, minval=1, title="Length for Main Stochastic", group=stochGroup) 
smoothK = input.int(3, minval=1, title="SmoothK for Main Stochastic", group=stochGroup)
smoothD = input.int(3, minval=1, title="SmoothD for Main Stochastic", group=stochGroup)
upLine = input.int(80, minval=50, maxval=90, title="Upper Line Value?", group=stochGroup)
lowLine = input.int(20, minval=10, maxval=50, title="Lower Line Value?", group=stochGroup)
sml = input.bool(true, title="Show Mid Line?", group=stochGroup)
sbh = input.bool(false, title="Show Back Ground Highlights When Stoch is Above/Below High/Low Lines?", group=stochGroup)
sch = input.bool(true, title="Show Back Ground Highlights When Stoch Cross - Strict Criteria - K Greater/LesThan High/Low Line - Crosses D ?", group=stochGroup)
sl = input.bool(true, title="Show 'B' and 'S' Letters When Stoch Crosses High/Low Line & D?", group=stochGroup)
sac = input.bool(false, title="Show Back Ground Highlights When Stoch Cross - Any Cross?", group=stochGroup)
sacl = input.bool(false, title="Show 'B' and 'S' Letters When Stoch Crosses - Any Cross?", group=stochGroup)
useCurrentRes = input.bool(true, title="Use Current Chart Resolution?", group=stochGroup)
resCustom = input.string("60", title="Use Different Timeframe? Uncheck Box Above", group=stochGroup)
ssStoch = input.bool(false, title="Show 2nd Stoch?", group=stochGroup)
resCustom2 = input.string("1D", title="Use 2nd Stoch? Check Box Above", group=stochGroup)
useCurrentRes2 = input.bool(false, title="Use 2nd Stoch Plot On Same Timeframe?", group=stochGroup)
stochLen2 = input.int(14, minval=1, title="2nd Stoch Length", group=stochGroup)
smoothK2 = input.int(3, minval=1, title="SmoothK for 2nd Stoch", group=stochGroup)
smoothD2 = input.int(3, minval=1, title="SmoothD for 2nd Stoch", group=stochGroup)

normalizeTF(string tf) =>
    tf == "D" or tf == "d" ? "1D" : tf == "W" or tf == "w" ? "1W" : tf == "M" or tf == "m" ? "1M" : tf

stochMain() =>
    float kk = ta.sma(ta.stoch(close, high, low, stochLen), smoothK)
    float dd = ta.sma(kk, smoothD)
    [kk, dd]

stochSecond() =>
    float kk = ta.sma(ta.stoch(close, high, low, stochLen2), smoothK2)
    float dd = ta.sma(kk, smoothD2)
    [kk, dd]

string res = useCurrentRes ? timeframe.period : normalizeTF(resCustom)
string res2 = useCurrentRes2 ? timeframe.period : normalizeTF(resCustom2)

[outK, outD] = request.security(syminfo.tickerid, res, stochMain())
[outK2, outD2] = request.security(syminfo.tickerid, res2, stochSecond())

aboveLine = outK > upLine
belowLine = outK < lowLine
crossUp = (outK[1] < outD[1] and outK[1] < lowLine) and (outK > outD)
crossDn = (outK[1] > outD[1] and outK[1] > upLine) and (outK < outD)
crossUpAll = (outK[1] < outD[1] and outK > outD)
crossDownAll = (outK[1] > outD[1] and outK < outD)

bgcolor(show_stochastic_bg and sbh and aboveLine ? color.new(color.red, 70) : na)
bgcolor(show_stochastic_bg and sbh and belowLine ? color.new(color.lime, 70) : na)
bgcolor(show_stochastic_bg and sch and crossUp ? color.new(color.lime, 40) : na)
bgcolor(show_stochastic_bg and sch and crossDn ? color.new(color.red, 40) : na)
bgcolor(show_stochastic_bg and sac and crossUpAll ? color.new(color.lime, 40) : na)
bgcolor(show_stochastic_bg and sac and crossDownAll ? color.new(color.red, 40) : na)

plot(show_stochastic_lines ? outK : na, title="Stoch K", style=plot.style_line, linewidth=2, color=color.new(color.lime, 0), display=display.data_window)
plot(show_stochastic_lines ? outD : na, title="Stoch D", style=plot.style_line, linewidth=2, color=color.new(color.red, 0), display=display.data_window)
plot(ssStoch and show_stochastic_lines ? outK2 : na, title="2nd Stoch K - Different TimeFrame", style=plot.style_line, linewidth=2, color=color.new(color.orange, 0), display=display.data_window)
plot(ssStoch and show_stochastic_lines ? outD2 : na, title="2nd Stoch D - Different TimeFrame", style=plot.style_line, linewidth=2, color=color.new(color.yellow, 0), display=display.data_window)
plot(show_stochastic_lines ? upLine : na, title="Upper Line", style=plot.style_line, linewidth=1, color=color.new(color.red, 0), display=display.data_window)
plot(show_stochastic_lines ? lowLine : na, title="Lower Line", style=plot.style_line, linewidth=1, color=color.new(color.lime, 0), display=display.data_window)
plot(sml and show_stochastic_lines ? 50 : na, title="Mid Line", style=plot.style_linebr, linewidth=1, color=color.new(color.gray, 0), display=display.data_window)

plotchar(show_stochastic_crosses and sl and crossUp, title="Buy Signal Strict Criteria", char='B', location=location.bottom, color=color.new(color.lime, 0), offset=0)
plotchar(show_stochastic_crosses and sl and crossDn, title="Sell Signal Strict Criteria", char='S', location=location.top, color=color.new(color.red, 0), offset=0)
plotchar(show_stochastic_crosses and sacl and crossUpAll, title="Buy Signal Any Cross Up", char='B', location=location.bottom, color=color.new(color.lime, 0), offset=0)
plotchar(show_stochastic_crosses and sacl and crossDownAll, title="Sell Signal Any Cross Down", char='S', location=location.top, color=color.new(color.red, 0), offset=0)
