f_ruleRow(table tbl, int row, string name, bool on) =>
    table.cell(tbl, 0, row, name, text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, row, on ? "✅" : "·", text_color=on ? color.lime : color.gray, text_size=size.tiny)

if showRuleTable and barstate.islast
    var table t = table.new(position.top_right, 2, 30, bgcolor=color.new(#0d1117, 20), border_width=1, border_color=color.gray)
    table.cell(t, 0, 0, "RULE", text_color=color.white, bgcolor=color.new(#161b22, 0))
    table.cell(t, 1, 0, "ON", text_color=color.white, bgcolor=color.new(#161b22, 0))
    f_ruleRow(t, 1, "R1", rule1)
    f_ruleRow(t, 2, "R2", rule2)
    f_ruleRow(t, 3, "R3", rule3)
    f_ruleRow(t, 4, "R4", rule4)
    f_ruleRow(t, 5, "R5", rule5)
    f_ruleRow(t, 6, "R6", rule6)
    f_ruleRow(t, 7, "R7", rule7)
    f_ruleRow(t, 8, "R8", rule8)
    f_ruleRow(t, 9, "R9", rule9)
    f_ruleRow(t, 10, "R10", rule10)
    f_ruleRow(t, 11, "R11", rule11)
    f_ruleRow(t, 12, "R12", rule12)
    f_ruleRow(t, 13, "R13", rule13)
    f_ruleRow(t, 14, "R14", rule14)
    f_ruleRow(t, 15, "R15", rule15)
    f_ruleRow(t, 16, "R16", rule16)
    f_ruleRow(t, 17, "R19", rule19)
    f_ruleRow(t, 18, "R20", rule20)
    f_ruleRow(t, 19, "R21", rule21)
    f_ruleRow(t, 20, "R22", rule22)
    f_ruleRow(t, 21, "R23", rule23)
    f_ruleRow(t, 22, "R25", rule25)
    f_ruleRow(t, 23, "R27", rule27)
    f_ruleRow(t, 24, "R28", rule28)
    f_ruleRow(t, 25, "R29", rule29)
    f_ruleRow(t, 26, "R30", rule30)
    f_ruleRow(t, 27, "R31", rule31)
    f_ruleRow(t, 28, "R32", rule32)
    table.cell(t, 0, 29, singleRuleMode ? "MODE:1" : "MODE:ALL", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 29, singleRuleMode ? str.tostring(singleRuleNum) : "ALL", text_color=color.gray, text_size=size.tiny)

