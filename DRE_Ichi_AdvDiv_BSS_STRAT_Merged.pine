slAnchorInput      = input.string("Structure", "SL Anchor", options = ["Trigger Level", "Setup Bar", "Wick-Anchored", "ATR", "Structure"], group = GRP_RSK)
slMultInput        = input.float(1.5, "SL Multiplier (xATR)", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_RSK)
slBufferInput      = input.float(0.25, "SL Buffer (xATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_RSK)
maxRiskAtrInput    = input.float(3.0, "Max Risk (xATR)", minval = 0.0, maxval = 10.0, step = 0.5, group = GRP_RSK)
tp1MultInput       = input.float(1.0, "TP1 (xRisk)", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_RSK)
tp2MultInput       = input.float(2.0, "TP2 (xRisk)", minval = 1.0, maxval = 10.0, step = 0.1, group = GRP_RSK)
tp3MultInput       = input.float(3.5, "TP3 (xRisk)", minval = 1.5, maxval = 15.0, step = 0.1, group = GRP_RSK)
