beInput            = input.bool(true, "Break-Even After TP1", group = GRP_RSK)
useTrailInput      = input.bool(true, "Smart Chandelier Trailing", group = GRP_RSK)
trailAtrMultInput  = input.float(2.5, "Trail ATR Multiplier", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_RSK)
