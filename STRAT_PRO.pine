// 3. THEME & COLORS
// ══════════════════════════════════════════════════════════
float bgLum  = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
bool  isDark = themeInput == "Dark" or (themeInput == "Auto" and bgLum < 128.0)

color BULL      = isDark ? #00E676 : #00A152
color BEAR      = isDark ? #FF5252 : #D32F2F
color C_INSIDE  = isDark ? #FFD54F : #C77800
color C_OUTSIDE = isDark ? #E040FB : #8E24AA
color C_TEXT    = isDark ? #ECEFF1 : #263238
color C_MUTED   = color.new(C_TEXT, 45)
color HEADER_BG = isDark ? #1E222D : #E8EAED
color PANEL_BG  = isDark ? color.new(#131722, 20) : color.new(#FFFFFF, 20)

color SL_COLOR       = isDark ? color.new(#E57373, 0)  : color.new(#B71C1C, 0)
color TP1_COLOR      = isDark ? color.new(#66BB6A, 30) : color.new(#388E3C, 30)
color TP2_COLOR      = isDark ? color.new(#66BB6A, 40) : color.new(#388E3C, 40)
color TP3_COLOR      = isDark ? color.new(#66BB6A, 0)  : color.new(#388E3C, 0)
color ENTRY_COLOR    = isDark ? color.new(#5C8AAE, 0)  : color.new(#34495E, 0)
color TP_LABEL_COLOR = isDark ? color.new(#66BB6A, 0)  : color.new(#388E3C, 0)
color TP_HIT_COLOR   = isDark ? color.new(#4DB6AC, 0)  : color.new(#00695C, 0)
color BE_COLOR       = isDark ? color.new(#FFA726, 0)  : color.new(#E65100, 0)
color LABEL_TEXT     = isDark ? #1A1A1A                : #FFFFFF
color TABLE_ROW_ALT  = isDark ? color.new(#1C2030, 0)  : color.new(#F0F4F8, 0)
color HEADER_TEXT    = #FFFFFF
color HEADER_BG_BULL = color.new(#0F6E56, 0)
color HEADER_BG_BEAR = color.new(#A32D2D, 0)

color BOS_BULL_COLOR = isDark ? color.new(#00BCD4, 0) : color.new(#00838F, 0)
color BOS_BEAR_COLOR = isDark ? color.new(#FF9800, 0) : color.new(#E65100, 0)
color FVG_BULL_COLOR = isDark ? color.new(#00E676, 60) : color.new(#00A152, 60)
color FVG_BEAR_COLOR = isDark ? color.new(#FF5252, 60) : color.new(#D32F2F, 60)
color OB_BULL_COLOR  = isDark ? color.new(#2196F3, 70) : color.new(#1565C0, 70)
color OB_BEAR_COLOR  = isDark ? color.new(#F44336, 70) : color.new(#C62828, 70)
color LIQ_COLOR      = isDark ? color.new(#FFEB3B, 0)  : color.new(#F57F17, 0)
color KZ_BG          = isDark ? color.new(#FFD54F, 92) : color.new(#FFF8E1, 70)
color EMA21_C        = isDark ? #42A5F5 : #1565C0
color EMA50_C        = isDark ? #FFA726 : #EF6C00
color EMA200_C       = isDark ? #AB47BC : #6A1B9A

bool  isMore   = signalProfileInput == "More Signals"
bool  isStrict = signalProfileInput == "Strict"
float effMinConf = isMore ? 28.0 : isStrict ? 50.0 : float(minConfScoreInput)
bool  effUsePvte = isStrict or (not isMore and usePvteInput)
bool  effNeedStruct = isStrict or (not isMore and requireStructureInput)

// ══════════════════════════════════════════════════════════
// 4. UTILITY FUNCTIONS  (all UDFs before first use)
// ══════════════════════════════════════════════════════════
seqGet(array<int> s, int back) =>
    s.get(s.size() - 1 - back)

clsName(int c) =>
    c == 1 ? "1" : c == 3 ? "3" : c == 2 ? "2U" : c == -2 ? "2D" : "·"

clsColor(int c) =>
    c == 1 ? C_INSIDE : c == 3 ? C_OUTSIDE : c == 2 ? BULL : c == -2 ? BEAR : na

addPat(matrix<int> m, array<string> nm, int grp, int dir, string name, int plen, int t0, int t1, int t2, int t3) =>
    m.add_row(m.rows(), array.from(grp, dir, plen, t0, t1, t2, t3))
    nm.push(name)

buildFtc(array<bool> v, array<bool> g, array<string> lbl) =>
    string s = ""
    for i = 0 to 7
        if v.get(i)
            s += lbl.get(i) + (g.get(i) ? "+" : "-")
    s

fireAlert(string action, string pat, float trig, float stp, string ftc) =>
    if enableAlertsInput
        string msg = ""
        if alertFmtInput == "JSON"
            msg := '{"ind":"' + JSON_IND + '","v":"' + VERSION + '","sym":"' + syminfo.ticker +
                 '","tf":"' + timeframe.period + '","action":"' + action + '","pattern":"' + pat +
                 '","price":' + str.tostring(close) + ',"trig":' + str.tostring(trig) +
                 ',"stop":' + str.tostring(stp) + ',"ftc":"' + ftc + '"}'
        else
            msg := "STRAT PRO " + str.upper(action) + " " + pat + " " + syminfo.ticker + " " + timeframe.period +
                 " @ " + str.tostring(close, format.mintick) +
                 " | trig " + str.tostring(trig, format.mintick) +
                 " stop " + str.tostring(stp, format.mintick) + " | FTC " + ftc
        alert(msg, alert.freq_once_per_bar)

fireTradeAlert(string action, string jsonFields, string textFields, string ftc) =>
    if enableAlertsInput
        string msg = ""
        if alertFmtInput == "JSON"
            msg := '{"ind":"' + JSON_IND + '","v":"' + VERSION + '","sym":"' + syminfo.ticker +
                 '","tf":"' + timeframe.period + '","action":"' + action + '"' + jsonFields +
                 ',"ftc":"' + ftc + '"}'
        else
            msg := "STRAT PRO " + str.upper(action) + " " + syminfo.ticker + " " + timeframe.period +
                 textFields + " | FTC " + ftc
        alert(msg, alert.freq_once_per_bar)

lineStyleFromString(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

sizeFromString(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : s == "Huge" ? size.huge : size.small

fmtPrice(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

safeDiv(float num, float den, float fallback) =>
    den != 0 and not na(num) and not na(den) ? num / den : fallback

kamaCalc(float src, int len) =>
    float fastSC = 2.0 / 3.0
    float slowSC = 2.0 / 31.0
    float mom    = math.abs(ta.change(src, len))
    float noise  = math.sum(math.abs(ta.change(src)), len)
    float er     = safeDiv(mom, noise, 0.0)
    float sc     = math.pow(er * (fastSC - slowSC) + slowSC, 2.0)
    var float k  = na
    k := na(k[1]) ? src : k[1] + nz(sc) * (src - k[1])
    k

sizeDownFromString(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.tiny : s == "Normal" ? size.small : s == "Large" ? size.normal : s == "Huge" ? size.large : size.tiny

buildGauge(float value, float maxVal, int width) =>
    string result = ""
    int filled = maxVal <= 0 ? 0 : int(math.round(math.min(width, math.max(0.0, value / maxVal * width))))
    for i = 0 to width - 1
        result += i < filled ? "▰" : "▱"
    result

periodStats(array<int> tms, array<bool> wns, int cutoff) =>
    int w = 0
    int l = 0
    int n = array.size(tms)
    if n > 0
        for i = 0 to n - 1
            if array.get(tms, i) >= cutoff
                if array.get(wns, i)
                    w += 1
                else
                    l += 1
    [w, l]

formatPctFromEntry(float level, float entry) =>
    string res = ""
    if showPctOnLabelsInput and not na(level) and not na(entry) and entry != 0
        float pct   = (level - entry) / entry * 100.0
        string sign = pct >= 0 ? "+" : ""
        res := " (" + sign + str.tostring(pct, "#.##") + "%)"
    res

levelLine(bool show, float px, int startBar, string tag, color col) =>
    var line  ln = na
    var label lb = na
    if show and not na(px) and barstate.islast
        if na(ln)
            ln := line.new(startBar, px, bar_index, px, extend = extend.right, style = line.style_dashed, color = col, width = 1)
            lb := label.new(bar_index, px, "", style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small)
        line.set_xy1(ln, startBar, px)
        line.set_xy2(ln, bar_index, px)
        label.set_xy(lb, bar_index, px)
        label.set_text(lb, tag + " " + str.tostring(px, format.mintick))
    if not show and not na(ln)
        line.delete(ln)
        label.delete(lb)
        ln := na
        lb := na

pushBoxCap(array<box> boxes, box b, int cap) =>
    boxes.push(b)
    while boxes.size() > cap
        box.delete(boxes.shift())
    true

pushLblCap(array<label> arr, label lb, int cap) =>
    arr.push(lb)
    while arr.size() > cap
        label.delete(arr.shift())
    true

// ══════════════════════════════════════════════════════════
// 5. CORE CALCULATIONS  (ta.* unconditional)
// ══════════════════════════════════════════════════════════
bool insideNow  = bar_index > 0 and high <= high[1] and low >= low[1]
bool outsideNow = bar_index > 0 and high >  high[1] and low <  low[1]
int  clsNow     = bar_index == 0 ? 0 : insideNow ? 1 : outsideNow ? 3 : high > high[1] ? 2 : -2

float rng    = high - low
float upWick = high - math.max(open, close)
float dnWick = math.min(open, close) - low
bool hammerNow  = rng > 0 and dnWick >= rng * wickPctInput and clsNow != 1
bool shooterNow = rng > 0 and upWick >= rng * wickPctInput and clsNow != 1

float riskAtr   = nz(ta.atr(atrLenRiskInput), 0.0)
bool  hasVolume = nz(volume, 0) > 0
float volSma    = nz(ta.sma(volume, volLookbackInput), 0.0)

entryLineStyle  = lineStyleFromString(entryLineStyleInput)
slLineStyle     = lineStyleFromString(slLineStyleInput)
tpLineStyle     = lineStyleFromString(tpLineStyleInput)
slTpLabelSize   = sizeFromString(labelFontSizeInput)
signalSize      = sizeFromString(signalSizeInput)
dashFontSize    = sizeFromString(dashSizeInput)
dashFontSizeSub = sizeDownFromString(dashSizeInput)
dashPos = dashPosInput == "Top Left" ? position.top_left : dashPosInput == "Bottom Left" ? position.bottom_left : dashPosInput == "Bottom Right" ? position.bottom_right : position.top_right

[effSlMult, effTp1m, effTp2m, effTp3m] = switch riskPresetInput
    "Conservative" => [2.5, 1.0, 2.0, 4.0]
    "Aggressive"   => [1.0, 1.5, 2.5, 4.0]
    "Scalping"     => [0.8, 0.8, 1.5, 2.0]
    "Custom"       => [slMultInput, tp1MultInput, tp2MultInput, tp3MultInput]
    => [1.5, 1.0, 2.0, 3.0]

htf(string tf) =>
    request.security(syminfo.tickerid, tf, [open, close, high, low, high[1], low[1]])

[o15, c15, h15, l15, h15p, l15p]  = htf("15")
[o30, c30, h30, l30, h30p, l30p]  = htf("30")
[o60, c60, h60, l60, h60p, l60p]  = htf("60")
[o4h, c4h, h4h, l4h, h4hp, l4hp]  = htf("240")
[oD,  cD,  hD,  lD,  hDp,  lDp ]  = htf("D")
[oW,  cW,  hW,  lW,  hWp,  lWp ]  = htf("W")
[oM,  cM,  hM,  lM,  hMp,  lMp ]  = htf("M")
[oQ,  cQ,  hQ,  lQ,  hQp,  lQp ]  = htf("3M")

int chartSec = timeframe.in_seconds(timeframe.period)

array<bool> fV = array.from(
     chartSec < timeframe.in_seconds("15")  and not na(o15),
     chartSec < timeframe.in_seconds("30")  and not na(o30),
     chartSec < timeframe.in_seconds("60")  and not na(o60),
     chartSec < timeframe.in_seconds("240") and not na(o4h),
     chartSec < timeframe.in_seconds("D")   and not na(oD),
     chartSec < timeframe.in_seconds("W")   and not na(oW),
     chartSec < timeframe.in_seconds("M")   and not na(oM),
     chartSec < timeframe.in_seconds("3M")  and not na(oQ))
array<bool> fG = array.from(
     nz(o15) <= nz(c15), nz(o30) <= nz(c30), nz(o60) <= nz(c60), nz(o4h) <= nz(c4h),
     nz(oD) <= nz(cD), nz(oW) <= nz(cW), nz(oM) <= nz(cM), nz(oQ) <= nz(cQ))
array<bool> fI = array.from(
     nz(h15) <= nz(h15p) and nz(l15) >= nz(l15p), nz(h30) <= nz(h30p) and nz(l30) >= nz(l30p),
     nz(h60) <= nz(h60p) and nz(l60) >= nz(l60p), nz(h4h) <= nz(h4hp) and nz(l4h) >= nz(l4hp),
     nz(hD) <= nz(hDp) and nz(lD) >= nz(lDp), nz(hW) <= nz(hWp) and nz(lW) >= nz(lWp),
     nz(hM) <= nz(hMp) and nz(lM) >= nz(lMp), nz(hQ) <= nz(hQp) and nz(lQ) >= nz(lQp))
array<bool> fO = array.from(
     nz(h15) > nz(h15p) and nz(l15) < nz(l15p), nz(h30) > nz(h30p) and nz(l30) < nz(l30p),
     nz(h60) > nz(h60p) and nz(l60) < nz(l60p), nz(h4h) > nz(h4hp) and nz(l4h) < nz(l4hp),
     nz(hD) > nz(hDp) and nz(lD) < nz(lDp), nz(hW) > nz(hWp) and nz(lW) < nz(lWp),
     nz(hM) > nz(hMp) and nz(lM) < nz(lMp), nz(hQ) > nz(hQp) and nz(lQ) < nz(lQp))
var array<string> FTC_LBL = array.from("15", "30", "1H", "4H", "D", "W", "M", "Q")

int ftcVisible = 0
int ftcAlignedBull = 0
int ftcAlignedBear = 0
for i = 0 to 7
    if fV.get(i)
        ftcVisible += 1
        if fG.get(i)
            ftcAlignedBull += 1
        else
            ftcAlignedBear += 1

[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmH, pmL] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

bool newD = nz(ta.change(time("D"))) != 0
bool newW = nz(ta.change(time("W"))) != 0
bool newM = nz(ta.change(time("M"))) != 0
var int dStart = 0
var int wStart = 0
var int mStart = 0
if newD
    dStart := bar_index
if newW
    wStart := bar_index
if newM
    mStart := bar_index

// ══════════════════════════════════════════════════════════
// 6. SMC ENGINE
// ══════════════════════════════════════════════════════════
float swingHigh = ta.pivothigh(high, smcSwingLenInput, smcSwingLenInput)
float swingLow  = ta.pivotlow(low, smcSwingLenInput, smcSwingLenInput)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na

if not na(swingHigh)
    lastSwingHigh := swingHigh
    lastSwingHighBar := bar_index - smcSwingLenInput
if not na(swingLow)
    lastSwingLow := swingLow
    lastSwingLowBar := bar_index - smcSwingLenInput

var int   marketStructure = 0
var float structureLevel  = na

bool bullBreak = not na(lastSwingHigh) and close > lastSwingHigh
bool bearBreak = not na(lastSwingLow) and close < lastSwingLow
bool bullBOS   = bullBreak and marketStructure == 1
bool bearBOS   = bearBreak and marketStructure == -1
bool bullCHoCH = bullBreak and marketStructure != 1
bool bearCHoCH = bearBreak and marketStructure != -1

if barstate.isconfirmed
    if bullBOS or bullCHoCH
        marketStructure := 1
        structureLevel := lastSwingHigh
    if bearBOS or bearCHoCH
        marketStructure := -1
        structureLevel := lastSwingLow

// Standard 3-candle FVG: bull = current low above high[2]; bear = current high below low[2]
bool bullFVG_now = low > high[2]
bool bearFVG_now = high < low[2]

var array<float> fvgTop       = array.new<float>()
var array<float> fvgBottom    = array.new<float>()
var array<bool>  fvgBull      = array.new<bool>()
var array<bool>  fvgMitigated = array.new<bool>()
var array<int>   fvgBar       = array.new<int>()
var array<box>   fvgBoxes     = array.new<box>()

fvgFifoTrim() =>
    while fvgTop.size() > MAX_FVG
        fvgTop.shift()
        fvgBottom.shift()
        fvgBull.shift()
        fvgMitigated.shift()
        fvgBar.shift()
        if fvgBoxes.size() > 0
            box.delete(fvgBoxes.shift())
    true

if useSMCInput and barstate.isconfirmed
    if bullFVG_now
        fvgTop.push(low)
        fvgBottom.push(high[2])
        fvgBull.push(true)
        fvgMitigated.push(false)
        fvgBar.push(bar_index)
        if showFVGInput
            box bf = box.new(bar_index - 2, low, bar_index, high[2], bgcolor = color.new(FVG_BULL_COLOR, 75), border_color = color.new(FVG_BULL_COLOR, 50))
            fvgBoxes.push(bf)
        fvgFifoTrim()
    if bearFVG_now
        fvgTop.push(low[2])
        fvgBottom.push(high)
        fvgBull.push(false)
        fvgMitigated.push(false)
        fvgBar.push(bar_index)
        if showFVGInput
            box be = box.new(bar_index - 2, low[2], bar_index, high, bgcolor = color.new(FVG_BEAR_COLOR, 75), border_color = color.new(FVG_BEAR_COLOR, 50))
            fvgBoxes.push(be)
        fvgFifoTrim()

    int fvgN = fvgTop.size()
    if fvgN > 0
        for i = 0 to fvgN - 1
            if not fvgMitigated.get(i)
                bool isBullF = fvgBull.get(i)
                bool mitigatedF = isBullF ? low <= fvgBottom.get(i) : high >= fvgTop.get(i)
                if mitigatedF
                    fvgMitigated.set(i, true)
                    if fvgMitigationInput and i < fvgBoxes.size()
                        box.set_bgcolor(fvgBoxes.get(i), color.new(isBullF ? FVG_BULL_COLOR : FVG_BEAR_COLOR, 92))

if useSMCInput and showFVGInput and barstate.islast
    int fn = math.min(fvgBoxes.size(), fvgTop.size())
    if fn > 0
        for i = 0 to fn - 1
            if not fvgMitigated.get(i)
                box.set_right(fvgBoxes.get(i), bar_index)

var array<float> obTop       = array.new<float>()
var array<float> obBottom    = array.new<float>()
var array<bool>  obBull      = array.new<bool>()
var array<bool>  obMitigated = array.new<bool>()
var array<int>   obBar       = array.new<int>()
var array<box>   obBoxes     = array.new<box>()

obFifoTrim() =>
    while obTop.size() > MAX_OB
        obTop.shift()
        obBottom.shift()
        obBull.shift()
        obMitigated.shift()
        obBar.shift()
        if obBoxes.size() > 0
            box.delete(obBoxes.shift())
    true

if useSMCInput and barstate.isconfirmed and not na(swingLow)
    int lookbackL = smcSwingLenInput * 2 + 1
    for j = 1 to lookbackL
        if close[j] < open[j]
            obTop.push(high[j])
            obBottom.push(low[j])
            obBull.push(true)
            obMitigated.push(false)
            obBar.push(bar_index - j)
            if showOBInput
                box obl = box.new(bar_index - j, high[j], bar_index, low[j], bgcolor = color.new(OB_BULL_COLOR, 80), border_color = color.new(OB_BULL_COLOR, 60))
                obBoxes.push(obl)
            obFifoTrim()
            break

if useSMCInput and barstate.isconfirmed and not na(swingHigh)
    int lookbackH = smcSwingLenInput * 2 + 1
    for j = 1 to lookbackH
        if close[j] > open[j]
            obTop.push(high[j])
            obBottom.push(low[j])
            obBull.push(false)
            obMitigated.push(false)
            obBar.push(bar_index - j)
            if showOBInput
                box obh = box.new(bar_index - j, high[j], bar_index, low[j], bgcolor = color.new(OB_BEAR_COLOR, 80), border_color = color.new(OB_BEAR_COLOR, 60))
                obBoxes.push(obh)
            obFifoTrim()
            break

if useSMCInput and barstate.isconfirmed
    int obN = obTop.size()
    if obN > 0
        for i = 0 to obN - 1
            if not obMitigated.get(i)
                bool isBullO = obBull.get(i)
                bool mitigatedO = isBullO ? low <= obBottom.get(i) : high >= obTop.get(i)
                if mitigatedO
                    obMitigated.set(i, true)
                    if obMitigationInput and i < obBoxes.size()
                        box.set_bgcolor(obBoxes.get(i), color.new(isBullO ? OB_BULL_COLOR : OB_BEAR_COLOR, 92))

if useSMCInput and showOBInput and barstate.islast
    int on = math.min(obBoxes.size(), obTop.size())
    if on > 0
        for i = 0 to on - 1
            if not obMitigated.get(i)
                box.set_right(obBoxes.get(i), bar_index)

bool sweepHigh = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
bool sweepLow  = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow

var array<label> smcLblFifo = array.new<label>()
if useSMCInput and barstate.isconfirmed
    if showBOSInput and bullBOS
        pushLblCap(smcLblFifo, label.new(bar_index, low, "BOS ▲", style = label.style_label_up, color = color.new(BOS_BULL_COLOR, 80), textcolor = BOS_BULL_COLOR, size = size.small), MAX_SMC_LBL)
    if showBOSInput and bearBOS
        pushLblCap(smcLblFifo, label.new(bar_index, high, "BOS ▼", style = label.style_label_down, color = color.new(BOS_BEAR_COLOR, 80), textcolor = BOS_BEAR_COLOR, size = size.small), MAX_SMC_LBL)
    if showBOSInput and bullCHoCH
        pushLblCap(smcLblFifo, label.new(bar_index, low, "CHoCH ▲", style = label.style_label_up, color = color.new(BOS_BULL_COLOR, 80), textcolor = BOS_BULL_COLOR, size = size.small), MAX_SMC_LBL)
    if showBOSInput and bearCHoCH
        pushLblCap(smcLblFifo, label.new(bar_index, high, "CHoCH ▼", style = label.style_label_down, color = color.new(BOS_BEAR_COLOR, 80), textcolor = BOS_BEAR_COLOR, size = size.small), MAX_SMC_LBL)
    if showLiquidityInput and sweepHigh
        pushLblCap(smcLblFifo, label.new(bar_index, high, "Liq Sweep ▼", style = label.style_label_down, color = color.new(LIQ_COLOR, 80), textcolor = LIQ_COLOR, size = size.small), MAX_SMC_LBL)
    if showLiquidityInput and sweepLow
        pushLblCap(smcLblFifo, label.new(bar_index, low, "Liq Sweep ▲", style = label.style_label_up, color = color.new(LIQ_COLOR, 80), textcolor = LIQ_COLOR, size = size.small), MAX_SMC_LBL)

nearUnmitFvg(int dir) =>
    bool hit = false
    int n = fvgTop.size()
    if n > 0
        for i = 0 to n - 1
            if not fvgMitigated.get(i)
                bool isBull = fvgBull.get(i)
                bool dirOk = (dir == 1 and isBull) or (dir == -1 and not isBull)
                if dirOk and close >= fvgBottom.get(i) and close <= fvgTop.get(i)
                    hit := true
                    break
    hit

nearUnmitOb(int dir) =>
    bool hit = false
    int n = obTop.size()
    if n > 0
        for i = 0 to n - 1
            if not obMitigated.get(i)
                bool isBull = obBull.get(i)
                bool dirOk = (dir == 1 and isBull) or (dir == -1 and not isBull)
                if dirOk and close >= obBottom.get(i) and close <= obTop.get(i)
                    hit := true
                    break
    hit

// ══════════════════════════════════════════════════════════
// 7. MOMENTUM ENGINE  (unconditional ta.*)
// ══════════════════════════════════════════════════════════
float rsiVal = ta.rsi(close, rsiLenInput)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFastInput, macdSlowInput, macdSigInput)
float ema21  = ta.ema(close, 21)
float ema50  = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)

var float lastRsiHigh   = na
var float lastRsiLow    = na
var float lastPriceHigh = na
var float lastPriceLow  = na

float rsiAtSwing = rsiVal[smcSwingLenInput]
float hiAtSwing  = high[smcSwingLenInput]
float loAtSwing  = low[smcSwingLenInput]
float prevRsiHigh = lastRsiHigh
float prevRsiLow  = lastRsiLow
float prevPxHigh  = lastPriceHigh
float prevPxLow   = lastPriceLow

bool newRsiHigh = not na(swingHigh)
bool newRsiLow  = not na(swingLow)

bool bullDiv = useMomentumInput and useDivergenceInput and newRsiLow and not na(prevPxLow) and not na(prevRsiLow) and loAtSwing < prevPxLow and rsiAtSwing > prevRsiLow
bool bearDiv = useMomentumInput and useDivergenceInput and newRsiHigh and not na(prevPxHigh) and not na(prevRsiHigh) and hiAtSwing > prevPxHigh and rsiAtSwing < prevRsiHigh

if newRsiHigh
    lastRsiHigh := rsiAtSwing
    lastPriceHigh := hiAtSwing
if newRsiLow
    lastRsiLow := rsiAtSwing
    lastPriceLow := loAtSwing

float rsiNorm  = (rsiVal - 50.0) / 50.0 * 100.0
float macdNorm = safeDiv(macdHist, riskAtr, 0.0) * 10.0
float momScore = math.max(-100.0, math.min(100.0, rsiNorm * 0.6 + macdNorm * 0.4))

// ══════════════════════════════════════════════════════════
// 8. MARKET REGIME  (unconditional ta.*)
// ══════════════════════════════════════════════════════════
[diPlus, diMinus, adxVal] = ta.dmi(regimeAdxLenInput, regimeAdxLenInput)
[bbMid, bbUpper, bbLower] = ta.bb(close, regimeBBLenInput, regimeBBMultInput)
float bbWidth = safeDiv(bbUpper - bbLower, bbMid, 0.0) * 100.0

float trSum    = math.sum(ta.tr(true), regimeChopInput)
float rangeSum = ta.highest(high, regimeChopInput) - ta.lowest(low, regimeChopInput)
float chopIndex = safeDiv(trSum, rangeSum, 0.0) * 100.0

int marketRegime = 0
if useRegimeInput
    if adxVal > regimeAdxStrongInput
        marketRegime := close > open ? 2 : -2
    else if adxVal > 15
        marketRegime := close > open ? 1 : -1
    else if chopIndex > 60
        marketRegime := 0
    else if bbWidth > 5
        marketRegime := 3

bool isTrending = marketRegime == 2 or marketRegime == -2
bool isRanging  = marketRegime == 0
bool isVolatile = marketRegime == 3

// ══════════════════════════════════════════════════════════
// 9. VOLUME ENGINE
// ══════════════════════════════════════════════════════════
float volSma20   = nz(ta.sma(volume, 20), 0.0)
bool  volSpike    = hasVolume and volume > volSma20 * volSpikeMultInput
bool  volAboveAvg = hasVolume and volume > volSma20
float closePos    = safeDiv(close - low, high - low, 0.5)
float volDelta    = hasVolume ? volume * (closePos * 2.0 - 1.0) : 0.0
bool  buyingPressure  = useVolDeltaInput and volDelta > 0 and volAboveAvg
bool  sellingPressure = useVolDeltaInput and volDelta < 0 and volAboveAvg

// ══════════════════════════════════════════════════════════
// 10. SESSION ENGINE
// ══════════════════════════════════════════════════════════
bool inLondon = not na(time(timeframe.period, londonStartInput, "Europe/London"))
bool inNY     = not na(time(timeframe.period, nyStartInput, "America/New_York"))
bool inAsia   = not na(time(timeframe.period, asiaStartInput, "Asia/Tokyo"))
bool inKillzone = useSessionInput and (inLondon or inNY or inAsia)

var float sessionHigh = na
var float sessionLow  = na
var int   sessionStartBar = na
if useSessionInput
    if newD
        sessionHigh := high
        sessionLow := low
        sessionStartBar := bar_index
    else
        sessionHigh := math.max(nz(sessionHigh), high)
        sessionLow := math.min(nz(sessionLow, high), low)

// ══════════════════════════════════════════════════════════
// 11. PVTE REGIME ENGINE
// ══════════════════════════════════════════════════════════
float pvtEmaV  = ta.ema(close, pvteBasisLenInput)
float pvtEma2V = ta.ema(pvtEmaV, pvteBasisLenInput)
float pvtDemaV = 2.0 * pvtEmaV - pvtEma2V
float pvtHmaV  = ta.hma(close, pvteBasisLenInput)
float pvtKamaV = kamaCalc(close, pvteBasisLenInput)
float pvtBasis = switch pvteKernelInput
    "EMA"  => pvtEmaV
    "DEMA" => pvtDemaV
    "HMA"  => pvtHmaV
    =>        pvtKamaV

float pvtAtr     = ta.atr(pvteAtrLenInput)
float pvtInnerK  = math.max(pvteAtrMultInput - 1.0, 0.0)
float pvtOuterUp = pvtBasis + pvtAtr * pvteAtrMultInput
float pvtOuterDn = pvtBasis - pvtAtr * pvteAtrMultInput
float pvtInnerUp = pvtBasis + pvtAtr * pvtInnerK
float pvtInnerDn = pvtBasis - pvtAtr * pvtInnerK

bool pvtCrUpOuter = ta.crossover(close, pvtOuterUp)
bool pvtCrDnOuter = ta.crossunder(close, pvtOuterDn)
bool pvtCrDnInner = ta.crossunder(close, pvtInnerDn)
bool pvtCrUpInner = ta.crossover(close, pvtInnerUp)

var int pvteRegime = 0
if barstate.isconfirmed
    if pvteRegime == 1 and pvtCrDnInner
        pvteRegime := 0
    if pvteRegime == -1 and pvtCrUpInner
        pvteRegime := 0
    if pvtCrUpOuter
        pvteRegime := 1
    if pvtCrDnOuter
        pvteRegime := -1

float avwapPlV = ta.pivotlow(low, avwapPivotLenInput, avwapPivotLenInput)
float avwapPhV = ta.pivothigh(high, avwapPivotLenInput, avwapPivotLenInput)
float vSrc = avwapSrcInput == "HLC3" ? hlc3 : avwapSrcInput == "HL2" ? hl2 : close

var bool  avwapActive = false
var int   avwapDir    = 0
var float avwapPV     = 0.0
var float avwapV      = 0.0
var float aVwap       = na
var array<line> avwapLines = array.new<line>()

if barstate.isconfirmed and showAvwapInput
    bool avwapWarm = bar_index >= avwapPivotLenInput * 2 + 2
    if pvteRegime != nz(pvteRegime[1])
        while avwapLines.size() > 0
            line.delete(avwapLines.pop())
        avwapActive := false
        avwapDir    := 0
        aVwap       := na
    bool anchorBearNow = pvteRegime == -1 and not na(avwapPlV) and nz(pvteRegime[avwapPivotLenInput], 9) == -1 and avwapWarm
    bool anchorBullNow = pvteRegime ==  1 and not na(avwapPhV) and nz(pvteRegime[avwapPivotLenInput], 9) ==  1 and avwapWarm
    bool createdNow    = false
    if anchorBearNow or anchorBullNow
        while avwapLines.size() > 0
            line.delete(avwapLines.pop())
        avwapDir := anchorBearNow ? -1 : 1
        avwapPV  := 0.0
        avwapV   := 0.0
        float prevY = na
        for i = 0 to avwapPivotLenInput
            int j = avwapPivotLenInput - i
            avwapPV += vSrc[j] * nz(volume[j])
            avwapV  += nz(volume[j])
            float y = avwapV > 0.0 ? avwapPV / avwapV : vSrc[j]
            if not na(prevY)
                avwapLines.push(line.new(bar_index - j - 1, prevY, bar_index - j, y,
                     color = avwapDir == 1 ? BULL : BEAR, style = line.style_dotted, width = 2))
            prevY := y
        aVwap       := prevY
        avwapActive := true
        createdNow  := true
    if avwapActive and not createdNow
        avwapPV += vSrc * nz(volume)
        avwapV  += nz(volume)
        float newVwap = avwapV > 0.0 ? avwapPV / avwapV : vSrc
        if not na(aVwap)
            avwapLines.push(line.new(bar_index - 1, aVwap, bar_index, newVwap,
                 color = avwapDir == 1 ? BULL : BEAR, style = line.style_dotted, width = 2))
            if avwapLines.size() > MAX_VWAP_SEGMENTS
                line.delete(avwapLines.shift())
        aVwap := newVwap

// ══════════════════════════════════════════════════════════
// 12. STRAT FSM
// ══════════════════════════════════════════════════════════
var array<int>    seq      = array.new<int>()
var matrix<int>   patM     = matrix.new<int>()
var array<string> patNames = array.new<string>()
if barstate.isfirst
    addPat(patM, patNames, 1,  1, "2-2-2-2 RJ",     4,  2, -2,  2,  2)
    addPat(patM, patNames, 1, -1, "2-2-2-2 RJ",     4, -2,  2, -2, -2)
    addPat(patM, patNames, 1,  1, "2-2-2 Cont",     3,  2,  2,  2,  0)
    addPat(patM, patNames, 1, -1, "2-2-2 Cont",     3, -2, -2, -2,  0)
    addPat(patM, patNames, 0,  1, "3-2-2 Rev",      3,  2, -2,  3,  0)
    addPat(patM, patNames, 0, -1, "3-2-2 Rev",      3, -2,  2,  3,  0)
    addPat(patM, patNames, 0,  1, "3-1-2",          3,  2,  1,  3,  0)
    addPat(patM, patNames, 0, -1, "3-1-2",          3, -2,  1,  3,  0)
    addPat(patM, patNames, 0,  1, "2-1-2 Rev",      3,  2,  1, -2,  0)
    addPat(patM, patNames, 0, -1, "2-1-2 Rev",      3, -2,  1,  2,  0)
    addPat(patM, patNames, 0,  1, "2-1-2 Cont",     3,  2,  1,  2,  0)
    addPat(patM, patNames, 0, -1, "2-1-2 Cont",     3, -2,  1, -2,  0)
    addPat(patM, patNames, 0,  1, "1-2-2 RevStrat", 3,  2, -2,  1,  0)
    addPat(patM, patNames, 0, -1, "1-2-2 RevStrat", 3, -2,  2,  1,  0)
    addPat(patM, patNames, 0,  1, "3-2",            2,  2,  3,  0,  0)
    addPat(patM, patNames, 0, -1, "3-2",            2, -2,  3,  0,  0)
    addPat(patM, patNames, 0,  1, "2-2 Rev",        2,  2, -2,  0,  0)
    addPat(patM, patNames, 0, -1, "2-2 Rev",        2, -2,  2,  0,  0)
    addPat(patM, patNames, 0,  1, "2-2 Cont",       2,  2,  2,  0,  0)
    addPat(patM, patNames, 0, -1, "2-2 Cont",       2, -2, -2,  0,  0)

var int    fsmState    = ST_IDLE
var float  pendHi      = na
var float  pendLo      = na
var int    setupDir    = 0
var string pendName    = ""
var int    barsPending = 0
var line   hiLn        = na
var line   loLn        = na
var array<line>  lnFifo  = array.new<line>()
var array<label> lblFifo = array.new<label>()

bool setupBullSig = false
bool setupBearSig = false
bool trigBullSig  = false
bool trigBearSig  = false
string trigPat = ""
float  trigLvl = na
float  trigStp = na

if barstate.isconfirmed and bar_index > 0
    seq.push(clsNow)
    if seq.size() > 10
        seq.shift()

    if fsmState == ST_PENDING
        barsPending += 1
        bool brokeTrig  = setupDir > 0 ? high  > pendHi : low   < pendLo
        bool failedStop = setupDir > 0 ? close < pendLo : close > pendHi
        if failedStop
            fsmState := ST_IDLE
            if not na(hiLn)
                line.set_x2(hiLn, bar_index)
                line.set_x2(loLn, bar_index)
                line.set_color(hiLn, C_MUTED)
                line.set_color(loLn, C_MUTED)
        else if brokeTrig
            if setupDir > 0
                trigBullSig := true
            else
                trigBearSig := true
            if not na(hiLn)
                line.set_x2(hiLn, bar_index)
                line.set_x2(loLn, bar_index)
            trigPat := pendName
            trigLvl := setupDir > 0 ? pendHi : pendLo
            trigStp := setupDir > 0 ? pendLo : pendHi
            fsmState := ST_IDLE
        else if barsPending >= expiryInput
            fsmState := ST_IDLE
            if not na(hiLn)
                line.set_x2(hiLn, bar_index)
                line.set_x2(loLn, bar_index)
                line.set_color(hiLn, C_MUTED)
                line.set_color(loLn, C_MUTED)

    int mIdx = -1
    for r = 0 to patM.rows() - 1
        if patM.get(r, 0) == 1 and not extInput
            continue
        int plen = patM.get(r, 2)
        if seq.size() < plen
            continue
        bool ok = true
        for k = 0 to plen - 1
            if seqGet(seq, k) != patM.get(r, 3 + k)
                ok := false
                break
        if ok
            mIdx := r
            break

    string mName = mIdx >= 0 ? patNames.get(mIdx) : ""
    int    mDir  = mIdx >= 0 ? patM.get(mIdx, 1) : 0
    if mIdx == -1 and extInput and clsNow == 3
        if close > high[1]
            mName := "3 RevStrat"
            mDir  := 1
        else if close < low[1]
            mName := "3 RevStrat"
            mDir  := -1

    if mDir != 0
        if fsmState == ST_PENDING and not na(hiLn)
            line.set_x2(hiLn, bar_index)
            line.set_x2(loLn, bar_index)
            line.set_color(hiLn, C_MUTED)
            line.set_color(loLn, C_MUTED)
        fsmState    := ST_PENDING
        pendHi      := high
        pendLo      := low
        setupDir    := mDir
        pendName    := mName
        barsPending := 0
        if mDir > 0
            setupBullSig := true
        else
            setupBearSig := true
        if showSetupLblInput
            label sl = label.new(bar_index, mDir > 0 ? low : high, mName,
                 style = mDir > 0 ? label.style_label_up : label.style_label_down,
                 color = color.new(mDir > 0 ? BULL : BEAR, 80), textcolor = C_TEXT, size = signalSize,
                 tooltip = "Trigger: " + str.tostring(mDir > 0 ? high : low, format.mintick) +
                     "\nStop: "   + str.tostring(mDir > 0 ? low : high, format.mintick) +
                     "\nExpiry: " + str.tostring(expiryInput) + " bars")
            lblFifo.push(sl)
        if showLinesInput
            hiLn := line.new(bar_index, high, bar_index, high,
                 color = mDir > 0 ? BULL : C_MUTED, width = mDir > 0 ? 2 : 1,
                 style = mDir > 0 ? line.style_solid : line.style_dotted)
            loLn := line.new(bar_index, low, bar_index, low,
                 color = mDir < 0 ? BEAR : C_MUTED, width = mDir < 0 ? 2 : 1,
                 style = mDir < 0 ? line.style_solid : line.style_dotted)
            lnFifo.push(hiLn)
            lnFifo.push(loLn)

    while lblFifo.size() > maxDrawInput
        label.delete(lblFifo.shift())
    while lnFifo.size() > maxDrawInput * 2
        line.delete(lnFifo.shift())

if fsmState == ST_PENDING and not na(hiLn)
    line.set_x2(hiLn, bar_index)
    line.set_x2(loLn, bar_index)

bool trapShortBar = clsNow == 2  and close < open
bool trapLongBar  = clsNow == -2 and close > open

// ══════════════════════════════════════════════════════════
// 13. CONFIDENCE SCORING  (engine-aware grade, not a veto wall)
// ══════════════════════════════════════════════════════════
var int    lastSignalBar  = -1
var string lastSigPat     = "—"
var float  lastSigScore   = 0.0
var int    lastSigDir     = 0

calcConf(int dir, string engine) =>
    float s = 0.0
    if dir == 0
        s := 0.0
    else
        s += 22.0
        if engine == "TRIGGER"
            s += 28.0
        else if engine == "TRAP"
            s += 24.0
        else if engine == "SWEEP"
            s += 22.0
        else if engine == "CONT"
            s += 16.0
        int aligned = dir == 1 ? ftcAlignedBull : ftcAlignedBear
        if ftcVisible > 0
            s += math.min(10.0, float(aligned) / float(ftcVisible) * 10.0)
        if useSMCInput
            if (dir == 1 and marketStructure == 1) or (dir == -1 and marketStructure == -1)
                s += 10.0
            else if marketStructure == 0
                s += 4.0
        if (dir == 1 and close > ema21) or (dir == -1 and close < ema21)
            s += 6.0
        if (dir == 1 and close > ema50) or (dir == -1 and close < ema50)
            s += 3.0
        if useMomentumInput
            if dir == 1 and momScore > 20
                s += math.min(8.0, momScore / 12.0)
            else if dir == -1 and momScore < -20
                s += math.min(8.0, math.abs(momScore) / 12.0)
        if useMomentumInput and useDivergenceInput
            if (dir == 1 and bullDiv) or (dir == -1 and bearDiv)
                s += 8.0
        if useSMCInput and nearUnmitFvg(dir)
            s += 6.0
        if useSMCInput and nearUnmitOb(dir)
            s += 6.0
        if useVolEngineInput
            if volSpike
                s += 4.0
            else if volAboveAvg
                s += 2.0
        if inKillzone
            s += 4.0
        if (dir == 1 and pvteRegime == 1) or (dir == -1 and pvteRegime == -1)
            s += 5.0
        if useRegimeInput
            if isTrending
                s += 4.0
            else if not isRanging
                s += 2.0
        if (dir == 1 and hammerNow) or (dir == -1 and shooterNow)
            s += 3.0
    math.max(0.0, math.min(100.0, s))

passesGates(int dir, float score) =>
    bool volOk = not useVolFilterInput or not hasVolume or (volSma > 0 and volume > volSma * volFiltMultInput)
    int alignedN = dir == 1 ? ftcAlignedBull : ftcAlignedBear
    bool ftcOk = minFtcAlignInput == 0 or alignedN >= math.min(minFtcAlignInput, ftcVisible)
    bool pvteOk = not effUsePvte or (dir == 1 ? pvteRegime == 1 : pvteRegime == -1) or (pvteRegime == 0 and pvteNeutralInput == "Allow")
    bool structOk = not effNeedStruct or not useSMCInput or (dir == 1 and marketStructure >= 0) or (dir == -1 and marketStructure <= 0)
    bool confOk = not useConfScoreInput or score >= effMinConf
    bool fvgOk = not requireFVGInput or nearUnmitFvg(dir)
    bool obOk = not requireOBInput or nearUnmitOb(dir)
    bool cdOk = cooldownBarsInput == 0 or lastSignalBar < 0 or (bar_index - lastSignalBar) >= cooldownBarsInput
    volOk and ftcOk and pvteOk and structOk and confOk and fvgOk and obOk and cdOk

enginePri(string engine) =>
    engine == "TRIGGER" ? 4 : engine == "TRAP" ? 3 : engine == "SWEEP" ? 2 : 1

float confLong  = calcConf(1, "")
float confShort = calcConf(-1, "")
int   dashDir   = setupDir != 0 ? setupDir : (trapLongBar ? 1 : trapShortBar ? -1 : close >= open ? 1 : -1)
float confScore = dashDir == 1 ? confLong : confShort
bool  confPassedLong  = not useConfScoreInput or confLong  >= effMinConf
bool  confPassedShort = not useConfScoreInput or confShort >= effMinConf

// ══════════════════════════════════════════════════════════
// 14. TRADE ENGINE
// ══════════════════════════════════════════════════════════
var float activeEntry = na
var float activeSL    = na
var float activeTP1   = na
var float activeTP2   = na
var float activeTP3   = na
var int   activeDir   = 0
var int   entryBarIdx = na
var bool  tp1Reached  = false
var bool  tp2Reached  = false
var bool  tp3Reached  = false
var bool  beActive    = false
var float trailStop   = na
var bool  trailActive = false
var float entryConf   = 0.0

var int    winCount  = 0
var int    lossCount = 0
var string formStr   = ""
var array<int>  tradeTimes = array.new<int>()
var array<bool> tradeWins  = array.new<bool>()

bool  beActiveAtBarStart = beActive
float effectiveSL        = activeSL
if trailActive and not na(trailStop) and activeDir != 0
    effectiveSL := activeDir == 1 ? math.max(activeSL, trailStop) : math.min(activeSL, trailStop)

bool canCheckHit = enableTradesInput and activeDir != 0 and not na(entryBarIdx) and bar_index > entryBarIdx and barstate.isconfirmed

bool slHitRaw  = canCheckHit and (activeDir == 1 ? low  <= effectiveSL : high >= effectiveSL)
bool tp1HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP1   : low  <= activeTP1)
bool tp2HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP2   : low  <= activeTP2)
bool tp3HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP3   : low  <= activeTP3)

bool tp1FirstTouch = tp1HitRaw and not tp1Reached
bool tp2FirstTouch = tp2HitRaw and not tp2Reached
bool tp3FirstTouch = tp3HitRaw and not tp3Reached
if tp1FirstTouch
    tp1Reached := true
if tp2FirstTouch
    tp2Reached := true
if tp3FirstTouch
    tp3Reached := true

bool beJustActivated = false
if beInput and tp1FirstTouch and not beActive and activeDir != 0
    activeSL        := activeEntry
    beActive        := true
    beJustActivated := true

if useTrailingInput and activeDir != 0 and barstate.isconfirmed and tp1Reached
    if trailModeInput == "ATR"
        float trailDist = riskAtr * trailAtrMultInput
        if activeDir == 1
            float newTrail = close - trailDist
            trailStop := na(trailStop) ? newTrail : math.max(trailStop, newTrail)
        else
            float newTrail2 = close + trailDist
            trailStop := na(trailStop) ? newTrail2 : math.min(trailStop, newTrail2)
    else if trailModeInput == "Swing Point"
        if activeDir == 1 and not na(lastSwingLow)
            trailStop := lastSwingLow - riskAtr * trailOffsetInput
        else if activeDir == -1 and not na(lastSwingHigh)
            trailStop := lastSwingHigh + riskAtr * trailOffsetInput
    else
        if activeDir == 1 and marketStructure == 1 and not na(structureLevel)
            trailStop := structureLevel - riskAtr * trailOffsetInput
        else if activeDir == -1 and marketStructure == -1 and not na(structureLevel)
            trailStop := structureLevel + riskAtr * trailOffsetInput
    trailActive := true
    if not na(trailStop)
        if activeDir == 1 and trailStop > activeSL
            activeSL := trailStop
        else if activeDir == -1 and trailStop < activeSL
            activeSL := trailStop

var float hitSL    = na
var float hitEntry = na
if slHitRaw
    hitSL    := effectiveSL
    hitEntry := activeEntry

float exitEntry         = activeEntry
int   exitDir           = activeDir
float exitTP1           = activeTP1
float exitTP2           = activeTP2
float exitTP3           = activeTP3
bool  exitBeActive      = beActiveAtBarStart
bool  displayTp1Reached = tp1Reached
bool  displayTp2Reached = tp2Reached
bool  displayTp3Reached = tp3Reached

bool closeBySl  = slHitRaw and not tp1FirstTouch and not tp3FirstTouch
bool evSlHit    = closeBySl
bool evTp3Close = false
bool tradeWin   = false
if ((tp3HitRaw or closeBySl) and activeDir != 0)
    evTp3Close := tp3HitRaw
    tradeWin   := tp1Reached
    if tradeWin
        winCount += 1
    else
        lossCount += 1
    array.push(tradeTimes, time)
    array.push(tradeWins, tradeWin)
    while array.size(tradeTimes) > 0 and array.get(tradeTimes, 0) < time - MS_DAY * STATS_PRUNE_DAYS
        array.shift(tradeTimes)
        array.shift(tradeWins)
    formStr := formStr + (tradeWin ? "▰" : "▱")
    if str.length(formStr) > FORM_LEN
        formStr := str.substring(formStr, str.length(formStr) - FORM_LEN)
    activeDir   := 0
    activeEntry := na
    activeSL    := na
    activeTP1   := na
    activeTP2   := na
    activeTP3   := na
    entryBarIdx := na
    tp1Reached  := false
    tp2Reached  := false
    tp3Reached  := false
    beActive    := false
    trailStop   := na
    trailActive := false
    entryConf   := 0.0

bool evLongEntry   = false
bool evShortEntry  = false
bool openedByTrig  = false
bool openedByTrap  = false
bool openedBySweep = false
bool openedByCont  = false
string entryPat    = ""
bool allowTrig = entryModeInput != "Trap Bar"
bool allowTrap = entryModeInput != "STRAT Trigger"

bool contAgreeLong  = close > ema21 or rsiVal > 50 or (useSMCInput and marketStructure == 1)
bool contAgreeShort = close < ema21 or rsiVal < 50 or (useSMCInput and marketStructure == -1)
bool contLong  = enableContInput and clsNow == 2  and close > open and not trapShortBar and contAgreeLong
bool contShort = enableContInput and clsNow == -2 and close < open and not trapLongBar  and contAgreeShort
bool sweepLong  = enableSweepInput and useSMCInput and sweepLow
bool sweepShort = enableSweepInput and useSMCInput and sweepHigh

int    sigDir     = 0
string sigPat     = ""
string sigEngine  = ""
float  sigScore   = -1.0
float  sigSlAnchor = na
int    sigPri     = 0

if barstate.isconfirmed
    if allowTrig and trigBullSig
        float sc = calcConf(1, "TRIGGER")
        int pri = enginePri("TRIGGER")
        if passesGates(1, sc) and (sc > sigScore or (sc == sigScore and pri > sigPri))
            sigDir := 1
            sigPat := trigPat
            sigEngine := "TRIGGER"
            sigScore := sc
            sigPri := pri
            sigSlAnchor := slAnchorInput == "Setup Bar" ? trigStp : slAnchorInput == "Wick-Anchored" ? low : slAnchorInput == "Swing Point" ? lastSwingLow : trigLvl
    if allowTrig and trigBearSig
        float sc2 = calcConf(-1, "TRIGGER")
        int pri2 = enginePri("TRIGGER")
        if passesGates(-1, sc2) and (sc2 > sigScore or (sc2 == sigScore and pri2 > sigPri))
            sigDir := -1
            sigPat := trigPat
            sigEngine := "TRIGGER"
            sigScore := sc2
            sigPri := pri2
            sigSlAnchor := slAnchorInput == "Setup Bar" ? trigStp : slAnchorInput == "Wick-Anchored" ? high : slAnchorInput == "Swing Point" ? lastSwingHigh : trigLvl
    if allowTrap and trapLongBar
        float sc3 = calcConf(1, "TRAP")
        int pri3 = enginePri("TRAP")
        if passesGates(1, sc3) and (sc3 > sigScore or (sc3 == sigScore and pri3 > sigPri))
            sigDir := 1
            sigPat := "Trap 2D"
            sigEngine := "TRAP"
            sigScore := sc3
            sigPri := pri3
            sigSlAnchor := low
    if allowTrap and trapShortBar
        float sc4 = calcConf(-1, "TRAP")
        int pri4 = enginePri("TRAP")
        if passesGates(-1, sc4) and (sc4 > sigScore or (sc4 == sigScore and pri4 > sigPri))
            sigDir := -1
            sigPat := "Trap 2U"
            sigEngine := "TRAP"
            sigScore := sc4
            sigPri := pri4
            sigSlAnchor := high
    if sweepLong
        float sc5 = calcConf(1, "SWEEP")
        int pri5 = enginePri("SWEEP")
        if passesGates(1, sc5) and (sc5 > sigScore or (sc5 == sigScore and pri5 > sigPri))
            sigDir := 1
            sigPat := "Sweep Reclaim"
            sigEngine := "SWEEP"
            sigScore := sc5
            sigPri := pri5
            sigSlAnchor := low
    if sweepShort
        float sc6 = calcConf(-1, "SWEEP")
        int pri6 = enginePri("SWEEP")
        if passesGates(-1, sc6) and (sc6 > sigScore or (sc6 == sigScore and pri6 > sigPri))
            sigDir := -1
            sigPat := "Sweep Reject"
            sigEngine := "SWEEP"
            sigScore := sc6
            sigPri := pri6
            sigSlAnchor := high
    if contLong
        float sc7 = calcConf(1, "CONT")
        int pri7 = enginePri("CONT")
        if passesGates(1, sc7) and (sc7 > sigScore or (sc7 == sigScore and pri7 > sigPri))
            sigDir := 1
            sigPat := "2U Cont"
            sigEngine := "CONT"
            sigScore := sc7
            sigPri := pri7
            sigSlAnchor := low
    if contShort
        float sc8 = calcConf(-1, "CONT")
        int pri8 = enginePri("CONT")
        if passesGates(-1, sc8) and (sc8 > sigScore or (sc8 == sigScore and pri8 > sigPri))
            sigDir := -1
            sigPat := "2D Cont"
            sigEngine := "CONT"
            sigScore := sc8
            sigPri := pri8
            sigSlAnchor := high

bool sigLong  = sigDir == 1
bool sigShort = sigDir == -1

if sigDir != 0
    lastSignalBar  := bar_index
    lastSigPat     := sigPat
    lastSigScore   := sigScore
    lastSigDir     := sigDir
    entryPat       := sigPat
    entryConf      := sigScore
    openedByTrig   := sigEngine == "TRIGGER"
    openedByTrap   := sigEngine == "TRAP"
    openedBySweep  := sigEngine == "SWEEP"
    openedByCont   := sigEngine == "CONT"

if enableTradesInput and barstate.isconfirmed and activeDir == 0 and riskAtr > 0 and sigDir != 0
    float slPx = na
    bool structStop = sigEngine != "TRIGGER"
    if not structStop and slAnchorInput == "ATR"
        slPx := sigDir == 1 ? close - riskAtr * effSlMult : close + riskAtr * effSlMult
    else
        slPx := sigDir == 1 ? math.min(sigSlAnchor - riskAtr * slBufferInput, close - riskAtr * 0.5) : math.max(sigSlAnchor + riskAtr * slBufferInput, close + riskAtr * 0.5)
    float riskPx = sigDir == 1 ? close - slPx : slPx - close
    bool riskOk = riskPx > 0 and not na(slPx) and (maxRiskAtrInput == 0.0 or riskPx <= riskAtr * maxRiskAtrInput)
    if riskOk
        activeEntry := close
        activeSL    := slPx
        activeTP1   := sigDir == 1 ? close + riskPx * effTp1m : close - riskPx * effTp1m
        activeTP2   := sigDir == 1 ? close + riskPx * effTp2m : close - riskPx * effTp2m
        activeTP3   := sigDir == 1 ? close + riskPx * effTp3m : close - riskPx * effTp3m
        activeDir   := sigDir
        entryBarIdx := bar_index
        tp1Reached  := false
        tp2Reached  := false
        tp3Reached  := false
        beActive    := false
        trailStop   := na
        trailActive := false
        entryConf   := sigScore
        evLongEntry  := sigDir == 1
        evShortEntry := sigDir == -1
    else
        openedByTrig := false

// ══════════════════════════════════════════════════════════
// 15. PLOTS  (global scope only)
// ══════════════════════════════════════════════════════════
barcolor(colorBarsInput ? clsColor(clsNow) : na)
bgcolor(useSessionInput and showKillzonesInput and inKillzone ? KZ_BG : na)

plotchar(showBarNumInput and clsNow == 1,  "Inside (1)",   "1", location.belowbar, C_INSIDE,  size = size.tiny)
plotchar(showBarNumInput and clsNow == 2,  "Two Up (2U)",  "2", location.belowbar, BULL,      size = size.tiny)
plotchar(showBarNumInput and clsNow == -2, "Two Down (2D)","2", location.belowbar, BEAR,      size = size.tiny)
plotchar(showBarNumInput and clsNow == 3,  "Outside (3)",  "3", location.belowbar, C_OUTSIDE, size = size.tiny)

color pvtBandCol = pvteRegime == 1 ? BULL : pvteRegime == -1 ? BEAR : C_MUTED
plot(showPvteBandsInput ? pvtOuterUp : na, "PVTE Outer Up", color = pvtBandCol, linewidth = 1)
plot(showPvteBandsInput ? pvtOuterDn : na, "PVTE Outer Dn", color = pvtBandCol, linewidth = 1)
plot(showPvteBandsInput ? pvtInnerUp : na, "PVTE Inner Up", color = color.new(pvtBandCol, 65), linewidth = 1)
plot(showPvteBandsInput ? pvtInnerDn : na, "PVTE Inner Dn", color = color.new(pvtBandCol, 65), linewidth = 1)

plot(showEmaInput ? ema21  : na, "EMA 21",  color = EMA21_C,  linewidth = 1)
plot(showEmaInput ? ema50  : na, "EMA 50",  color = EMA50_C,  linewidth = 1)
plot(showEmaInput ? ema200 : na, "EMA 200", color = EMA200_C, linewidth = 2)

plot(useSessionInput and showSessionHLInput ? sessionHigh : na, "Session High", color = color.new(C_INSIDE, 50), style = plot.style_linebr)
plot(useSessionInput and showSessionHLInput ? sessionLow  : na, "Session Low",  color = color.new(C_INSIDE, 50), style = plot.style_linebr)

levelLine(prevDayInput   and chartSec <= timeframe.in_seconds("D"), pdH, dStart, "PDH", dayHiColInput)
levelLine(prevDayInput   and chartSec <= timeframe.in_seconds("D"), pdL, dStart, "PDL", dayLoColInput)
levelLine(prevWeekInput  and chartSec <= timeframe.in_seconds("W"), pwH, wStart, "PWH", weekHiColInput)
levelLine(prevWeekInput  and chartSec <= timeframe.in_seconds("W"), pwL, wStart, "PWL", weekLoColInput)
levelLine(prevMonthInput and chartSec <= timeframe.in_seconds("M"), pmH, mStart, "PMH", monthHiColInput)
levelLine(prevMonthInput and chartSec <= timeframe.in_seconds("M"), pmL, mStart, "PML", monthLoColInput)

// ══════════════════════════════════════════════════════════
// 16. LABELS & SHAPES
// ══════════════════════════════════════════════════════════
plotshape(showCandleInput and hammerNow and barstate.isconfirmed,  "Hammer",  shape.triangleup,   location.belowbar, BULL, size = size.tiny)
plotshape(showCandleInput and shooterNow and barstate.isconfirmed, "Shooter", shape.triangledown, location.abovebar, BEAR, size = size.tiny)
plotshape(showBuySellInput and sigLong,  "BUY",  shape.labelup,   location.belowbar, BULL, size = size.small, text = "BUY",  textcolor = color.white)
plotshape(showBuySellInput and sigShort, "SELL", shape.labeldown, location.abovebar, BEAR, size = size.small, text = "SELL", textcolor = color.white)

if sigDir != 0 and showSigLblInput
    string eTip = "Engine: " + sigEngine +
         "\nPattern: " + sigPat +
         "\nScore: " + str.tostring(sigScore, "#.#") + "/100" +
         "\nProfile: " + signalProfileInput +
         (evLongEntry or evShortEntry ? "\nEntry: " + fmtPrice(activeEntry) +
         "\nSL: "  + fmtPrice(activeSL) +
         "\nTP1: " + fmtPrice(activeTP1) +
         "\nTP2: " + fmtPrice(activeTP2) +
         "\nTP3: " + fmtPrice(activeTP3) : "\n(arrow only — trade not opened)")
    label el = label.new(bar_index, sigLong ? low : high,
         (sigLong ? "BUY · " : "SELL · ") + sigPat + " · " + str.tostring(sigScore, "#.") + "%",
         style = sigLong ? label.style_label_up : label.style_label_down,
         color = sigLong ? BULL : BEAR, textcolor = isDark ? #0B0E11 : #FFFFFF,
         size = signalSize, tooltip = eTip)
    lblFifo.push(el)
if (trigBullSig or trigBearSig) and showTrigLblInput and not openedByTrig
    label tl = label.new(bar_index, trigBullSig ? low : high,
         (trigBullSig ? "▲ " : "▼ ") + trigPat,
         style = trigBullSig ? label.style_label_up : label.style_label_down,
         color = trigBullSig ? BULL : BEAR, textcolor = isDark ? #0B0E11 : #FFFFFF,
         size = signalSize)
    lblFifo.push(tl)
while lblFifo.size() > maxDrawInput
    label.delete(lblFifo.shift())

// ══════════════════════════════════════════════════════════
// 17. SL/TP LINES & LABELS
// ══════════════════════════════════════════════════════════
var line slLine    = na
var line tp1Line   = na
var line tp2Line   = na
var line tp3Line   = na
var line entryLine = na
var label slLabel    = na
var label tp1Label   = na
var label tp2Label   = na
var label tp3Label   = na
var label entryLabel = na

if (evLongEntry or evShortEntry) and showSlTpInput
    line.delete(slLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    line.delete(entryLine)
    label.delete(slLabel)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)
    label.delete(entryLabel)

    int startBar = bar_index
    entryLine := line.new(startBar, activeEntry, startBar + LINE_FORWARD_BARS, activeEntry, color = ENTRY_COLOR, style = entryLineStyle, width = 1)
    slLine    := line.new(startBar, activeSL,    startBar + LINE_FORWARD_BARS, activeSL,    color = SL_COLOR,  style = slLineStyle, width = 2)
    tp1Line   := line.new(startBar, activeTP1,   startBar + LINE_FORWARD_BARS, activeTP1,   color = TP1_COLOR, style = tpLineStyle, width = 1)
    tp2Line   := line.new(startBar, activeTP2,   startBar + LINE_FORWARD_BARS, activeTP2,   color = TP2_COLOR, style = tpLineStyle, width = 1)
    tp3Line   := line.new(startBar, activeTP3,   startBar + LINE_FORWARD_BARS, activeTP3,   color = TP3_COLOR, style = tpLineStyle, width = 1)

    if showSlTpLabelsInput
        int lx = startBar + LINE_FORWARD_BARS + LABEL_OFFSET_BARS
        entryLabel := label.new(lx, activeEntry, "ENTRY " + fmtPrice(activeEntry), color = ENTRY_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = slTpLabelSize)
        slLabel    := label.new(lx, activeSL, "SL " + fmtPrice(activeSL) + formatPctFromEntry(activeSL, activeEntry), color = SL_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = slTpLabelSize)
        tp1Label   := label.new(lx, activeTP1, "TP1 " + fmtPrice(activeTP1) + formatPctFromEntry(activeTP1, activeEntry), color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = slTpLabelSize)
        tp2Label   := label.new(lx, activeTP2, "TP2 " + fmtPrice(activeTP2) + formatPctFromEntry(activeTP2, activeEntry), color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = slTpLabelSize)
        tp3Label   := label.new(lx, activeTP3, "TP3 " + fmtPrice(activeTP3) + formatPctFromEntry(activeTP3, activeEntry), color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = slTpLabelSize)

if showSlTpInput and not na(tp1Line) and displayTp1Reached and not (evLongEntry or evShortEntry)
    line.set_color(tp1Line, TP_HIT_COLOR)
    line.set_style(tp1Line, line.style_solid)
    if showSlTpLabelsInput and not na(tp1Label)
        label.set_text(tp1Label, "TP1 ✓ " + fmtPrice(exitTP1) + formatPctFromEntry(exitTP1, exitEntry))
        label.set_color(tp1Label, TP_HIT_COLOR)

if showSlTpInput and not na(tp2Line) and displayTp2Reached and not (evLongEntry or evShortEntry)
    line.set_color(tp2Line, TP_HIT_COLOR)
    line.set_style(tp2Line, line.style_solid)
    if showSlTpLabelsInput and not na(tp2Label)
        label.set_text(tp2Label, "TP2 ✓ " + fmtPrice(exitTP2) + formatPctFromEntry(exitTP2, exitEntry))
        label.set_color(tp2Label, TP_HIT_COLOR)

if showSlTpInput and not na(tp3Line) and displayTp3Reached and not (evLongEntry or evShortEntry)
    line.set_color(tp3Line, TP_HIT_COLOR)
    line.set_style(tp3Line, line.style_solid)
    if showSlTpLabelsInput and not na(tp3Label)
        label.set_text(tp3Label, "TP3 ✓ " + fmtPrice(exitTP3) + formatPctFromEntry(exitTP3, exitEntry))
        label.set_color(tp3Label, TP_HIT_COLOR)

if showSlTpInput and ((beActive and activeDir != 0) or beJustActivated)
    if not na(slLine)
        line.set_color(slLine, color.new(SL_COLOR, BE_DIM_TRANSP))
    if showSlTpLabelsInput
        if not na(slLabel)
            label.set_color(slLabel, color.new(SL_COLOR, BE_DIM_TRANSP))
        if not na(entryLabel)
            label.set_text(entryLabel, "ENTRY " + fmtPrice(exitEntry) + "  → SL (BE)")
            label.set_color(entryLabel, BE_COLOR)

if activeDir != 0 and showSlTpInput and not na(slLine)
    line.set_x2(slLine, bar_index + LINE_UPDATE_BARS)
    line.set_x2(tp1Line, bar_index + LINE_UPDATE_BARS)
    line.set_x2(tp2Line, bar_index + LINE_UPDATE_BARS)
    line.set_x2(tp3Line, bar_index + LINE_UPDATE_BARS)
    line.set_x2(entryLine, bar_index + LINE_UPDATE_BARS)
    if trailActive and not na(trailStop)
        line.set_y1(slLine, activeSL)
        line.set_y2(slLine, activeSL)
    if showSlTpLabelsInput and not na(slLabel)
        int lx2 = bar_index + LINE_UPDATE_BARS + LABEL_OFFSET_BARS
        label.set_x(slLabel, lx2)
        label.set_text(slLabel, (beActive ? "SL BE " : trailActive ? "SL TR " : "SL ") + fmtPrice(activeSL) + formatPctFromEntry(activeSL, activeEntry))
        label.set_x(tp1Label, lx2)
        label.set_x(tp2Label, lx2)
        label.set_x(tp3Label, lx2)
        label.set_x(entryLabel, lx2)

// ══════════════════════════════════════════════════════════
// 18. DASHBOARD
// ══════════════════════════════════════════════════════════
var table ftcT = na
if ftcInput
    if na(ftcT)
        ftcT := table.new(position.top_center, 8, 1)
    if barstate.islast
        for c = 0 to 7
            bool vv = fV.get(c)
            string t = vv ? FTC_LBL.get(c) + (fI.get(c) ? "·I" : fO.get(c) ? "·O" : "") : ""
            table.cell(ftcT, c, 0, t,
                 bgcolor = vv ? color.new(fG.get(c) ? BULL : BEAR, 55) : color.new(#000000, 100),
                 text_color = C_TEXT, text_size = size.small)

var table dash = na
if showDashInput and barstate.islast
    int marketRows = showMarketSecInput ? 6 : 0
    int smcRows    = showSMCSecInput and useSMCInput ? 5 : 0
    int confRows   = showConfSecInput and useConfScoreInput ? 4 : 0
    int tradeRows  = showTradeSecInput and enableTradesInput ? (activeDir != 0 ? 9 : 2) : 0
    int statsRows  = showStatsSecInput and enableTradesInput ? 6 : 0
    if not na(dash)
        table.delete(dash)
    dash := table.new(dashPos, 2, 2 + marketRows + smcRows + confRows + tradeRows + statsRows, bgcolor = PANEL_BG, frame_color = color.new(C_TEXT, 85), frame_width = 1)

    int  r   = 0
    bool zeb = false
    color rb = PANEL_BG

    string hdrWord = activeDir == 1 ? "Long" : activeDir == -1 ? "Short" : "Flat"
    color  hdrBg   = activeDir == 1 ? HEADER_BG_BULL : activeDir == -1 ? HEADER_BG_BEAR : HEADER_BG
    color  hdrTx   = activeDir != 0 ? HEADER_TEXT : C_TEXT
    table.cell(dash, 0, r, "◆ STRAT PRO · " + hdrWord, text_color = hdrTx, bgcolor = hdrBg, text_size = dashFontSize, text_halign = text.align_center)
    table.merge_cells(dash, 0, r, 1, r)
    r += 1

    if showMarketSecInput
        table.cell(dash, 0, r, "— Market —", text_color = C_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 1, r)
        r += 1
        string seqTxt = ""
        int nseq = math.min(seq.size(), 4)
        if nseq > 0
            for i = 0 to nseq - 1
                seqTxt := clsName(seqGet(seq, i)) + (seqTxt == "" ? "" : "-") + seqTxt
        else
            seqTxt := "—"
        string stTxt  = fsmState == ST_PENDING ? pendName + (setupDir > 0 ? " ▲ " : " ▼ ") + str.tostring(barsPending) + "/" + str.tostring(expiryInput) : "idle"
        string lvlTxt = fsmState == ST_PENDING ? "T " + str.tostring(setupDir > 0 ? pendHi : pendLo, format.mintick) + " · S " + str.tostring(setupDir > 0 ? pendLo : pendHi, format.mintick) : "—"
        string cndTxt = shooterNow ? "Shooter" : hammerNow ? "Hammer" : clsNow == 1 ? "Inside" : "—"
        color  cndCol = shooterNow ? BEAR : hammerNow ? BULL : clsNow == 1 ? C_INSIDE : C_MUTED
        color  stCol  = fsmState == ST_PENDING ? (setupDir > 0 ? BULL : BEAR) : C_MUTED
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Seq", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, seqTxt, text_color = C_TEXT, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Setup", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, stTxt, text_color = stCol, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Levels", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, lvlTxt, text_color = C_TEXT, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Candle", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, cndTxt, text_color = cndCol, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        string pvtTxt = not effUsePvte ? "Off" : pvteRegime == 1 ? "BULL" : pvteRegime == -1 ? "BEAR" : "NEUTRAL"
        color  pvtClr = not effUsePvte ? C_MUTED : pvteRegime == 1 ? BULL : pvteRegime == -1 ? BEAR : C_INSIDE
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "PVTE", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, pvtTxt, text_color = pvtClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb

    if showSMCSecInput and useSMCInput
        table.cell(dash, 0, r, "— SMC —", text_color = C_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 1, r)
        r += 1
        string structTxt = marketStructure == 1 ? "Bullish" : marketStructure == -1 ? "Bearish" : "Neutral"
        color structClr = marketStructure == 1 ? BULL : marketStructure == -1 ? BEAR : C_MUTED
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Structure", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, structTxt, text_color = structClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        string divTxt = bullDiv ? "Bull Div ✓" : bearDiv ? "Bear Div ✓" : "None"
        color divClr = bullDiv ? BULL : bearDiv ? BEAR : C_MUTED
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Divergence", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, divTxt, text_color = divClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        string liqTxt = sweepHigh ? "Sweep High" : sweepLow ? "Sweep Low" : "None"
        color liqClr = sweepHigh or sweepLow ? LIQ_COLOR : C_MUTED
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Liquidity", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, liqTxt, text_color = liqClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        string regimeTxt = marketRegime == 2 ? "Strong Bull" : marketRegime == 1 ? "Weak Bull" : marketRegime == -1 ? "Weak Bear" : marketRegime == -2 ? "Strong Bear" : marketRegime == 3 ? "Volatile" : "Ranging"
        color regimeClr = marketRegime == 2 or marketRegime == 1 ? BULL : marketRegime == -2 or marketRegime == -1 ? BEAR : marketRegime == 3 ? C_OUTSIDE : C_MUTED
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Regime", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, regimeTxt, text_color = regimeClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb

    if showConfSecInput and useConfScoreInput
        table.cell(dash, 0, r, "— Confidence —", text_color = C_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 1, r)
        r += 1
        color confClr = confScore >= 80 ? BULL : confScore >= 60 ? C_INSIDE : BEAR
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Score", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, str.tostring(confScore, "#.#") + "/100  " + buildGauge(confScore, 100, 6), text_color = confClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        bool dashPass = dashDir == 1 ? confPassedLong : confPassedShort
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Filter", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, dashPass ? "✓ PASSED" : "✗ BLOCKED", text_color = dashPass ? BULL : BEAR, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        string lastTxt = lastSigDir == 0 ? "—" : (lastSigDir == 1 ? "BUY " : "SELL ") + lastSigPat + " " + str.tostring(lastSigScore, "#.") + "%"
        color lastClr = lastSigDir == 1 ? BULL : lastSigDir == -1 ? BEAR : C_MUTED
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Last", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, lastTxt, text_color = lastClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        zeb := not zeb

    if showTradeSecInput and enableTradesInput
        table.cell(dash, 0, r, "— Trade —", text_color = C_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 1, r)
        r += 1
        if activeDir != 0
            float riskPct = safeDiv(math.abs(activeEntry - activeSL), activeEntry, 0.0) * 100.0
            color riskClr = riskPct > 3.0 ? BEAR : riskPct > 1.0 ? C_INSIDE : BULL
            color rrClr   = effTp1m >= 1.5 ? BULL : effTp1m >= 1.0 ? C_INSIDE : BEAR
            string dirWord = activeDir == 1 ? "Long" : "Short"
            color  dirClr  = activeDir == 1 ? BULL : BEAR
            string slVal   = (beActive ? "BE @ " : trailActive ? "TR @ " : "") + fmtPrice(activeSL)
            color  slClr   = beActive ? BE_COLOR : SL_COLOR
            rb := zeb ? TABLE_ROW_ALT : PANEL_BG
            table.cell(dash, 0, r, "Entry", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
            table.cell(dash, 1, r, dirWord + " @ " + fmtPrice(activeEntry), text_color = dirClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : PANEL_BG
            table.cell(dash, 0, r, "SL", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
            table.cell(dash, 1, r, slVal, text_color = slClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : PANEL_BG
            table.cell(dash, 0, r, "TP1", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
            table.cell(dash, 1, r, (tp1Reached ? "✓ " : "") + fmtPrice(activeTP1), text_color = tp1Reached ? TP_HIT_COLOR : TP_LABEL_COLOR, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : PANEL_BG
            table.cell(dash, 0, r, "TP2", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
            table.cell(dash, 1, r, (tp2Reached ? "✓ " : "") + fmtPrice(activeTP2), text_color = tp2Reached ? TP_HIT_COLOR : TP_LABEL_COLOR, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : PANEL_BG
            table.cell(dash, 0, r, "TP3", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
            table.cell(dash, 1, r, (tp3Reached ? "✓ " : "") + fmtPrice(activeTP3), text_color = tp3Reached ? TP_HIT_COLOR : TP_LABEL_COLOR, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : PANEL_BG
            table.cell(dash, 0, r, "R:R", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
            table.cell(dash, 1, r, str.tostring(effTp1m, "#.#") + "R", text_color = rrClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : PANEL_BG
            table.cell(dash, 0, r, "SL Dist", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
            table.cell(dash, 1, r, str.tostring(riskPct, "#.##") + "%", text_color = riskClr, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : PANEL_BG
            table.cell(dash, 0, r, "Trail", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
            table.cell(dash, 1, r, trailActive ? fmtPrice(trailStop) : "Off", text_color = trailActive ? C_INSIDE : C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
            r += 1
            zeb := not zeb
        else
            table.cell(dash, 0, r, "Flat · waiting for signal", text_color = C_MUTED, bgcolor = PANEL_BG, text_size = dashFontSize, text_halign = text.align_center)
            table.merge_cells(dash, 0, r, 1, r)
            r += 1

    if showStatsSecInput and enableTradesInput
        int pW = winCount
        int pL = lossCount
        if statsPeriodInput == "24 Hours"
            [w24, l24] = periodStats(tradeTimes, tradeWins, time - MS_DAY)
            pW := w24
            pL := l24
        else if statsPeriodInput == "30 Days"
            [w30, l30] = periodStats(tradeTimes, tradeWins, time - MS_DAY * 30)
            pW := w30
            pL := l30
        int    pTotal   = pW + pL
        float  pWinRate = pTotal > 0 ? pW / float(pTotal) * 100.0 : 0.0
        string perTag   = statsPeriodInput == "24 Hours" ? "24H" : statsPeriodInput == "30 Days" ? "30D" : "All-Time"
        table.cell(dash, 0, r, "— Stats · " + perTag + " —", text_color = C_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 1, r)
        r += 1
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Trades", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, pTotal > 0 ? str.tostring(pTotal) : "—", text_color = C_TEXT, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Wins", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, pTotal > 0 ? str.tostring(pW) : "—", text_color = pTotal > 0 ? BULL : C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Losses", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, pTotal > 0 ? str.tostring(pL) : "—", text_color = pTotal > 0 ? BEAR : C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        string dashWR = pTotal > 0 ? str.tostring(pWinRate, "#.#") + "%  " + buildGauge(pWinRate, 100, 8) : "—"
        color  wrCol  = pTotal == 0 ? C_MUTED : pWinRate >= 55.0 ? BULL : pWinRate >= 45.0 ? C_INSIDE : BEAR
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Win rate", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, dashWR, text_color = wrCol, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : PANEL_BG
        table.cell(dash, 0, r, "Form", text_color = C_MUTED, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_left)
        table.cell(dash, 1, r, formStr == "" ? "—" : formStr, text_color = C_TEXT, bgcolor = rb, text_size = dashFontSize, text_halign = text.align_right)
        r += 1
        zeb := not zeb

    table.cell(dash, 0, r, "STRAT PRO · SMC + Confluence · v" + VERSION, text_color = C_MUTED, bgcolor = PANEL_BG, text_size = dashFontSizeSub, text_halign = text.align_center)
    table.merge_cells(dash, 0, r, 1, r)

// ══════════════════════════════════════════════════════════
// 19. WATERMARK
// ══════════════════════════════════════════════════════════
var table wm = na
if showWatermarkInput
    if na(wm)
        wm := table.new(position.bottom_center, 1, 1)
    if barstate.islast
        table.cell(wm, 0, 0, "WillyAlgoTrader — STRAT PRO [SMC + Confluence]", text_color = color.new(C_TEXT, 55), text_size = size.small)

// ══════════════════════════════════════════════════════════
// 20. ALERTS
// ══════════════════════════════════════════════════════════
if beJustActivated and tpBeAlertInput
    fireTradeAlert("be", ',"entry":' + str.tostring(exitEntry) + ',"sl":' + str.tostring(exitEntry),
         " | SL → BE @ " + fmtPrice(exitEntry), buildFtc(fV, fG, FTC_LBL))
if tp1FirstTouch and tpBeAlertInput
    fireTradeAlert("tp1_hit", ',"level":' + str.tostring(exitTP1) + ',"entry":' + str.tostring(exitEntry),
         " | TP1 " + fmtPrice(exitTP1), buildFtc(fV, fG, FTC_LBL))
if tp2FirstTouch and tpBeAlertInput
    fireTradeAlert("tp2_hit", ',"level":' + str.tostring(exitTP2) + ',"entry":' + str.tostring(exitEntry),
         " | TP2 " + fmtPrice(exitTP2), buildFtc(fV, fG, FTC_LBL))

if evTp3Close and tpBeAlertInput
    fireTradeAlert("tp3_close", ',"entry":' + str.tostring(exitEntry) + ',"level":' + str.tostring(exitTP3) +
         ',"dir":"' + (exitDir == 1 ? "long" : "short") + '","result":"win"',
         " | " + (exitDir == 1 ? "Long" : "Short") + " closed at TP3 " + fmtPrice(exitTP3), buildFtc(fV, fG, FTC_LBL))
if evSlHit and slAlertInput
    fireTradeAlert("sl_hit", ',"entry":' + str.tostring(nz(hitEntry)) + ',"sl":' + str.tostring(nz(hitSL)) +
         ',"dir":"' + (exitDir == 1 ? "long" : "short") + '","be_stop":' + (exitBeActive ? "true" : "false") +
         ',"result":"' + (tradeWin ? "win" : "loss") + '"',
         " | " + (exitBeActive ? "BE stop-out" : "SL hit") + " @ " + str.tostring(nz(hitSL), format.mintick), buildFtc(fV, fG, FTC_LBL))

if sigLong or sigShort
    fireTradeAlert(sigLong ? "buy" : "sell", ',"pattern":"' + sigPat + '","engine":"' + sigEngine +
         '","price":' + str.tostring(close) + ',"confidence":' + str.tostring(sigScore) +
         ',"regime":' + str.tostring(pvteRegime),
         " | " + sigPat + " @ " + str.tostring(close, format.mintick) +
         " | Conf: " + str.tostring(sigScore, "#.") + "%", buildFtc(fV, fG, FTC_LBL))

if trigBullSig or trigBearSig
    string trigAction = trigBullSig ? "trigger_bull" : "trigger_bear"
    if openedByTrig and (evLongEntry or evShortEntry)
        if entryAlertInput
            fireTradeAlert(trigAction, ',"pattern":"' + trigPat + '","price":' + str.tostring(close) +
                 ',"entry":' + str.tostring(activeEntry) + ',"sl":' + str.tostring(activeSL) +
                 ',"tp1":' + str.tostring(activeTP1) + ',"tp2":' + str.tostring(activeTP2) +
                 ',"tp3":' + str.tostring(activeTP3) + ',"regime":' + str.tostring(pvteRegime) +
                 ',"confidence":' + str.tostring(entryConf),
                 " | " + trigPat + " @ " + str.tostring(close, format.mintick) +
                 " | SL " + fmtPrice(activeSL) + " TP1 " + fmtPrice(activeTP1) +
                 " TP2 " + fmtPrice(activeTP2) + " TP3 " + fmtPrice(activeTP3) + " | Conf: " + str.tostring(entryConf, "#.") + "%", buildFtc(fV, fG, FTC_LBL))
    else if trigAlertInput and not (sigLong or sigShort)
        fireAlert(trigAction, trigPat, trigLvl, trigStp, buildFtc(fV, fG, FTC_LBL))

if (evLongEntry or evShortEntry) and not openedByTrig and entryAlertInput
    string extraAction = openedBySweep ? (evLongEntry ? "sweep_long" : "sweep_short") : openedByCont ? (evLongEntry ? "cont_long" : "cont_short") : (evLongEntry ? "trap_long" : "trap_short")
    fireTradeAlert(extraAction, ',"pattern":"' + entryPat +
         '","price":' + str.tostring(close) +
         ',"entry":' + str.tostring(activeEntry) + ',"sl":' + str.tostring(activeSL) +
         ',"tp1":' + str.tostring(activeTP1) + ',"tp2":' + str.tostring(activeTP2) +
         ',"tp3":' + str.tostring(activeTP3) + ',"regime":' + str.tostring(pvteRegime) +
         ',"confidence":' + str.tostring(entryConf),
         " | " + entryPat + " @ " + str.tostring(close, format.mintick) +
         " | SL " + fmtPrice(activeSL) + " TP1 " + fmtPrice(activeTP1) +
         " TP2 " + fmtPrice(activeTP2) + " TP3 " + fmtPrice(activeTP3) + " | Conf: " + str.tostring(entryConf, "#.") + "%", buildFtc(fV, fG, FTC_LBL))

if (setupBullSig or setupBearSig) and setupAlertInput
    fireAlert(setupBullSig ? "setup_bull" : "setup_bear", pendName,
         setupBullSig ? pendHi : pendLo, setupBullSig ? pendLo : pendHi, buildFtc(fV, fG, FTC_LBL))

alertcondition(setupBullSig,                 "STRAT PRO: Setup Bull",     "STRAT PRO bullish setup formed")
alertcondition(setupBearSig,                 "STRAT PRO: Setup Bear",     "STRAT PRO bearish setup formed")
alertcondition(setupBullSig or setupBearSig, "STRAT PRO: Setup Any",      "STRAT PRO setup formed")
alertcondition(trigBullSig,                  "STRAT PRO: Triggered Bull", "STRAT PRO bullish setup triggered")
alertcondition(trigBearSig,                  "STRAT PRO: Triggered Bear", "STRAT PRO bearish setup triggered")
alertcondition(trigBullSig or trigBearSig,   "STRAT PRO: Triggered Any",  "STRAT PRO setup triggered")
alertcondition(sigLong,                      "STRAT PRO: BUY",            "STRAT PRO BUY signal")
alertcondition(sigShort,                     "STRAT PRO: SELL",           "STRAT PRO SELL signal")
alertcondition(sigLong or sigShort,          "STRAT PRO: BUY or SELL",    "STRAT PRO BUY or SELL signal")
alertcondition(evLongEntry,                  "STRAT PRO: LONG Trade",     "STRAT PRO long trade opened")
alertcondition(evShortEntry,                 "STRAT PRO: SHORT Trade",    "STRAT PRO short trade opened")
alertcondition(evLongEntry or evShortEntry,  "STRAT PRO: Trade Opened",   "STRAT PRO trade opened")
alertcondition(tp1FirstTouch or tp2FirstTouch or tp3FirstTouch, "STRAT PRO: TP Hit", "STRAT PRO take-profit touched")
alertcondition(evTp3Close or evSlHit,        "STRAT PRO: Trade Closed",   "STRAT PRO trade closed")
