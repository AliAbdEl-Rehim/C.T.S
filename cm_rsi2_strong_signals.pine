//@version=6
indicator("CM RSI-2 Strong Signals", shorttitle="RSI2 STRONG", overlay=false, precision=1, max_labels_count=500)

//====================================================================
// CM RSI-2 STRONG SIGNALS
// Based on ChrisMoody / Larry Connors RSI-2
//
// Classic Connors rules:
//   BUY  setup: close > SMA200 and close < SMA5 and RSI(2) < 10
//   SELL setup: close < SMA200 and close > SMA5 and RSI(2) > 90
//
// Strong-signal upgrades:
//   ✓ Reversal confirmation (RSI turns from the extreme)
//   ✓ Quality score with a minimum threshold
//   ✓ SMA200 slope / trend health
//   ✓ Volume confirmation
//   ✓ Candle confirmation
//   ✓ HTF trend alignment
//   ✓ ADX trend filter
//   ✓ Distance-from-MA sanity checks
//   ✓ Bar-close confirmation
//   ✓ Signal cooldown
//====================================================================


//====================================================================
// 01 - GENERAL
//====================================================================

groupGeneral = "01 • GENERAL"

showDashboard = input.bool(true, "Show Dashboard", group=groupGeneral)
showSignals = input.bool(true, "Show Buy / Sell Signals", group=groupGeneral)
showWeakSetups = input.bool(false, "Show Extra Setup Dots", group=groupGeneral)
showOverlayLabels = input.bool(true, "Show Overlay Labels", group=groupGeneral)
showExits = input.bool(true, "Show Mean-Reversion Exits", group=groupGeneral)
showBackground = input.bool(true, "Show Background", group=groupGeneral)
useArabicText = input.bool(true, "Write Signals In Arabic", group=groupGeneral)


//====================================================================
// 02 - CONNORS RSI-2
//====================================================================

groupCore = "02 • CONNORS RSI-2"

src = input.source(close, "RSI Source", group=groupCore)
rsiLen = input.int(2, "RSI Length", minval=2, maxval=14, group=groupCore)
maFastLen = input.int(5, "Pullback MA", minval=2, maxval=50, group=groupCore)
maTrendLen = input.int(200, "Trend MA", minval=50, maxval=400, group=groupCore)

buyRsiLevel = input.float(10.0, "Buy RSI Extreme", minval=2, maxval=25, step=1, group=groupCore)
sellRsiLevel = input.float(90.0, "Sell RSI Extreme", minval=75, maxval=98, step=1, group=groupCore)
exitLongRsi = input.float(70.0, "Exit Long RSI", minval=40, maxval=90, step=1, group=groupCore)
exitShortRsi = input.float(30.0, "Exit Short RSI", minval=10, maxval=60, step=1, group=groupCore)


//====================================================================
// 03 - STRONG SIGNAL ENGINE
//====================================================================

groupStrong = "03 • STRONG SIGNAL ENGINE"

signalMode = input.string("Extreme Touch", "Entry Mode", options=["Extreme Touch", "Reversal Confirm"], group=groupStrong)

minQuality = input.float(55.0, "Strong Quality Score", minval=40, maxval=95, step=1, group=groupStrong)
signalCooldownBars = input.int(5, "Same-Side Cooldown Bars", minval=1, maxval=50, group=groupStrong)
minExtremeBars = input.int(1, "Minimum Extreme Bars", minval=1, maxval=8, group=groupStrong)

requireVolume = input.bool(false, "Require Volume Confirmation", group=groupStrong)
volumeLen = input.int(20, "Volume Average", minval=5, maxval=100, group=groupStrong)
minRvol = input.float(1.10, "Minimum RVOL", minval=0.50, maxval=3.0, step=0.05, group=groupStrong)

requireCandle = input.bool(false, "Require Candle Confirmation", group=groupStrong)
requireMaSlope = input.bool(false, "Require Trend MA Slope", group=groupStrong)
maSlopeLen = input.int(5, "Trend MA Slope Bars", minval=1, maxval=20, group=groupStrong)

requireAdx = input.bool(false, "Require ADX Trend", group=groupStrong)
adxLen = input.int(14, "ADX Length", minval=5, maxval=50, group=groupStrong)
minAdx = input.float(18.0, "Minimum ADX", minval=10, maxval=40, step=1, group=groupStrong)

maxExtendATR = input.float(8.0, "Max Distance From Trend MA (ATR)", minval=1.0, maxval=20.0, step=0.5, group=groupStrong)
minPullbackATR = input.float(0.0, "Min Pullback From Fast MA (ATR)", minval=0.0, maxval=2.0, step=0.05, group=groupStrong)


//====================================================================
// 04 - HIGHER TIMEFRAME
//====================================================================

groupHTF = "04 • HIGHER TIMEFRAME"

useHTF = input.bool(false, "Require HTF Trend Alignment", group=groupHTF)
higherTF = input.timeframe("240", "Higher Timeframe", group=groupHTF)


//====================================================================
// 05 - TARGETS
//====================================================================

groupTargets = "05 • TARGETS"

atrLen = input.int(14, "ATR Length", minval=5, maxval=50, group=groupTargets)
tp1ATR = input.float(1.0, "TP1 ATR", minval=0.3, maxval=5.0, step=0.1, group=groupTargets)
tp2ATR = input.float(2.0, "TP2 ATR", minval=0.5, maxval=8.0, step=0.1, group=groupTargets)
slATR = input.float(1.2, "Stop ATR", minval=0.4, maxval=5.0, step=0.1, group=groupTargets)


//====================================================================
// 06 - COLORS
//====================================================================

bullColor = color.rgb(0, 235, 140)
bullStrong = color.rgb(0, 255, 80)
bearColor = color.rgb(255, 75, 95)
bearStrong = color.rgb(255, 35, 55)
aquaColor = color.rgb(0, 220, 255)
orangeColor = color.rgb(255, 160, 40)
silverColor = color.rgb(170, 180, 195)
neutralColor = color.rgb(135, 150, 175)
panelBG = color.rgb(16, 22, 31)
panelBG2 = color.rgb(23, 30, 41)
borderColor = color.rgb(65, 80, 100)


//====================================================================
// 07 - CORE CALCULATIONS
//====================================================================

up = ta.rma(math.max(ta.change(src), 0), rsiLen)
down = ta.rma(-math.min(ta.change(src), 0), rsiLen)
rsi = down == 0 ? 100.0 : up == 0 ? 0.0 : 100.0 - (100.0 / (1.0 + up / down))

maFast = ta.sma(close, maFastLen)
maTrend = ta.sma(close, maTrendLen)
maTrendSlope = maTrend - maTrend[maSlopeLen]

atr = ta.atr(atrLen)
volumeAverage = ta.sma(volume, volumeLen)
rvol = volumeAverage > 0 ? volume / volumeAverage : 0.0

[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)

distTrendATR = atr > 0 ? (close - maTrend) / atr : 0.0
distFastATR = atr > 0 ? (close - maFast) / atr : 0.0

trendUp = close > maTrend
trendDown = close < maTrend
pullbackBuy = close < maFast
pullbackSell = close > maFast
maTrendRising = maTrendSlope > 0
maTrendFalling = maTrendSlope < 0

rsiBuyExtreme = rsi < buyRsiLevel
rsiSellExtreme = rsi > sellRsiLevel

var int buyExtremeBars = 0
var int sellExtremeBars = 0

if rsiBuyExtreme
    buyExtremeBars += 1
else
    buyExtremeBars := 0

if rsiSellExtreme
    sellExtremeBars += 1
else
    sellExtremeBars := 0


//====================================================================
// 08 - HTF TREND
//====================================================================

f_htfBull() =>
    float _ma = ta.sma(close, maTrendLen)
    close > _ma and _ma > _ma[maSlopeLen]

f_htfBear() =>
    float _ma = ta.sma(close, maTrendLen)
    close < _ma and _ma < _ma[maSlopeLen]

htfBullRaw = request.security(syminfo.tickerid, higherTF, f_htfBull()[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htfBearRaw = request.security(syminfo.tickerid, higherTF, f_htfBear()[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

htfBull = not useHTF or htfBullRaw
htfBear = not useHTF or htfBearRaw


//====================================================================
// 09 - CLASSIC CONNORS SETUPS
//====================================================================

connorsBuySetup =
     trendUp and
     pullbackBuy and
     rsiBuyExtreme

connorsSellSetup =
     trendDown and
     pullbackSell and
     rsiSellExtreme

rsiTurningUp = rsi > rsi[1] and rsi[1] <= rsi[2]
rsiTurningDown = rsi < rsi[1] and rsi[1] >= rsi[2]

buyReversal =
     connorsBuySetup and
     buyExtremeBars >= minExtremeBars and
     rsiTurningUp

sellReversal =
     connorsSellSetup and
     sellExtremeBars >= minExtremeBars and
     rsiTurningDown

buyTouch =
     connorsBuySetup and
     buyExtremeBars >= minExtremeBars and
     not connorsBuySetup[1]

sellTouch =
     connorsSellSetup and
     sellExtremeBars >= minExtremeBars and
     not connorsSellSetup[1]


//====================================================================
// 10 - QUALITY SCORE
//====================================================================

f_clamp(float value) =>
    math.max(0.0, math.min(100.0, value))

float buyQuality = 0.0
float sellQuality = 0.0

if connorsBuySetup
    buyQuality += 28.0
    buyQuality += rsi <= buyRsiLevel * 0.5 ? 12.0 : rsi <= buyRsiLevel ? 8.0 : 0.0
    buyQuality += rsiTurningUp ? 14.0 : 0.0
    buyQuality += close > open ? 8.0 : close >= close[1] ? 4.0 : 0.0
    buyQuality += rvol >= minRvol * 1.25 ? 10.0 : rvol >= minRvol ? 6.0 : rvol >= 0.90 ? 2.0 : 0.0
    buyQuality += maTrendRising ? 8.0 : 0.0
    buyQuality += adxValue >= minAdx ? 7.0 : adxValue >= minAdx * 0.75 ? 3.0 : 0.0
    buyQuality += diPlus > diMinus ? 5.0 : 0.0
    buyQuality += useHTF and htfBullRaw ? 10.0 : 0.0
    buyQuality += distTrendATR >= 0.25 and distTrendATR <= maxExtendATR ? 5.0 : 0.0
    buyQuality += distFastATR <= -minPullbackATR ? 4.0 : 0.0
    buyQuality += buyExtremeBars >= 2 ? 4.0 : 0.0

if connorsSellSetup
    sellQuality += 28.0
    sellQuality += rsi >= 100.0 - (100.0 - sellRsiLevel) * 0.5 ? 12.0 : rsi >= sellRsiLevel ? 8.0 : 0.0
    sellQuality += rsiTurningDown ? 14.0 : 0.0
    sellQuality += close < open ? 8.0 : close <= close[1] ? 4.0 : 0.0
    sellQuality += rvol >= minRvol * 1.25 ? 10.0 : rvol >= minRvol ? 6.0 : rvol >= 0.90 ? 2.0 : 0.0
    sellQuality += maTrendFalling ? 8.0 : 0.0
    sellQuality += adxValue >= minAdx ? 7.0 : adxValue >= minAdx * 0.75 ? 3.0 : 0.0
    sellQuality += diMinus > diPlus ? 5.0 : 0.0
    sellQuality += useHTF and htfBearRaw ? 10.0 : 0.0
    sellQuality += distTrendATR <= -0.25 and math.abs(distTrendATR) <= maxExtendATR ? 5.0 : 0.0
    sellQuality += distFastATR >= minPullbackATR ? 4.0 : 0.0
    sellQuality += sellExtremeBars >= 2 ? 4.0 : 0.0

buyQuality := f_clamp(buyQuality)
sellQuality := f_clamp(sellQuality)


//====================================================================
// 11 - HARD FILTERS
//====================================================================

volumeOK = not requireVolume or rvol >= minRvol
buyCandleOK = not requireCandle or close > open or close > close[1]
sellCandleOK = not requireCandle or close < open or close < close[1]
buySlopeOK = not requireMaSlope or maTrendRising
sellSlopeOK = not requireMaSlope or maTrendFalling
adxOK = not requireAdx or adxValue >= minAdx

buyDistanceOK =
     distTrendATR >= 0 and
     distTrendATR <= maxExtendATR and
     distFastATR <= -minPullbackATR

sellDistanceOK =
     distTrendATR <= 0 and
     math.abs(distTrendATR) <= maxExtendATR and
     distFastATR >= minPullbackATR

buyFiltersOK =
     volumeOK and
     buyCandleOK and
     buySlopeOK and
     adxOK and
     htfBull and
     buyDistanceOK and
     buyQuality >= minQuality

sellFiltersOK =
     volumeOK and
     sellCandleOK and
     sellSlopeOK and
     adxOK and
     htfBear and
     sellDistanceOK and
     sellQuality >= minQuality


//====================================================================
// 12 - COOLDOWN / FINAL SIGNALS
//====================================================================

var int lastBuyBar = na
var int lastSellBar = na
var int lastExitBar = na
var string lastEvent = "WAITING"
var color lastEventColor = neutralColor

buyCooldownOK = na(lastBuyBar) or bar_index - lastBuyBar >= signalCooldownBars
sellCooldownOK = na(lastSellBar) or bar_index - lastSellBar >= signalCooldownBars

buyTrigger = signalMode == "Reversal Confirm" ? buyReversal : buyTouch
sellTrigger = signalMode == "Reversal Confirm" ? sellReversal : sellTouch

buySignal =
     showSignals and
     buyTrigger and
     buyCooldownOK

sellSignal =
     showSignals and
     sellTrigger and
     sellCooldownOK

strongBuy =
     buySignal and
     buyFiltersOK

strongSell =
     sellSignal and
     sellFiltersOK

buySignalConfirmed = barstate.isconfirmed and buySignal
sellSignalConfirmed = barstate.isconfirmed and sellSignal
strongBuyConfirmed = barstate.isconfirmed and strongBuy
strongSellConfirmed = barstate.isconfirmed and strongSell

exitLong =
     barstate.isconfirmed and
     showExits and
     not na(lastBuyBar) and
     (na(lastSellBar) or lastBuyBar > lastSellBar) and
     (na(lastExitBar) or lastBuyBar > lastExitBar) and
     (ta.crossover(close, maFast) or ta.crossover(rsi, exitLongRsi))

exitShort =
     barstate.isconfirmed and
     showExits and
     not na(lastSellBar) and
     (na(lastBuyBar) or lastSellBar > lastBuyBar) and
     (na(lastExitBar) or lastSellBar > lastExitBar) and
     (ta.crossunder(close, maFast) or ta.crossunder(rsi, exitShortRsi))

if buySignalConfirmed
    lastBuyBar := bar_index
    lastEvent := strongBuyConfirmed ? "شراء قوي" : "شراء"
    lastEventColor := strongBuyConfirmed ? bullStrong : bullColor

if sellSignalConfirmed
    lastSellBar := bar_index
    lastEvent := strongSellConfirmed ? "بيع قوي" : "بيع"
    lastEventColor := strongSellConfirmed ? bearStrong : bearColor

if exitLong
    lastExitBar := bar_index
    lastEvent := "خروج شراء"
    lastEventColor := aquaColor

if exitShort
    lastExitBar := bar_index
    lastEvent := "خروج بيع"
    lastEventColor := aquaColor


//====================================================================
// 13 - TARGETS
//====================================================================

buyTP1 = close + atr * tp1ATR
buyTP2 = close + atr * tp2ATR
buySL = close - atr * slATR

sellTP1 = close - atr * tp1ATR
sellTP2 = close - atr * tp2ATR
sellSL = close + atr * slATR


//====================================================================
// 14 - DISPLAY TEXT
//====================================================================

string rsiZone = "NEUTRAL"

if rsiBuyExtreme
    rsiZone := "OVERSOLD"
else if rsiSellExtreme
    rsiZone := "OVERBOUGHT"
else if rsi < 30
    rsiZone := "LOW"
else if rsi > 70
    rsiZone := "HIGH"

string trendText = trendUp ? "BULL 200" : trendDown ? "BEAR 200" : "FLAT"
string htfText = not useHTF ? "OFF" : htfBull and not htfBear ? "BULL" : htfBear and not htfBull ? "BEAR" : htfBull and htfBear ? "BULL" : "MIXED"

string qualityGrade = "C"

if math.max(buyQuality, sellQuality) >= 85
    qualityGrade := "A+"
else if math.max(buyQuality, sellQuality) >= 75
    qualityGrade := "A"
else if math.max(buyQuality, sellQuality) >= 65
    qualityGrade := "B"

string modeText = connorsBuySetup ? "BUY SETUP" : connorsSellSetup ? "SELL SETUP" : "WAIT"


//====================================================================
// 15 - RSI COLOR (original CM logic + strong override)
//====================================================================

color rsiColor = silverColor

if buySignal or (connorsBuySetup and buyQuality >= minQuality)
    rsiColor := bullStrong
else if sellSignal or (connorsSellSetup and sellQuality >= minQuality)
    rsiColor := bearStrong
else if connorsBuySetup
    rsiColor := bullColor
else if connorsSellSetup
    rsiColor := bearColor


//====================================================================
// 16 - PLOTS
//====================================================================

plot(rsi, title="RSI-2", color=rsiColor, linewidth=3)

bandUpper = plot(100, title="Upper 100", color=aquaColor, linewidth=2)
band90 = plot(sellRsiLevel, title="Sell Extreme", color=color.new(bearColor, 20), linewidth=2)
bandExitHigh = plot(exitLongRsi, title="Exit Long", color=color.new(aquaColor, 50), linewidth=1)
bandExitLow = plot(exitShortRsi, title="Exit Short", color=color.new(aquaColor, 50), linewidth=1)
band10 = plot(buyRsiLevel, title="Buy Extreme", color=color.new(bullColor, 20), linewidth=2)
bandLower = plot(0, title="Lower 0", color=aquaColor, linewidth=2)

fill(band90, band10, color=color.new(silverColor, 90), title="RSI Band")

hline(50, "Mid 50", color=color.new(neutralColor, 50), linestyle=hline.style_dotted)


//====================================================================
// 17 - BACKGROUND
//====================================================================

color paneBackground = na

if showBackground
    if strongBuy
        paneBackground := color.new(bullStrong, 78)
    else if strongSell
        paneBackground := color.new(bearStrong, 78)
    else if buySignal
        paneBackground := color.new(bullColor, 82)
    else if sellSignal
        paneBackground := color.new(bearColor, 82)
    else if connorsBuySetup
        paneBackground := color.new(bullColor, 92)
    else if connorsSellSetup
        paneBackground := color.new(bearColor, 92)

bgcolor(paneBackground)


//====================================================================
// 18 - SIGNAL SHAPES
//====================================================================

plotshape(showWeakSetups and connorsBuySetup and not buySignal, title="Raw Buy Setup", text="SETUP", style=shape.circle, location=location.bottom, color=color.new(bullColor, 30), textcolor=color.black, size=size.tiny)
plotshape(showWeakSetups and connorsSellSetup and not sellSignal, title="Raw Sell Setup", text="SETUP", style=shape.circle, location=location.top, color=color.new(bearColor, 30), textcolor=color.white, size=size.tiny)

plotshape(buySignal and not strongBuy and useArabicText, title="Buy Arabic Pane", text="شراء", style=shape.labelup, location=location.bottom, color=bullColor, textcolor=color.black, size=size.small)
plotshape(buySignal and strongBuy and useArabicText, title="Strong Buy Arabic Pane", text="شراء قوي", style=shape.labelup, location=location.bottom, color=bullStrong, textcolor=color.black, size=size.small)
plotshape(sellSignal and not strongSell and useArabicText, title="Sell Arabic Pane", text="بيع", style=shape.labeldown, location=location.top, color=bearColor, textcolor=color.white, size=size.small)
plotshape(sellSignal and strongSell and useArabicText, title="Strong Sell Arabic Pane", text="بيع قوي", style=shape.labeldown, location=location.top, color=bearStrong, textcolor=color.white, size=size.small)

plotshape(buySignal and not strongBuy and not useArabicText, title="Buy English Pane", text="BUY", style=shape.labelup, location=location.bottom, color=bullColor, textcolor=color.black, size=size.small)
plotshape(buySignal and strongBuy and not useArabicText, title="Strong Buy English Pane", text="BUY", style=shape.labelup, location=location.bottom, color=bullStrong, textcolor=color.black, size=size.small)
plotshape(sellSignal and not strongSell and not useArabicText, title="Sell English Pane", text="SELL", style=shape.labeldown, location=location.top, color=bearColor, textcolor=color.white, size=size.small)
plotshape(sellSignal and strongSell and not useArabicText, title="Strong Sell English Pane", text="SELL", style=shape.labeldown, location=location.top, color=bearStrong, textcolor=color.white, size=size.small)

plotshape(buySignal and not strongBuy and useArabicText, title="Buy Arabic Chart", text="شراء", style=shape.labelup, location=location.belowbar, color=bullColor, textcolor=color.black, size=size.normal, force_overlay=true)
plotshape(buySignal and strongBuy and useArabicText, title="Strong Buy Arabic Chart", text="شراء قوي", style=shape.labelup, location=location.belowbar, color=bullStrong, textcolor=color.black, size=size.normal, force_overlay=true)
plotshape(sellSignal and not strongSell and useArabicText, title="Sell Arabic Chart", text="بيع", style=shape.labeldown, location=location.abovebar, color=bearColor, textcolor=color.white, size=size.normal, force_overlay=true)
plotshape(sellSignal and strongSell and useArabicText, title="Strong Sell Arabic Chart", text="بيع قوي", style=shape.labeldown, location=location.abovebar, color=bearStrong, textcolor=color.white, size=size.normal, force_overlay=true)

plotshape(buySignal and not strongBuy and not useArabicText, title="Buy English Chart", text="BUY", style=shape.labelup, location=location.belowbar, color=bullColor, textcolor=color.black, size=size.normal, force_overlay=true)
plotshape(buySignal and strongBuy and not useArabicText, title="Strong Buy English Chart", text="STRONG BUY", style=shape.labelup, location=location.belowbar, color=bullStrong, textcolor=color.black, size=size.normal, force_overlay=true)
plotshape(sellSignal and not strongSell and not useArabicText, title="Sell English Chart", text="SELL", style=shape.labeldown, location=location.abovebar, color=bearColor, textcolor=color.white, size=size.normal, force_overlay=true)
plotshape(sellSignal and strongSell and not useArabicText, title="Strong Sell English Chart", text="STRONG SELL", style=shape.labeldown, location=location.abovebar, color=bearStrong, textcolor=color.white, size=size.normal, force_overlay=true)

plotshape(exitLong and useArabicText, title="Exit Long Arabic", text="خروج", style=shape.xcross, location=location.belowbar, color=aquaColor, size=size.small, force_overlay=true)
plotshape(exitShort and useArabicText, title="Exit Short Arabic", text="خروج", style=shape.xcross, location=location.abovebar, color=aquaColor, size=size.small, force_overlay=true)
plotshape(exitLong and not useArabicText, title="Exit Long English", text="XL", style=shape.xcross, location=location.belowbar, color=aquaColor, size=size.small, force_overlay=true)
plotshape(exitShort and not useArabicText, title="Exit Short English", text="XS", style=shape.xcross, location=location.abovebar, color=aquaColor, size=size.small, force_overlay=true)


//====================================================================
// 19 - OVERLAY LABELS
//====================================================================

if showOverlayLabels and buySignalConfirmed
    string buyLabelText =
         (useArabicText ? (strongBuyConfirmed ? "شراء قوي" : "شراء") : (strongBuyConfirmed ? "STRONG BUY" : "BUY")) +
         "\nQ " + str.tostring(buyQuality, "#") +
         "\nTP1 " + str.tostring(buyTP1, format.mintick) +
         "\nTP2 " + str.tostring(buyTP2, format.mintick) +
         "\nSL " + str.tostring(buySL, format.mintick)
    label.new(
         bar_index,
         low,
         buyLabelText,
         style=label.style_label_up,
         color=color.new(strongBuyConfirmed ? bullStrong : bullColor, 5),
         textcolor=color.black,
         size=size.normal,
         force_overlay=true
     )

if showOverlayLabels and sellSignalConfirmed
    string sellLabelText =
         (useArabicText ? (strongSellConfirmed ? "بيع قوي" : "بيع") : (strongSellConfirmed ? "STRONG SELL" : "SELL")) +
         "\nQ " + str.tostring(sellQuality, "#") +
         "\nTP1 " + str.tostring(sellTP1, format.mintick) +
         "\nTP2 " + str.tostring(sellTP2, format.mintick) +
         "\nSL " + str.tostring(sellSL, format.mintick)
    label.new(
         bar_index,
         high,
         sellLabelText,
         style=label.style_label_down,
         color=color.new(strongSellConfirmed ? bearStrong : bearColor, 5),
         textcolor=color.white,
         size=size.normal,
         force_overlay=true
     )


//====================================================================
// 20 - DASHBOARD
//====================================================================

var table dashboard = table.new(position.top_right, 2, 16, bgcolor=panelBG, frame_color=borderColor, frame_width=1, border_color=borderColor, border_width=1, force_overlay=true)

if barstate.islast
    if showDashboard
        table.cell(dashboard, 0, 0, "CM RSI-2 STRONG", bgcolor=panelBG2, text_color=aquaColor)
        table.cell(dashboard, 1, 0, "CONNORS+", bgcolor=panelBG2, text_color=color.white)

        table.cell(dashboard, 0, 1, "RSI-2", text_color=neutralColor)
        table.cell(dashboard, 1, 1, str.tostring(rsi, "#.0"), text_color=rsiColor)

        table.cell(dashboard, 0, 2, "RSI ZONE", text_color=neutralColor)
        table.cell(dashboard, 1, 2, rsiZone, text_color=rsiBuyExtreme ? bullColor : rsiSellExtreme ? bearColor : neutralColor)

        table.cell(dashboard, 0, 3, "TREND MA200", text_color=neutralColor)
        table.cell(dashboard, 1, 3, trendText, text_color=trendUp ? bullColor : bearColor)

        table.cell(dashboard, 0, 4, "PULLBACK MA5", text_color=neutralColor)
        table.cell(dashboard, 1, 4, pullbackBuy ? "BELOW" : pullbackSell ? "ABOVE" : "FLAT", text_color=pullbackBuy and trendUp ? bullColor : pullbackSell and trendDown ? bearColor : neutralColor)

        table.cell(dashboard, 0, 5, "MODE", text_color=neutralColor)
        table.cell(dashboard, 1, 5, modeText, text_color=connorsBuySetup ? bullColor : connorsSellSetup ? bearColor : neutralColor)

        table.cell(dashboard, 0, 6, "BUY QUALITY", text_color=neutralColor)
        table.cell(dashboard, 1, 6, str.tostring(buyQuality, "#") + " / 100", text_color=buyQuality >= minQuality ? bullStrong : buyQuality >= 50 ? bullColor : neutralColor)

        table.cell(dashboard, 0, 7, "SELL QUALITY", text_color=neutralColor)
        table.cell(dashboard, 1, 7, str.tostring(sellQuality, "#") + " / 100", text_color=sellQuality >= minQuality ? bearStrong : sellQuality >= 50 ? bearColor : neutralColor)

        table.cell(dashboard, 0, 8, "GRADE", text_color=neutralColor)
        table.cell(dashboard, 1, 8, qualityGrade, text_color=qualityGrade == "A+" or qualityGrade == "A" ? bullColor : qualityGrade == "B" ? aquaColor : neutralColor)

        table.cell(dashboard, 0, 9, "RVOL", text_color=neutralColor)
        table.cell(dashboard, 1, 9, str.tostring(rvol, "#.##") + "x", text_color=rvol >= minRvol ? bullColor : orangeColor)

        table.cell(dashboard, 0, 10, "ADX", text_color=neutralColor)
        table.cell(dashboard, 1, 10, str.tostring(adxValue, "#.0"), text_color=adxValue >= minAdx ? aquaColor : orangeColor)

        table.cell(dashboard, 0, 11, "HTF TREND", text_color=neutralColor)
        table.cell(dashboard, 1, 11, htfText, text_color=htfText == "BULL" ? bullColor : htfText == "BEAR" ? bearColor : neutralColor)

        table.cell(dashboard, 0, 12, "FILTERS BUY", text_color=neutralColor)
        table.cell(dashboard, 1, 12, buyFiltersOK ? "READY" : "BLOCKED", text_color=buyFiltersOK ? bullColor : orangeColor)

        table.cell(dashboard, 0, 13, "FILTERS SELL", text_color=neutralColor)
        table.cell(dashboard, 1, 13, sellFiltersOK ? "READY" : "BLOCKED", text_color=sellFiltersOK ? bearColor : orangeColor)

        table.cell(dashboard, 0, 14, "ENTRY MODE", text_color=neutralColor)
        table.cell(dashboard, 1, 14, signalMode, text_color=aquaColor)

        table.cell(dashboard, 0, 15, "LAST EVENT", bgcolor=panelBG2, text_color=neutralColor)
        table.cell(dashboard, 1, 15, lastEvent, bgcolor=panelBG2, text_color=lastEventColor)
    else
        table.clear(dashboard, 0, 0, 1, 15)


//====================================================================
// 21 - ALERTS
//====================================================================

alertcondition(buySignalConfirmed, title="Buy", message="CM RSI-2: BUY signal confirmed at candle close.")
alertcondition(sellSignalConfirmed, title="Sell", message="CM RSI-2: SELL signal confirmed at candle close.")
alertcondition(strongBuyConfirmed, title="Strong Buy", message="CM RSI-2: STRONG BUY confirmed at candle close.")
alertcondition(strongSellConfirmed, title="Strong Sell", message="CM RSI-2: STRONG SELL confirmed at candle close.")
alertcondition(exitLong, title="Exit Long", message="CM RSI-2: EXIT LONG (RSI/MA5 mean reversion).")
alertcondition(exitShort, title="Exit Short", message="CM RSI-2: EXIT SHORT (RSI/MA5 mean reversion).")
