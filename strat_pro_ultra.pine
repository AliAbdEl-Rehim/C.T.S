float bgLum  = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
bool  isDark = themeInput == "Dark" or (themeInput == "Auto" and bgLum < 128.0)

color BULL      = isDark ? #00E676 : #00A152
color BEAR      = isDark ? #FF5252 : #D32F2F
color C_INSIDE  = isDark ? #FFD54F : #C77800
color C_OUTSIDE = isDark ? #E040FB : #8E24AA
color C_TEXT    = isDark ? #ECEFF1 : #263238
color C_MUTED   = color.new(C_TEXT, 45)
color HEADER_BG = isDark ? #1E222D : #E8EAED
color PANEL_BG  = isDark ? color.new(#131722, 20) : color.new(#FFFFFF, 20)

color SL_COLOR       = isDark ? color.new(#E57373, 0)  : color.new(#B71C1C, 0)
color TP1_COLOR      = isDark ? color.new(#66BB6A, 30) : color.new(#388E3C, 30)
color TP2_COLOR      = isDark ? color.new(#66BB6A, 40) : color.new(#388E3C, 40)
color TP3_COLOR      = isDark ? color.new(#66BB6A, 0)  : color.new(#388E3C, 0)
color ENTRY_COLOR    = isDark ? color.new(#5C8AAE, 0)  : color.new(#34495E, 0)
color TP_LABEL_COLOR = isDark ? color.new(#66BB6A, 0)  : color.new(#388E3C, 0)
color TP_HIT_COLOR   = isDark ? color.new(#4DB6AC, 0)  : color.new(#00695C, 0)
color BE_COLOR       = isDark ? color.new(#FFA726, 0)  : color.new(#E65100, 0)
color LABEL_TEXT     = isDark ? #1A1A1A                : #FFFFFF
color TABLE_ROW_ALT  = isDark ? color.new(#1C2030, 0)  : color.new(#F0F4F8, 0)
color HEADER_TEXT    = #FFFFFF
color HEADER_BG_BULL = color.new(#0F6E56, 0)
color HEADER_BG_BEAR = color.new(#A32D2D, 0)

color FILTER_PASS  = isDark ? #69F0AE : #2E7D32
color FILTER_BLOCK = isDark ? #FF8A80 : #C62828
color FILTER_WARN  = isDark ? #FFD54F : #F57F17
color DIAG_COLOR   = isDark ? #FFD54F : #F57F17

// ══════════════════════════════════════════════════════════
// FUNCTIONS
// ══════════════════════════════════════════════════════════
seqGet(array<int> s, int back) =>
    s.get(s.size() - 1 - back)

clsName(int c) =>
    c == 1 ? "1" : c == 3 ? "3" : c == 2 ? "2U" : c == -2 ? "2D" : "·"

clsColor(int c) =>
    c == 1 ? C_INSIDE : c == 3 ? C_OUTSIDE : c == 2 ? BULL : c == -2 ? BEAR : na

addPat(matrix<int> m, array<string> nm, int grp, int dir, string name, int plen, int t0, int t1, int t2, int t3) =>
    m.add_row(m.rows(), array.from(grp, dir, plen, t0, t1, t2, t3))
    nm.push(name)

buildFtc(array<bool> v, array<bool> g, array<string> lbl) =>
    string s = ""
    for i = 0 to 7
        if v.get(i)
            s += lbl.get(i) + (g.get(i) ? "+" : "-")
    s

fireAlert(string action, string pat, float trig, float stp, string ftc) =>
    if enableAlertsInput
        string msg = ""
        if alertFmtInput == "JSON"
            msg := '{"ind":"' + JSON_IND + '","v":"' + VERSION + '","sym":"' + syminfo.ticker +
                 '","tf":"' + timeframe.period + '","action":"' + action + '","pattern":"' + pat +
                 '","price":' + str.tostring(close) + ',"trig":' + str.tostring(trig) +
                 ',"stop":' + str.tostring(stp) + ',"ftc":"' + ftc + '"}'
        else
            msg := "STRAT " + str.upper(action) + " " + pat + " " + syminfo.ticker + " " + timeframe.period +
                 " @ " + str.tostring(close, format.mintick) +
                 " | trig " + str.tostring(trig, format.mintick) +
                 " stop " + str.tostring(stp, format.mintick) + " | FTC " + ftc
        alert(msg, alert.freq_once_per_bar)

fireTradeAlert(string action, string jsonFields, string textFields, string ftc) =>
    if enableAlertsInput
        string msg = ""
        if alertFmtInput == "JSON"
            msg := '{"ind":"' + JSON_IND + '","v":"' + VERSION + '","sym":"' + syminfo.ticker +
                 '","tf":"' + timeframe.period + '","action":"' + action + '"' + jsonFields +
                 ',"ftc":"' + ftc + '"}'
        else
            msg := "STRAT " + str.upper(action) + " " + syminfo.ticker + " " + timeframe.period +
                 textFields + " | FTC " + ftc
        alert(msg, alert.freq_once_per_bar)

lineStyleFromString(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

sizeFromString(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : s == "Huge" ? size.huge : size.small

fmtPrice(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

safeDiv(float num, float den, float fallback) =>
    den != 0 and not na(num) and not na(den) ? num / den : fallback

// Pine has no built-in clamp() / math.clamp() — CE10271
clamp(float val, float lo, float hi) =>
    math.max(lo, math.min(hi, val))

kamaCalc(float src, int len) =>
    float fastSC = 2.0 / 3.0
    float slowSC = 2.0 / 31.0
    float mom    = math.abs(ta.change(src, len))
    float noise  = math.sum(math.abs(ta.change(src)), len)
    float er     = safeDiv(mom, noise, 0.0)
    float sc     = math.pow(er * (fastSC - slowSC) + slowSC, 2.0)
    var float k  = na
    k := na(k[1]) ? src : k[1] + nz(sc) * (src - k[1])
    k

sizeDownFromString(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.tiny : s == "Normal" ? size.small : s == "Large" ? size.normal : s == "Huge" ? size.large : size.tiny

buildGauge(float value, float maxVal, int width) =>
    string result = ""
    int filled = maxVal <= 0 ? 0 : math.round(math.min(width, math.max(0.0, value / maxVal * width)))
    for i = 0 to width - 1
        result += i < filled ? "▰" : "▱"
    result

periodStats(array<int> tms, array<bool> wns, int cutoff) =>
    int w = 0
    int l = 0
    int n = array.size(tms)
    if n > 0
        for i = 0 to n - 1
            if array.get(tms, i) >= cutoff
                if array.get(wns, i)
                    w += 1
                else
                    l += 1
    [w, l]

formatPctFromEntry(float level, float entry) =>
    string res = ""
    if showPctOnLabelsInput and not na(level) and not na(entry) and entry != 0
        float pct   = (level - entry) / entry * 100.0
        string sign = pct >= 0 ? "+" : ""
        res := " (" + sign + str.tostring(pct, "#.##") + "%)"
    res

levelLine(bool show, float px, int startBar, string tag, color col) =>
    var line  ln = na
    var label lb = na
    if show and not na(px) and barstate.islast
        if na(ln)
            ln := line.new(startBar, px, bar_index, px, extend = extend.right, style = line.style_dashed, color = col, width = 1)
            lb := label.new(bar_index, px, "", style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small)
        line.set_xy1(ln, startBar, px)
        line.set_xy2(ln, bar_index, px)
        label.set_xy(lb, bar_index, px)
        label.set_text(lb, tag + " " + str.tostring(px, format.mintick))
    if not show and not na(ln)
        line.delete(ln)
        label.delete(lb)
        ln := na
        lb := na

// ══════════════════════════════════════════════════════════
// CALCULATIONS
// ══════════════════════════════════════════════════════════
bool insideNow  = bar_index > 0 and high <= high[1] and low >= low[1]
bool outsideNow = bar_index > 0 and high >  high[1] and low <  low[1]
int  clsNow     = bar_index == 0 ? 0 : insideNow ? 1 : outsideNow ? 3 : high > high[1] ? 2 : -2

float rng    = high - low
float upWick = high - math.max(open, close)
float dnWick = math.min(open, close) - low
bool hammerNow  = rng > 0 and dnWick >= rng * wickPctInput and clsNow != 1
bool shooterNow = rng > 0 and upWick >= rng * wickPctInput and clsNow != 1

// ── risk primitives ──
float riskAtr = nz(ta.atr(atrLenRiskInput), 0.0)
bool  hasVolume = nz(volume, 0) > 0
float volSma    = nz(ta.sma(volume, 20), 0.0)
entryLineStyle = lineStyleFromString(entryLineStyleInput)
slLineStyle    = lineStyleFromString(slLineStyleInput)
tpLineStyle    = lineStyleFromString(tpLineStyleInput)
slTpLabelSize  = sizeFromString(labelFontSizeInput)
signalSize     = sizeFromString(signalSizeInput)
dashFontSize    = sizeFromString(dashSizeInput)
dashFontSizeSub = sizeDownFromString(dashSizeInput)
dashPos = dashPosInput == "Top Left" ? position.top_left : dashPosInput == "Bottom Left" ? position.bottom_left : dashPosInput == "Bottom Right" ? position.bottom_right : position.top_right

// ── risk presets ──
[effSlMult, effTp1m, effTp2m, effTp3m] = switch riskPresetInput
    "Conservative" => [2.5, 1.0, 2.0, 4.0]
    "Aggressive"   => [1.0, 1.5, 2.5, 4.0]
    "Scalping"     => [0.8, 0.8, 1.5, 2.0]
    "Custom"       => [slMultInput, tp1MultInput, tp2MultInput, tp3MultInput]
    => [1.5, 1.0, 2.0, 3.0]

// ── HTF data ──
htf(string tf) =>
    request.security(syminfo.tickerid, tf, [open, close, high, low, high[1], low[1]])

[o15, c15, h15, l15, h15p, l15p]  = htf("15")
[o30, c30, h30, l30, h30p, l30p]  = htf("30")
[o60, c60, h60, l60, h60p, l60p]  = htf("60")
[o4h, c4h, h4h, l4h, h4hp, l4hp]  = htf("240")
[oD,  cD,  hD,  lD,  hDp,  lDp ]  = htf("D")
[oW,  cW,  hW,  lW,  hWp,  lWp ]  = htf("W")
[oM,  cM,  hM,  lM,  hMp,  lMp ]  = htf("M")
[oQ,  cQ,  hQ,  lQ,  hQp,  lQp ]  = htf("3M")

int chartSec = timeframe.in_seconds(timeframe.period)

array<bool> fV = array.from(
     chartSec < timeframe.in_seconds("15")  and not na(o15),
     chartSec < timeframe.in_seconds("30")  and not na(o30),
     chartSec < timeframe.in_seconds("60")  and not na(o60),
     chartSec < timeframe.in_seconds("240") and not na(o4h),
     chartSec < timeframe.in_seconds("D")   and not na(oD),
     chartSec < timeframe.in_seconds("W")   and not na(oW),
     chartSec < timeframe.in_seconds("M")   and not na(oM),
     chartSec < timeframe.in_seconds("3M")  and not na(oQ))
array<bool> fG = array.from(
     nz(o15) <= nz(c15), nz(o30) <= nz(c30), nz(o60) <= nz(c60), nz(o4h) <= nz(c4h),
     nz(oD) <= nz(cD), nz(oW) <= nz(cW), nz(oM) <= nz(cM), nz(oQ) <= nz(cQ))
array<bool> fI = array.from(
     nz(h15) <= nz(h15p) and nz(l15) >= nz(l15p), nz(h30) <= nz(h30p) and nz(l30) >= nz(l30p),
     nz(h60) <= nz(h60p) and nz(l60) >= nz(l60p), nz(h4h) <= nz(h4hp) and nz(l4h) >= nz(l4hp),
     nz(hD) <= nz(hDp) and nz(lD) >= nz(lDp), nz(hW) <= nz(hWp) and nz(lW) >= nz(lWp),
     nz(hM) <= nz(hMp) and nz(lM) >= nz(lMp), nz(hQ) <= nz(hQp) and nz(lQ) >= nz(lQp))
array<bool> fO = array.from(
     nz(h15) > nz(h15p) and nz(l15) < nz(l15p), nz(h30) > nz(h30p) and nz(l30) < nz(l30p),
     nz(h60) > nz(h60p) and nz(l60) < nz(l60p), nz(h4h) > nz(h4hp) and nz(l4h) < nz(l4hp),
     nz(hD) > nz(hDp) and nz(lD) < nz(lDp), nz(hW) > nz(hWp) and nz(lW) < nz(lWp),
     nz(hM) > nz(hMp) and nz(lM) < nz(lMp), nz(hQ) > nz(hQp) and nz(lQ) < nz(lQp))
var array<string> FTC_LBL = array.from("15", "30", "1H", "4H", "D", "W", "M", "Q")

// Global FTC counts (used by ULTRA signals + dashboard; were previously local-only)
int ftcVisible = 0
int ftcAlignedBull = 0
int ftcAlignedBear = 0
for i = 0 to 7
    if fV.get(i)
        ftcVisible += 1
        if fG.get(i)
            ftcAlignedBull += 1
        else
            ftcAlignedBear += 1

// ── previous-period levels ──
[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmH, pmL] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

bool newD = nz(ta.change(time("D"))) != 0
bool newW = nz(ta.change(time("W"))) != 0
bool newM = nz(ta.change(time("M"))) != 0
var int dStart = 0
var int wStart = 0
var int mStart = 0
if newD
    dStart := bar_index
if newW
    wStart := bar_index
if newM
    mStart := bar_index

// ── PVTE regime ──
float pvtEmaV  = ta.ema(close, pvteBasisLenInput)
float pvtEma2V = ta.ema(pvtEmaV, pvteBasisLenInput)
float pvtDemaV = 2.0 * pvtEmaV - pvtEma2V
float pvtHmaV  = ta.hma(close, pvteBasisLenInput)
float pvtKamaV = kamaCalc(close, pvteBasisLenInput)
float pvtBasis = switch pvteKernelInput
    "EMA"  => pvtEmaV
    "DEMA" => pvtDemaV
    "HMA"  => pvtHmaV
    =>        pvtKamaV

float pvtAtr     = ta.atr(pvteAtrLenInput)
float pvtInnerK  = math.max(pvteAtrMultInput - 1.0, 0.0)
float pvtOuterUp = pvtBasis + pvtAtr * pvteAtrMultInput
float pvtOuterDn = pvtBasis - pvtAtr * pvteAtrMultInput
float pvtInnerUp = pvtBasis + pvtAtr * pvtInnerK
float pvtInnerDn = pvtBasis - pvtAtr * pvtInnerK

bool pvtCrUpOuter = ta.crossover(close, pvtOuterUp)
bool pvtCrDnOuter = ta.crossunder(close, pvtOuterDn)
bool pvtCrDnInner = ta.crossunder(close, pvtInnerDn)
bool pvtCrUpInner = ta.crossover(close, pvtInnerUp)

// ── anchored VWAP ──
float avwapPlV = ta.pivotlow(low, avwapPivotLenInput, avwapPivotLenInput)
float avwapPhV = ta.pivothigh(high, avwapPivotLenInput, avwapPivotLenInput)
float vSrc = avwapSrcInput == "HLC3" ? hlc3 : avwapSrcInput == "HL2" ? hl2 : close

// ══════════════════════════════════════════════════════════
// ENHANCED FILTER CALCULATIONS
// ══════════════════════════════════════════════════════════
// ── EMA Trend ──
float fastEma = ta.ema(close, trendFastEmaInput)
float slowEma = ta.ema(close, trendSlowEmaInput)
bool trendBull = close > fastEma and fastEma > slowEma
bool trendBear = close < fastEma and fastEma < slowEma

// ── ADX ──
[diPlus, diMinus, adxVal] = ta.dmi(adxLengthInput, adxLengthInput)
bool strongTrend = adxVal >= adxThresholdInput
bool dmiBull = diPlus > diMinus
bool dmiBear = diMinus > diPlus

// ── RSI ──
float rsiVal = ta.rsi(close, rsiLengthInput)
bool rsiOkLong = rsiVal < rsiOverboughtInput
bool rsiOkShort = rsiVal > rsiOversoldInput

// ── Session ──
bool inSession = not useSessionFilterInput or not na(time(timeframe.period, sessionInput))

// ── Enhanced Trap ──
bool enhancedTrapVolOk = hasVolume and volSma > 0 and volume > volSma * trapVolMultInput
bool enhancedTrapWickOk = rng > 0 and ((clsNow == 2 and upWick >= rng * trapWickMultInput) or (clsNow == -2 and dnWick >= rng * trapWickMultInput))
bool enhancedTrapOk = not enhanceTrapInput or (enhancedTrapVolOk and enhancedTrapWickOk)

// ── Filter Status ──
bool trendOkLong = not useTrendFilterInput or trendBull
bool trendOkShort = not useTrendFilterInput or trendBear

// ══════════════════════════════════════════════════════════
// PVTE REGIME  (declared BEFORE FVG so fvgBull/BearSignal can read it)
// ══════════════════════════════════════════════════════════
var int pvteRegime = 0
if barstate.isconfirmed
    if pvteRegime == 1 and pvtCrDnInner
        pvteRegime := 0
    if pvteRegime == -1 and pvtCrUpInner
        pvteRegime := 0
    if pvtCrUpOuter
        pvteRegime := 1
    if pvtCrDnOuter
        pvteRegime := -1

int ftcAligned = pvteRegime == 1 ? ftcAlignedBull : pvteRegime == -1 ? ftcAlignedBear : math.max(ftcAlignedBull, ftcAlignedBear)

// ══════════════════════════════════════════════════════════
// ⚡ FVG CALCULATIONS (NEW)
// ══════════════════════════════════════════════════════════
float atr_fvg = ta.atr(i_atrLen)
float bullGap = low - high[2]
float bearGap = low[2] - high
bool  bullFVG = low > high[2] and bullGap >= i_minAtrMult * atr_fvg
bool  bearFVG = high < low[2] and bearGap >= i_minAtrMult * atr_fvg

calcFvgScore(float fvgSize, bool isBull) =>
    float sizeRatio = fvgSize / math.max(atr_fvg, syminfo.mintick)
    float f1 = sizeRatio > 1.5 ? 0.82 : sizeRatio > 0.9 ? 0.65 : sizeRatio > 0.4 ? 0.50 : 0.35
    float f2 = isBull ? (fastEma > slowEma ? 0.78 : 0.30) : (fastEma < slowEma ? 0.78 : 0.30)
    float f3 = isBull ? (close > slowEma ? 0.76 : 0.34) : (close < slowEma ? 0.76 : 0.34)
    float f4 = volSma > 0 ? (volume / volSma > 1.5 ? 0.72 : 0.55) : 0.38
    clamp((f1 + f2 + f3 + f4) / 4, 0.04, 0.95)

float fvgBullScore = bullFVG ? calcFvgScore(bullGap, true) : 0.0
float fvgBearScore = bearFVG ? calcFvgScore(bearGap, false) : 0.0
bool  fvgBullSignal = bullFVG and fvgBullScore > 0.65 and (not usePvteInput or pvteRegime == 1)
bool  fvgBearSignal = bearFVG and fvgBearScore > 0.65 and (not usePvteInput or pvteRegime == -1)

var array<box>  fvgBoxArr = array.new<box>()
var array<line> fvgCeArr  = array.new<line>()
if barstate.isconfirmed
    if bullFVG
        box bxBull = box.new(bar_index - 2, low, bar_index + i_extendBars, high[2], border_color = BULL, bgcolor = color.new(BULL, 85), border_width = 1)
        fvgBoxArr.push(bxBull)
        if i_showCE
            float ceBull = (low + high[2]) * 0.5
            fvgCeArr.push(line.new(bar_index - 2, ceBull, bar_index + i_extendBars, ceBull, color = color.new(BULL, 40), style = line.style_dotted, width = 1))
    if bearFVG
        box bxBear = box.new(bar_index - 2, low[2], bar_index + i_extendBars, high, border_color = BEAR, bgcolor = color.new(BEAR, 85), border_width = 1)
        fvgBoxArr.push(bxBear)
        if i_showCE
            float ceBear = (low[2] + high) * 0.5
            fvgCeArr.push(line.new(bar_index - 2, ceBear, bar_index + i_extendBars, ceBear, color = color.new(BEAR, 40), style = line.style_dotted, width = 1))
    while fvgBoxArr.size() > MAX_FVG_DRAWINGS
        box.delete(fvgBoxArr.shift())
    while fvgCeArr.size() > MAX_FVG_DRAWINGS
        line.delete(fvgCeArr.shift())

// ══════════════════════════════════════════════════════════
// 📊 CVD CALCULATIONS (NEW)
// ══════════════════════════════════════════════════════════
float buyVol  = volume * (close - low) / (high - low + 0.0001)
float sellVol = volume * (high - close) / (high - low + 0.0001)
float delta   = buyVol - sellVol

var float cvd = na
float alphaAvg = 2.0 / (i_cvdAvgLen + 1)
if na(cvd[1])
    cvd := delta
else
    cvd := alphaAvg * delta + (1 - alphaAvg) * cvd[1]

var float cvdSmoothed = na
float alphaSmooth = 2.0 / (i_cvdSmoothLen + 1)
if na(cvdSmoothed[1])
    cvdSmoothed := cvd
else
    cvdSmoothed := alphaSmooth * cvd + (1 - alphaSmooth) * cvdSmoothed[1]

float cvdROC = cvdSmoothed - cvdSmoothed[1]
float cvdLeader = ta.ema(cvdROC, i_leadLen) * i_leadMult

bool cvdStrongBuy  = cvdLeader > 0 and cvdLeader > cvdLeader[1] and cvdSmoothed > 0
bool cvdStrongSell = cvdLeader < 0 and cvdLeader < cvdLeader[1] and cvdSmoothed < 0
bool cvdBuy = cvdLeader > 0 and cvdLeader > cvdLeader[1]
bool cvdSell = cvdLeader < 0 and cvdLeader < cvdLeader[1]

// ══════════════════════════════════════════════════════════
// 📊 OBV CALCULATIONS (NEW)
// ══════════════════════════════════════════════════════════
float obv_raw = ta.cum(math.sign(ta.change(close)) * volume)
float obv_smooth = ta.ema(obv_raw, i_obvSmoothLen)

float obv_pivot_low = ta.pivotlow(obv_smooth, i_obvPivotLen, i_obvPivotLen)
float obv_pivot_high = ta.pivothigh(obv_smooth, i_obvPivotLen, i_obvPivotLen)

var float obv_low1 = na
var float obv_low2 = na
var float obv_high1 = na
var float obv_high2 = na
bool obv_bullish_reversal = false
bool obv_bearish_reversal = false

if not na(obv_pivot_low) and na(obv_low1)
    obv_low1 := obv_pivot_low
if not na(obv_pivot_low) and not na(obv_low1) and na(obv_low2)
    if obv_pivot_low > obv_low1
        obv_low2 := obv_pivot_low
if not na(obv_low1) and not na(obv_low2)
    if obv_smooth > obv_smooth[1] and obv_smooth > ta.highest(obv_smooth, 10)[1]
        obv_bullish_reversal := true
        obv_low1 := na
        obv_low2 := na

if not na(obv_pivot_high) and na(obv_high1)
    obv_high1 := obv_pivot_high
if not na(obv_pivot_high) and not na(obv_high1) and na(obv_high2)
    if obv_pivot_high < obv_high1
        obv_high2 := obv_pivot_high
if not na(obv_high1) and not na(obv_high2)
    if obv_smooth < obv_smooth[1] and obv_smooth < ta.lowest(obv_smooth, 10)[1]
        obv_bearish_reversal := true
        obv_high1 := na
        obv_high2 := na

// ══════════════════════════════════════════════════════════
// SIGNAL LOGIC — STRAT FSM
// ══════════════════════════════════════════════════════════
var array<int>    seq      = array.new<int>()
var matrix<int>   patM     = matrix.new<int>()
var array<string> patNames = array.new<string>()
if barstate.isfirst
    addPat(patM, patNames, 1,  1, "2-2-2-2 RJ",     4,  2, -2,  2,  2)
    addPat(patM, patNames, 1, -1, "2-2-2-2 RJ",     4, -2,  2, -2, -2)
    addPat(patM, patNames, 1,  1, "2-2-2 Cont",     3,  2,  2,  2,  0)
    addPat(patM, patNames, 1, -1, "2-2-2 Cont",     3, -2, -2, -2,  0)
    addPat(patM, patNames, 0,  1, "3-2-2 Rev",      3,  2, -2,  3,  0)
    addPat(patM, patNames, 0, -1, "3-2-2 Rev",      3, -2,  2,  3,  0)
    addPat(patM, patNames, 0,  1, "3-1-2",          3,  2,  1,  3,  0)
    addPat(patM, patNames, 0, -1, "3-1-2",          3, -2,  1,  3,  0)
    addPat(patM, patNames, 0,  1, "2-1-2 Rev",      3,  2,  1, -2,  0)
    addPat(patM, patNames, 0, -1, "2-1-2 Rev",      3, -2,  1,  2,  0)
    addPat(patM, patNames, 0,  1, "2-1-2 Cont",     3,  2,  1,  2,  0)
    addPat(patM, patNames, 0, -1, "2-1-2 Cont",     3, -2,  1, -2,  0)
    addPat(patM, patNames, 0,  1, "1-2-2 RevStrat", 3,  2, -2,  1,  0)
    addPat(patM, patNames, 0, -1, "1-2-2 RevStrat", 3, -2,  2,  1,  0)
    addPat(patM, patNames, 0,  1, "3-2",            2,  2,  3,  0,  0)
    addPat(patM, patNames, 0, -1, "3-2",            2, -2,  3,  0,  0)
    addPat(patM, patNames, 0,  1, "2-2 Rev",        2,  2, -2,  0,  0)
    addPat(patM, patNames, 0, -1, "2-2 Rev",        2, -2,  2,  0,  0)
    addPat(patM, patNames, 0,  1, "2-2 Cont",       2,  2,  2,  0,  0)
    addPat(patM, patNames, 0, -1, "2-2 Cont",       2, -2, -2,  0,  0)

// ── FSM state ──
var int    fsmState    = ST_IDLE
var float  pendHi      = na
var float  pendLo      = na
var int    setupDir    = 0
var string pendName    = ""
var int    barsPending = 0
var line   hiLn        = na
var line   loLn        = na
var array<line>  lnFifo  = array.new<line>()
var array<label> lblFifo = array.new<label>()

bool setupBullSig = false
bool setupBearSig = false
bool trigBullSig  = false
bool trigBearSig  = false
string trigPat = ""
float  trigLvl = na
float  trigStp = na

// ── Confirmation Bar State ──
var int    rawSignalDir  = 0
var int    rawSignalBar  = na
var string rawSignalPat  = ""
var float  rawSignalSl   = na
var float  rawSignalLvl  = na
var bool   rawSignalTrap = false

if barstate.isconfirmed and bar_index > 0
    seq.push(clsNow)
    if seq.size() > 10
        seq.shift()

    // ── 1) resolve pending ──
    if fsmState == ST_PENDING
        barsPending += 1
        bool brokeTrig  = setupDir > 0 ? high  > pendHi : low   < pendLo
        bool failedStop = setupDir > 0 ? close < pendLo : close > pendHi
        if failedStop
            fsmState := ST_IDLE
            if not na(hiLn) and not na(loLn)
                line.set_x2(hiLn, bar_index)
                line.set_x2(loLn, bar_index)
                line.set_color(hiLn, C_MUTED)
                line.set_color(loLn, C_MUTED)
        else if brokeTrig
            if setupDir > 0
                trigBullSig := true
            else
                trigBearSig := true
            if not na(hiLn) and not na(loLn)
                line.set_x2(hiLn, bar_index)
                line.set_x2(loLn, bar_index)
            trigPat := pendName
            trigLvl := setupDir > 0 ? pendHi : pendLo
            trigStp := setupDir > 0 ? pendLo : pendHi
            fsmState := ST_IDLE
        else if barsPending >= expiryInput
            fsmState := ST_IDLE
            if not na(hiLn) and not na(loLn)
                line.set_x2(hiLn, bar_index)
                line.set_x2(loLn, bar_index)
                line.set_color(hiLn, C_MUTED)
                line.set_color(loLn, C_MUTED)

    // ── 2) detect new setup ──
    int mIdx = -1
    for r = 0 to patM.rows() - 1
        bool skipExt = patM.get(r, 0) == 1 and not extInput
        int plen = patM.get(r, 2)
        if not skipExt and seq.size() >= plen
            bool ok = true
            for k = 0 to plen - 1
                if seqGet(seq, k) != patM.get(r, 3 + k)
                    ok := false
                    break
            if ok
                mIdx := r
                break

    string mName = mIdx >= 0 ? patNames.get(mIdx) : ""
    int    mDir  = mIdx >= 0 ? patM.get(mIdx, 1) : 0
    if mIdx == -1 and extInput and clsNow == 3
        if close > high[1]
            mName := "3 RevStrat"
            mDir  := 1
        else if close < low[1]
            mName := "3 RevStrat"
            mDir  := -1

    // ── 3) arm ──
    if mDir != 0
        if fsmState == ST_PENDING and not na(hiLn) and not na(loLn)
            line.set_x2(hiLn, bar_index)
            line.set_x2(loLn, bar_index)
            line.set_color(hiLn, C_MUTED)
            line.set_color(loLn, C_MUTED)
        fsmState    := ST_PENDING
        pendHi      := high
        pendLo      := low
        setupDir    := mDir
        pendName    := mName
        barsPending := 0
        if mDir > 0
            setupBullSig := true
        else
            setupBearSig := true
        if showSetupLblInput
            label sl = label.new(bar_index, mDir > 0 ? low : high, mName,
                 style = mDir > 0 ? label.style_label_up : label.style_label_down,
                 color = color.new(mDir > 0 ? BULL : BEAR, 80), textcolor = C_TEXT, size = signalSize,
                 tooltip = "Trigger: " + str.tostring(mDir > 0 ? high : low, format.mintick) +
                     "\nStop: "   + str.tostring(mDir > 0 ? low : high, format.mintick) +
                     "\nExpiry: " + str.tostring(expiryInput) + " bars")
            lblFifo.push(sl)
        if showLinesInput
            hiLn := line.new(bar_index, high, bar_index, high,
                 color = mDir > 0 ? BULL : C_MUTED, width = mDir > 0 ? 2 : 1,
                 style = mDir > 0 ? line.style_solid : line.style_dotted)
            loLn := line.new(bar_index, low, bar_index, low,
                 color = mDir < 0 ? BEAR : C_MUTED, width = mDir < 0 ? 2 : 1,
                 style = mDir < 0 ? line.style_solid : line.style_dotted)
            lnFifo.push(hiLn)
            lnFifo.push(loLn)

    // ── 4) FIFO caps ──
    while lblFifo.size() > maxDrawInput
        label.delete(lblFifo.shift())
    while lnFifo.size() > maxDrawInput * 2
        line.delete(lnFifo.shift())

// extend live trigger/stop lines while pending
if fsmState == ST_PENDING and not na(hiLn) and not na(loLn)
    line.set_x2(hiLn, bar_index)
    line.set_x2(loLn, bar_index)

// ══════════════════════════════════════════════════════════
// ANCHORED VWAP TRAIL
// ══════════════════════════════════════════════════════════
var bool  avwapActive = false
var int   avwapDir    = 0
var float avwapPV     = 0.0
var float avwapV      = 0.0
var float aVwap       = na
var array<line> avwapLines = array.new<line>()

if barstate.isconfirmed and showAvwapInput
    bool avwapWarm = bar_index >= avwapPivotLenInput * 2 + 2
    if pvteRegime != nz(pvteRegime[1])
        while avwapLines.size() > 0
            line.delete(avwapLines.pop())
        avwapActive := false
        avwapDir    := 0
        aVwap       := na
    bool anchorBearNow = pvteRegime == -1 and not na(avwapPlV) and nz(pvteRegime[avwapPivotLenInput], 9) == -1 and avwapWarm
    bool anchorBullNow = pvteRegime ==  1 and not na(avwapPhV) and nz(pvteRegime[avwapPivotLenInput], 9) ==  1 and avwapWarm
    bool createdNow    = false
    if anchorBearNow or anchorBullNow
        while avwapLines.size() > 0
            line.delete(avwapLines.pop())
        avwapDir := anchorBearNow ? -1 : 1
        avwapPV  := 0.0
        avwapV   := 0.0
        float prevY = na
        for i = 0 to avwapPivotLenInput
            int j = avwapPivotLenInput - i
            avwapPV += vSrc[j] * nz(volume[j])
            avwapV  += nz(volume[j])
            float y = avwapV > 0.0 ? avwapPV / avwapV : vSrc[j]
            if not na(prevY)
                avwapLines.push(line.new(bar_index - j - 1, prevY, bar_index - j, y,
                     color = avwapDir == 1 ? BULL : BEAR, style = line.style_dotted, width = 2))
            prevY := y
        aVwap        := prevY
        avwapActive  := true
        createdNow   := true
    if avwapActive and not createdNow
        avwapPV += vSrc * nz(volume)
        avwapV  += nz(volume)
        float newVwap = avwapV > 0.0 ? avwapPV / avwapV : vSrc
        if not na(aVwap)
            avwapLines.push(line.new(bar_index - 1, aVwap, bar_index, newVwap,
                 color = avwapDir == 1 ? BULL : BEAR, style = line.style_dotted, width = 2))
            if avwapLines.size() > MAX_VWAP_SEGMENTS
                line.delete(avwapLines.shift())
        aVwap := newVwap

// ══════════════════════════════════════════════════════════
// RISK MANAGEMENT — TRADE ENGINE
// ══════════════════════════════════════════════════════════
var float activeEntry = na
var float activeSL    = na
var float activeTP1   = na
var float activeTP2   = na
var float activeTP3   = na
var int   activeDir   = 0
var int   entryBarIdx = na
var bool  tp1Reached  = false
var bool  tp2Reached  = false
var bool  tp3Reached  = false
var bool  beActive    = false

// Trailing Stop vars
var float trailHighest = na
var float trailLowest  = na
var float trailStopPx  = na

// session statistics
var int    winCount  = 0
var int    lossCount = 0
var string formStr   = ""
var array<int>  tradeTimes = array.new<int>()
var array<bool> tradeWins  = array.new<bool>()

// bar-start captures
bool  beActiveAtBarStart = beActive
float effectiveSL        = activeSL

// hit detection
bool canCheckHit = enableTradesInput and activeDir != 0 and not na(entryBarIdx) and bar_index > entryBarIdx and barstate.isconfirmed

bool slHitRaw  = canCheckHit and (activeDir == 1 ? low  <= effectiveSL : high >= effectiveSL)
bool tp1HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP1   : low  <= activeTP1)
bool tp2HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP2   : low  <= activeTP2)
bool tp3HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP3   : low  <= activeTP3)

// TP-priority
bool tp1FirstTouch = tp1HitRaw and not tp1Reached
bool tp2FirstTouch = tp2HitRaw and not tp2Reached
bool tp3FirstTouch = tp3HitRaw and not tp3Reached
if tp1FirstTouch
    tp1Reached := true
if tp2FirstTouch
    tp2Reached := true
if tp3FirstTouch
    tp3Reached := true

// break-even after TP1
bool beJustActivated = false
if beInput and tp1FirstTouch and not beActive and activeDir != 0
    activeSL        := activeEntry
    beActive        := true
    beJustActivated := true

// snapshots BEFORE reset
var float hitSL    = na
var float hitEntry = na
if slHitRaw
    hitSL    := effectiveSL
    hitEntry := activeEntry

float exitEntry         = activeEntry
int   exitDir           = activeDir
float exitTP1           = activeTP1
float exitTP2           = activeTP2
float exitTP3           = activeTP3
bool  exitBeActive      = beActiveAtBarStart
bool  displayTp1Reached = tp1Reached
bool  displayTp2Reached = tp2Reached
bool  displayTp3Reached = tp3Reached

// closure: SL blocked by first TP1/TP3 touch of this bar
bool closeBySl  = slHitRaw and not tp1FirstTouch and not tp3FirstTouch
bool evSlHit    = closeBySl
bool evTp3Close = false
bool tradeWin   = false
if (tp3HitRaw or closeBySl) and activeDir != 0
    evTp3Close := tp3HitRaw
    tradeWin   := tp1Reached
    if tradeWin
        winCount += 1
    else
        lossCount += 1
    array.push(tradeTimes, time)
    array.push(tradeWins, tradeWin)
    while array.size(tradeTimes) > 0 and array.get(tradeTimes, 0) < time - MS_DAY * STATS_PRUNE_DAYS
        array.shift(tradeTimes)
        array.shift(tradeWins)
    formStr := formStr + (tradeWin ? "▰" : "▱")
    if str.length(formStr) > FORM_LEN
        formStr := str.substring(formStr, str.length(formStr) - FORM_LEN)
    activeDir   := 0
    activeEntry := na
    activeSL    := na
    activeTP1   := na
    activeTP2   := na
    activeTP3   := na
    entryBarIdx := na
    tp1Reached  := false
    tp2Reached  := false
    tp3Reached  := false
    beActive    := false
    trailHighest:= na
    trailLowest := na
    trailStopPx := na

// ── Trailing Stop Update ──
if useTrailingStopInput and activeDir != 0 and barstate.isconfirmed
    if activeDir == 1
        trailHighest := na(trailHighest) ? high : math.max(trailHighest, high)
        float newTrail = trailHighest - riskAtr * trailAtrMultInput
        if na(trailStopPx)
            trailStopPx := newTrail
        else if newTrail > trailStopPx + riskAtr * trailStepInput
            trailStopPx := newTrail
        if not na(trailStopPx) and trailStopPx > activeSL
            activeSL := trailStopPx
    else
        trailLowest := na(trailLowest) ? low : math.min(trailLowest, low)
        float newTrail = trailLowest + riskAtr * trailAtrMultInput
        if na(trailStopPx)
            trailStopPx := newTrail
        else if newTrail < trailStopPx - riskAtr * trailStepInput
            trailStopPx := newTrail
        if not na(trailStopPx) and trailStopPx < activeSL
            activeSL := trailStopPx

// ── entries ──
bool trapShortBar = clsNow == 2  and close < open
bool trapLongBar  = clsNow == -2 and close > open

bool evLongEntry   = false
bool evShortEntry  = false
bool openedByTrig  = false
string entryPat    = ""
bool allowTrig = entryModeInput != "Trap Bar"
bool allowTrap = entryModeInput != "STRAT Trigger"

// ── Confirmation Bar Logic ──
bool confirmLong  = false
bool confirmShort = false
if useConfirmationInput and barstate.isconfirmed
    if rawSignalDir != 0 and bar_index == rawSignalBar + 1
        bool confirmOk = false
        if confirmTypeInput == "Close vs Close"
            confirmOk := rawSignalDir == 1 ? close > close[1] : close < close[1]
        else
            confirmOk := rawSignalDir == 1 ? close > open : close < open
        if confirmOk
            if rawSignalDir == 1
                confirmLong := true
            else
                confirmShort := true
        rawSignalDir := 0
        rawSignalBar := na

// ── Filter Diagnostics helper ──
string diagReason = ""
bool diagTriggered = false

// ── Process raw signals into confirmation queue ──
if enableTradesInput and barstate.isconfirmed and activeDir == 0 and riskAtr > 0
    int   tDir       = 0
    float slAnchorPx = na
    bool  viaTrap    = false
    if allowTrap and (trapLongBar or trapShortBar) and enhancedTrapOk
        tDir       := trapLongBar ? 1 : -1
        entryPat   := trapLongBar ? "Trap 2D" : "Trap 2U"
        slAnchorPx := trapLongBar ? low : high
        viaTrap    := true
    else if allowTrig and (trigBullSig or trigBearSig)
        tDir         := trigBullSig ? 1 : -1
        entryPat     := trigPat
        slAnchorPx   := slAnchorInput == "Setup Bar" ? trigStp :
             slAnchorInput == "Wick-Anchored" ? (trigBullSig ? low : high) : trigLvl
        openedByTrig := true

    // If confirmation enabled, store signal and skip entry this bar
    if tDir != 0 and useConfirmationInput
        rawSignalDir  := tDir
        rawSignalBar  := bar_index
        rawSignalPat  := entryPat
        rawSignalLvl  := trigLvl
        rawSignalSl   := trigStp
        rawSignalTrap := viaTrap
        tDir := 0

    // ── entry filters (both sources) ──
    if tDir != 0
        bool volOk = not useVolFilterInput or not hasVolume or (volSma > 0 and volume > volSma * volFiltMultInput)
        int ftcAlignedEntry = 0
        int ftcVisibleEntry = 0
        for i = 0 to 7
            if fV.get(i)
                ftcVisibleEntry += 1
                if (tDir == 1) == fG.get(i)
                    ftcAlignedEntry += 1
        bool ftcOk = minFtcAlignInput == 0 or ftcAlignedEntry >= math.min(minFtcAlignInput, ftcVisibleEntry)
        bool pvteOk = not usePvteInput or (tDir == 1 ? pvteRegime == 1 : pvteRegime == -1) or
             (pvteRegime == 0 and pvteNeutralInput == "Allow")
        bool trendOk = tDir == 1 ? trendOkLong : trendOkShort
        bool adxFilterOk = not useAdxFilterInput or strongTrend
        bool rsiFilterOk = not useRsiFilterInput or (tDir == 1 ? rsiOkLong : rsiOkShort)
        bool sessionFilterOk = not useSessionFilterInput or inSession

        // Build diagnostics reason
        if showDiagInput
            if not trendOk
                diagReason := "Trend"
            else if not adxFilterOk
                diagReason := "ADX"
            else if not rsiFilterOk
                diagReason := "RSI"
            else if not sessionFilterOk
                diagReason := "Session"
            else if not pvteOk
                diagReason := "PVTE"
            else if not ftcOk
                diagReason := "FTC"
            else if not volOk
                diagReason := "Volume"
            if diagReason != ""
                diagTriggered := true

        if not (volOk and ftcOk and pvteOk and trendOk and adxFilterOk and rsiFilterOk and sessionFilterOk)
            tDir := 0
    if tDir != 0
        float slPx = na
        if not viaTrap and slAnchorInput == "ATR"
            slPx := tDir == 1 ? close - riskAtr * effSlMult : close + riskAtr * effSlMult
        else
            slPx := tDir == 1 ?
                 math.min(slAnchorPx - riskAtr * slBufferInput, close - riskAtr * 0.5) :
                 math.max(slAnchorPx + riskAtr * slBufferInput, close + riskAtr * 0.5)
        float riskPx = tDir == 1 ? close - slPx : slPx - close
        bool riskOk = riskPx > 0 and (maxRiskAtrInput == 0.0 or riskPx <= riskAtr * maxRiskAtrInput)
        if riskOk
            activeEntry := close
            activeSL    := slPx
            activeTP1   := tDir == 1 ? close + riskPx * effTp1m : close - riskPx * effTp1m
            activeTP2   := tDir == 1 ? close + riskPx * effTp2m : close - riskPx * effTp2m
            activeTP3   := tDir == 1 ? close + riskPx * effTp3m : close - riskPx * effTp3m
            activeDir   := tDir
            entryBarIdx := bar_index
            tp1Reached  := false
            tp2Reached  := false
            tp3Reached  := false
            beActive    := false
            trailHighest:= na
            trailLowest := na
            trailStopPx := na
            evLongEntry  := tDir == 1
            evShortEntry := tDir == -1
        else
            if showDiagInput
                diagReason := "Risk"
                diagTriggered := true
            openedByTrig := false
    else
        openedByTrig := false

// ── Process confirmation entries ──
if confirmLong or confirmShort
    int tDir = confirmLong ? 1 : -1
    entryPat := rawSignalPat
    bool viaTrap = rawSignalTrap
    float slAnchorPx = na
    if viaTrap
        slAnchorPx := tDir == 1 ? low : high
    else
        slAnchorPx := slAnchorInput == "Setup Bar" ? rawSignalSl :
             slAnchorInput == "Wick-Anchored" ? (tDir == 1 ? low : high) : rawSignalLvl
    openedByTrig := not viaTrap

    bool volOk = not useVolFilterInput or not hasVolume or (volSma > 0 and volume > volSma * volFiltMultInput)
    int ftcAlignedConf = 0
    int ftcVisibleConf = 0
    for i = 0 to 7
        if fV.get(i)
            ftcVisibleConf += 1
            if (tDir == 1) == fG.get(i)
                ftcAlignedConf += 1
    bool ftcOk = minFtcAlignInput == 0 or ftcAlignedConf >= math.min(minFtcAlignInput, ftcVisibleConf)
    bool pvteOk = not usePvteInput or (tDir == 1 ? pvteRegime == 1 : pvteRegime == -1) or
         (pvteRegime == 0 and pvteNeutralInput == "Allow")
    bool trendOk = tDir == 1 ? trendOkLong : trendOkShort
    bool adxFilterOk = not useAdxFilterInput or strongTrend
    bool rsiFilterOk = not useRsiFilterInput or (tDir == 1 ? rsiOkLong : rsiOkShort)
    bool sessionFilterOk = not useSessionFilterInput or inSession

    if showDiagInput
        if not trendOk
            diagReason := "Trend"
        else if not adxFilterOk
            diagReason := "ADX"
        else if not rsiFilterOk
            diagReason := "RSI"
        else if not sessionFilterOk
            diagReason := "Session"
        else if not pvteOk
            diagReason := "PVTE"
        else if not ftcOk
            diagReason := "FTC"
        else if not volOk
            diagReason := "Volume"
        if diagReason != ""
            diagTriggered := true

    if volOk and ftcOk and pvteOk and trendOk and adxFilterOk and rsiFilterOk and sessionFilterOk
        float slPx = na
        if not viaTrap and slAnchorInput == "ATR"
            slPx := tDir == 1 ? close - riskAtr * effSlMult : close + riskAtr * effSlMult
        else
            slPx := tDir == 1 ?
                 math.min(slAnchorPx - riskAtr * slBufferInput, close - riskAtr * 0.5) :
                 math.max(slAnchorPx + riskAtr * slBufferInput, close + riskAtr * 0.5)
        float riskPx = tDir == 1 ? close - slPx : slPx - close
        bool riskOk = riskPx > 0 and (maxRiskAtrInput == 0.0 or riskPx <= riskAtr * maxRiskAtrInput)
        if riskOk
            activeEntry := close
            activeSL    := slPx
            activeTP1   := tDir == 1 ? close + riskPx * effTp1m : close - riskPx * effTp1m
            activeTP2   := tDir == 1 ? close + riskPx * effTp2m : close - riskPx * effTp2m
            activeTP3   := tDir == 1 ? close + riskPx * effTp3m : close - riskPx * effTp3m
            activeDir   := tDir
            entryBarIdx := bar_index
            tp1Reached  := false
            tp2Reached  := false
            tp3Reached  := false
            beActive    := false
            trailHighest:= na
            trailLowest := na
            trailStopPx := na
            evLongEntry  := tDir == 1
            evShortEntry := tDir == -1
        else
            if showDiagInput
                diagReason := "Risk"
                diagTriggered := true
            openedByTrig := false
    else
        openedByTrig := false

// ══════════════════════════════════════════════════════════
// ⚡ ULTRA PRECISE SIGNALS
// ══════════════════════════════════════════════════════════
float buyConfidence  = 0.0
float sellConfidence = 0.0
bool  ultraBuySignal  = false
bool  ultraSellSignal = false
string buyReasons  = ""
string sellReasons = ""

if enableTradesInput and activeDir == 0 and riskAtr > 0 and barstate.isconfirmed
    buyConfidence := 0.0
    if trendBull and fastEma > slowEma
        buyConfidence += 15.0
    if pvteRegime == 1
        buyConfidence += 15.0
    if ftcAlignedBull >= 3
        buyConfidence += 10.0
    if fvgBullSignal
        buyConfidence += 15.0
    if cvdStrongBuy or cvdBuy
        buyConfidence += 15.0
    if obv_bullish_reversal or obv_smooth > obv_smooth[1]
        buyConfidence += 10.0
    if trigBullSig or trapLongBar
        buyConfidence += 10.0
    if rsiVal < 50 and rsiVal > 25
        buyConfidence += 5.0
    if hasVolume and volSma > 0 and volume > volSma * 1.2
        buyConfidence += 5.0
    buyConfidence := math.min(buyConfidence, 100.0)
    ultraBuySignal := buyConfidence >= 75.0
    if ultraBuySignal
        buyReasons := "✅ "
        if trendBull and fastEma > slowEma
            buyReasons += "TREND "
        if pvteRegime == 1
            buyReasons += "PVTE "
        if fvgBullSignal
            buyReasons += "FVG "
        if cvdStrongBuy or cvdBuy
            buyReasons += "CVD "
        if obv_bullish_reversal or obv_smooth > obv_smooth[1]
            buyReasons += "OBV "
        if trigBullSig or trapLongBar
            buyReasons += "TRIG "
        buyReasons += "| CONF: " + str.tostring(buyConfidence, "#.#") + "%"

    sellConfidence := 0.0
    if trendBear and fastEma < slowEma
        sellConfidence += 15.0
    if pvteRegime == -1
        sellConfidence += 15.0
    if ftcAlignedBear >= 3
        sellConfidence += 10.0
    if fvgBearSignal
        sellConfidence += 15.0
    if cvdStrongSell or cvdSell
        sellConfidence += 15.0
    if obv_bearish_reversal or obv_smooth < obv_smooth[1]
        sellConfidence += 10.0
    if trigBearSig or trapShortBar
        sellConfidence += 10.0
    if rsiVal > 50 and rsiVal < 75
        sellConfidence += 5.0
    if hasVolume and volSma > 0 and volume > volSma * 1.2
        sellConfidence += 5.0
    sellConfidence := math.min(sellConfidence, 100.0)
    ultraSellSignal := sellConfidence >= 75.0
    if ultraSellSignal
        sellReasons := "✅ "
        if trendBear and fastEma < slowEma
            sellReasons += "TREND "
        if pvteRegime == -1
            sellReasons += "PVTE "
        if fvgBearSignal
            sellReasons += "FVG "
        if cvdStrongSell or cvdSell
            sellReasons += "CVD "
        if obv_bearish_reversal or obv_smooth < obv_smooth[1]
            sellReasons += "OBV "
        if trigBearSig or trapShortBar
            sellReasons += "TRIG "
        sellReasons += "| CONF: " + str.tostring(sellConfidence, "#.#") + "%"

// ══════════════════════════════════════════════════════════
// ⚡ ULTRA SIGNAL DISPLAY
// ══════════════════════════════════════════════════════════
var array<label> ultraLbls = array.new<label>()
var array<line>  ultraLns  = array.new<line>()

if ultraBuySignal and barstate.isconfirmed
    label ub = label.new(
        bar_index,
        low - riskAtr * 0.5,
        "🚀 BUY\n" + buyReasons,
        style = label.style_label_up,
        color = color.new(#00E676, 85),
        textcolor = color.black,
        size = size.large,
        textalign = text.align_center,
        tooltip = "Buy Signal: " + buyReasons)
    ultraLbls.push(ub)
    line uln = line.new(
        bar_index, close,
        bar_index + 10, close,
        color = color.new(#00E676, 70),
        width = 3,
        style = line.style_solid)
    ultraLns.push(uln)
    if enableAlertsInput
        alert(
            "🚀 ULTRA BUY SIGNAL\n" +
            "Price: " + str.tostring(close, format.mintick) + "\n" +
            "Confidence: " + str.tostring(buyConfidence, "#.#") + "%\n" +
            "Reasons: " + buyReasons + "\n" +
            "TP1: " + str.tostring(close * 1.01, format.mintick) + "\n" +
            "TP2: " + str.tostring(close * 1.02, format.mintick) + "\n" +
            "TP3: " + str.tostring(close * 1.035, format.mintick) + "\n" +
            "SL: " + str.tostring(close * 0.985, format.mintick),
            alert.freq_once_per_bar)

if ultraSellSignal and barstate.isconfirmed
    label us = label.new(
        bar_index,
        high + riskAtr * 0.5,
        "🔻 SELL\n" + sellReasons,
        style = label.style_label_down,
        color = color.new(#FF5252, 85),
        textcolor = color.black,
        size = size.large,
        textalign = text.align_center,
        tooltip = "Sell Signal: " + sellReasons)
    ultraLbls.push(us)
    line sln = line.new(
        bar_index, close,
        bar_index + 10, close,
        color = color.new(#FF5252, 70),
        width = 3,
        style = line.style_solid)
    ultraLns.push(sln)
    if enableAlertsInput
        alert(
            "🔻 ULTRA SELL SIGNAL\n" +
            "Price: " + str.tostring(close, format.mintick) + "\n" +
            "Confidence: " + str.tostring(sellConfidence, "#.#") + "%\n" +
            "Reasons: " + sellReasons + "\n" +
            "TP1: " + str.tostring(close * 0.99, format.mintick) + "\n" +
            "TP2: " + str.tostring(close * 0.98, format.mintick) + "\n" +
            "TP3: " + str.tostring(close * 0.965, format.mintick) + "\n" +
            "SL: " + str.tostring(close * 1.015, format.mintick),
            alert.freq_once_per_bar)

while ultraLbls.size() > MAX_ULTRA_DRAW
    label.delete(ultraLbls.shift())
while ultraLns.size() > MAX_ULTRA_DRAW
    line.delete(ultraLns.shift())

// ══════════════════════════════════════════════════════════
// DRAWINGS — bars, candles, SL/TP, levels, diagnostics
// ══════════════════════════════════════════════════════════
barcolor(colorBarsInput ? clsColor(clsNow) : na)
plotshape(showCandleInput and hammerNow,  title = "Hammer",  style = shape.triangleup,   location = location.belowbar, color = BULL, size = size.tiny)
plotshape(showCandleInput and shooterNow, title = "Shooter", style = shape.triangledown, location = location.abovebar, color = BEAR, size = size.tiny)

pOuterUp = plot(showPvteBandsInput ? pvtOuterUp : na, "PVTE Outer Up", color.new(BULL, 70), 1)
pOuterDn = plot(showPvteBandsInput ? pvtOuterDn : na, "PVTE Outer Dn", color.new(BEAR, 70), 1)
pInnerUp = plot(showPvteBandsInput ? pvtInnerUp : na, "PVTE Inner Up", color.new(BULL, 85), 1)
pInnerDn = plot(showPvteBandsInput ? pvtInnerDn : na, "PVTE Inner Dn", color.new(BEAR, 85), 1)
plot(showPvteBandsInput ? pvtBasis : na, "PVTE Basis", color.new(C_TEXT, 70), 1)
fill(pOuterUp, pInnerUp, color.new(BULL, 92), "PVTE Bull Zone")
fill(pOuterDn, pInnerDn, color.new(BEAR, 92), "PVTE Bear Zone")

var array<label> barNumLbls = array.new<label>()
if showBarNumInput and barstate.isconfirmed
    barNumLbls.push(label.new(bar_index, high, clsName(clsNow), style = label.style_none, textcolor = clsColor(clsNow), size = size.tiny, yloc = yloc.abovebar))
    while barNumLbls.size() > MAX_BARNUM_DRAW
        label.delete(barNumLbls.shift())

if showTrigLblInput and barstate.isconfirmed and (trigBullSig or trigBearSig)
    lblFifo.push(label.new(bar_index, trigBullSig ? low : high, trigPat,
         style = trigBullSig ? label.style_label_up : label.style_label_down,
         color = color.new(trigBullSig ? BULL : BEAR, 70), textcolor = C_TEXT, size = signalSize))

if showDiagInput and diagTriggered and barstate.isconfirmed
    lblFifo.push(label.new(bar_index, high, "⛔ " + diagReason,
         style = label.style_label_down, color = color.new(DIAG_COLOR, 70), textcolor = C_TEXT, size = size.tiny))

if showEntryLblInput and barstate.isconfirmed and (evLongEntry or evShortEntry)
    lblFifo.push(label.new(bar_index, close, evLongEntry ? "LONG" : "SHORT",
         style = evLongEntry ? label.style_label_up : label.style_label_down,
         color = evLongEntry ? BULL : BEAR, textcolor = LABEL_TEXT, size = signalSize,
         tooltip = entryPat + (openedByTrig ? " (trigger)" : " (trap)") + "\nEntry " + fmtPrice(activeEntry) + "\nSL " + fmtPrice(activeSL)))

var line lnE = na
var line lnS = na
var line ln1 = na
var line ln2 = na
var line ln3 = na
var label lbE = na
var label lbS = na
var label lb1 = na
var label lb2 = na
var label lb3 = na

if enableTradesInput and showSlTpInput and activeDir != 0 and not na(activeEntry)
    int x1 = nz(entryBarIdx, bar_index)
    int x2 = bar_index + LINE_FORWARD_BARS
    color slColNow = beActive ? BE_COLOR : SL_COLOR
    if na(lnE)
        lnE := line.new(x1, activeEntry, x2, activeEntry, color = ENTRY_COLOR, style = entryLineStyle, width = 1)
        lnS := line.new(x1, activeSL,    x2, activeSL,    color = slColNow,    style = slLineStyle,    width = 2)
        ln1 := line.new(x1, activeTP1,   x2, activeTP1,   color = TP1_COLOR,   style = tpLineStyle,    width = 1)
        ln2 := line.new(x1, activeTP2,   x2, activeTP2,   color = TP2_COLOR,   style = tpLineStyle,    width = 1)
        ln3 := line.new(x1, activeTP3,   x2, activeTP3,   color = TP3_COLOR,   style = tpLineStyle,    width = 1)
    else if bar_index % math.max(1, LINE_UPDATE_BARS) == 0 or barstate.islast
        line.set_xy1(lnE, x1, activeEntry)
        line.set_xy2(lnE, x2, activeEntry)
        line.set_xy1(lnS, x1, activeSL)
        line.set_xy2(lnS, x2, activeSL)
        line.set_xy1(ln1, x1, activeTP1)
        line.set_xy2(ln1, x2, activeTP1)
        line.set_xy1(ln2, x1, activeTP2)
        line.set_xy2(ln2, x2, activeTP2)
        line.set_xy1(ln3, x1, activeTP3)
        line.set_xy2(ln3, x2, activeTP3)
        line.set_color(lnS, slColNow)
        line.set_color(ln1, displayTp1Reached ? color.new(TP_HIT_COLOR, BE_DIM_TRANSP) : TP1_COLOR)
        line.set_color(ln2, displayTp2Reached ? color.new(TP_HIT_COLOR, BE_DIM_TRANSP) : TP2_COLOR)
        line.set_color(ln3, displayTp3Reached ? color.new(TP_HIT_COLOR, BE_DIM_TRANSP) : TP3_COLOR)
    if showSlTpLabelsInput and barstate.islast
        int lx = bar_index + LABEL_OFFSET_BARS
        if na(lbE)
            lbE := label.new(lx, activeEntry, "", style = label.style_label_left, color = ENTRY_COLOR, textcolor = LABEL_TEXT, size = slTpLabelSize)
            lbS := label.new(lx, activeSL,    "", style = label.style_label_left, color = slColNow,    textcolor = LABEL_TEXT, size = slTpLabelSize)
            lb1 := label.new(lx, activeTP1,   "", style = label.style_label_left, color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, size = slTpLabelSize)
            lb2 := label.new(lx, activeTP2,   "", style = label.style_label_left, color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, size = slTpLabelSize)
            lb3 := label.new(lx, activeTP3,   "", style = label.style_label_left, color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, size = slTpLabelSize)
        label.set_xy(lbE, lx, activeEntry)
        label.set_xy(lbS, lx, activeSL)
        label.set_xy(lb1, lx, activeTP1)
        label.set_xy(lb2, lx, activeTP2)
        label.set_xy(lb3, lx, activeTP3)
        label.set_color(lbS, slColNow)
        label.set_text(lbE, (activeDir == 1 ? "LONG " : "SHORT ") + fmtPrice(activeEntry))
        label.set_text(lbS, (beActive ? "BE " : "SL ") + fmtPrice(activeSL) + formatPctFromEntry(activeSL, activeEntry))
        label.set_text(lb1, "TP1 " + fmtPrice(activeTP1) + formatPctFromEntry(activeTP1, activeEntry))
        label.set_text(lb2, "TP2 " + fmtPrice(activeTP2) + formatPctFromEntry(activeTP2, activeEntry))
        label.set_text(lb3, "TP3 " + fmtPrice(activeTP3) + formatPctFromEntry(activeTP3, activeEntry))
else
    if not na(lnE)
        line.set_x2(lnE, bar_index)
        line.set_x2(lnS, bar_index)
        line.set_x2(ln1, bar_index)
        line.set_x2(ln2, bar_index)
        line.set_x2(ln3, bar_index)
        lnE := na
        lnS := na
        ln1 := na
        ln2 := na
        ln3 := na
    if not na(lbE)
        label.delete(lbE)
        label.delete(lbS)
        label.delete(lb1)
        label.delete(lb2)
        label.delete(lb3)
        lbE := na
        lbS := na
        lb1 := na
        lb2 := na
        lb3 := na

levelLine(prevDayInput,   pdH, dStart, "PDH", dayHiColInput)
levelLine(prevDayInput,   pdL, dStart, "PDL", dayLoColInput)
levelLine(prevWeekInput,  pwH, wStart, "PWH", weekHiColInput)
levelLine(prevWeekInput,  pwL, wStart, "PWL", weekLoColInput)
levelLine(prevMonthInput, pmH, mStart, "PMH", monthHiColInput)
levelLine(prevMonthInput, pmL, mStart, "PML", monthLoColInput)

string ftcStr = buildFtc(fV, fG, FTC_LBL)

if setupAlertInput and (setupBullSig or setupBearSig)
    fireAlert(setupDir > 0 ? "setup_long" : "setup_short", pendName, setupDir > 0 ? pendHi : pendLo, setupDir > 0 ? pendLo : pendHi, ftcStr)

if trigAlertInput and (trigBullSig or trigBearSig)
    fireAlert(trigBullSig ? "trigger_long" : "trigger_short", trigPat, trigLvl, trigStp, ftcStr)

if entryAlertInput and (evLongEntry or evShortEntry)
    fireTradeAlert(evLongEntry ? "entry_long" : "entry_short",
         ',"pattern":"' + entryPat + '","entry":' + str.tostring(activeEntry) + ',"sl":' + str.tostring(activeSL) +
         ',"tp1":' + str.tostring(activeTP1) + ',"tp2":' + str.tostring(activeTP2) + ',"tp3":' + str.tostring(activeTP3),
         " " + entryPat + " @ " + fmtPrice(activeEntry) + " SL " + fmtPrice(activeSL),
         ftcStr)

if slAlertInput and evSlHit
    fireTradeAlert(exitBeActive ? "be_stop" : "stop_loss",
         ',"entry":' + str.tostring(exitEntry) + ',"sl":' + str.tostring(hitSL) + ',"dir":' + str.tostring(exitDir),
         " SL " + fmtPrice(hitSL) + " from " + fmtPrice(exitEntry),
         ftcStr)

if tpBeAlertInput and beJustActivated
    fireTradeAlert("break_even",
         ',"entry":' + str.tostring(activeEntry),
         " BE @ " + fmtPrice(activeEntry),
         ftcStr)

if tpBeAlertInput and tp1FirstTouch
    fireTradeAlert("tp1", ',"tp":' + str.tostring(exitTP1), " TP1 " + fmtPrice(exitTP1), ftcStr)
if tpBeAlertInput and tp2FirstTouch
    fireTradeAlert("tp2", ',"tp":' + str.tostring(exitTP2), " TP2 " + fmtPrice(exitTP2), ftcStr)
if tpBeAlertInput and evTp3Close
    fireTradeAlert("tp3", ',"tp":' + str.tostring(exitTP3), " TP3 " + fmtPrice(exitTP3), ftcStr)

// ══════════════════════════════════════════════════════════
// 📊 ULTIMATE DASHBOARD (2-column — table.cell has no colspan)
// ══════════════════════════════════════════════════════════
var table ultraDash = na
var bool  ultraDashMerged = false
var table wmTbl = na
var table ftcTbl = na

if showWatermarkInput and barstate.islast
    if na(wmTbl)
        wmTbl := table.new(position.bottom_left, 1, 1, bgcolor = color.new(color.black, 100), frame_color = color.new(color.black, 100), border_width = 0)
    table.cell(wmTbl, 0, 0, "STRAT ULTRA " + VERSION, text_color = color.new(C_TEXT, 65), text_size = size.tiny, bgcolor = color.new(color.black, 100))
else if not showWatermarkInput and not na(wmTbl)
    table.delete(wmTbl)
    wmTbl := na

if ftcInput and barstate.islast
    if na(ftcTbl)
        ftcTbl := table.new(position.bottom_center, 8, 1, bgcolor = PANEL_BG, border_color = color.new(#30363D, 60), border_width = 1)
    for i = 0 to 7
        if fV.get(i)
            table.cell(ftcTbl, i, 0, FTC_LBL.get(i) + (fG.get(i) ? "+" : "-"),
                 text_color = color.white,
                 bgcolor = fI.get(i) ? color.new(FILTER_WARN, 45) : fO.get(i) ? color.new(C_OUTSIDE, 40) : fG.get(i) ? color.new(FILTER_PASS, 45) : color.new(FILTER_BLOCK, 45),
                 text_size = dashFontSizeSub, text_halign = text.align_center)
        else
            table.cell(ftcTbl, i, 0, "—", text_color = C_MUTED, bgcolor = PANEL_BG, text_size = dashFontSizeSub, text_halign = text.align_center)
else if not ftcInput and not na(ftcTbl)
    table.delete(ftcTbl)
    ftcTbl := na

if showDashInput and barstate.islast
    if na(ultraDash)
        ultraDash := table.new(
             dashPos,
             2, 12,
             bgcolor = color.new(#0D1117, 20),
             border_color = color.new(#30363D, 40),
             border_width = 1,
             frame_color = color.new(#30363D, 40),
             frame_width = 1)
        ultraDashMerged := false

    color hdrBg = ultraBuySignal ? HEADER_BG_BULL : ultraSellSignal ? HEADER_BG_BEAR : color.new(#1F2937, 0)
    table.cell(ultraDash, 0, 0, "⚡ ULTRA STRAT PRO", text_color = HEADER_TEXT, bgcolor = hdrBg, text_size = dashFontSize, text_halign = text.align_center)
    if not ultraDashMerged
        table.cell(ultraDash, 1, 0, "", text_color = HEADER_TEXT, bgcolor = hdrBg, text_size = dashFontSize)
        table.cell(ultraDash, 1, 11, "", text_color = color.gray, bgcolor = HEADER_BG, text_size = size.tiny)
        table.merge_cells(ultraDash, 0, 0, 1, 0)
        table.merge_cells(ultraDash, 0, 11, 1, 11)
        ultraDashMerged := true

    string sigText = ultraBuySignal ? "🚀 BUY" : ultraSellSignal ? "🔻 SELL" : "⏸️ WAIT"
    color  sigColor = ultraBuySignal ? #00E676 : ultraSellSignal ? #FF5252 : color.gray
    table.cell(ultraDash, 0, 1, "SIGNAL", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
    table.cell(ultraDash, 1, 1, sigText, text_color = sigColor, text_size = dashFontSize, text_halign = text.align_center, bgcolor = TABLE_ROW_ALT)

    float  confVal = ultraBuySignal ? buyConfidence : ultraSellSignal ? sellConfidence : 0.0
    string confText = str.tostring(confVal, "#.#") + "%  " + buildGauge(confVal, 100.0, 8)
    color  confColor = ultraBuySignal ? #00E676 : ultraSellSignal ? #FF5252 : color.gray
    table.cell(ultraDash, 0, 2, "CONFIDENCE", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
    table.cell(ultraDash, 1, 2, confText, text_color = confColor, text_size = dashFontSize, text_halign = text.align_center)

    if showMarketSecInput
        string trendText = trendBull ? "🟢 BULL" : trendBear ? "🔴 BEAR" : "⚪ NEUTRAL"
        trendText += dmiBull ? " ▲" : dmiBear ? " ▼" : ""
        color  trendColor = trendBull ? #00E676 : trendBear ? #FF5252 : color.gray
        table.cell(ultraDash, 0, 3, "TREND", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
        table.cell(ultraDash, 1, 3, trendText, text_color = trendColor, text_size = dashFontSizeSub, text_halign = text.align_center, bgcolor = TABLE_ROW_ALT)

        string pvteText = pvteRegime == 1 ? "🟢 BULL" : pvteRegime == -1 ? "🔴 BEAR" : "⚪ NEUTRAL"
        color  pvteColor = pvteRegime == 1 ? #00E676 : pvteRegime == -1 ? #FF5252 : color.gray
        table.cell(ultraDash, 0, 4, "PVTE", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
        table.cell(ultraDash, 1, 4, pvteText, text_color = pvteColor, text_size = dashFontSizeSub, text_halign = text.align_center)

        string fvgText = fvgBullSignal ? "🟢 BULL" : fvgBearSignal ? "🔴 BEAR" : "⚪ NONE"
        color  fvgColor = fvgBullSignal ? #00E676 : fvgBearSignal ? #FF5252 : color.gray
        table.cell(ultraDash, 0, 5, "FVG", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
        table.cell(ultraDash, 1, 5, fvgText, text_color = fvgColor, text_size = dashFontSizeSub, text_halign = text.align_center, bgcolor = TABLE_ROW_ALT)

        string cvdText = cvdStrongBuy ? "🟢 STRONG" : cvdStrongSell ? "🔴 STRONG" : cvdBuy ? "🟢 BUY" : cvdSell ? "🔴 SELL" : "⚪ NEUTRAL"
        color  cvdColor = cvdStrongBuy or cvdBuy ? #00E676 : cvdStrongSell or cvdSell ? #FF5252 : color.gray
        table.cell(ultraDash, 0, 6, "CVD", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
        table.cell(ultraDash, 1, 6, cvdText, text_color = cvdColor, text_size = dashFontSizeSub, text_halign = text.align_center)

        string obvText = obv_bullish_reversal ? "🟢 REV" : obv_bearish_reversal ? "🔴 REV" : obv_smooth > obv_smooth[1] ? "🟢 UP" : "🔴 DOWN"
        color  obvColor = obv_bullish_reversal or obv_smooth > obv_smooth[1] ? #00E676 : #FF5252
        table.cell(ultraDash, 0, 7, "OBV", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
        table.cell(ultraDash, 1, 7, obvText, text_color = obvColor, text_size = dashFontSizeSub, text_halign = text.align_center, bgcolor = TABLE_ROW_ALT)

        table.cell(ultraDash, 0, 8, "FTC", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
        table.cell(ultraDash, 1, 8, str.tostring(ftcAligned) + "/" + str.tostring(ftcVisible),
             text_color = color.white, text_size = dashFontSizeSub, text_halign = text.align_center)
    else
        for r = 3 to 8
            table.cell(ultraDash, 0, r, "", bgcolor = PANEL_BG)
            table.cell(ultraDash, 1, r, "", bgcolor = PANEL_BG)

    if showStatsSecInput
        int cutoff = statsPeriodInput == "24 Hours" ? time - MS_DAY : statsPeriodInput == "30 Days" ? time - MS_DAY * 30 : 0
        [pw, pl] = periodStats(tradeTimes, tradeWins, cutoff)
        int wrW = statsPeriodInput == "All-Time" ? winCount : pw
        int wrN = statsPeriodInput == "All-Time" ? winCount + lossCount : pw + pl
        float winRate = wrN > 0 ? wrW / wrN * 100.0 : 0.0
        color wrColor = winRate >= 60 ? #00E676 : winRate >= 45 ? #FFD700 : #FF5252
        table.cell(ultraDash, 0, 9, "WIN RATE", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
        table.cell(ultraDash, 1, 9, str.tostring(winRate, "#.#") + "%", text_color = wrColor, text_size = dashFontSizeSub, text_halign = text.align_center, bgcolor = TABLE_ROW_ALT)

        table.cell(ultraDash, 0, 10, "RECENT", text_color = color.gray, text_size = dashFontSizeSub, bgcolor = HEADER_BG)
        table.cell(ultraDash, 1, 10, formStr, text_color = color.white, text_size = dashFontSizeSub, text_halign = text.align_left)
    else
        table.cell(ultraDash, 0, 9, "", bgcolor = PANEL_BG)
        table.cell(ultraDash, 1, 9, "", bgcolor = PANEL_BG)
        table.cell(ultraDash, 0, 10, "", bgcolor = PANEL_BG)
        table.cell(ultraDash, 1, 10, "", bgcolor = PANEL_BG)

    string tradeHint = showTradeSecInput and activeDir != 0 ? (activeDir == 1 ? " LONG" : " SHORT") : ""
    table.cell(ultraDash, 0, 11, "v" + VERSION + tradeHint, text_color = color.gray, text_size = size.tiny, text_halign = text.align_center, bgcolor = HEADER_BG)
else if not showDashInput and not na(ultraDash)
    table.delete(ultraDash)
    ultraDash := na
    ultraDashMerged := false

// ══════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════
alertcondition(ultraBuySignal, "🚀 ULTRA BUY", "Ultra Buy Signal")
alertcondition(ultraSellSignal, "🔻 ULTRA SELL", "Ultra Sell Signal")
alertcondition(trigBullSig, "STRAT Buy Trigger", "STRAT Buy Trigger")
alertcondition(trigBearSig, "STRAT Sell Trigger", "STRAT Sell Trigger")
alertcondition(fvgBullSignal, "FVG Bullish", "FVG Bullish Signal")
alertcondition(fvgBearSignal, "FVG Bearish", "FVG Bearish Signal")
alertcondition(evLongEntry, "Trade Long Entry", "STRAT Long Entry")
alertcondition(evShortEntry, "Trade Short Entry", "STRAT Short Entry")
alertcondition(evSlHit, "Trade Stop Hit", "STRAT Stop Hit")
alertcondition(evTp3Close, "Trade TP3 Hit", "STRAT TP3 Hit")
