//@version=6
indicator('Buy Sell Signal + Statistical Score', overlay = true, max_labels_count = 500)

// ============================================
// BASE PARAMETERS
// ============================================
emaFastLen = input.int(5, 'Fast EMA', minval = 1)
emaSlowLen = input.int(13, 'Slow EMA', minval = 1)
atrLen = input.int(14, 'ATR Period', minval = 1)
atrMultSL = input.float(0.5, 'SL Multiplier (ATR)', minval = 0.1, step = 0.1)
riskReward = input.float(3.0, 'Risk:Reward (R:R)', minval = 1.0, step = 0.5)
confirmCandle = input.bool(true, 'Require candle confirmation')

// EMA Settings
showEmaFastLabel = input.bool(true, 'Show Fast EMA', group = 'EMAs')
emaFastColor = input.color(color.green, 'Fast EMA Color', group = 'EMAs')
showEmaSlowLabel = input.bool(true, 'Show Slow EMA', group = 'EMAs')
emaSlowColor = input.color(color.orange, 'Slow EMA Color', group = 'EMAs')

// ============================================
// STATISTICAL SCORE ENGINE
// ============================================
grp_score = 'Quality Score Engine'
i_enableScore = input.bool(true, 'Enable Statistical Scoring', group = grp_score)
i_sigMinScore = input.float(0.55, 'Min Score for Signal', group = grp_score, minval = 0.35, maxval = 0.95, step = 0.01)
i_highOnly = input.bool(false, 'Show Only High-Tier Signals (H)', group = grp_score)
i_emaHTF = input.int(200, 'HTF EMA', group = grp_score)
i_swingLen = input.int(5, 'Fractal Lookback', minval = 2, maxval = 20, group = grp_score)
i_rvolLen = input.int(20, 'RVOL Length', minval = 5, group = grp_score)
i_volRegimeLen = input.int(50, 'Volatility Regime ATR Length', group = grp_score)
i_highProb = input.float(0.65, 'High Cutoff', group = grp_score, minval = 0.5, maxval = 0.99, step = 0.01)
i_medProb = input.float(0.45, 'Med Cutoff', group = grp_score, minval = 0.2, maxval = 0.64, step = 0.01)
i_maxScore = input.float(0.88, 'Max Score Clamp', group = grp_score, minval = 0.70, maxval = 0.98, step = 0.01)
i_sigCooldown = input.int(3, 'Min Bars Between Same-Direction Signals', minval = 0, group = grp_score)

// ============================================
// CALCULATIONS
// ============================================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaHTF = ta.ema(close, i_emaHTF)
atr = ta.atr(atrLen)
atrLong = ta.atr(i_volRegimeLen)
volMA = ta.sma(volume, i_rvolLen)
rvol = volume / math.max(volMA, 1)

bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow
trendChange = bullTrend != bullTrend[1]
aboveHTF = close > emaHTF
belowHTF = close < emaHTF
trendStrength = math.abs(emaFast - emaSlow) / math.max(atr, syminfo.mintick)

volRatio = atr / math.max(atrLong, syminfo.mintick)
volCompressed = volRatio < 0.7
volExpanded = volRatio > 1.3
volNormal = not volCompressed and not volExpanded

swingH = ta.pivothigh(high, i_swingLen, i_swingLen)
swingL = ta.pivotlow(low, i_swingLen, i_swingLen)

var float lastSH = na
var float lastSL = na
var float prevSH = na
var float prevSL = na

if not na(swingH)
    prevSH := lastSH
    lastSH := swingH
if not na(swingL)
    prevSL := lastSL
    lastSL := swingL

bosBull = not na(lastSH) and not na(prevSH) and lastSH > prevSH
bosBear = not na(lastSL) and not na(prevSL) and lastSL < prevSL

haveRange = not na(lastSH) and not na(lastSL)
rangeHi = haveRange ? math.max(lastSH, lastSL) : na
rangeLo = haveRange ? math.min(lastSH, lastSL) : na
rangeMid = haveRange ? (rangeHi + rangeLo) / 2 : na
inDiscount = haveRange and close < rangeMid
inPremium = haveRange and close > rangeMid

bodyAbs = math.abs(close - open)
rng = math.max(high - low, syminfo.mintick)
bodyRatio = bodyAbs / rng
bullCandle = close > open
bearCandle = close < open

clamp(v, lo, hi) =>
    math.max(lo, math.min(hi, v))

logit(p) =>
    math.log(p / (1.0 - p))

tierLabel(p) =>
    p >= i_highProb ? 'H' : p >= i_medProb ? 'M' : 'L'

tierColor(p, isLong) =>
    tier = p >= i_highProb ? 2 : p >= i_medProb ? 1 : 0
    isLong ?
         (tier == 2 ? color.new(#00e676, 0) : tier == 1 ? color.new(#66bb6a, 0) : color.new(#37474f, 0)) :
         (tier == 2 ? color.new(#ff1744, 0) : tier == 1 ? color.new(#ef5350, 0) : color.new(#4e342e, 0))

// Logistic quality model for EMA crossover signals
calcSignalScore(isLong) =>
    f1 = trendStrength > 1.5 ? 0.84 : trendStrength > 0.8 ? 0.70 : trendStrength > 0.4 ? 0.55 : 0.36
    f2 = isLong ? (bullTrend ? 0.82 : 0.28) : (bearTrend ? 0.82 : 0.28)
    f3 = isLong ? (aboveHTF ? 0.76 : 0.34) : (belowHTF ? 0.76 : 0.34)
    f4 = rvol > 1.5 ? 0.78 : rvol > 1.0 ? 0.64 : rvol > 0.7 ? 0.48 : 0.34
    f5 = not haveRange ? 0.50 : isLong ? (inDiscount ? 0.82 : 0.30) : (inPremium ? 0.82 : 0.30)
    f6 = isLong ? (bosBull ? 0.74 : 0.40) : (bosBear ? 0.74 : 0.40)
    f7 = volNormal ? 0.58 : volExpanded ? 0.74 : 0.36
    f8 = confirmCandle ? (isLong ? (bullCandle and bodyRatio > 0.45 ? 0.76 : 0.42) : (bearCandle and bodyRatio > 0.45 ? 0.76 : 0.42)) : 0.58
    f9 = isLong ? (close > emaFast and emaFast > emaSlow ? 0.72 : 0.38) : (close < emaFast and emaFast < emaSlow ? 0.72 : 0.38)

    ll = 1.2 * logit(clamp(f1, 0.1, 0.9)) +
         1.4 * logit(clamp(f2, 0.1, 0.9)) +
         1.0 * logit(clamp(f3, 0.1, 0.9)) +
         0.8 * logit(clamp(f4, 0.1, 0.9)) +
         1.5 * logit(clamp(f5, 0.1, 0.9)) +
         1.2 * logit(clamp(f6, 0.1, 0.9)) +
         0.8 * logit(clamp(f7, 0.1, 0.9)) +
         1.0 * logit(clamp(f8, 0.1, 0.9)) +
         1.0 * logit(clamp(f9, 0.1, 0.9))

    clamp(1.0 / (1.0 + math.exp(-(-0.58 + ll))), 0.04, i_maxScore)

scorePasses(prob) =>
    not i_enableScore or prob >= i_sigMinScore

tierPasses(prob) =>
    not i_highOnly or prob >= i_highProb

// ============================================
// TREND LOGIC + RAW SIGNALS
// ============================================
buyCondition1 = bullTrend and trendChange and bullCandle
sellCondition1 = bearTrend and trendChange and bearCandle
buyCondition2 = bullTrend and trendChange
sellCondition2 = bearTrend and trendChange

rawBuy = confirmCandle ? buyCondition1 : buyCondition2
rawSell = confirmCandle ? sellCondition1 : sellCondition2

var int lastRawBuyBar = -9999
var int lastRawSellBar = -9999

buyScore = calcSignalScore(true)
sellScore = calcSignalScore(false)

buyCooldownOk = bar_index - lastRawBuyBar >= i_sigCooldown
sellCooldownOk = bar_index - lastRawSellBar >= i_sigCooldown

buySignal = rawBuy and buyCooldownOk and scorePasses(buyScore) and tierPasses(buyScore)
sellSignal = rawSell and sellCooldownOk and scorePasses(sellScore) and tierPasses(sellScore)

if rawBuy
    lastRawBuyBar := bar_index
if rawSell
    lastRawSellBar := bar_index

// ============================================
// POSITION MANAGEMENT
// ============================================
var float entryPrice = na
var float stopLoss = na
var float takeProfitFinal = na
var bool inPosition = false
var string positionType = ''
var float entryScore = na
var string entryTier = ''

var float[] tpLevels = array.new_float(0)
var bool[] tpHitFlags = array.new_bool(0)

tpFinalHit = false
slHit = false
invalidated = false

if inPosition and positionType == 'LONG'
    if high >= takeProfitFinal
        tpFinalHit := true
        inPosition := false
        positionType := ''
    else if low <= stopLoss
        slHit := true
        inPosition := false
        positionType := ''

if inPosition and positionType == 'SHORT'
    if low <= takeProfitFinal
        tpFinalHit := true
        inPosition := false
        positionType := ''
    else if high >= stopLoss
        slHit := true
        inPosition := false
        positionType := ''

if inPosition and array.size(tpLevels) > 0
    for i = 0 to array.size(tpLevels) - 1
        if not array.get(tpHitFlags, i)
            if positionType == 'LONG' and high >= array.get(tpLevels, i)
                array.set(tpHitFlags, i, true)
            else if positionType == 'SHORT' and low <= array.get(tpLevels, i)
                array.set(tpHitFlags, i, true)

showBuySignal = false
showSellSignal = false
var string invalidatedType = ''

if buySignal
    if not inPosition or positionType != 'LONG'
        if inPosition and positionType == 'SHORT'
            invalidated := true
            invalidatedType := 'SELL'
            inPosition := false

        entryPrice := close
        stopLoss := low - atr * atrMultSL
        risk = entryPrice - stopLoss
        takeProfitFinal := entryPrice + risk * riskReward
        entryScore := buyScore
        entryTier := tierLabel(buyScore)

        array.clear(tpLevels)
        array.clear(tpHitFlags)
        numTPs = math.floor(riskReward)
        for i = 1 to numTPs - 1
            array.push(tpLevels, entryPrice + risk * i)
            array.push(tpHitFlags, false)

        inPosition := true
        positionType := 'LONG'
        showBuySignal := true

if sellSignal
    if not inPosition or positionType != 'SHORT'
        if inPosition and positionType == 'LONG'
            invalidated := true
            invalidatedType := 'BUY'
            inPosition := false

        entryPrice := close
        stopLoss := high + atr * atrMultSL
        risk = stopLoss - entryPrice
        takeProfitFinal := entryPrice - risk * riskReward
        entryScore := sellScore
        entryTier := tierLabel(sellScore)

        array.clear(tpLevels)
        array.clear(tpHitFlags)
        numTPs = math.floor(riskReward)
        for i = 1 to numTPs - 1
            array.push(tpLevels, entryPrice - risk * i)
            array.push(tpHitFlags, false)

        inPosition := true
        positionType := 'SHORT'
        showSellSignal := true

// ============================================
// VISUALIZATION
// ============================================
plot(emaFast, title = 'Fast EMA', color = color.new(emaFastColor, 0), linewidth = 1, display = showEmaFastLabel ? display.all : display.none)
plot(emaSlow, title = 'Slow EMA', color = color.new(emaSlowColor, 0), linewidth = 1, display = showEmaSlowLabel ? display.all : display.none)

buyTxt = i_enableScore ? 'BUY ' + tierLabel(buyScore) + '\n' + str.format('{0,number,#}%', buyScore * 100) : 'BUY'
sellTxt = i_enableScore ? 'SELL ' + tierLabel(sellScore) + '\n' + str.format('{0,number,#}%', sellScore * 100) : 'SELL'

plotshape(showBuySignal, 'BUY Signal', shape.labelup, location.belowbar, tierColor(buyScore, true), text = buyTxt, textcolor = color.white, size = size.normal)
plotshape(showSellSignal, 'SELL Signal', shape.labeldown, location.abovebar, tierColor(sellScore, false), text = sellTxt, textcolor = color.white, size = size.normal)

plotshape(tpFinalHit, 'FINAL TAKE PROFIT', shape.circle, location.abovebar, color.new(#00ff00, 0), text = '🎯 TP', textcolor = #00ff00, size = size.small)
plotshape(slHit, 'STOP LOSS', shape.xcross, location.belowbar, color.new(#ff0000, 0), text = 'SL', textcolor = color.white, size = size.small)

plotshape(invalidated and invalidatedType == 'BUY', 'INVALIDATED BUY', shape.diamond, location.abovebar, color.new(color.yellow, 0), text = 'INV BUY', textcolor = color.rgb(97, 100, 107), size = size.tiny)
plotshape(invalidated and invalidatedType == 'SELL', 'INVALIDATED SELL', shape.diamond, location.abovebar, color.new(color.yellow, 0), text = 'INV SELL', textcolor = color.rgb(97, 100, 107), size = size.tiny)

var bool[] tpAlreadyMarked = array.new_bool(0)

if showBuySignal or showSellSignal
    array.clear(tpAlreadyMarked)
    numTPs = math.floor(riskReward)
    for i = 1 to numTPs - 1
        array.push(tpAlreadyMarked, false)

if inPosition and array.size(tpHitFlags) > 0 and array.size(tpAlreadyMarked) > 0
    for i = 0 to array.size(tpHitFlags) - 1
        if array.get(tpHitFlags, i) and not array.get(tpAlreadyMarked, i)
            label.new(bar_index, high, 'TP' + str.tostring(i + 1), style = label.style_label_down, color = color.new(color.green, 50), textcolor = color.white, size = size.tiny, yloc = yloc.abovebar)
            array.set(tpAlreadyMarked, i, true)

var line entryLine = na
var line slLine = na
var line tpLineFinal = na
var line[] tpIntermediateLines = array.new_line(0)

if inPosition and positionType != ''
    if na(entryLine)
        entryLine := line.new(bar_index - 10, entryPrice, bar_index + 10, entryPrice, color = color.new(color.white, 0), width = 1, style = line.style_dashed)
    else
        line.set_xy1(entryLine, bar_index - 10, entryPrice)
        line.set_xy2(entryLine, bar_index + 10, entryPrice)

    if na(slLine)
        slLine := line.new(bar_index, stopLoss, bar_index + 1, stopLoss, color = color.new(color.red, 0), width = 2)
    else
        line.set_xy1(slLine, bar_index, stopLoss)
        line.set_xy2(slLine, bar_index + 1, stopLoss)

    if na(tpLineFinal)
        tpLineFinal := line.new(bar_index, takeProfitFinal, bar_index + 1, takeProfitFinal, color = color.new(color.green, 0), width = 2)
    else
        line.set_xy1(tpLineFinal, bar_index, takeProfitFinal)
        line.set_xy2(tpLineFinal, bar_index + 1, takeProfitFinal)

    if array.size(tpIntermediateLines) == 0 and array.size(tpLevels) > 0
        for i = 0 to array.size(tpLevels) - 1
            tpLine = line.new(bar_index, array.get(tpLevels, i), bar_index + 1, array.get(tpLevels, i), color = color.new(color.green, 60), width = 1, style = line.style_dotted)
            array.push(tpIntermediateLines, tpLine)
    else if array.size(tpIntermediateLines) > 0
        for i = 0 to array.size(tpIntermediateLines) - 1
            line.set_xy1(array.get(tpIntermediateLines, i), bar_index, array.get(tpLevels, i))
            line.set_xy2(array.get(tpIntermediateLines, i), bar_index + 1, array.get(tpLevels, i))
else
    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na
    if not na(slLine)
        line.delete(slLine)
        slLine := na
    if not na(tpLineFinal)
        line.delete(tpLineFinal)
        tpLineFinal := na
    if array.size(tpIntermediateLines) > 0
        for i = 0 to array.size(tpIntermediateLines) - 1
            line.delete(array.get(tpIntermediateLines, i))
        array.clear(tpIntermediateLines)

// ============================================
// INFO TABLE (enhanced with statistical context)
// ============================================
var table infoTable = table.new(position.top_right, 2, 10, bgcolor = color.new(color.black, 85), border_width = 1)

ctxTxt = bullTrend and aboveHTF ? 'BULL' : bearTrend and belowHTF ? 'BEAR' : 'CHOP'
zoneTxt = not haveRange ? '-' : inPremium ? 'PREM' : 'DISC'
volTxt = volCompressed ? 'COMP' : volExpanded ? 'EXP' : 'NORM'

if barstate.islast
    table.cell(infoTable, 0, 0, 'Status:', text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 0, inPosition ? positionType : 'No Position', text_color = inPosition ? color.yellow : color.gray, text_size = size.small)

    if inPosition
        table.cell(infoTable, 0, 1, 'Entry:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 1, str.tostring(entryPrice, '#.##'), text_color = color.white, text_size = size.small)

        table.cell(infoTable, 0, 2, 'Stop Loss:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 2, str.tostring(stopLoss, '#.##'), text_color = color.red, text_size = size.small)

        table.cell(infoTable, 0, 3, 'Take Profit:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 3, str.tostring(takeProfitFinal, '#.##'), text_color = color.green, text_size = size.small)

        riskVal = math.abs(entryPrice - stopLoss)
        rewardVal = math.abs(takeProfitFinal - entryPrice)
        currentRR = riskVal > 0 ? rewardVal / riskVal : na

        table.cell(infoTable, 0, 4, 'R:R:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 4, na(currentRR) ? '-' : str.tostring(currentRR, '#.##') + ':1', text_color = color.orange, text_size = size.small)

        table.cell(infoTable, 0, 5, 'Entry Q:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 5, entryTier + ' ' + str.format('{0}%', math.round(entryScore * 100)), text_color = color.aqua, text_size = size.small)
    else
        table.cell(infoTable, 0, 1, 'Buy Q:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 1, tierLabel(buyScore) + ' ' + str.format('{0}%', math.round(buyScore * 100)), text_color = tierColor(buyScore, true), text_size = size.small)

        table.cell(infoTable, 0, 2, 'Sell Q:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 2, tierLabel(sellScore) + ' ' + str.format('{0}%', math.round(sellScore * 100)), text_color = tierColor(sellScore, false), text_size = size.small)

        table.cell(infoTable, 0, 3, 'Min Sig:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 3, str.format('{0}%', math.round(i_sigMinScore * 100)), text_color = color.gray, text_size = size.small)

        table.cell(infoTable, 0, 4, 'Bias:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 4, ctxTxt, text_color = color.white, text_size = size.small)

        table.cell(infoTable, 0, 5, 'Zone:', text_color = color.white, text_size = size.small)
        table.cell(infoTable, 1, 5, zoneTxt, text_color = color.white, text_size = size.small)

    table.cell(infoTable, 0, 6, 'BOS:', text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 6, bosBull ? 'BOS+' : bosBear ? 'BOS-' : '-', text_color = color.white, text_size = size.small)

    table.cell(infoTable, 0, 7, 'Vol:', text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 7, volTxt + ' | RVOL ' + str.format('{0,number,#.#}', rvol), text_color = color.white, text_size = size.small)

    table.cell(infoTable, 0, 8, 'Tiers:', text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 8, 'H>=' + str.format('{0}%', math.round(i_highProb * 100)) + ' M>=' + str.format('{0}%', math.round(i_medProb * 100)), text_color = color.gray, text_size = size.tiny)

    table.cell(infoTable, 0, 9, 'Score:', text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 9, i_enableScore ? 'ON' : 'OFF', text_color = i_enableScore ? color.lime : color.gray, text_size = size.small)

// ============================================
// ALERTS
// ============================================
alertcondition(showBuySignal, '🟢 BUY Signal', '📈 BUY on {{ticker}} | Price: {{close}} | Quality filtered')
alertcondition(showSellSignal, '🔴 SELL Signal', '📉 SELL on {{ticker}} | Price: {{close}} | Quality filtered')
alertcondition(tpFinalHit, '🎯 Final Take Profit', '✅ Final TP hit on {{ticker}} | Price: {{close}}')
alertcondition(slHit, '❌ Stop Loss', '🛑 SL triggered on {{ticker}} | Price: {{close}}')
alertcondition(invalidated, '⚠️ Entry Invalidated', '⚠️ Previous entry invalidated on {{ticker}} | New signal detected')
